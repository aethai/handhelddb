---
interface Props {
  fps: number;
  size?: 'sm' | 'md' | 'lg';
}

const { fps, size = 'md' } = Astro.props;

function getVerdict(fps: number) {
  if (fps >= 60) return { label: '60fps', class: 'perf-green' };
  if (fps >= 40) return { label: '40fps', class: 'perf-yellow' };
  if (fps >= 30) return { label: '30fps', class: 'perf-orange' };
  return { label: '<30fps', class: 'perf-red' };
}

const verdict = getVerdict(fps);

const sizeClasses = {
  sm: 'perf-sm',
  md: 'perf-md',
  lg: 'perf-lg',
};
---

<span class={`perf-badge ${verdict.class} ${sizeClasses[size]}`}>
  {verdict.label}
</span>

<style>
  .perf-badge {
    font-family: var(--font-mono);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }
  .perf-sm { font-size: 11px; }
  .perf-md { font-size: 13px; }
  .perf-lg { font-size: 16px; }
  .perf-green { color: #22c55e; }
  .perf-yellow { color: #eab308; }
  .perf-orange { color: #f97316; }
  .perf-red { color: #ef4444; }
</style>
