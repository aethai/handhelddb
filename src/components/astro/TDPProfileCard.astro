---
interface TDPProfile {
  tdpWatts: number;
  fpsAvg: number;
  resolution: string;
  preset: string;
  fsrEnabled: boolean;
  fsrMode?: string;
  estimatedBatteryHours: number;
  thermal: string;
  fanNoise: string;
  reportCount: number;
  confidence: string;
}

interface Props {
  profile: TDPProfile;
  tier?: string;
}

const { profile } = Astro.props;

function fpsColor(fps: number): string {
  if (fps >= 60) return 'text-green-400';
  if (fps >= 40) return 'text-yellow-400';
  if (fps >= 30) return 'text-orange-400';
  return 'text-red-400';
}

const thermalLabels: Record<string, string> = { cool: 'Cool', warm: 'Warm', hot: 'Hot' };
const fanLabels: Record<string, string> = { silent: 'Silent', quiet: 'Quiet', audible: 'Audible', loud: 'Loud' };
const hasTdp = profile.tdpWatts > 0;
const hasBattery = profile.estimatedBatteryHours > 0;
---

<div class="border border-[#D4FF00]/20 bg-[#D4FF00]/5 rounded-lg p-5">
  <!-- Big FPS number -->
  <div class="text-center mb-4">
    <p class={`text-4xl font-bold font-mono ${fpsColor(profile.fpsAvg)}`}>{Math.round(profile.fpsAvg)}</p>
    <p class="text-xs text-[var(--color-text-dim)] mt-1">avg FPS</p>
  </div>

  <!-- Settings grid -->
  <div class="space-y-2 text-sm">
    <div class="flex justify-between">
      <span class="text-[var(--color-text-dim)]">Resolution</span>
      <span class="text-[var(--color-text-2)]">{profile.resolution}</span>
    </div>
    <div class="flex justify-between">
      <span class="text-[var(--color-text-dim)]">Preset</span>
      <span class="text-[var(--color-text-2)] capitalize">{profile.preset.replace('_', ' ')}</span>
    </div>
    {hasTdp && (
      <div class="flex justify-between">
        <span class="text-[var(--color-text-dim)]">TDP</span>
        <span class="text-white font-medium font-mono">{profile.tdpWatts}W</span>
      </div>
    )}
    {profile.fsrEnabled && (
      <div class="flex justify-between">
        <span class="text-[var(--color-text-dim)]">FSR/DLSS</span>
        <span class="text-[var(--color-text-2)] capitalize">{profile.fsrMode ?? 'On'}</span>
      </div>
    )}
    {(hasBattery || profile.thermal || profile.fanNoise) && (
      <div class="border-t border-[var(--color-elevated)] my-2"></div>
    )}
    {hasBattery && (
      <div class="flex justify-between">
        <span class="text-[var(--color-text-dim)]">Battery</span>
        <span class="text-[var(--color-text-2)] font-mono">{profile.estimatedBatteryHours.toFixed(1)}h</span>
      </div>
    )}
    {profile.thermal && thermalLabels[profile.thermal] && (
      <div class="flex justify-between">
        <span class="text-[var(--color-text-dim)]">Thermal</span>
        <span class="text-[var(--color-text-2)]">{thermalLabels[profile.thermal]}</span>
      </div>
    )}
    {profile.fanNoise && fanLabels[profile.fanNoise] && (
      <div class="flex justify-between">
        <span class="text-[var(--color-text-dim)]">Fan</span>
        <span class="text-[var(--color-text-2)]">{fanLabels[profile.fanNoise]}</span>
      </div>
    )}
  </div>
</div>
