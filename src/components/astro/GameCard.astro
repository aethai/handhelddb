---
import PerformanceBadge from './PerformanceBadge.astro';

interface Props {
  slug: string;
  name: string;
  headerImage?: string | null;
  genres?: string[];
  deckCompatibility?: string;
  bestFps?: number | null;
  reportCount?: number;
}

const {
  slug,
  name,
  headerImage,
  genres = [],
  deckCompatibility,
  bestFps,
  reportCount = 0,
} = Astro.props;
---

<a href={`/games/${slug}`} class="hdb-game-card group">
  <!-- Header Image -->
  <div class="hdb-game-card-img">
    {headerImage ? (
      <img
        src={headerImage}
        alt={name}
        class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
        loading="lazy"
      />
    ) : (
      <div class="flex h-full items-center justify-center text-[#2a2838]">
        <svg class="h-10 w-10" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M14.25 6.087c0-.355.186-.676.401-.959.221-.29.349-.634.349-1.003 0-1.036-1.007-1.875-2.25-1.875s-2.25.84-2.25 1.875c0 .369.128.713.349 1.003.215.283.401.604.401.959v0a.64.64 0 01-.657.643 48.39 48.39 0 01-4.163-.3c.186 1.613.293 3.25.315 4.907a.656.656 0 01-.658.663v0c-.355 0-.676-.186-.959-.401a1.647 1.647 0 00-1.003-.349c-1.036 0-1.875 1.007-1.875 2.25s.84 2.25 1.875 2.25c.369 0 .713-.128 1.003-.349.283-.215.604-.401.959-.401v0c.31 0 .555.26.532.57a48.039 48.039 0 01-.642 5.056c1.518.19 3.058.309 4.616.354a.64.64 0 00.657-.643v0c0-.355-.186-.676-.401-.959a1.647 1.647 0 01-.349-1.003c0-1.035 1.008-1.875 2.25-1.875 1.243 0 2.25.84 2.25 1.875 0 .369-.128.713-.349 1.003-.215.283-.4.604-.4.959v0c0 .333.277.599.61.58a48.1 48.1 0 005.427-.63 48.05 48.05 0 00.582-4.717.532.532 0 00-.533-.57v0c-.355 0-.676.186-.959.401-.29.221-.634.349-1.003.349-1.035 0-1.875-1.007-1.875-2.25s.84-2.25 1.875-2.25c.37 0 .713.128 1.003.349.283.215.604.401.959.401v0a.656.656 0 00.658-.663 48.422 48.422 0 00-.37-5.36c-1.886.342-3.81.574-5.766.689a.578.578 0 01-.61-.58v0z" />
        </svg>
      </div>
    )}
  </div>

  <!-- Card Body -->
  <div class="hdb-game-card-body">
    <h3 class="hdb-game-card-title">
      {name}
    </h3>

    <div class="hdb-game-card-meta">
      {genres.slice(0, 2).map((genre) => (
        <span class="hdb-game-card-genre">{genre}</span>
      ))}
    </div>

    <div class="hdb-game-card-footer">
      {bestFps != null ? (
        <PerformanceBadge fps={bestFps} size="sm" />
      ) : (
        <span class="hdb-game-card-nodata">No data yet</span>
      )}
      {reportCount > 0 && (
        <span class="hdb-game-card-reports">{reportCount} reports</span>
      )}
    </div>
  </div>
</a>

<style>
  .hdb-game-card {
    display: block;
    overflow: hidden;
    border-radius: 12px;
    border: 1px solid rgba(255,255,255,0.06);
    background: var(--color-raised, #0e0c16);
    text-decoration: none;
    transition: all 0.2s ease;
  }
  .hdb-game-card:hover {
    border-color: rgba(255,255,255,0.1);
    box-shadow: 0 4px 20px rgba(0,0,0,0.25), 0 0 20px rgba(167,139,250,0.04);
    transform: translateY(-2px);
  }

  .hdb-game-card-img {
    aspect-ratio: 460/215;
    overflow: hidden;
    background: var(--color-elevated, #12101a);
  }

  .hdb-game-card-body {
    padding: 12px 14px;
  }

  .hdb-game-card-title {
    font-size: 14px;
    font-weight: 600;
    color: #eae6f4;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    transition: color 0.15s;
  }
  .hdb-game-card:hover .hdb-game-card-title {
    color: #a78bfa;
  }

  .hdb-game-card-meta {
    margin-top: 6px;
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }
  .hdb-game-card-genre {
    font-size: 12px;
    color: #6d6882;
  }

  .hdb-game-card-footer {
    margin-top: 10px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .hdb-game-card-nodata {
    font-size: 12px;
    color: #2a2838;
  }
  .hdb-game-card-reports {
    font-size: 12px;
    color: #6d6882;
  }
</style>
