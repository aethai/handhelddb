---
interface Props {
  slug: string;
  name: string;
  headerImage?: string | null;
  genres?: string[];
  deckCompatibility?: string | null;
}

const { slug, name, headerImage, genres = [], deckCompatibility } = Astro.props;

const deckBadge: Record<string, { label: string; class: string }> = {
  verified: { label: 'Verified', class: 'hdb-badge-verified' },
  playable: { label: 'Playable', class: 'hdb-badge-playable' },
  unsupported: { label: 'Unsupported', class: 'hdb-badge-unsupported' },
};
const deck = deckBadge[deckCompatibility ?? ''];
---

<a href={`/games/${slug}`} class="hdb-featured-card group">
  {headerImage ? (
    <img
      src={headerImage}
      alt={name}
      class="hdb-featured-img"
      loading="lazy"
    />
  ) : (
    <div class="hdb-featured-placeholder"></div>
  )}

  <div class="game-card-overlay"></div>

  {deck && (
    <div class="hdb-featured-badge">
      <span class={`hdb-badge ${deck.class}`}>{deck.label}</span>
    </div>
  )}

  <div class="hdb-featured-content">
    <h3 class="hdb-featured-title">{name}</h3>
    {genres.length > 0 && (
      <div class="hdb-featured-genres">
        {genres.slice(0, 3).map((genre) => (
          <span class="hdb-featured-genre">{genre}</span>
        ))}
      </div>
    )}
  </div>
</a>

<style>
  .hdb-featured-card {
    position: relative;
    display: block;
    overflow: hidden;
    border-radius: 14px;
    border: 1px solid rgba(255,255,255,0.06);
    background: var(--color-raised, #0e0c16);
    height: 100%;
    min-height: 280px;
    text-decoration: none;
    transition: all 0.2s ease;
  }
  .hdb-featured-card:hover {
    border-color: rgba(167,139,250,0.15);
    box-shadow: 0 4px 24px rgba(0,0,0,0.3), 0 0 30px rgba(167,139,250,0.08);
    transform: translateY(-3px);
  }

  .hdb-featured-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  .hdb-featured-card:hover .hdb-featured-img {
    transform: scale(1.05);
  }

  .hdb-featured-placeholder {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, #12101a, #0e0c16, #08070c);
  }

  .hdb-featured-badge {
    position: absolute;
    top: 12px;
    left: 12px;
    z-index: 10;
  }
  .hdb-badge {
    display: inline-block;
    border-radius: 6px;
    border: 1px solid;
    padding: 2px 8px;
    font-size: 11px;
    font-weight: 600;
  }
  .hdb-badge-verified { background: rgba(74,222,128,0.15); color: #4ade80; border-color: rgba(74,222,128,0.25); }
  .hdb-badge-playable { background: rgba(251,191,36,0.15); color: #fbbf24; border-color: rgba(251,191,36,0.25); }
  .hdb-badge-unsupported { background: rgba(248,113,113,0.15); color: #f87171; border-color: rgba(248,113,113,0.25); }

  .hdb-featured-content {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 16px 18px;
    z-index: 10;
  }
  .hdb-featured-title {
    font-family: var(--font-display);
    font-size: clamp(18px, 2.5vw, 24px);
    font-weight: 700;
    color: white;
    line-height: 1.2;
    transition: color 0.2s;
  }
  .hdb-featured-card:hover .hdb-featured-title {
    color: #c4b5fd;
  }

  .hdb-featured-genres {
    margin-top: 8px;
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
  }
  .hdb-featured-genre {
    border-radius: 4px;
    background: rgba(255,255,255,0.1);
    backdrop-filter: blur(8px);
    padding: 2px 8px;
    font-size: 11px;
    color: #9890a8;
  }
</style>
