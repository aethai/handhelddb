---
interface Props {
  slug: string;
  name: string;
  headerImage?: string | null;
  genres?: string[];
  deckCompatibility?: string | null;
}

const { slug, name, headerImage, genres = [], deckCompatibility } = Astro.props;

const deckBadge: Record<string, { label: string; class: string }> = {
  verified: { label: 'Verified', class: 'badge-verified' },
  playable: { label: 'Playable', class: 'badge-playable' },
  unsupported: { label: 'Unsupported', class: 'badge-unsupported' },
};
const deck = deckBadge[deckCompatibility ?? ''];
---

<a href={`/games/${slug}`} class="hdb-featured-card">
  {headerImage ? (
    <img
      src={headerImage}
      alt={name}
      class="hdb-featured-img"
      loading="lazy"
    />
  ) : (
    <div class="hdb-featured-placeholder"></div>
  )}

  <div class="hdb-featured-overlay"></div>

  {deck && (
    <div class="hdb-featured-badge">
      <span class={`hdb-badge ${deck.class}`}>{deck.label}</span>
    </div>
  )}

  <div class="hdb-featured-content">
    <h3 class="hdb-featured-title">{name}</h3>
    {genres.length > 0 && (
      <div class="hdb-featured-genres">
        {genres.slice(0, 3).map((genre) => (
          <span class="hdb-featured-genre">{genre}</span>
        ))}
      </div>
    )}
  </div>
</a>

<style>
  .hdb-featured-card {
    position: relative;
    display: block;
    overflow: hidden;
    border-radius: 8px;
    border: 1px solid var(--color-border);
    background: var(--color-raised);
    height: 100%;
    min-height: 280px;
    text-decoration: none;
    transition: border-color 0.15s;
  }
  .hdb-featured-card:hover {
    border-color: var(--color-border-strong);
  }

  .hdb-featured-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hdb-featured-placeholder {
    position: absolute;
    inset: 0;
    background: var(--color-elevated);
  }

  .hdb-featured-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.8) 0%, transparent 60%);
    z-index: 5;
  }

  .hdb-featured-badge {
    position: absolute;
    top: 12px;
    left: 12px;
    z-index: 10;
  }
  .hdb-badge {
    display: inline-block;
    border-radius: 0;
    border: 1px solid;
    padding: 2px 8px;
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .badge-verified { background: rgba(34,197,94,0.15); color: #22c55e; border-color: rgba(34,197,94,0.3); }
  .badge-playable { background: rgba(234,179,8,0.15); color: #eab308; border-color: rgba(234,179,8,0.3); }
  .badge-unsupported { background: rgba(239,68,68,0.15); color: #ef4444; border-color: rgba(239,68,68,0.3); }

  .hdb-featured-content {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 16px 18px;
    z-index: 10;
  }
  .hdb-featured-title {
    font-family: var(--font-heading);
    font-size: clamp(18px, 2.5vw, 24px);
    font-weight: 700;
    color: white;
    line-height: 1.2;
    text-transform: uppercase;
    transition: color 0.15s;
  }
  .hdb-featured-card:hover .hdb-featured-title {
    color: #D4FF00;
  }

  .hdb-featured-genres {
    margin-top: 8px;
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
  }
  .hdb-featured-genre {
    border-radius: 0;
    background: rgba(255,255,255,0.1);
    padding: 2px 8px;
    font-family: var(--font-mono);
    font-size: 10px;
    color: rgba(255,255,255,0.7);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
</style>
