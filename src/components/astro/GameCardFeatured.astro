---
interface Props {
  slug: string;
  name: string;
  headerImage?: string | null;
  genres?: string[];
  deckCompatibility?: string | null;
}

const { slug, name, headerImage, genres = [], deckCompatibility } = Astro.props;

const deckBadge: Record<string, { label: string; class: string }> = {
  verified: { label: 'Verified', class: 'bg-[#4ADE80]/15 text-[#4ADE80] border-[#4ADE80]/25' },
  playable: { label: 'Playable', class: 'bg-[#FBBF24]/15 text-[#FBBF24] border-[#FBBF24]/25' },
  unsupported: { label: 'Unsupported', class: 'bg-[#F87171]/15 text-[#F87171] border-[#F87171]/25' },
};
const deck = deckBadge[deckCompatibility ?? ''];
---

<a
  href={`/games/${slug}`}
  class="group relative block overflow-hidden rounded-lg border border-[#2A2D35] bg-[#16181D] h-full min-h-[280px] hover:border-[#3A3D45] transition-all"
>
  {headerImage ? (
    <img
      src={headerImage}
      alt={name}
      class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
      loading="lazy"
    />
  ) : (
    <div class="absolute inset-0 bg-gradient-to-br from-[#1E2128] via-[#16181D] to-[#0F1115]"></div>
  )}

  <!-- Gradient overlay -->
  <div class="game-card-overlay"></div>

  <!-- Deck badge top-left -->
  {deck && (
    <div class="absolute top-3 left-3 z-10">
      <span class={`rounded border px-2 py-0.5 text-xs font-medium ${deck.class}`}>
        {deck.label}
      </span>
    </div>
  )}

  <!-- Content at bottom -->
  <div class="absolute bottom-0 left-0 right-0 p-4 sm:p-5 z-10">
    <h3 class="text-xl sm:text-2xl font-semibold text-white leading-tight group-hover:text-[#93C5FD] transition-colors">
      {name}
    </h3>
    {genres.length > 0 && (
      <div class="mt-2 flex items-center gap-2 flex-wrap">
        {genres.slice(0, 3).map((genre) => (
          <span class="rounded bg-white/10 px-2 py-0.5 text-xs text-[#9CA3AF] backdrop-blur-sm">
            {genre}
          </span>
        ))}
      </div>
    )}
  </div>
</a>
