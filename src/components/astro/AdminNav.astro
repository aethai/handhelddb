---
const currentPath = Astro.url.pathname;

const navItems = [
  { href: '/admin', label: 'Dashboard', icon: 'chart' },
  { href: '/admin/users', label: 'Users', icon: 'users' },
  { href: '/admin/articles', label: 'Articles', icon: 'article' },
  { href: '/admin/devices', label: 'Devices', icon: 'device' },
  { href: '/admin/comments', label: 'Comments', icon: 'comment' },
  { href: '/admin/reports', label: 'Reports', icon: 'report' },
];

function isActive(href: string): boolean {
  if (href === '/admin') return currentPath === '/admin' || currentPath === '/admin/';
  return currentPath.startsWith(href);
}
---

<aside class="w-full lg:w-56 shrink-0">
  <!-- Mobile: horizontal scrolling nav -->
  <nav class="lg:hidden flex gap-2 overflow-x-auto pb-2 mb-6 border-b border-gray-800">
    {navItems.map(item => (
      <a
        href={item.href}
        class:list={[
          'whitespace-nowrap rounded-lg px-3 py-2 text-sm font-medium transition-colors',
          isActive(item.href)
            ? 'bg-[#D4A574]/20 text-[#D4A574] border border-[#D4A574]/30'
            : 'text-gray-400 hover:text-white hover:bg-gray-800',
        ]}
      >
        {item.label}
      </a>
    ))}
  </nav>

  <!-- Desktop: vertical sidebar -->
  <nav class="hidden lg:block sticky top-20 space-y-1">
    <div class="mb-4 px-3">
      <h2 class="text-xs font-semibold uppercase tracking-wider text-gray-500">Admin Panel</h2>
    </div>
    {navItems.map(item => (
      <a
        href={item.href}
        class:list={[
          'flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm font-medium transition-colors',
          isActive(item.href)
            ? 'bg-[#D4A574]/20 text-[#D4A574] border border-[#D4A574]/30'
            : 'text-gray-400 hover:text-white hover:bg-gray-800',
        ]}
      >
        {item.icon === 'chart' && (
          <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 13h2v8H3zm6-4h2v12H9zm6-6h2v18h-2zm6 10h2v8h-2z" />
          </svg>
        )}
        {item.icon === 'users' && (
          <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
            <circle cx="9" cy="7" r="4" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M23 21v-2a4 4 0 0 0-3-3.87" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M16 3.13a4 4 0 0 1 0 7.75" />
          </svg>
        )}
        {item.icon === 'article' && (
          <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 20H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v1m2 13a2 2 0 0 1-2-2V7m2 13a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-2m-4-3H9M7 16h6M7 12h10" />
          </svg>
        )}
        {item.icon === 'device' && (
          <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <rect x="4" y="6" width="16" height="12" rx="2" />
            <circle cx="9" cy="12" r="1.5" />
            <circle cx="15" cy="12" r="1.5" />
          </svg>
        )}
        {item.icon === 'comment' && (
          <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
          </svg>
        )}
        {item.icon === 'report' && (
          <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
        )}
        {item.label}
      </a>
    ))}

    <!-- Back to site link -->
    <div class="mt-6 pt-4 border-t border-gray-800">
      <a
        href="/"
        class="flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm font-medium text-gray-500 hover:text-white hover:bg-gray-800 transition-colors"
      >
        <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        Back to Site
      </a>
    </div>
  </nav>
</aside>
