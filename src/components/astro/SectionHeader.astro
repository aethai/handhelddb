---
interface Props {
  title: string;
  subtitle?: string;
  href?: string;
  linkText?: string;
  editorial?: string;
}

const { title, subtitle, href, linkText = 'View all', editorial } = Astro.props;
---

<div class="flex items-end justify-between mb-6">
  <div>
    {editorial && <p class="editorial-label mb-2">{editorial}</p>}
    <h2 class="text-xl font-semibold text-[#E8EAED]">{title}</h2>
    {subtitle && <p class="mt-1 text-sm text-[#6B7280]">{subtitle}</p>}
  </div>
  {href && (
    <a href={href} class="text-sm text-[#60A5FA] hover:text-[#93C5FD] transition-colors flex-shrink-0">
      {linkText} &rarr;
    </a>
  )}
</div>
