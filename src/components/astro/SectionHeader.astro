---
interface Props {
  title: string;
  subtitle?: string;
  href?: string;
  linkText?: string;
  editorial?: string;
}

const { title, subtitle, href, linkText = 'View all', editorial } = Astro.props;
---

<div class="flex items-end justify-between mb-6">
  <div>
    {editorial && <p class="editorial-label mb-2">{editorial}</p>}
    <h2 class="text-xl font-semibold text-[#eeeef0] font-[Space_Grotesk,sans-serif]">{title}</h2>
    {subtitle && <p class="mt-1 text-sm text-[#55555e]">{subtitle}</p>}
  </div>
  {href && (
    <a href={href} class="text-sm text-[#7c6cf0] hover:text-[#9b8fff] transition-colors flex-shrink-0 flex items-center gap-1">
      {linkText}
      <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M5 12h14M12 5l7 7-7 7" />
      </svg>
    </a>
  )}
</div>
