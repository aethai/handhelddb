---
interface Props {
  title: string;
  subtitle?: string;
  href?: string;
  linkText?: string;
  editorial?: string;
}

const { title, subtitle, href, linkText = 'View all', editorial } = Astro.props;
---

<div class="hdb-section-header">
  <div>
    {editorial && <p class="hdb-section-editorial">{editorial}</p>}
    <h2 class="hdb-section-title">{title}</h2>
    {subtitle && <p class="hdb-section-subtitle">{subtitle}</p>}
  </div>
  {href && (
    <a href={href} class="hdb-section-link">
      {linkText} <span aria-hidden="true">&rarr;</span>
    </a>
  )}
</div>

<style>
  .hdb-section-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    margin-bottom: 16px;
  }
  .hdb-section-editorial {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #D4FF00;
    margin-bottom: 4px;
  }
  .hdb-section-title {
    font-family: var(--font-heading);
    font-size: 22px;
    font-weight: 700;
    color: var(--color-text);
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }
  .hdb-section-subtitle {
    margin-top: 4px;
    font-size: 13px;
    color: var(--color-text-3);
  }
  .hdb-section-link {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    color: var(--color-text-3);
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 4px;
    flex-shrink: 0;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    transition: color 0.15s;
  }
  .hdb-section-link:hover {
    color: #D4FF00;
  }
</style>
