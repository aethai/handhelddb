---
interface Props {
  title: string;
  subtitle?: string;
  href?: string;
  linkText?: string;
  editorial?: string;
}

const { title, subtitle, href, linkText = 'View all', editorial } = Astro.props;
---

<div class="flex items-end justify-between mb-6">
  <div>
    {editorial && <p class="editorial-label mb-2">{editorial}</p>}
    <h2 class="text-2xl font-bold text-white font-heading uppercase tracking-wider">{title}</h2>
    {subtitle && <p class="mt-1 text-sm text-stone-500">{subtitle}</p>}
  </div>
  {href && (
    <a href={href} class="text-sm text-[#D4A574] hover:text-[#E8C5A0] transition-colors flex-shrink-0">
      {linkText} &rarr;
    </a>
  )}
</div>
