---
interface Props {
  title: string;
  subtitle?: string;
  href?: string;
  linkText?: string;
  editorial?: string;
}

const { title, subtitle, href, linkText = 'View all', editorial } = Astro.props;
---

<div class="hdb-section-header">
  <div>
    {editorial && <p class="hdb-section-editorial">{editorial}</p>}
    <h2 class="hdb-section-title">{title}</h2>
    {subtitle && <p class="hdb-section-subtitle">{subtitle}</p>}
  </div>
  {href && (
    <a href={href} class="hdb-section-link">
      {linkText}
      <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M5 12h14M12 5l7 7-7 7" />
      </svg>
    </a>
  )}
</div>

<style>
  .hdb-section-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    margin-bottom: 16px;
  }
  .hdb-section-editorial {
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #a78bfa;
    margin-bottom: 4px;
  }
  .hdb-section-title {
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 800;
    color: #eae6f4;
    letter-spacing: -0.02em;
  }
  .hdb-section-subtitle {
    margin-top: 4px;
    font-size: 13px;
    color: #6d6882;
  }
  .hdb-section-link {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    color: #a78bfa;
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 4px;
    flex-shrink: 0;
    transition: color 0.15s;
  }
  .hdb-section-link:hover {
    color: #c4b5fd;
  }
</style>
