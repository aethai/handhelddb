---
const currentYear = new Date().getFullYear();
---

<div class="metallic-line"></div>
<footer class="border-t border-[#2A2D35] bg-[#0F1115] py-8 mt-16">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <!-- Mini CTA -->
    <p class="text-center text-sm text-[#6B7280] mb-8">
      Help build the database &mdash; <a href="/report/new" class="text-[#60A5FA] hover:text-[#93C5FD] underline underline-offset-2">submit your first report</a>
    </p>

    <div class="grid grid-cols-2 gap-8 md:grid-cols-3">
      <div>
        <h3 class="text-sm font-semibold text-[#60A5FA]">Browse</h3>
        <ul class="mt-3 space-y-2">
          <li><a href="/games" class="text-sm text-[#9CA3AF] hover:text-[#60A5FA]">Games</a></li>
          <li><a href="/devices" class="text-sm text-[#9CA3AF] hover:text-[#60A5FA]">Devices</a></li>
          <li><a href="/discover" class="text-sm text-[#9CA3AF] hover:text-[#60A5FA]">Discover</a></li>
          <li><a href="/compare" class="text-sm text-[#9CA3AF] hover:text-[#60A5FA]">Compare</a></li>
          <li><a href="/news" class="text-sm text-[#9CA3AF] hover:text-[#60A5FA]">News</a></li>
        </ul>
      </div>
      <div>
        <h3 class="text-sm font-semibold text-[#60A5FA]">Contribute</h3>
        <ul class="mt-3 space-y-2">
          <li><a href="/report/new" class="text-sm text-[#9CA3AF] hover:text-[#60A5FA]">Submit Report</a></li>
          <li><a href="/auth/login" class="text-sm text-[#9CA3AF] hover:text-[#60A5FA]">Sign In</a></li>
        </ul>
      </div>
      <div>
        <h3 class="text-sm font-semibold text-[#60A5FA]">About</h3>
        <ul class="mt-3 space-y-2">
          <li><a href="/about" class="text-sm text-[#9CA3AF] hover:text-[#60A5FA]">About Us</a></li>
          <li><a href="/privacy" class="text-sm text-[#9CA3AF] hover:text-[#60A5FA]">Privacy</a></li>
          <li><a href="/terms" class="text-sm text-[#9CA3AF] hover:text-[#60A5FA]">Terms</a></li>
        </ul>
      </div>
    </div>
    <div class="mt-8 border-t border-[#2A2D35] pt-6 text-center">
      <p class="text-sm text-[#6B7280] font-mono">
        &copy; {currentYear} Handheld GameDB. Not affiliated with Valve, ASUS, or Lenovo.
      </p>
    </div>
  </div>
</footer>
