---
const currentYear = new Date().getFullYear();

const browseLinks = [
  { href: '/games', label: 'Games' },
  { href: '/devices', label: 'Devices' },
  { href: '/compare', label: 'Compare' },
  { href: '/news', label: 'News' },
];

const communityLinks = [
  { href: '/report/new', label: 'Submit Report' },
  { href: '/discover', label: 'Discover' },
  { href: '/leaderboard', label: 'Leaderboard' },
];

const aboutLinks = [
  { href: '/about', label: 'About' },
  { href: '/privacy', label: 'Privacy' },
  { href: '/terms', label: 'Terms' },
  { href: '/about#contact', label: 'Contact' },
];
---

<footer class="hdb-footer">
  <div class="hdb-footer-inner">
    <div class="hdb-footer-grid">
      <!-- Brand -->
      <div class="hdb-footer-brand">
        <div class="hdb-footer-logo">
          <div class="hdb-footer-logo-mark">
            <div class="hdb-footer-logo-dot"></div>
          </div>
          <span class="hdb-footer-logo-text">HandheldDB</span>
        </div>
        <p class="hdb-footer-tagline">Community-powered performance database for handheld gaming devices.</p>
      </div>

      <!-- Link columns -->
      <div class="hdb-footer-columns">
        <div class="hdb-footer-col">
          <div class="hdb-footer-col-label">Browse</div>
          {browseLinks.map(({ href, label }) => (
            <a href={href} class="hdb-footer-link">{label}</a>
          ))}
        </div>
        <div class="hdb-footer-col">
          <div class="hdb-footer-col-label">Community</div>
          {communityLinks.map(({ href, label }) => (
            <a href={href} class="hdb-footer-link">{label}</a>
          ))}
        </div>
        <div class="hdb-footer-col">
          <div class="hdb-footer-col-label">About</div>
          {aboutLinks.map(({ href, label }) => (
            <a href={href} class="hdb-footer-link">{label}</a>
          ))}
        </div>
      </div>
    </div>

    <div class="hdb-footer-bottom">
      <span>&copy; {currentYear} HandheldDB</span>
      <span class="hdb-footer-sep">&middot;</span>
      <a href="/rss.xml" class="hdb-footer-link-inline">RSS</a>
    </div>
  </div>
</footer>

<style>
  .hdb-footer {
    border-top: 1px solid rgba(255,255,255,0.04);
    margin-top: 64px;
    position: relative;
  }
  .hdb-footer::before {
    content: '';
    position: absolute;
    top: -1px;
    left: 20%;
    right: 20%;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(167,139,250,0.15), transparent);
  }
  .hdb-footer-inner {
    max-width: 1080px;
    margin: 0 auto;
    padding: 40px 24px 24px;
  }
  .hdb-footer-grid {
    display: flex;
    gap: 48px;
    margin-bottom: 24px;
    flex-wrap: wrap;
  }

  /* Brand section */
  .hdb-footer-brand {
    flex: 1;
    min-width: 200px;
  }
  .hdb-footer-logo {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 8px;
  }
  .hdb-footer-logo-mark {
    width: 20px;
    height: 20px;
    border-radius: 5px;
    background: rgba(167,139,250,0.1);
    border: 1px solid rgba(167,139,250,0.2);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .hdb-footer-logo-dot {
    width: 5px;
    height: 5px;
    border-radius: 2px;
    background: #a78bfa;
  }
  .hdb-footer-logo-text {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 14px;
    color: #eae6f4;
  }
  .hdb-footer-tagline {
    font-size: 13px;
    line-height: 1.6;
    color: #6d6882;
  }

  /* Link columns */
  .hdb-footer-columns {
    display: flex;
    gap: 48px;
    flex-wrap: wrap;
  }
  .hdb-footer-col {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .hdb-footer-col-label {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 600;
    color: #6d6882;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 4px;
  }
  .hdb-footer-link {
    font-size: 13px;
    color: #6d6882;
    text-decoration: none;
    transition: color 0.15s;
  }
  .hdb-footer-link:hover {
    color: #a78bfa;
  }

  /* Bottom bar */
  .hdb-footer-bottom {
    font-family: var(--font-mono);
    font-size: 11px;
    color: #3e3a4c;
    text-align: center;
    padding-top: 16px;
    border-top: 1px solid rgba(255,255,255,0.04);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
  }
  .hdb-footer-sep { color: #2a2838; }
  .hdb-footer-link-inline {
    color: #3e3a4c;
    text-decoration: none;
    transition: color 0.15s;
  }
  .hdb-footer-link-inline:hover { color: #6d6882; }
</style>
