---
const currentYear = new Date().getFullYear();

const browseLinks = [
  { href: '/games', label: 'Games' },
  { href: '/devices', label: 'Devices' },
  { href: '/compare', label: 'Compare' },
  { href: '/news', label: 'News' },
];

const communityLinks = [
  { href: '/report/new', label: 'Submit Report' },
  { href: '/discover', label: 'Discover' },
  { href: '/leaderboard', label: 'Leaderboard' },
];

const aboutLinks = [
  { href: '/about', label: 'About' },
  { href: '/privacy', label: 'Privacy' },
  { href: '/terms', label: 'Terms' },
  { href: '/about#contact', label: 'Contact' },
];
---

<footer class="hdb-footer">
  <div class="hdb-footer-inner">
    <div class="hdb-footer-grid">
      <!-- Brand -->
      <div class="hdb-footer-brand">
        <a href="/" class="hdb-footer-logo">HDB</a>
        <p class="hdb-footer-tagline">Community-powered performance database for handheld gaming devices.</p>
      </div>

      <!-- Link columns -->
      <div class="hdb-footer-columns">
        <div class="hdb-footer-col">
          <div class="hdb-footer-col-label">Browse</div>
          {browseLinks.map(({ href, label }) => (
            <a href={href} class="hdb-footer-link">{label}</a>
          ))}
        </div>
        <div class="hdb-footer-col">
          <div class="hdb-footer-col-label">Community</div>
          {communityLinks.map(({ href, label }) => (
            <a href={href} class="hdb-footer-link">{label}</a>
          ))}
        </div>
        <div class="hdb-footer-col">
          <div class="hdb-footer-col-label">About</div>
          {aboutLinks.map(({ href, label }) => (
            <a href={href} class="hdb-footer-link">{label}</a>
          ))}
        </div>
      </div>
    </div>

    <div class="hdb-footer-bottom">
      <span>&copy; {currentYear} HandheldDB</span>
      <span class="hdb-footer-sep">&middot;</span>
      <a href="/rss.xml" class="hdb-footer-link-inline">RSS</a>
    </div>
  </div>
</footer>

<style>
  .hdb-footer {
    border-top: 1px solid var(--color-border);
    margin-top: 64px;
  }
  .hdb-footer-inner {
    max-width: 1120px;
    margin: 0 auto;
    padding: 40px 24px 24px;
  }
  .hdb-footer-grid {
    display: flex;
    gap: 48px;
    margin-bottom: 24px;
    flex-wrap: wrap;
  }

  /* Brand */
  .hdb-footer-brand {
    flex: 1;
    min-width: 200px;
  }
  .hdb-footer-logo {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 18px;
    color: var(--color-text);
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    display: inline-block;
    margin-bottom: 8px;
    transition: color 0.15s;
  }
  .hdb-footer-logo:hover {
    color: #D4FF00;
  }
  .hdb-footer-tagline {
    font-size: 13px;
    line-height: 1.6;
    color: var(--color-text-3);
  }

  /* Link columns */
  .hdb-footer-columns {
    display: flex;
    gap: 48px;
    flex-wrap: wrap;
  }
  .hdb-footer-col {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .hdb-footer-col-label {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 500;
    color: var(--color-text-3);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 4px;
  }
  .hdb-footer-link {
    font-size: 13px;
    color: var(--color-text-3);
    text-decoration: none;
    transition: color 0.15s;
  }
  .hdb-footer-link:hover {
    color: #D4FF00;
  }

  /* Bottom bar */
  .hdb-footer-bottom {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-text-dim);
    text-align: center;
    padding-top: 16px;
    border-top: 1px solid var(--color-border-subtle);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
  }
  .hdb-footer-sep {
    color: var(--color-border);
  }
  .hdb-footer-link-inline {
    color: var(--color-text-dim);
    text-decoration: none;
    transition: color 0.15s;
  }
  .hdb-footer-link-inline:hover {
    color: #D4FF00;
  }
</style>
