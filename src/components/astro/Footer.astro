---
const currentYear = new Date().getFullYear();
---

<div class="h-px bg-gradient-to-r from-transparent via-cyan-500/30 to-transparent"></div>
<footer class="border-t border-[#151c2b] bg-[#0a0e17] py-8 mt-16">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-2 gap-8 md:grid-cols-4">
      <div>
        <h3 class="text-sm font-semibold font-heading uppercase tracking-wider text-cyan-400">Database</h3>
        <ul class="mt-3 space-y-2">
          <li><a href="/games" class="text-sm text-gray-400 hover:text-cyan-400">All Games</a></li>
          <li><a href="/devices" class="text-sm text-gray-400 hover:text-cyan-400">Devices</a></li>
          <li><a href="/compare" class="text-sm text-gray-400 hover:text-cyan-400">Compare</a></li>
          <li><a href="/news" class="text-sm text-gray-400 hover:text-cyan-400">News</a></li>
        </ul>
      </div>
      <div>
        <h3 class="text-sm font-semibold font-heading uppercase tracking-wider text-cyan-400">Contribute</h3>
        <ul class="mt-3 space-y-2">
          <li><a href="/report/new" class="text-sm text-gray-400 hover:text-cyan-400">Submit Report</a></li>
          <li><a href="/auth/login" class="text-sm text-gray-400 hover:text-cyan-400">Sign In</a></li>
        </ul>
      </div>
      <div>
        <h3 class="text-sm font-semibold font-heading uppercase tracking-wider text-cyan-400">Devices</h3>
        <ul class="mt-3 space-y-2">
          <li><a href="/devices/steam-deck-oled" class="text-sm text-gray-400 hover:text-cyan-400">Steam Deck OLED</a></li>
          <li><a href="/devices/rog-ally-x" class="text-sm text-gray-400 hover:text-cyan-400">ROG Ally X</a></li>
          <li><a href="/devices/legion-go" class="text-sm text-gray-400 hover:text-cyan-400">Legion Go</a></li>
        </ul>
      </div>
      <div>
        <h3 class="text-sm font-semibold font-heading uppercase tracking-wider text-cyan-400">About</h3>
        <ul class="mt-3 space-y-2">
          <li><a href="/about" class="text-sm text-gray-400 hover:text-cyan-400">About Us</a></li>
          <li><a href="/privacy" class="text-sm text-gray-400 hover:text-cyan-400">Privacy Policy</a></li>
          <li><a href="/terms" class="text-sm text-gray-400 hover:text-cyan-400">Terms of Service</a></li>
        </ul>
      </div>
    </div>
    <div class="mt-8 border-t border-[#151c2b] pt-6 text-center">
      <p class="text-sm text-gray-500">
        &copy; {currentYear} Handheld GameDB. Not affiliated with Valve, ASUS, or Lenovo.
      </p>
    </div>
  </div>
</footer>
