---
const currentYear = new Date().getFullYear();
---

<footer style="border-top:1px solid rgba(255,255,255,0.04);">
  <div style="max-width:960px;margin:0 auto;padding:28px 24px 20px;">
    <div style="display:flex;gap:40px;margin-bottom:16px;flex-wrap:wrap;">
      <!-- Brand -->
      <div style="flex:1;min-width:200px;">
        <div style="font-family:var(--font-display);font-weight:800;font-size:14px;color:#c8c4d4;margin-bottom:4px;">HandheldDB</div>
        <p style="font-family:var(--font-display);font-size:11px;color:#4a4560;line-height:1.5;">Community-powered performance database for handheld gaming devices.</p>
      </div>
      <!-- Link columns -->
      <div style="display:flex;gap:40px;flex-wrap:wrap;">
        <div>
          <div style="font-family:var(--font-mono);font-size:9px;color:#4a4560;letter-spacing:0.08em;margin-bottom:6px;">BROWSE</div>
          <a href="/games" style="display:block;font-family:var(--font-display);font-size:11px;color:#6d6882;margin-bottom:4px;text-decoration:none;transition:color 0.15s;">Games</a>
          <a href="/devices" style="display:block;font-family:var(--font-display);font-size:11px;color:#6d6882;margin-bottom:4px;text-decoration:none;transition:color 0.15s;">Devices</a>
          <a href="/compare" style="display:block;font-family:var(--font-display);font-size:11px;color:#6d6882;margin-bottom:4px;text-decoration:none;transition:color 0.15s;">Compare</a>
          <a href="/news" style="display:block;font-family:var(--font-display);font-size:11px;color:#6d6882;margin-bottom:4px;text-decoration:none;transition:color 0.15s;">News</a>
        </div>
        <div>
          <div style="font-family:var(--font-mono);font-size:9px;color:#4a4560;letter-spacing:0.08em;margin-bottom:6px;">COMMUNITY</div>
          <a href="/report/new" style="display:block;font-family:var(--font-display);font-size:11px;color:#6d6882;margin-bottom:4px;text-decoration:none;transition:color 0.15s;">Submit Report</a>
          <a href="/discover" style="display:block;font-family:var(--font-display);font-size:11px;color:#6d6882;margin-bottom:4px;text-decoration:none;transition:color 0.15s;">Discover</a>
          <a href="/leaderboard" style="display:block;font-family:var(--font-display);font-size:11px;color:#6d6882;margin-bottom:4px;text-decoration:none;transition:color 0.15s;">Leaderboard</a>
        </div>
        <div>
          <div style="font-family:var(--font-mono);font-size:9px;color:#4a4560;letter-spacing:0.08em;margin-bottom:6px;">ABOUT</div>
          <a href="/about" style="display:block;font-family:var(--font-display);font-size:11px;color:#6d6882;margin-bottom:4px;text-decoration:none;transition:color 0.15s;">About</a>
          <a href="/privacy" style="display:block;font-family:var(--font-display);font-size:11px;color:#6d6882;margin-bottom:4px;text-decoration:none;transition:color 0.15s;">Privacy</a>
          <a href="/terms" style="display:block;font-family:var(--font-display);font-size:11px;color:#6d6882;margin-bottom:4px;text-decoration:none;transition:color 0.15s;">Terms</a>
          <a href="/about#contact" style="display:block;font-family:var(--font-display);font-size:11px;color:#6d6882;margin-bottom:4px;text-decoration:none;transition:color 0.15s;">Contact</a>
        </div>
      </div>
    </div>
    <div style="font-family:var(--font-mono);font-size:9px;color:#2a2838;text-align:center;padding-top:12px;border-top:1px solid rgba(255,255,255,0.04);">
      {currentYear} HandheldDB
    </div>
  </div>
</footer>
