---
interface Props {
  slug: string;
  name: string;
  manufacturer: string;
  screenSize?: number | null;
  batteryWh?: number | null;
  chip?: string | null;
  image?: string | null;
  msrpUsd?: number | null;
  testedGames?: number;
}

const {
  slug,
  name,
  manufacturer,
  screenSize,
  batteryWh,
  chip,
  image,
  msrpUsd,
  testedGames = 0,
} = Astro.props;
---

<a href={`/devices/${slug}`} class="hdb-device-card">
  <p class="hdb-device-card-mfr">{manufacturer}</p>
  <h3 class="hdb-device-card-name">{name}</h3>

  <div class="hdb-device-card-specs">
    {chip && <span class="hdb-device-card-spec">{chip}</span>}
    {batteryWh && <span class="hdb-device-card-spec">{batteryWh}Wh</span>}
    {msrpUsd && <span class="hdb-device-card-spec">${msrpUsd}</span>}
  </div>

  {testedGames > 0 && (
    <p class="hdb-device-card-tested">{testedGames} games tested</p>
  )}
</a>

<style>
  .hdb-device-card {
    display: block;
    border-radius: 8px;
    border: 1px solid var(--color-border);
    background: var(--color-raised);
    padding: 16px;
    text-decoration: none;
    transition: border-color 0.15s;
  }
  .hdb-device-card:hover {
    border-color: var(--color-border-strong);
  }

  .hdb-device-card-mfr {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 500;
    color: #D4FF00;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 2px;
  }
  .hdb-device-card-name {
    font-family: var(--font-heading);
    font-size: 16px;
    font-weight: 700;
    color: var(--color-text);
    text-transform: uppercase;
    transition: color 0.15s;
  }
  .hdb-device-card:hover .hdb-device-card-name {
    color: #D4FF00;
  }

  .hdb-device-card-specs {
    margin-top: 8px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 12px;
  }
  .hdb-device-card-spec {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-text-3);
  }

  .hdb-device-card-tested {
    margin-top: 8px;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    color: var(--color-text-2);
  }
</style>
