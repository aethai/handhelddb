---
interface Props {
  slug: string;
  name: string;
  manufacturer: string;
  screenSize?: number | null;
  batteryWh?: number | null;
  chip?: string | null;
  image?: string | null;
  msrpUsd?: number | null;
  testedGames?: number;
}

const {
  slug,
  name,
  manufacturer,
  screenSize,
  batteryWh,
  chip,
  image,
  msrpUsd,
  testedGames = 0,
} = Astro.props;
---

<a href={`/devices/${slug}`} class="hdb-device-card group">
  <div class="hdb-device-card-inner">
    <!-- Device Image -->
    <div class="hdb-device-card-img">
      {image ? (
        <img src={image} alt={name} class="h-full w-full object-contain" loading="lazy" />
      ) : (
        <svg class="h-10 w-10 text-[#2a2838]" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
          <rect x="5" y="3" width="14" height="18" rx="3" />
          <line x1="9" y1="18" x2="15" y2="18" />
        </svg>
      )}
    </div>

    <!-- Device Info -->
    <div class="hdb-device-card-info">
      <p class="hdb-device-card-mfr">{manufacturer}</p>
      <h3 class="hdb-device-card-name">
        {name}
      </h3>

      <div class="hdb-device-card-specs">
        {chip && <span class="hdb-device-card-spec">{chip}</span>}
        {screenSize && <span class="hdb-device-card-spec">{screenSize}"</span>}
        {batteryWh && <span class="hdb-device-card-spec">{batteryWh} Wh</span>}
        {msrpUsd && <span class="hdb-device-card-spec">${msrpUsd}</span>}
      </div>

      {testedGames > 0 && (
        <p class="hdb-device-card-tested">{testedGames} games tested</p>
      )}
    </div>
  </div>
</a>

<style>
  .hdb-device-card {
    display: block;
    border-radius: 12px;
    border: 1px solid rgba(255,255,255,0.06);
    background: var(--color-raised, #0e0c16);
    padding: 16px;
    text-decoration: none;
    transition: all 0.2s ease;
  }
  .hdb-device-card:hover {
    border-color: rgba(255,255,255,0.1);
    box-shadow: 0 4px 20px rgba(0,0,0,0.25), 0 0 20px rgba(167,139,250,0.04);
    transform: translateY(-2px);
  }

  .hdb-device-card-inner {
    display: flex;
    align-items: flex-start;
    gap: 16px;
  }

  .hdb-device-card-img {
    flex-shrink: 0;
    width: 72px;
    height: 72px;
    border-radius: 10px;
    background: var(--color-elevated, #12101a);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .hdb-device-card-info {
    flex: 1;
    min-width: 0;
  }

  .hdb-device-card-mfr {
    font-size: 11px;
    font-weight: 600;
    color: #a78bfa;
    letter-spacing: 0.02em;
  }
  .hdb-device-card-name {
    font-size: 16px;
    font-weight: 600;
    color: white;
    transition: color 0.15s;
  }
  .hdb-device-card:hover .hdb-device-card-name {
    color: #a78bfa;
  }

  .hdb-device-card-specs {
    margin-top: 8px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 12px;
  }
  .hdb-device-card-spec {
    font-size: 12px;
    color: #6d6882;
  }

  .hdb-device-card-tested {
    margin-top: 8px;
    font-size: 12px;
    font-weight: 600;
    color: #a78bfa;
  }
</style>
