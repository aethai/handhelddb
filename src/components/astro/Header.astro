---
import SearchBar from '@components/react/SearchBar';
import NotificationBell from '@components/react/NotificationBell';

interface Props {
  user?: { email?: string; user_metadata?: Record<string, unknown> } | null;
}

const { user } = Astro.props;
const avatarUrl = user?.user_metadata?.avatar_url as string | undefined;
const displayName = (user?.user_metadata?.full_name as string) ?? user?.email?.split('@')[0] ?? 'User';
const currentPath = Astro.url.pathname;

const navLinks = [
  { href: '/games', label: 'Games' },
  { href: '/devices', label: 'Devices' },
  { href: '/discover', label: 'Discover' },
  { href: '/compare', label: 'Compare' },
  { href: '/news', label: 'News' },
];
---

<header class="hdb-header">
  <div class="hdb-header-inner">
    <div class="hdb-header-left">
      <!-- Logo -->
      <a href="/" class="hdb-logo">
        <span class="hdb-logo-text">HDB</span>
      </a>

      <!-- Navigation (desktop) -->
      <nav class="hidden md:flex hdb-nav">
        {navLinks.map(({ href, label }) => {
          const isActive = currentPath.startsWith(href);
          return (
            <a
              href={href}
              class:list={['hdb-nav-link', { 'is-active': isActive }]}
            >
              {label}
            </a>
          );
        })}
      </nav>
    </div>

    <!-- Right side -->
    <div class="hdb-header-right">
      <!-- Search (desktop) -->
      <div class="hidden md:block">
        <SearchBar client:load variant="header" placeholder="Search games..." />
      </div>

      {user && (
        <NotificationBell client:load />
      )}

      <!-- Theme toggle -->
      <button id="theme-toggle" class="hdb-theme-toggle" aria-label="Toggle theme">
        <svg class="hdb-theme-icon-sun" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="5"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg>
        <svg class="hdb-theme-icon-moon" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"/></svg>
      </button>

      <!-- Submit button -->
      <a href="/report/new" class="hidden sm:inline-flex hdb-submit-btn">
        SUBMIT
      </a>

      {user ? (
        <div class="relative group">
          <button class="hdb-avatar-btn">
            {avatarUrl ? (
              <img src={avatarUrl} alt="" class="hdb-avatar-img" />
            ) : (
              <div class="hdb-avatar-fallback">
                {displayName.charAt(0).toUpperCase()}
              </div>
            )}
            <span class="hidden sm:inline hdb-avatar-name">{displayName}</span>
          </button>
          <div class="hdb-dropdown">
            <div class="hdb-dropdown-inner">
              <a href="/profile" class="hdb-dropdown-link">Profile</a>
              <a href="/auth/logout" class="hdb-dropdown-link hdb-dropdown-danger">Sign out</a>
            </div>
          </div>
        </div>
      ) : (
        <a href="/auth/login" class="hidden md:inline-flex hdb-signin-link">
          Sign in
        </a>
      )}

      <!-- Hamburger (mobile) -->
      <button
        id="mobile-menu-btn"
        type="button"
        class="md:hidden hdb-hamburger"
        aria-label="Open menu"
        aria-expanded="false"
      >
        <div class="hdb-hamburger-line w-[18px]"></div>
        <div class="hdb-hamburger-line w-[13px]"></div>
      </button>
    </div>
  </div>
</header>

<!-- Mobile menu backdrop -->
<div
  id="mobile-menu-backdrop"
  class="fixed inset-0 z-[60] bg-black/60 opacity-0 invisible transition-all duration-300"
></div>

<!-- Mobile menu drawer -->
<nav
  id="mobile-menu-drawer"
  class="fixed top-0 right-0 z-[70] h-full w-72 translate-x-full transition-transform duration-300 ease-in-out bg-[var(--color-base)] border-l border-[var(--color-border)]"
>
  <div class="flex h-full flex-col">
    <!-- Drawer header -->
    <div class="flex items-center justify-between border-b border-[var(--color-border)] px-5 py-4">
      <span class="font-[var(--font-heading)] text-sm font-bold text-[var(--color-text)] uppercase tracking-tight">Menu</span>
      <button
        id="mobile-menu-close"
        type="button"
        class="p-1.5 text-[var(--color-text-3)] bg-transparent border-none cursor-pointer"
        aria-label="Close menu"
      >
        <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Mobile Search -->
    <div class="px-3 pt-3">
      <SearchBar client:load variant="header" placeholder="Search games..." />
    </div>

    <!-- Nav links -->
    <div class="flex-1 overflow-y-auto p-3">
      <div class="flex flex-col gap-1">
        {navLinks.map(({ href, label }) => {
          const isActive = currentPath.startsWith(href);
          return (
            <a
              href={href}
              class:list={[
                'mobile-menu-link block px-4 py-3 text-sm font-medium no-underline transition-colors uppercase tracking-wide',
                isActive ? 'text-[var(--color-text)] bg-[var(--color-elevated)]' : 'text-[var(--color-text-2)]'
              ]}
            >
              {label}
            </a>
          );
        })}
      </div>

      <div class="my-4 border-t border-[var(--color-border)]"></div>

      <a
        href="/report/new"
        class="mobile-menu-link flex items-center gap-2 bg-[#D4FF00] px-4 py-3 text-sm font-bold text-[#0a0a0a] no-underline font-mono uppercase tracking-wider"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
        </svg>
        Submit Report
      </a>
    </div>

    <!-- Auth at bottom -->
    <div class="border-t border-[var(--color-border)] p-3">
      {user ? (
        <div class="flex flex-col gap-2">
          <div class="flex items-center gap-3 px-4 py-2">
            {avatarUrl ? (
              <img src={avatarUrl} alt="" class="h-8 w-8" />
            ) : (
              <div class="h-8 w-8 bg-[#D4FF00] flex items-center justify-center text-sm font-bold text-[#0a0a0a]">
                {displayName.charAt(0).toUpperCase()}
              </div>
            )}
            <div class="min-w-0">
              <p class="text-sm font-medium text-[var(--color-text)] truncate">{displayName}</p>
              <p class="text-[11px] text-[var(--color-text-3)] truncate">{user.email}</p>
            </div>
          </div>
          <a href="/profile" class="mobile-menu-link block px-4 py-2.5 text-[13px] text-[var(--color-text-2)] no-underline">Profile</a>
          <a href="/auth/logout" class="mobile-menu-link block px-4 py-2.5 text-[13px] text-[var(--color-fps-red)] no-underline">Sign out</a>
        </div>
      ) : (
        <a
          href="/auth/login"
          class="mobile-menu-link flex items-center justify-center gap-2 border border-[var(--color-border)] px-4 py-3 text-sm font-medium text-[var(--color-text-2)] no-underline transition-colors"
        >
          Sign in
        </a>
      )}
    </div>
  </div>
</nav>

<style>
  .hdb-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--color-base);
    border-bottom: 1px solid var(--color-border);
  }
  .hdb-header-inner {
    max-width: 1120px;
    margin: 0 auto;
    padding: 0 24px;
    height: 52px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .hdb-header-left {
    display: flex;
    align-items: center;
    gap: 32px;
  }
  .hdb-header-right {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  /* Logo */
  .hdb-logo {
    display: flex;
    align-items: center;
    text-decoration: none;
  }
  .hdb-logo-text {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 18px;
    color: var(--color-text);
    letter-spacing: -0.02em;
    text-transform: uppercase;
    transition: color 0.15s;
  }
  .hdb-logo:hover .hdb-logo-text {
    color: #D4FF00;
  }

  /* Navigation */
  .hdb-nav {
    gap: 4px;
  }
  .hdb-nav-link {
    position: relative;
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 500;
    color: var(--color-text-3);
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 6px 10px;
    transition: color 0.15s;
  }
  .hdb-nav-link:hover {
    color: var(--color-text);
  }
  .hdb-nav-link.is-active {
    color: var(--color-text);
  }
  .hdb-nav-link.is-active::after {
    content: '';
    position: absolute;
    bottom: -14px;
    left: 10px;
    right: 10px;
    height: 2px;
    background: #D4FF00;
  }

  /* Theme toggle */
  .hdb-theme-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    background: none;
    border: 1px solid var(--color-border);
    border-radius: 0;
    color: var(--color-text-3);
    cursor: pointer;
    transition: border-color 0.15s, color 0.15s;
  }
  .hdb-theme-toggle:hover {
    border-color: #D4FF00;
    color: #D4FF00;
  }
  .hdb-theme-icon-moon { display: none; }
  html.light .hdb-theme-icon-sun { display: none; }
  html.light .hdb-theme-icon-moon { display: block; }

  /* Submit button */
  .hdb-submit-btn {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: #0a0a0a;
    background: #D4FF00;
    padding: 7px 16px;
    border-radius: 0;
    text-decoration: none;
    transition: background-color 0.15s;
  }
  .hdb-submit-btn:hover {
    background: #e8ff4d;
  }

  /* Sign in */
  .hdb-signin-link {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    color: var(--color-text-3);
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    transition: color 0.15s;
  }
  .hdb-signin-link:hover { color: #D4FF00; }

  /* Avatar */
  .hdb-avatar-btn {
    display: flex;
    align-items: center;
    gap: 8px;
    border: 1px solid var(--color-border);
    border-radius: 0;
    padding: 4px 10px 4px 4px;
    background: none;
    cursor: pointer;
    transition: border-color 0.15s;
  }
  .hdb-avatar-btn:hover {
    border-color: var(--color-border-strong);
  }
  .hdb-avatar-img {
    height: 26px;
    width: 26px;
    border-radius: 0;
  }
  .hdb-avatar-fallback {
    height: 26px;
    width: 26px;
    border-radius: 0;
    background: #D4FF00;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
    font-weight: 700;
    color: #0a0a0a;
  }
  .hdb-avatar-name {
    font-size: 13px;
    color: var(--color-text-2);
  }

  /* Dropdown */
  .hdb-dropdown {
    position: absolute;
    right: 0;
    margin-top: 8px;
    width: 192px;
    border-radius: 0;
    background: var(--color-raised);
    border: 1px solid var(--color-border);
    border-top: 2px solid #D4FF00;
    box-shadow: var(--shadow-elevated);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-4px);
    transition: all 0.15s;
  }
  .group:hover .hdb-dropdown {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }
  .hdb-dropdown-inner {
    padding: 6px;
  }
  .hdb-dropdown-link {
    display: block;
    padding: 8px 12px;
    font-size: 13px;
    color: var(--color-text-2);
    text-decoration: none;
    transition: background-color 0.1s, color 0.1s;
  }
  .hdb-dropdown-link:hover {
    background: var(--color-elevated);
    color: var(--color-text);
  }
  .hdb-dropdown-danger {
    color: var(--color-fps-red);
  }

  /* Hamburger */
  .hdb-hamburger {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    padding: 6px;
    background: none;
    border: none;
    cursor: pointer;
  }
  .hdb-hamburger-line {
    height: 1.5px;
    background: var(--color-text-3);
    transition: background 0.15s;
  }
  .hdb-hamburger:hover .hdb-hamburger-line {
    background: var(--color-text-2);
  }
</style>

<script>
  function initMobileMenu() {
    const btn = document.getElementById('mobile-menu-btn');
    const closeBtn = document.getElementById('mobile-menu-close');
    const backdrop = document.getElementById('mobile-menu-backdrop');
    const drawer = document.getElementById('mobile-menu-drawer');

    if (!btn || !closeBtn || !backdrop || !drawer) return;

    const _btn = btn!;
    const _backdrop = backdrop!;
    const _drawer = drawer!;

    function openMenu() {
      _backdrop.classList.remove('opacity-0', 'invisible');
      _backdrop.classList.add('opacity-100', 'visible');
      _drawer.classList.remove('translate-x-full');
      _drawer.classList.add('translate-x-0');
      _btn.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
    }

    function closeMenu() {
      _backdrop.classList.add('opacity-0', 'invisible');
      _backdrop.classList.remove('opacity-100', 'visible');
      _drawer.classList.add('translate-x-full');
      _drawer.classList.remove('translate-x-0');
      _btn.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
    }

    _btn.addEventListener('click', openMenu);
    closeBtn!.addEventListener('click', closeMenu);
    _backdrop.addEventListener('click', closeMenu);

    const links = _drawer.querySelectorAll('.mobile-menu-link');
    links.forEach((link) => {
      link.addEventListener('click', closeMenu);
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && _btn.getAttribute('aria-expanded') === 'true') {
        closeMenu();
      }
    });
  }

  initMobileMenu();
  document.addEventListener('astro:after-swap', initMobileMenu);

  // Theme toggle
  function initThemeToggle() {
    const toggle = document.getElementById('theme-toggle');
    if (!toggle) return;
    toggle.addEventListener('click', () => {
      const isLight = document.documentElement.classList.toggle('light');
      localStorage.setItem('hdb-theme', isLight ? 'light' : 'dark');
    });
  }
  initThemeToggle();
  document.addEventListener('astro:after-swap', initThemeToggle);
</script>
