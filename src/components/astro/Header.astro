---
import SearchBar from '@components/react/SearchBar';
import NotificationBell from '@components/react/NotificationBell';

interface Props {
  user?: { email?: string; user_metadata?: Record<string, unknown> } | null;
}

const { user } = Astro.props;
const avatarUrl = user?.user_metadata?.avatar_url as string | undefined;
const displayName = (user?.user_metadata?.full_name as string) ?? user?.email?.split('@')[0] ?? 'User';
const currentPath = Astro.url.pathname;

const navLinks = [
  { href: '/games', label: 'Games' },
  { href: '/devices', label: 'Devices' },
  { href: '/discover', label: 'Discover' },
  { href: '/compare', label: 'Compare' },
  { href: '/news', label: 'News' },
];
---

<header class="hdb-header">
  <div class="hdb-header-inner">
    <div class="hdb-header-left">
      <!-- Logo -->
      <a href="/" class="hdb-logo">
        <div class="hdb-logo-mark">
          <div class="hdb-logo-dot"></div>
        </div>
        <span class="hdb-logo-text">HandheldDB</span>
      </a>

      <!-- Navigation (desktop) -->
      <nav class="hidden md:flex hdb-nav">
        {navLinks.map(({ href, label }) => {
          const isActive = currentPath.startsWith(href);
          return (
            <a
              href={href}
              class:list={['hdb-nav-link', { 'is-active': isActive }]}
            >
              {label}
            </a>
          );
        })}
      </nav>
    </div>

    <!-- Right side -->
    <div class="hdb-header-right">
      <!-- Search (desktop) -->
      <div class="hidden md:block">
        <SearchBar client:load variant="header" placeholder="Search games..." />
      </div>

      {user && (
        <NotificationBell client:load />
      )}

      <!-- Submit button -->
      <a href="/report/new" class="hidden sm:inline-flex hdb-submit-btn">
        SUBMIT
      </a>

      {user ? (
        <div class="relative group">
          <button class="hdb-avatar-btn">
            {avatarUrl ? (
              <img src={avatarUrl} alt="" class="hdb-avatar-img" />
            ) : (
              <div class="hdb-avatar-fallback">
                {displayName.charAt(0).toUpperCase()}
              </div>
            )}
            <span class="hidden sm:inline hdb-avatar-name">{displayName}</span>
          </button>
          <div class="hdb-dropdown">
            <div class="hdb-dropdown-inner">
              <a href="/profile" class="hdb-dropdown-link">Profile</a>
              <a href="/auth/logout" class="hdb-dropdown-link hdb-dropdown-danger">Sign out</a>
            </div>
          </div>
        </div>
      ) : (
        <a href="/auth/login" class="hidden md:inline-flex hdb-signin-link">
          Sign in
        </a>
      )}

      <!-- Hamburger (mobile) -->
      <button
        id="mobile-menu-btn"
        type="button"
        class="md:hidden hdb-hamburger"
        aria-label="Open menu"
        aria-expanded="false"
      >
        <div class="hdb-hamburger-line w-[18px]"></div>
        <div class="hdb-hamburger-line w-[13px]"></div>
      </button>
    </div>
  </div>
</header>

<!-- Mobile menu backdrop -->
<div
  id="mobile-menu-backdrop"
  class="fixed inset-0 z-[60] bg-black/60 backdrop-blur-sm opacity-0 invisible transition-all duration-300"
></div>

<!-- Mobile menu drawer -->
<nav
  id="mobile-menu-drawer"
  class="fixed top-0 right-0 z-[70] h-full w-72 translate-x-full transition-transform duration-300 ease-in-out"
  style="background:#08070c;border-left:1px solid rgba(255,255,255,0.06);box-shadow:0 0 40px rgba(0,0,0,0.5);"
>
  <div class="flex h-full flex-col">
    <!-- Drawer header -->
    <div style="display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid rgba(255,255,255,0.06);padding:16px 20px;">
      <span style="font-family:var(--font-display);font-size:14px;font-weight:700;color:#eae6f4;">Menu</span>
      <button
        id="mobile-menu-close"
        type="button"
        style="padding:6px;color:#6d6882;background:none;border:none;cursor:pointer;"
        aria-label="Close menu"
      >
        <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Mobile Search -->
    <div style="padding:12px 12px 0;">
      <SearchBar client:load variant="header" placeholder="Search games..." />
    </div>

    <!-- Nav links -->
    <div style="flex:1;overflow-y:auto;padding:16px 12px;">
      <div style="display:flex;flex-direction:column;gap:4px;">
        {navLinks.map(({ href, label }) => {
          const isActive = currentPath.startsWith(href);
          return (
            <a
              href={href}
              class="mobile-menu-link"
              style={`display:block;border-radius:8px;padding:12px 16px;font-size:14px;font-weight:500;text-decoration:none;transition:all 0.15s;color:${isActive ? '#eae6f4' : '#9890a8'};background:${isActive ? '#0e0c16' : 'transparent'};`}
            >
              {label}
            </a>
          );
        })}
      </div>

      <div style="margin:16px 0;border-top:1px solid rgba(255,255,255,0.06);"></div>

      <a
        href="/report/new"
        class="mobile-menu-link"
        style="display:flex;align-items:center;gap:8px;border-radius:8px;background:rgba(167,139,250,0.1);border:1px solid rgba(167,139,250,0.2);padding:12px 16px;font-size:14px;font-weight:600;color:#a78bfa;text-decoration:none;transition:background 0.15s;"
      >
        <svg style="width:16px;height:16px;" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
        </svg>
        Submit Report
      </a>
    </div>

    <!-- Auth at bottom -->
    <div style="border-top:1px solid rgba(255,255,255,0.06);padding:16px 12px;">
      {user ? (
        <div style="display:flex;flex-direction:column;gap:8px;">
          <div style="display:flex;align-items:center;gap:12px;padding:8px 16px;">
            {avatarUrl ? (
              <img src={avatarUrl} alt="" style="height:32px;width:32px;border-radius:50%;" />
            ) : (
              <div style="height:32px;width:32px;border-radius:50%;background:#a78bfa;display:flex;align-items:center;justify-content:center;font-size:13px;font-weight:700;color:#08070c;">
                {displayName.charAt(0).toUpperCase()}
              </div>
            )}
            <div style="min-width:0;">
              <p style="font-size:14px;font-weight:500;color:#eae6f4;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">{displayName}</p>
              <p style="font-size:11px;color:#6d6882;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">{user.email}</p>
            </div>
          </div>
          <a href="/profile" class="mobile-menu-link" style="display:block;border-radius:8px;padding:10px 16px;font-size:13px;color:#9890a8;text-decoration:none;">Profile</a>
          <a href="/auth/logout" class="mobile-menu-link" style="display:block;border-radius:8px;padding:10px 16px;font-size:13px;color:#f87171;text-decoration:none;">Sign out</a>
        </div>
      ) : (
        <a
          href="/auth/login"
          class="mobile-menu-link"
          style="display:flex;align-items:center;justify-content:center;gap:8px;border-radius:8px;border:1px solid rgba(255,255,255,0.09);padding:12px 16px;font-size:14px;font-weight:500;color:#9890a8;text-decoration:none;transition:all 0.15s;"
        >
          Sign in
        </a>
      )}
    </div>
  </div>
</nav>

<style>
  .hdb-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(8, 7, 12, 0.92);
    backdrop-filter: blur(24px);
    border-bottom: 1px solid rgba(255,255,255,0.06);
    transition: background 0.3s, border-color 0.3s;
  }
  .hdb-header.scrolled {
    background: rgba(8, 7, 12, 0.98);
    border-bottom-color: rgba(255,255,255,0.08);
  }
  .hdb-header-inner {
    max-width: 1080px;
    margin: 0 auto;
    padding: 0 24px;
    height: 56px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .hdb-header-left {
    display: flex;
    align-items: center;
    gap: 32px;
  }
  .hdb-header-right {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  /* Logo */
  .hdb-logo {
    display: flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
  }
  .hdb-logo-mark {
    width: 24px;
    height: 24px;
    border-radius: 7px;
    background: rgba(167,139,250,0.12);
    border: 1px solid rgba(167,139,250,0.25);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s;
  }
  .hdb-logo:hover .hdb-logo-mark {
    background: rgba(167,139,250,0.18);
    border-color: rgba(167,139,250,0.35);
    box-shadow: 0 0 12px rgba(167,139,250,0.15);
  }
  .hdb-logo-dot {
    width: 7px;
    height: 7px;
    border-radius: 2px;
    background: #a78bfa;
  }
  .hdb-logo-text {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 16px;
    color: #eae6f4;
    letter-spacing: -0.02em;
  }

  /* Navigation */
  .hdb-nav {
    gap: 6px;
  }
  .hdb-nav-link {
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 500;
    color: #6d6882;
    text-decoration: none;
    padding: 6px 10px;
    border-radius: 6px;
    transition: all 0.15s;
  }
  .hdb-nav-link:hover {
    color: #9890a8;
    background: rgba(255,255,255,0.03);
  }
  .hdb-nav-link.is-active {
    color: #eae6f4;
    background: rgba(255,255,255,0.04);
  }
  .hdb-nav-link.is-active::after {
    content: '';
    position: absolute;
    bottom: -1px;
    left: 50%;
    transform: translateX(-50%);
    width: 16px;
    height: 2px;
    background: #a78bfa;
    border-radius: 1px;
  }
  .hdb-nav-link {
    position: relative;
  }

  /* Submit button */
  .hdb-submit-btn {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: #08070c;
    background: #a78bfa;
    padding: 7px 16px;
    border-radius: 8px;
    text-decoration: none;
    transition: all 0.2s;
    box-shadow: 0 0 16px rgba(167,139,250,0.2);
  }
  .hdb-submit-btn:hover {
    background: #c4b5fd;
    box-shadow: 0 0 24px rgba(167,139,250,0.3);
    transform: translateY(-1px);
  }

  /* Sign in */
  .hdb-signin-link {
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 500;
    color: #6d6882;
    text-decoration: none;
    transition: color 0.15s;
  }
  .hdb-signin-link:hover { color: #9890a8; }

  /* Avatar */
  .hdb-avatar-btn {
    display: flex;
    align-items: center;
    gap: 8px;
    border-radius: 8px;
    border: 1px solid rgba(255,255,255,0.06);
    padding: 4px 10px 4px 4px;
    background: none;
    cursor: pointer;
    transition: all 0.15s;
  }
  .hdb-avatar-btn:hover {
    border-color: rgba(255,255,255,0.1);
    background: rgba(255,255,255,0.02);
  }
  .hdb-avatar-img {
    height: 26px;
    width: 26px;
    border-radius: 50%;
  }
  .hdb-avatar-fallback {
    height: 26px;
    width: 26px;
    border-radius: 50%;
    background: #a78bfa;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
    font-weight: 700;
    color: #08070c;
  }
  .hdb-avatar-name {
    font-size: 13px;
    color: #9890a8;
  }

  /* Dropdown */
  .hdb-dropdown {
    position: absolute;
    right: 0;
    margin-top: 8px;
    width: 192px;
    border-radius: 12px;
    background: #0e0c16;
    border: 1px solid rgba(255,255,255,0.08);
    box-shadow: 0 8px 32px rgba(0,0,0,0.4);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-4px);
    transition: all 0.15s;
  }
  .group:hover .hdb-dropdown {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }
  .hdb-dropdown-inner {
    padding: 6px;
  }
  .hdb-dropdown-link {
    display: block;
    border-radius: 8px;
    padding: 8px 12px;
    font-size: 13px;
    color: #9890a8;
    text-decoration: none;
    transition: background 0.1s;
  }
  .hdb-dropdown-link:hover {
    background: rgba(255,255,255,0.04);
  }
  .hdb-dropdown-danger {
    color: #f87171;
  }

  /* Hamburger */
  .hdb-hamburger {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    padding: 6px;
    background: none;
    border: none;
    cursor: pointer;
  }
  .hdb-hamburger-line {
    height: 1.5px;
    background: #6d6882;
    border-radius: 1px;
    transition: background 0.15s;
  }
  .hdb-hamburger:hover .hdb-hamburger-line {
    background: #9890a8;
  }
</style>

<script>
  function initMobileMenu() {
    const btn = document.getElementById('mobile-menu-btn');
    const closeBtn = document.getElementById('mobile-menu-close');
    const backdrop = document.getElementById('mobile-menu-backdrop');
    const drawer = document.getElementById('mobile-menu-drawer');

    if (!btn || !closeBtn || !backdrop || !drawer) return;

    const _btn = btn!;
    const _backdrop = backdrop!;
    const _drawer = drawer!;

    function openMenu() {
      _backdrop.classList.remove('opacity-0', 'invisible');
      _backdrop.classList.add('opacity-100', 'visible');
      _drawer.classList.remove('translate-x-full');
      _drawer.classList.add('translate-x-0');
      _btn.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
    }

    function closeMenu() {
      _backdrop.classList.add('opacity-0', 'invisible');
      _backdrop.classList.remove('opacity-100', 'visible');
      _drawer.classList.add('translate-x-full');
      _drawer.classList.remove('translate-x-0');
      _btn.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
    }

    _btn.addEventListener('click', openMenu);
    closeBtn!.addEventListener('click', closeMenu);
    _backdrop.addEventListener('click', closeMenu);

    const links = _drawer.querySelectorAll('.mobile-menu-link');
    links.forEach((link) => {
      link.addEventListener('click', closeMenu);
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && _btn.getAttribute('aria-expanded') === 'true') {
        closeMenu();
      }
    });
  }

  initMobileMenu();
  document.addEventListener('astro:after-swap', initMobileMenu);

  // Header scroll state
  function initHeaderScroll() {
    const header = document.querySelector('.hdb-header');
    if (!header) return;
    let ticking = false;
    window.addEventListener('scroll', () => {
      if (!ticking) {
        requestAnimationFrame(() => {
          header.classList.toggle('scrolled', window.scrollY > 20);
          ticking = false;
        });
        ticking = true;
      }
    }, { passive: true });
    // Set initial state
    header.classList.toggle('scrolled', window.scrollY > 20);
  }
  initHeaderScroll();
  document.addEventListener('astro:after-swap', initHeaderScroll);
</script>
