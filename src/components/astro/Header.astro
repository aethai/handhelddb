---
import SearchBar from '@components/react/SearchBar';
import NotificationBell from '@components/react/NotificationBell';

interface Props {
  user?: { email?: string; user_metadata?: Record<string, unknown> } | null;
}

const { user } = Astro.props;
const avatarUrl = user?.user_metadata?.avatar_url as string | undefined;
const displayName = (user?.user_metadata?.full_name as string) ?? user?.email?.split('@')[0] ?? 'User';
const currentPath = Astro.url.pathname;

const navLinks = [
  { href: '/games', label: 'Games' },
  { href: '/devices', label: 'Devices' },
  { href: '/discover', label: 'Discover' },
  { href: '/compare', label: 'Compare' },
  { href: '/news', label: 'News' },
];
---

<header style="position:sticky;top:0;z-index:50;background:#08070cee;backdrop-filter:blur(20px);border-bottom:1px solid rgba(255,255,255,0.06);">
  <div style="max-width:960px;margin:0 auto;padding:11px 24px;display:flex;align-items:center;justify-content:space-between;">
    <div style="display:flex;align-items:center;gap:24px;">
      <!-- Logo -->
      <a href="/" style="display:flex;align-items:center;gap:7px;text-decoration:none;">
        <div style="width:22px;height:22px;border-radius:6px;background:rgba(167,139,250,0.12);border:1px solid rgba(167,139,250,0.2);display:flex;align-items:center;justify-content:center;">
          <div style="width:6px;height:6px;border-radius:2px;background:#a78bfa;"></div>
        </div>
        <span style="font-family:var(--font-display);font-weight:800;font-size:15px;color:#eae6f4;">HandheldDB</span>
      </a>

      <!-- Navigation (desktop) -->
      <nav class="hidden md:flex" style="gap:20px;">
        {navLinks.map(({ href, label }) => {
          const isActive = currentPath.startsWith(href);
          return (
            <a
              href={href}
              style={`font-family:var(--font-mono);font-size:11px;color:${isActive ? '#9890a8' : '#4a4458'};text-decoration:none;transition:color 0.15s;`}
            >
              {label}
            </a>
          );
        })}
      </nav>
    </div>

    <!-- Right side -->
    <div style="display:flex;align-items:center;gap:12px;">
      <!-- Search (desktop) -->
      <div class="hidden md:block">
        <SearchBar client:load variant="header" placeholder="Search games..." />
      </div>

      {user && (
        <NotificationBell client:load />
      )}

      <!-- Submit button -->
      <a
        href="/report/new"
        class="hidden sm:inline-flex"
        style="font-family:var(--font-mono);font-size:9px;font-weight:700;color:#08070c;background:#a78bfa;padding:6px 14px;border-radius:6px;letter-spacing:0.04em;box-shadow:0 0 16px rgba(167,139,250,0.2);text-decoration:none;transition:all 0.2s;"
      >
        SUBMIT
      </a>

      {user ? (
        <div class="relative group">
          <button style="display:flex;align-items:center;gap:6px;border-radius:8px;border:1px solid rgba(255,255,255,0.09);padding:4px 8px;background:none;cursor:pointer;transition:border-color 0.15s;">
            {avatarUrl ? (
              <img src={avatarUrl} alt="" style="height:24px;width:24px;border-radius:50%;" />
            ) : (
              <div style="height:24px;width:24px;border-radius:50%;background:#a78bfa;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:700;color:#08070c;">
                {displayName.charAt(0).toUpperCase()}
              </div>
            )}
            <span class="hidden sm:inline" style="font-size:12px;color:#9890a8;">{displayName}</span>
          </button>
          <div class="absolute right-0 mt-2 w-48 rounded-xl bg-[#0e0c16] shadow-xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all z-50" style="border:1px solid rgba(255,255,255,0.09);">
            <div style="padding:8px;">
              <a href="/profile" style="display:block;border-radius:8px;padding:8px 12px;font-size:13px;color:#9890a8;text-decoration:none;transition:background 0.1s;">Profile</a>
              <a href="/auth/logout" style="display:block;border-radius:8px;padding:8px 12px;font-size:13px;color:#f87171;text-decoration:none;transition:background 0.1s;">Sign out</a>
            </div>
          </div>
        </div>
      ) : (
        <a
          href="/auth/login"
          class="hidden md:inline-flex"
          style="font-family:var(--font-mono);font-size:10px;color:#6d6882;text-decoration:none;transition:color 0.15s;"
        >
          Sign in
        </a>
      )}

      <!-- Hamburger (mobile) -->
      <button
        id="mobile-menu-btn"
        type="button"
        class="md:hidden"
        style="display:flex;flex-direction:column;justify-content:center;gap:4px;padding:4px;background:none;border:none;cursor:pointer;"
        aria-label="Open menu"
        aria-expanded="false"
      >
        <div style="width:16px;height:1.5px;background:#6d6882;border-radius:1px;"></div>
        <div style="width:12px;height:1.5px;background:#6d6882;border-radius:1px;"></div>
      </button>
    </div>
  </div>
</header>

<!-- Mobile menu backdrop -->
<div
  id="mobile-menu-backdrop"
  class="fixed inset-0 z-[60] bg-black/60 backdrop-blur-sm opacity-0 invisible transition-all duration-300"
></div>

<!-- Mobile menu drawer -->
<nav
  id="mobile-menu-drawer"
  class="fixed top-0 right-0 z-[70] h-full w-72 translate-x-full transition-transform duration-300 ease-in-out"
  style="background:#08070c;border-left:1px solid rgba(255,255,255,0.06);box-shadow:0 0 40px rgba(0,0,0,0.5);"
>
  <div class="flex h-full flex-col">
    <!-- Drawer header -->
    <div style="display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid rgba(255,255,255,0.06);padding:16px 20px;">
      <span style="font-family:var(--font-display);font-size:14px;font-weight:700;color:#eae6f4;">Menu</span>
      <button
        id="mobile-menu-close"
        type="button"
        style="padding:6px;color:#6d6882;background:none;border:none;cursor:pointer;"
        aria-label="Close menu"
      >
        <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Mobile Search -->
    <div style="padding:12px 12px 0;">
      <SearchBar client:load variant="header" placeholder="Search games..." />
    </div>

    <!-- Nav links -->
    <div style="flex:1;overflow-y:auto;padding:16px 12px;">
      <div style="display:flex;flex-direction:column;gap:4px;">
        {navLinks.map(({ href, label }) => {
          const isActive = currentPath.startsWith(href);
          return (
            <a
              href={href}
              class="mobile-menu-link"
              style={`display:block;border-radius:8px;padding:12px 16px;font-size:14px;font-weight:500;text-decoration:none;transition:all 0.15s;color:${isActive ? '#eae6f4' : '#9890a8'};background:${isActive ? '#0e0c16' : 'transparent'};`}
            >
              {label}
            </a>
          );
        })}
      </div>

      <div style="margin:16px 0;border-top:1px solid rgba(255,255,255,0.06);"></div>

      <a
        href="/report/new"
        class="mobile-menu-link"
        style="display:flex;align-items:center;gap:8px;border-radius:8px;background:rgba(167,139,250,0.1);border:1px solid rgba(167,139,250,0.2);padding:12px 16px;font-size:14px;font-weight:600;color:#a78bfa;text-decoration:none;transition:background 0.15s;"
      >
        <svg style="width:16px;height:16px;" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
        </svg>
        Submit Report
      </a>
    </div>

    <!-- Auth at bottom -->
    <div style="border-top:1px solid rgba(255,255,255,0.06);padding:16px 12px;">
      {user ? (
        <div style="display:flex;flex-direction:column;gap:8px;">
          <div style="display:flex;align-items:center;gap:12px;padding:8px 16px;">
            {avatarUrl ? (
              <img src={avatarUrl} alt="" style="height:32px;width:32px;border-radius:50%;" />
            ) : (
              <div style="height:32px;width:32px;border-radius:50%;background:#a78bfa;display:flex;align-items:center;justify-content:center;font-size:13px;font-weight:700;color:#08070c;">
                {displayName.charAt(0).toUpperCase()}
              </div>
            )}
            <div style="min-width:0;">
              <p style="font-size:14px;font-weight:500;color:#eae6f4;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">{displayName}</p>
              <p style="font-size:11px;color:#6d6882;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">{user.email}</p>
            </div>
          </div>
          <a href="/profile" class="mobile-menu-link" style="display:block;border-radius:8px;padding:10px 16px;font-size:13px;color:#9890a8;text-decoration:none;">Profile</a>
          <a href="/auth/logout" class="mobile-menu-link" style="display:block;border-radius:8px;padding:10px 16px;font-size:13px;color:#f87171;text-decoration:none;">Sign out</a>
        </div>
      ) : (
        <a
          href="/auth/login"
          class="mobile-menu-link"
          style="display:flex;align-items:center;justify-content:center;gap:8px;border-radius:8px;border:1px solid rgba(255,255,255,0.09);padding:12px 16px;font-size:14px;font-weight:500;color:#9890a8;text-decoration:none;transition:all 0.15s;"
        >
          Sign in
        </a>
      )}
    </div>
  </div>
</nav>

<script>
  function initMobileMenu() {
    const btn = document.getElementById('mobile-menu-btn');
    const closeBtn = document.getElementById('mobile-menu-close');
    const backdrop = document.getElementById('mobile-menu-backdrop');
    const drawer = document.getElementById('mobile-menu-drawer');

    if (!btn || !closeBtn || !backdrop || !drawer) return;

    const _btn = btn!;
    const _backdrop = backdrop!;
    const _drawer = drawer!;

    function openMenu() {
      _backdrop.classList.remove('opacity-0', 'invisible');
      _backdrop.classList.add('opacity-100', 'visible');
      _drawer.classList.remove('translate-x-full');
      _drawer.classList.add('translate-x-0');
      _btn.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
    }

    function closeMenu() {
      _backdrop.classList.add('opacity-0', 'invisible');
      _backdrop.classList.remove('opacity-100', 'visible');
      _drawer.classList.add('translate-x-full');
      _drawer.classList.remove('translate-x-0');
      _btn.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
    }

    _btn.addEventListener('click', openMenu);
    closeBtn!.addEventListener('click', closeMenu);
    _backdrop.addEventListener('click', closeMenu);

    const links = _drawer.querySelectorAll('.mobile-menu-link');
    links.forEach((link) => {
      link.addEventListener('click', closeMenu);
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && _btn.getAttribute('aria-expanded') === 'true') {
        closeMenu();
      }
    });
  }

  initMobileMenu();
  document.addEventListener('astro:after-swap', initMobileMenu);
</script>
