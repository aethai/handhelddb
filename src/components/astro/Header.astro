---
const navLinks = [
  { href: '/games', label: 'Games' },
  { href: '/devices', label: 'Devices' },
  { href: '/compare', label: 'Compare' },
  { href: '/discover', label: 'Discover' },
];
---

<header class="sticky top-0 z-50 border-b border-gray-800 bg-gray-950/80 backdrop-blur-md">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex h-16 items-center justify-between">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-2 text-lg font-bold text-white hover:text-emerald-400 transition-colors">
        <svg class="h-8 w-8 text-emerald-500" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
          <rect x="4" y="8" width="24" height="16" rx="4" stroke="currentColor" stroke-width="2" />
          <circle cx="11" cy="16" r="2" fill="currentColor" />
          <circle cx="21" cy="14" r="1.5" fill="currentColor" />
          <circle cx="23" cy="16" r="1.5" fill="currentColor" />
          <circle cx="21" cy="18" r="1.5" fill="currentColor" />
          <circle cx="19" cy="16" r="1.5" fill="currentColor" />
        </svg>
        <span class="hidden sm:inline">Handheld GameDB</span>
      </a>

      <!-- Navigation -->
      <nav class="hidden md:flex items-center gap-6">
        {navLinks.map(({ href, label }) => (
          <a
            href={href}
            class="text-sm font-medium text-gray-400 hover:text-white transition-colors"
          >
            {label}
          </a>
        ))}
      </nav>

      <!-- Search + Auth -->
      <div class="flex items-center gap-3">
        <a
          href="/games"
          class="text-gray-400 hover:text-white transition-colors"
          aria-label="Search games"
        >
          <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M11 19a8 8 0 100-16 8 8 0 000 16z" />
          </svg>
        </a>
        <a
          href="/report/new"
          class="hidden sm:inline-flex items-center gap-1.5 rounded-lg bg-emerald-600 px-3 py-1.5 text-sm font-medium text-white hover:bg-emerald-500 transition-colors"
        >
          <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
          </svg>
          Report
        </a>
        <a
          href="/auth/login"
          class="rounded-lg border border-gray-700 px-3 py-1.5 text-sm font-medium text-gray-300 hover:border-gray-500 hover:text-white transition-colors"
        >
          Sign in
        </a>
      </div>
    </div>
  </div>
</header>
