---
import SearchBar from '@components/react/SearchBar';
import NotificationBell from '@components/react/NotificationBell';

interface Props {
  user?: { email?: string; user_metadata?: Record<string, unknown> } | null;
}

const { user } = Astro.props;
const avatarUrl = user?.user_metadata?.avatar_url as string | undefined;
const displayName = (user?.user_metadata?.full_name as string) ?? user?.email?.split('@')[0] ?? 'User';
const currentPath = Astro.url.pathname;

const navLinks = [
  { href: '/games', label: 'Games' },
  { href: '/devices', label: 'Devices' },
  { href: '/discover', label: 'Discover' },
  { href: '/news', label: 'News' },
  { href: '/compare', label: 'Compare' },
];
---

<header class="sticky top-0 z-50 bg-[#0F1115]/90 backdrop-blur-md border-b border-[#2A2D35]">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex h-16 items-center justify-between">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-2 text-lg font-bold text-white hover:text-[#93C5FD] transition-colors">
        <svg class="h-8 w-8 text-[#60A5FA]" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
          <rect x="4" y="8" width="24" height="16" rx="4" stroke="currentColor" stroke-width="2" />
          <circle cx="11" cy="16" r="2" fill="currentColor" />
          <circle cx="21" cy="14" r="1.5" fill="currentColor" />
          <circle cx="23" cy="16" r="1.5" fill="currentColor" />
          <circle cx="21" cy="18" r="1.5" fill="currentColor" />
          <circle cx="19" cy="16" r="1.5" fill="currentColor" />
        </svg>
        <span class="hidden sm:inline text-sm font-semibold">Handheld GameDB</span>
      </a>

      <!-- Navigation (desktop) -->
      <nav class="hidden md:flex items-center gap-6">
        {navLinks.map(({ href, label }) => {
          const isActive = currentPath.startsWith(href);
          return (
            <a
              href={href}
              class={`relative text-sm font-medium transition-colors after:absolute after:bottom-0 after:left-0 after:h-0.5 after:bg-[#60A5FA] after:transition-all ${isActive ? 'text-[#E8EAED] after:w-full' : 'text-[#9CA3AF] hover:text-[#E8EAED] after:w-0 hover:after:w-full'}`}
            >
              {label}
            </a>
          );
        })}
      </nav>

      <!-- Search + Auth + Hamburger -->
      <div class="flex items-center gap-3">
        <div class="hidden md:block">
          <SearchBar client:load variant="header" placeholder="Search games..." />
        </div>
        {user && (
          <NotificationBell client:load />
        )}
        <a
          href="/report/new"
          class="hidden sm:inline-flex items-center gap-1.5 rounded-lg bg-[#60A5FA] px-3 py-1.5 text-sm font-medium text-[#0F1115] hover:bg-[#93C5FD] transition-colors"
        >
          <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
          </svg>
          Report
        </a>
        {user ? (
          <div class="relative group">
            <button class="flex items-center gap-2 rounded-lg border border-[#3A3D45] px-2 py-1 hover:border-[#60A5FA] transition-colors">
              {avatarUrl ? (
                <img src={avatarUrl} alt="" class="h-6 w-6 rounded-full" />
              ) : (
                <div class="h-6 w-6 rounded-full bg-[#60A5FA] flex items-center justify-center text-xs font-bold text-[#0F1115]">
                  {displayName.charAt(0).toUpperCase()}
                </div>
              )}
              <span class="hidden sm:inline text-sm text-[#9CA3AF]">{displayName}</span>
            </button>
            <div class="absolute right-0 mt-2 w-48 rounded-xl border border-[#3A3D45] bg-[#16181D] shadow-xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all z-50">
              <div class="p-2 space-y-1">
                <a href="/profile" class="block rounded-lg px-3 py-2 text-sm text-[#9CA3AF] hover:bg-[#1E2128] hover:text-white">Profile</a>
                <a href="/auth/logout" class="block rounded-lg px-3 py-2 text-sm text-red-400 hover:bg-[#1E2128] hover:text-red-300">Sign out</a>
              </div>
            </div>
          </div>
        ) : (
          <a
            href="/auth/login"
            class="hidden md:inline-flex rounded-lg border border-[#3A3D45] px-3 py-1.5 text-sm font-medium text-[#9CA3AF] hover:border-[#60A5FA] hover:text-white transition-colors"
          >
            Sign in
          </a>
        )}

        <!-- Hamburger button (mobile only) -->
        <button
          id="mobile-menu-btn"
          type="button"
          class="md:hidden inline-flex items-center justify-center rounded-lg border border-[#3A3D45] p-2 text-[#9CA3AF] hover:border-[#60A5FA] hover:text-white transition-colors"
          aria-label="Open menu"
          aria-expanded="false"
        >
          <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>
  </div>
</header>

<!-- Mobile menu backdrop -->
<div
  id="mobile-menu-backdrop"
  class="fixed inset-0 z-[60] bg-black/60 backdrop-blur-sm opacity-0 invisible transition-all duration-300"
></div>

<!-- Mobile menu drawer -->
<nav
  id="mobile-menu-drawer"
  class="fixed top-0 right-0 z-[70] h-full w-72 bg-[#0F1115] border-l border-[#2A2D35] shadow-2xl translate-x-full transition-transform duration-300 ease-in-out"
>
  <div class="flex h-full flex-col">
    <!-- Drawer header -->
    <div class="flex items-center justify-between border-b border-[#2A2D35] px-5 py-4">
      <span class="text-sm font-semibold text-white">Menu</span>
      <button
        id="mobile-menu-close"
        type="button"
        class="rounded-lg p-1.5 text-[#9CA3AF] hover:text-white transition-colors"
        aria-label="Close menu"
      >
        <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Nav links -->
    <div class="flex-1 overflow-y-auto px-3 py-4">
      <div class="space-y-1">
        {navLinks.map(({ href, label }) => {
          const isActive = currentPath.startsWith(href);
          return (
            <a
              href={href}
              class={`mobile-menu-link block rounded-lg px-4 py-3 text-sm font-medium transition-colors ${isActive ? 'text-white bg-[#16181D]' : 'text-[#9CA3AF] hover:bg-[#16181D] hover:text-white'}`}
            >
              {label}
            </a>
          );
        })}
      </div>

      <!-- Divider -->
      <div class="my-4 border-t border-[#2A2D35]"></div>

      <!-- Report button -->
      <a
        href="/report/new"
        class="mobile-menu-link flex items-center gap-2 rounded-lg bg-[#60A5FA]/10 border border-[#60A5FA]/20 px-4 py-3 text-sm font-medium text-[#60A5FA] hover:bg-[#60A5FA]/20 transition-colors"
      >
        <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
        </svg>
        Submit Report
      </a>
    </div>

    <!-- Auth section at bottom -->
    <div class="border-t border-[#2A2D35] px-3 py-4">
      {user ? (
        <div class="space-y-2">
          <div class="flex items-center gap-3 px-4 py-2">
            {avatarUrl ? (
              <img src={avatarUrl} alt="" class="h-8 w-8 rounded-full" />
            ) : (
              <div class="h-8 w-8 rounded-full bg-[#60A5FA] flex items-center justify-center text-sm font-bold text-[#0F1115]">
                {displayName.charAt(0).toUpperCase()}
              </div>
            )}
            <div class="min-w-0">
              <p class="truncate text-sm font-medium text-white">{displayName}</p>
              <p class="truncate text-xs text-[#6B7280]">{user.email}</p>
            </div>
          </div>
          <a href="/profile" class="mobile-menu-link block rounded-lg px-4 py-2.5 text-sm text-[#9CA3AF] hover:bg-[#16181D] hover:text-white transition-colors">
            Profile
          </a>
          <a href="/auth/logout" class="mobile-menu-link block rounded-lg px-4 py-2.5 text-sm text-red-400 hover:bg-[#16181D] hover:text-red-300 transition-colors">
            Sign out
          </a>
        </div>
      ) : (
        <a
          href="/auth/login"
          class="mobile-menu-link flex items-center justify-center gap-2 rounded-lg border border-[#3A3D45] px-4 py-3 text-sm font-medium text-[#9CA3AF] hover:border-[#60A5FA] hover:text-white transition-colors"
        >
          Sign in
        </a>
      )}
    </div>
  </div>
</nav>

<script>
  function initMobileMenu() {
    const btn = document.getElementById('mobile-menu-btn');
    const closeBtn = document.getElementById('mobile-menu-close');
    const backdrop = document.getElementById('mobile-menu-backdrop');
    const drawer = document.getElementById('mobile-menu-drawer');

    if (!btn || !closeBtn || !backdrop || !drawer) return;

    const _btn = btn!;
    const _backdrop = backdrop!;
    const _drawer = drawer!;

    function openMenu() {
      _backdrop.classList.remove('opacity-0', 'invisible');
      _backdrop.classList.add('opacity-100', 'visible');
      _drawer.classList.remove('translate-x-full');
      _drawer.classList.add('translate-x-0');
      _btn.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
    }

    function closeMenu() {
      _backdrop.classList.add('opacity-0', 'invisible');
      _backdrop.classList.remove('opacity-100', 'visible');
      _drawer.classList.add('translate-x-full');
      _drawer.classList.remove('translate-x-0');
      _btn.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
    }

    _btn.addEventListener('click', openMenu);
    closeBtn!.addEventListener('click', closeMenu);
    _backdrop.addEventListener('click', closeMenu);

    // Close on link click
    const links = _drawer.querySelectorAll('.mobile-menu-link');
    links.forEach((link) => {
      link.addEventListener('click', closeMenu);
    });

    // Close on Escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && _btn.getAttribute('aria-expanded') === 'true') {
        closeMenu();
      }
    });
  }

  // Run on initial load
  initMobileMenu();

  // Re-run after Astro client-side navigation (View Transitions)
  document.addEventListener('astro:after-swap', initMobileMenu);
</script>
