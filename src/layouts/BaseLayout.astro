---
import '@/styles/global.css';
import Header from '@components/astro/Header.astro';
import Footer from '@components/astro/Footer.astro';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  canonicalUrl?: string;
  noindex?: boolean;
}

const {
  title,
  description = 'The universal handheld gaming performance database. Find optimal settings for every game on Steam Deck, ROG Ally, Legion Go and more.',
  ogImage,
  canonicalUrl,
  noindex = false,
} = Astro.props;

const siteName = 'Handheld GameDB';
const fullTitle = title === siteName ? title : `${title} | ${siteName}`;
const siteUrl = import.meta.env.PUBLIC_SITE_URL ?? 'https://handheldgamedb.com';
const resolvedOgImage = ogImage ?? `${siteUrl}/og/default.png`;
const resolvedCanonical = canonicalUrl ?? new URL(Astro.url.pathname, siteUrl).href;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#08070c" />

    <!-- SEO -->
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={resolvedCanonical} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={resolvedOgImage} />
    <meta property="og:url" content={resolvedCanonical} />
    <meta property="og:site_name" content={siteName} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedOgImage} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- RSS -->
    <link rel="alternate" type="application/rss+xml" title="HandheldDB News" href="/rss.xml" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&display=swap"
      rel="stylesheet"
    />

    <!-- View Transitions -->
    <meta name="view-transition" content="same-origin" />

    <!-- Analytics (Plausible) -->
    {import.meta.env.PUBLIC_PLAUSIBLE_DOMAIN && (
      <script
        defer
        data-domain={import.meta.env.PUBLIC_PLAUSIBLE_DOMAIN}
        src={import.meta.env.PUBLIC_PLAUSIBLE_SRC ?? 'https://plausible.io/js/script.js'}
      />
    )}
  </head>
  <body class="min-h-screen bg-[#08070c] text-[#d0cce0] flex flex-col font-[Outfit,system-ui,sans-serif]">
    <div class="hdb-reading-progress" id="reading-progress"></div>
    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[100] focus:bg-[#a78bfa] focus:text-[#08070c] focus:px-4 focus:py-2 focus:rounded-lg focus:font-bold focus:text-sm">Skip to content</a>
    <Header user={Astro.locals.user} />
    <main id="main-content" class="flex-1">
      <slot />
    </main>
    <Footer />

    <!-- Scroll-to-top button -->
    <button class="hdb-scroll-top" id="scroll-top" aria-label="Scroll to top">
      <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 15.75l7.5-7.5 7.5 7.5" /></svg>
    </button>
    <script>
      // ── Scroll-to-top ──
      const btn = document.getElementById('scroll-top');
      if (btn) {
        let ticking = false;
        window.addEventListener('scroll', () => {
          if (!ticking) {
            requestAnimationFrame(() => {
              btn.classList.toggle('visible', window.scrollY > 400);
              ticking = false;
            });
            ticking = true;
          }
        }, { passive: true });
        btn.addEventListener('click', () => {
          window.scrollTo({ top: 0, behavior: 'smooth' });
        });
      }

      // ── Lazy image fade-in ──
      document.addEventListener('DOMContentLoaded', () => {
        document.querySelectorAll('img[loading="lazy"]').forEach(img => {
          if ((img as HTMLImageElement).complete) {
            img.classList.add('loaded');
          } else {
            img.addEventListener('load', () => img.classList.add('loaded'), { once: true });
          }
        });

        // Observer for dynamically added images
        const mo = new MutationObserver(muts => {
          for (const m of muts) {
            m.addedNodes.forEach(n => {
              if (n instanceof HTMLImageElement && n.loading === 'lazy') {
                if (n.complete) n.classList.add('loaded');
                else n.addEventListener('load', () => n.classList.add('loaded'), { once: true });
              }
              if (n instanceof HTMLElement) {
                n.querySelectorAll?.('img[loading="lazy"]').forEach(img => {
                  if ((img as HTMLImageElement).complete) img.classList.add('loaded');
                  else img.addEventListener('load', () => img.classList.add('loaded'), { once: true });
                });
              }
            });
          }
        });
        mo.observe(document.body, { childList: true, subtree: true });
      });

      // ── Mouse glow tracking ──
      document.querySelectorAll('.hdb-glow').forEach(el => {
        el.addEventListener('mousemove', (e: Event) => {
          const me = e as MouseEvent;
          const rect = (el as HTMLElement).getBoundingClientRect();
          (el as HTMLElement).style.setProperty('--mouse-x', me.clientX - rect.left + 'px');
          (el as HTMLElement).style.setProperty('--mouse-y', me.clientY - rect.top + 'px');
        });
      });

      // ── Reading progress bar ──
      const progressBar = document.getElementById('reading-progress');
      if (progressBar) {
        const docHeight = document.documentElement.scrollHeight - window.innerHeight;
        // Only show on pages taller than 2x viewport
        if (docHeight > window.innerHeight * 1.5) {
          progressBar.classList.add('active');
          let rpTicking = false;
          window.addEventListener('scroll', () => {
            if (!rpTicking) {
              requestAnimationFrame(() => {
                const pct = Math.min((window.scrollY / docHeight) * 100, 100);
                progressBar.style.width = pct + '%';
                rpTicking = false;
              });
              rpTicking = true;
            }
          }, { passive: true });
        }
      }

      // ── Keyboard shortcut: / to focus search ──
      document.addEventListener('keydown', (e) => {
        if (e.key === '/' && !['INPUT', 'TEXTAREA', 'SELECT'].includes((e.target as HTMLElement).tagName) && !(e.target as HTMLElement).isContentEditable) {
          e.preventDefault();
          const searchInput = document.querySelector('input[type="search"], input[placeholder*="Search"]') as HTMLInputElement | null;
          searchInput?.focus();
        }
      });
    </script>
  </body>
</html>
