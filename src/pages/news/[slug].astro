---
import BaseLayout from '@layouts/BaseLayout.astro';
import { supabaseAdmin } from '@lib/db/client';

const { slug } = Astro.params;

const { data: article, error } = await supabaseAdmin
  .from('articles')
  .select('*')
  .eq('slug', slug)
  .eq('status', 'published')
  .single();

if (error || !article) {
  return Astro.redirect('/news');
}

// Increment view count (fire and forget)
supabaseAdmin
  .from('articles')
  .update({ view_count: (article.view_count ?? 0) + 1 })
  .eq('id', article.id)
  .then(() => {});

const tags = (article.tags as string[]) ?? [];
const devices = (article.devices as string[]) ?? [];

const categoryLabels: Record<string, string> = {
  device_launch: 'Device Launch', device_update: 'Device Update',
  os_update: 'OS Update', driver_update: 'Driver Update',
  game_patch: 'Game Patch', game_launch: 'Game Launch',
  sale_event: 'Sale', performance_analysis: 'Analysis',
  industry: 'Industry', editorial: 'Editorial',
};

const categoryColors: Record<string, string> = {
  device_launch: 'bg-blue-500/20 text-blue-400',
  device_update: 'bg-[#a78bfa]/20 text-[#a78bfa]',
  os_update: 'bg-purple-500/20 text-purple-400',
  driver_update: 'bg-indigo-500/20 text-indigo-400',
  game_patch: 'bg-orange-500/20 text-orange-400',
  game_launch: 'bg-green-500/20 text-green-400',
  sale_event: 'bg-yellow-500/20 text-yellow-400',
  performance_analysis: 'bg-[#a78bfa]/20 text-[#a78bfa]',
  industry: 'bg-[#55555e]/20 text-[#9890a8]',
  editorial: 'bg-pink-500/20 text-pink-400',
};

const publishedDate = article.published_at
  ? new Date(article.published_at).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })
  : null;

// Fetch recent articles for bottom section
const { data: recentArticles } = await supabaseAdmin
  .from('articles')
  .select('slug, title, published_at, category, cover_image, lead')
  .eq('status', 'published')
  .neq('slug', slug)
  .not('published_at', 'is', null)
  .order('published_at', { ascending: false })
  .limit(5);

// Fetch related articles (same category, then backfill with shared tags)
const { data: sameCategoryArticles } = await supabaseAdmin
  .from('articles')
  .select('slug, title, published_at, category, cover_image, lead')
  .eq('status', 'published')
  .eq('category', article.category)
  .neq('slug', slug)
  .not('published_at', 'is', null)
  .order('published_at', { ascending: false })
  .limit(3);

let relatedArticles = sameCategoryArticles ?? [];

// Backfill with tag-matched articles if fewer than 3
if (relatedArticles.length < 3 && tags.length > 0) {
  const existingSlugs = new Set([slug, ...relatedArticles.map(a => a.slug)]);
  const { data: tagArticles } = await supabaseAdmin
    .from('articles')
    .select('slug, title, published_at, category, tags, cover_image, lead')
    .eq('status', 'published')
    .neq('slug', slug)
    .not('published_at', 'is', null)
    .order('published_at', { ascending: false })
    .limit(20);

  if (tagArticles) {
    for (const a of tagArticles) {
      if (relatedArticles.length >= 3) break;
      if (existingSlugs.has(a.slug)) continue;
      const aTags = (a.tags as string[]) ?? [];
      if (aTags.some(t => tags.includes(t))) {
        relatedArticles.push(a);
        existingSlugs.add(a.slug);
      }
    }
  }
}

function formatDateShort(d: string): string {
  return new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
}
---

<BaseLayout
  title={article.meta_title ?? article.title}
  description={article.meta_description ?? article.lead}
  ogImage={article.cover_image}
>
  <article class="py-8">

    <!-- Back Link -->
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 mb-8">
      <a href="/news" class="inline-flex items-center gap-2 text-sm text-[#9890a8] hover:text-[#a78bfa] transition-colors">
        <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
        </svg>
        Back to News
      </a>
    </div>

    <!-- Article Header (Centered) -->
    <header class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center mb-10">
      <div class="flex items-center justify-center gap-3 mb-5">
        <span class={`rounded-full px-3 py-1 text-xs font-medium ${categoryColors[article.category] ?? 'bg-[#55555e]/20 text-[#9890a8]'}`}>
          {categoryLabels[article.category] ?? article.category}
        </span>
        {publishedDate && <span class="text-sm text-[#4a4560]">{publishedDate}</span>}
        {article.ai_generated && (
          <span class="rounded-full bg-purple-500/20 text-purple-400 px-2.5 py-0.5 text-[10px] font-medium">AI Assisted</span>
        )}
      </div>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-white leading-tight">
        {article.title}
      </h1>
      {article.lead && (
        <p class="mt-6 text-lg sm:text-xl text-[#9890a8] leading-relaxed max-w-2xl mx-auto">
          {article.lead}
        </p>
      )}
    </header>

    <!-- Cover Image (Wider than text) -->
    {article.cover_image && (
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 mb-12">
        <div class="rounded-2xl overflow-hidden">
          <img
            src={article.cover_image}
            alt={article.title}
            class="w-full h-auto"
            loading="eager"
          />
        </div>
      </div>
    )}

    <!-- Article Body (Centered, narrower) -->
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <div
        class="prose prose-invert prose-luxury max-w-none prose-headings:text-white prose-p:text-[#9890a8] prose-p:leading-relaxed prose-a:text-[#a78bfa] prose-a:no-underline hover:prose-a:underline prose-strong:text-white prose-code:text-[#9b8fff] prose-code:bg-[#1a1a22] prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded prose-pre:bg-[#0e0c16] prose-pre:border prose-pre:border-white/6 prose-img:rounded-xl prose-blockquote:border-l-[#7c6cf0] prose-blockquote:text-[#9890a8] prose-li:text-[#9890a8]"
        set:html={article.body_html}
      />

      <!-- Related Devices -->
      {devices.length > 0 && (
        <div class="mt-10 pt-6 border-t border-white/6">
          <p class="editorial-label mb-3">Related Devices</p>
          <div class="flex flex-wrap gap-2">
            {devices.map(d => (
              <a
                href={`/devices/${d}`}
                class="rounded-full border border-[#a78bfa]/30 text-[#a78bfa] px-4 py-2 text-sm hover:bg-[#a78bfa]/10 hover:border-[#a78bfa]/50 transition-all"
              >
                {d}
              </a>
            ))}
          </div>
        </div>
      )}

      <!-- Tags (Centered) -->
      {tags.length > 0 && (
        <div class="mt-8 pt-6 border-t border-white/6 text-center">
          <div class="flex flex-wrap justify-center gap-2">
            {tags.map(tag => (
              <span class="rounded-full border border-white/10 px-3 py-1 text-xs text-[#9890a8] hover:border-[#55555e] transition-colors">
                {tag}
              </span>
            ))}
          </div>
        </div>
      )}
    </div>

    <!-- Related Articles -->
    {relatedArticles.length > 0 && (
      <section class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 mt-16">
        <div class="flex items-center gap-4 mb-6">
          <div class="metallic-line flex-1"></div>
          <span class="editorial-label">Related Articles</span>
          <div class="metallic-line flex-1"></div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          {relatedArticles.map(a => (
            <a
              href={`/news/${a.slug}`}
              class="group rounded-xl border border-white/6 bg-[#0e0c16] overflow-hidden hover:border-white/10 transition-colors"
            >
              {(a as any).cover_image ? (
                <div class="aspect-[16/9] overflow-hidden">
                  <img
                    src={(a as any).cover_image}
                    alt={a.title}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                    loading="lazy"
                  />
                </div>
              ) : (
                <div class="aspect-[16/9] bg-gradient-to-br from-[#12101a] to-[#0e0c16] flex items-center justify-center">
                  <span class="text-sm font-bold text-[#25252e]/30 text-center px-4">{a.title}</span>
                </div>
              )}
              <div class="p-4">
                <div class="flex items-center gap-2 mb-1.5">
                  <span class={`rounded-full px-2 py-0.5 text-[10px] font-medium ${categoryColors[a.category] ?? 'bg-[#55555e]/20 text-[#9890a8]'}`}>
                    {categoryLabels[a.category] ?? a.category}
                  </span>
                  <span class="text-xs text-[#4a4560]">{formatDateShort(a.published_at!)}</span>
                </div>
                <h3 class="text-sm font-bold text-white group-hover:text-[#a78bfa] transition-colors line-clamp-2">
                  {a.title}
                </h3>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- Recent Articles -->
    {(recentArticles && recentArticles.length > 0) && (
      <section class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 mt-12 mb-4">
        <div class="flex items-center gap-4 mb-6">
          <div class="metallic-line flex-1"></div>
          <span class="editorial-label">Recent News</span>
          <div class="metallic-line flex-1"></div>
        </div>

        <div class="scroll-strip flex gap-4 pb-2">
          {recentArticles.map(a => (
            <a
              href={`/news/${a.slug}`}
              class="group flex-shrink-0 w-64 rounded-xl border border-white/6 bg-[#0e0c16] overflow-hidden hover:border-white/10 transition-colors"
            >
              {(a as any).cover_image ? (
                <div class="aspect-[16/9] overflow-hidden">
                  <img
                    src={(a as any).cover_image}
                    alt={a.title}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                    loading="lazy"
                  />
                </div>
              ) : (
                <div class="aspect-[16/9] bg-gradient-to-br from-[#12101a] to-[#0e0c16] flex items-center justify-center">
                  <span class="text-xs font-bold text-[#25252e]/30 text-center px-3">{a.title}</span>
                </div>
              )}
              <div class="p-3">
                <div class="flex items-center gap-2 mb-1">
                  <span class={`rounded-full px-2 py-0.5 text-[10px] font-medium ${categoryColors[a.category] ?? 'bg-[#55555e]/20 text-[#9890a8]'}`}>
                    {categoryLabels[a.category] ?? a.category}
                  </span>
                  <span class="text-[10px] text-[#4a4560]">{formatDateShort(a.published_at!)}</span>
                </div>
                <h3 class="text-xs font-bold text-white group-hover:text-[#a78bfa] transition-colors line-clamp-2">
                  {a.title}
                </h3>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}

  </article>
</BaseLayout>
