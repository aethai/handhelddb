---
import BaseLayout from '@layouts/BaseLayout.astro';
import { supabaseAdmin } from '@lib/db/client';
import { getCached, setCache } from '@lib/cache';

const page = Math.max(1, Number(Astro.url.searchParams.get('page')) || 1);
const perPage = 12;
const offset = (page - 1) * perPage;

type NewsPageCache = {
  articles: Array<{ slug: string; title: string; lead: string | null; cover_image: string | null; category: string; tags: string[] | null; published_at: string | null; view_count: number | null }>;
  count: number;
};

const cacheKey = `news:list:${page}`;
let newsData = getCached<NewsPageCache>(cacheKey);

let articles: NewsPageCache['articles'];
let count: number;

if (newsData) {
  articles = newsData.articles;
  count = newsData.count;
} else {
  const res = await supabaseAdmin
    .from('articles')
    .select('slug, title, lead, cover_image, category, tags, published_at, view_count', { count: 'exact' })
    .eq('status', 'published')
    .not('published_at', 'is', null)
    .order('published_at', { ascending: false })
    .range(offset, offset + perPage - 1);

  articles = (res.data ?? []) as NewsPageCache['articles'];
  count = res.count ?? 0;
  setCache(cacheKey, { articles, count }, 300); // 5 minutes
}

const totalPages = Math.ceil(count / perPage);

const categoryColors: Record<string, string> = {
  device_launch: 'bg-blue-500/20 text-blue-400',
  device_update: 'bg-[#D4A574]/20 text-[#D4A574]',
  os_update: 'bg-purple-500/20 text-purple-400',
  driver_update: 'bg-indigo-500/20 text-indigo-400',
  game_patch: 'bg-orange-500/20 text-orange-400',
  game_launch: 'bg-green-500/20 text-green-400',
  sale_event: 'bg-yellow-500/20 text-yellow-400',
  performance_analysis: 'bg-[#D4A574]/20 text-[#D4A574]',
  industry: 'bg-gray-500/20 text-gray-400',
  editorial: 'bg-pink-500/20 text-pink-400',
};

const categoryLabels: Record<string, string> = {
  device_launch: 'Device Launch',
  device_update: 'Device Update',
  os_update: 'OS Update',
  driver_update: 'Driver Update',
  game_patch: 'Game Patch',
  game_launch: 'Game Launch',
  sale_event: 'Sale',
  performance_analysis: 'Analysis',
  industry: 'Industry',
  editorial: 'Editorial',
};

function formatDate(d: string): string {
  return new Date(d).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
}

// Split articles into tiers
const featured = articles.length > 0 ? articles[0] : null;
const secondary = articles.slice(1, 5); // Articles 2-5
const remaining = articles.slice(5);     // Articles 6+
---

<BaseLayout title="News" description="Handheld gaming news, device launches, firmware updates, and performance analyses.">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-12">

    <!-- Page Heading -->
    <div class="mb-10">
      <h1 class="text-4xl font-bold text-white font-heading">News</h1>
      <div class="mt-3 h-0.5 w-24 bg-gradient-to-r from-[#D4A574] to-[#DAA520]"></div>
      <p class="mt-3 text-stone-400 text-lg">Handheld gaming news, firmware updates, and performance analyses</p>
    </div>

    {(articles && articles.length > 0) ? (
      <div>
        <!-- Featured Article (Magazine Cover) -->
        {featured && (
          <a href={`/news/${featured.slug}`} class="group block mb-8 rounded-2xl overflow-hidden relative">
            {featured.cover_image ? (
              <div class="aspect-[2.5/1] overflow-hidden">
                <img
                  src={featured.cover_image}
                  alt={featured.title}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  loading="eager"
                />
              </div>
            ) : (
              <div class="aspect-[2.5/1] bg-gradient-to-br from-[#292524] to-[#1C1917] flex items-center justify-center">
                <span class="text-3xl font-heading font-bold text-stone-700/30 text-center px-12">{featured.title}</span>
              </div>
            )}
            <!-- Gradient Overlay -->
            <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/30 to-transparent"></div>
            <!-- Overlaid Content -->
            <div class="absolute bottom-0 left-0 right-0 p-6 sm:p-10">
              <div class="flex items-center gap-3 mb-3">
                <span class={`rounded-full px-2.5 py-0.5 text-xs font-medium ${categoryColors[featured.category] ?? 'bg-gray-500/20 text-gray-400'}`}>
                  {categoryLabels[featured.category] ?? featured.category}
                </span>
                <span class="text-xs text-stone-400">{formatDate(featured.published_at!)}</span>
              </div>
              <h2 class="text-2xl sm:text-3xl lg:text-4xl font-heading font-bold text-white group-hover:text-[#D4A574] transition-colors leading-tight max-w-3xl">
                {featured.title}
              </h2>
              {featured.lead && (
                <p class="mt-3 text-stone-300 text-sm sm:text-base max-w-2xl line-clamp-2">{featured.lead}</p>
              )}
            </div>
          </a>
        )}

        <!-- Secondary Articles (2-5): Asymmetric Grid -->
        {secondary.length > 0 && (
          <div class="grid grid-cols-1 md:grid-cols-5 gap-4 mb-8">
            {/* Article 2: Wide horizontal card (col-span-3) */}
            {secondary[0] && (
              <a
                href={`/news/${secondary[0].slug}`}
                class="group md:col-span-3 rounded-xl border border-[#292524] bg-[#1C1917] overflow-hidden hover:border-[#44403C] transition-colors flex flex-col sm:flex-row"
              >
                {secondary[0].cover_image ? (
                  <div class="sm:w-2/5 flex-shrink-0 overflow-hidden">
                    <img
                      src={secondary[0].cover_image}
                      alt={secondary[0].title}
                      class="w-full h-full object-cover aspect-[16/9] sm:aspect-auto group-hover:scale-105 transition-transform duration-300"
                      loading="eager"
                    />
                  </div>
                ) : (
                  <div class="sm:w-2/5 flex-shrink-0 bg-gradient-to-br from-[#292524] to-[#1C1917] flex items-center justify-center aspect-[16/9] sm:aspect-auto">
                    <span class="text-lg font-bold text-stone-700/30 text-center px-4">{secondary[0].title}</span>
                  </div>
                )}
                <div class="p-5 flex flex-col justify-center">
                  <div class="flex items-center gap-2 mb-2">
                    <span class={`rounded-full px-2 py-0.5 text-[10px] font-medium ${categoryColors[secondary[0].category] ?? 'bg-gray-500/20 text-gray-400'}`}>
                      {categoryLabels[secondary[0].category] ?? secondary[0].category}
                    </span>
                    <span class="text-xs text-stone-500">{formatDate(secondary[0].published_at!)}</span>
                  </div>
                  <h2 class="text-lg font-bold text-white group-hover:text-[#D4A574] transition-colors line-clamp-2">
                    {secondary[0].title}
                  </h2>
                  <p class="mt-2 text-sm text-stone-400 line-clamp-2">{secondary[0].lead}</p>
                </div>
              </a>
            )}

            {/* Articles 3-4: Vertical stacked cards (col-span-2) */}
            {secondary.length > 1 && (
              <div class="md:col-span-2 flex flex-col gap-4">
                {secondary.slice(1).map((article, i) => (
                  <a
                    href={`/news/${article.slug}`}
                    class="group flex-1 rounded-xl border border-[#292524] bg-[#1C1917] overflow-hidden hover:border-[#44403C] transition-colors"
                  >
                    {article.cover_image ? (
                      <div class="aspect-[16/9] overflow-hidden">
                        <img
                          src={article.cover_image}
                          alt={article.title}
                          class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                          loading={i < 2 ? 'eager' : 'lazy'}
                        />
                      </div>
                    ) : (
                      <div class="aspect-[16/9] bg-gradient-to-br from-[#292524] to-[#1C1917] flex items-center justify-center">
                        <span class="text-sm font-bold text-stone-700/30 text-center px-4">{article.title}</span>
                      </div>
                    )}
                    <div class="p-4">
                      <div class="flex items-center gap-2 mb-1.5">
                        <span class={`rounded-full px-2 py-0.5 text-[10px] font-medium ${categoryColors[article.category] ?? 'bg-gray-500/20 text-gray-400'}`}>
                          {categoryLabels[article.category] ?? article.category}
                        </span>
                        <span class="text-xs text-stone-500">{formatDate(article.published_at!)}</span>
                      </div>
                      <h2 class="text-sm font-bold text-white group-hover:text-[#D4A574] transition-colors line-clamp-2">
                        {article.title}
                      </h2>
                    </div>
                  </a>
                ))}
              </div>
            )}
          </div>
        )}

        <!-- Remaining Articles (6+): Standard 3-Column Grid -->
        {remaining.length > 0 && (
          <div>
            <div class="flex items-center gap-4 mb-6">
              <div class="metallic-line flex-1"></div>
              <span class="editorial-label">More Stories</span>
              <div class="metallic-line flex-1"></div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
              {remaining.map((article) => (
                <a
                  href={`/news/${article.slug}`}
                  class="group rounded-xl border border-[#292524] bg-[#1C1917] overflow-hidden hover:border-[#44403C] transition-colors"
                >
                  {article.cover_image ? (
                    <div class="aspect-[16/9] overflow-hidden">
                      <img
                        src={article.cover_image}
                        alt={article.title}
                        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                        loading="lazy"
                      />
                    </div>
                  ) : (
                    <div class="aspect-[16/9] bg-gradient-to-br from-[#292524] to-[#1C1917] flex items-center justify-center">
                      <span class="text-sm font-bold text-stone-700/30 text-center px-4">{article.title}</span>
                    </div>
                  )}
                  <div class="p-4">
                    <div class="flex items-center gap-2 mb-1.5">
                      <span class={`rounded-full px-2 py-0.5 text-[10px] font-medium ${categoryColors[article.category] ?? 'bg-gray-500/20 text-gray-400'}`}>
                        {categoryLabels[article.category] ?? article.category}
                      </span>
                      <span class="text-xs text-stone-500">{formatDate(article.published_at!)}</span>
                    </div>
                    <h2 class="text-sm font-bold text-white group-hover:text-[#D4A574] transition-colors line-clamp-2">
                      {article.title}
                    </h2>
                    {article.lead && (
                      <p class="mt-1.5 text-xs text-stone-400 line-clamp-2">{article.lead}</p>
                    )}
                  </div>
                </a>
              ))}
            </div>
          </div>
        )}
      </div>
    ) : (
      <div class="section-atmospheric rounded-2xl border border-[#292524] p-14 text-center">
        <div class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-2xl bg-[#292524]">
          <svg class="h-8 w-8 text-stone-600" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 7.5h1.5m-1.5 3h1.5m-7.5 3h7.5m-7.5 3h7.5m3-9h3.375c.621 0 1.125.504 1.125 1.125V18a2.25 2.25 0 01-2.25 2.25M16.5 7.5V18a2.25 2.25 0 002.25 2.25M16.5 7.5V4.875c0-.621-.504-1.125-1.125-1.125H4.125C3.504 3.75 3 4.254 3 4.875V18a2.25 2.25 0 002.25 2.25h13.5M6 7.5h3v3H6v-3z" />
          </svg>
        </div>
        <h3 class="text-xl font-heading font-semibold text-white mb-2">Coming soon</h3>
        <p class="text-stone-400">We're working on our first articles. Check back soon!</p>
      </div>
    )}

    <!-- Pagination -->
    {totalPages > 1 && (
      <nav class="mt-12 flex items-center justify-center gap-3">
        {page > 1 && (
          <a
            href={`/news?page=${page - 1}`}
            class="rounded-full border border-[#44403C] bg-[#1C1917] px-5 py-2.5 text-sm text-stone-300 hover:border-[#D4A574]/50 hover:text-white transition-colors"
          >
            &larr; Previous
          </a>
        )}
        <span class="text-sm text-stone-500 font-mono">
          {page} / {totalPages}
        </span>
        {page < totalPages && (
          <a
            href={`/news?page=${page + 1}`}
            class="rounded-full border border-[#44403C] bg-[#1C1917] px-5 py-2.5 text-sm text-stone-300 hover:border-[#D4A574]/50 hover:text-white transition-colors"
          >
            Next &rarr;
          </a>
        )}
      </nav>
    )}
  </div>
</BaseLayout>
