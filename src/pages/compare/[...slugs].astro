---
import BaseLayout from '@layouts/BaseLayout.astro';
import PerformanceBadge from '@components/astro/PerformanceBadge.astro';

const { slugs } = Astro.params;
const deviceSlugs = slugs?.split('/') ?? ['steam-deck-oled', 'rog-ally-x'];

// ─── Mock comparison data ───
const devicesData: Record<string, any> = {
  'steam-deck-oled': {
    name: 'Steam Deck OLED', manufacturer: 'Valve',
    chip: 'AMD Van Gogh', gpu: 'RDNA 2, 8 CUs', ram: '16 GB LPDDR5', storage: '512 GB',
    screen: '7.4" HDR OLED', resolution: '1280x800', battery: '50 Wh',
    tdp: '3-15W', weight: '640g', os: 'SteamOS 3.6', price: '$549',
    tested: 487, at60: 142, at40: 198, avgBattery: '2.4h',
  },
  'rog-ally-x': {
    name: 'ROG Ally X', manufacturer: 'ASUS',
    chip: 'Ryzen Z1 Extreme', gpu: 'RDNA 3, 12 CUs', ram: '24 GB LPDDR5X', storage: '1 TB',
    screen: '7.0" IPS', resolution: '1920x1080', battery: '80 Wh',
    tdp: '9-30W', weight: '678g', os: 'Windows 11', price: '$799',
    tested: 312, at60: 187, at40: 89, avgBattery: '2.1h',
  },
  'legion-go': {
    name: 'Legion Go', manufacturer: 'Lenovo',
    chip: 'Ryzen Z1 Extreme', gpu: 'RDNA 3, 12 CUs', ram: '16 GB LPDDR5X', storage: '512 GB',
    screen: '8.8" IPS', resolution: '2560x1600', battery: '49.2 Wh',
    tdp: '8-30W', weight: '854g', os: 'Windows 11', price: '$699',
    tested: 198, at60: 95, at40: 68, avgBattery: '1.6h',
  },
};

const selected = deviceSlugs.map(s => devicesData[s]).filter(Boolean);
if (selected.length < 2) {
  selected.push(devicesData['steam-deck-oled'], devicesData['rog-ally-x']);
}
const [a, b] = selected;

const sharedGames = [
  { name: 'Elden Ring', fpsA: 40, fpsB: 50, battA: '2.1h', battB: '2.3h' },
  { name: 'Cyberpunk 2077', fpsA: 35, fpsB: 48, battA: '1.8h', battB: '1.9h' },
  { name: 'Hades II', fpsA: 60, fpsB: 60, battA: '3.5h', battB: '3.8h' },
  { name: "Baldur's Gate 3", fpsA: 38, fpsB: 48, battA: '2.0h', battB: '2.1h' },
  { name: 'Stardew Valley', fpsA: 60, fpsB: 60, battA: '6.0h', battB: '5.5h' },
  { name: 'God of War Ragnarok', fpsA: 34, fpsB: 52, battA: '1.7h', battB: '1.5h' },
  { name: 'Helldivers 2', fpsA: 32, fpsB: 45, battA: '1.6h', battB: '1.7h' },
  { name: 'Palworld', fpsA: 40, fpsB: 50, battA: '2.2h', battB: '2.0h' },
];

const specs = [
  { label: 'Chip', a: a.chip, b: b.chip },
  { label: 'GPU', a: a.gpu, b: b.gpu },
  { label: 'RAM', a: a.ram, b: b.ram },
  { label: 'Storage', a: a.storage, b: b.storage },
  { label: 'Screen', a: a.screen, b: b.screen },
  { label: 'Resolution', a: a.resolution, b: b.resolution },
  { label: 'Battery', a: a.battery, b: b.battery },
  { label: 'TDP Range', a: a.tdp, b: b.tdp },
  { label: 'Weight', a: a.weight, b: b.weight },
  { label: 'OS', a: a.os, b: b.os },
  { label: 'Price', a: a.price, b: b.price },
];
---

<BaseLayout title={`${a.name} vs ${b.name} — Compare Handhelds`} description={`Side-by-side comparison of ${a.name} and ${b.name}. Specs, game performance, FPS benchmarks, and battery life.`}>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8">
    <!-- Breadcrumb -->
    <nav class="mb-4 text-sm text-gray-500">
      <a href="/" class="hover:text-white transition-colors">Home</a>
      <span class="mx-2">/</span>
      <a href="/compare" class="hover:text-white transition-colors">Compare</a>
      <span class="mx-2">/</span>
      <span class="text-gray-300">{a.name} vs {b.name}</span>
    </nav>

    <h1 class="text-3xl font-bold text-white mb-2">
      {a.name} <span class="text-gray-600">vs</span> {b.name}
    </h1>
    <p class="text-gray-400 mb-8">Side-by-side performance comparison across {sharedGames.length} shared tested games</p>

    <!-- Device selector -->
    <div class="grid grid-cols-2 gap-4 mb-8">
      <div class="rounded-xl border-2 border-emerald-500/30 bg-gray-900 p-5 text-center">
        <p class="text-xs text-emerald-400 uppercase tracking-wider">{a.manufacturer}</p>
        <h2 class="text-xl font-bold text-white mt-1">{a.name}</h2>
        <div class="mt-3 flex justify-center gap-4 text-sm text-gray-400">
          <span>{a.tested} games</span>
          <span class="text-gray-700">|</span>
          <span>{a.price}</span>
        </div>
      </div>
      <div class="rounded-xl border-2 border-blue-500/30 bg-gray-900 p-5 text-center">
        <p class="text-xs text-blue-400 uppercase tracking-wider">{b.manufacturer}</p>
        <h2 class="text-xl font-bold text-white mt-1">{b.name}</h2>
        <div class="mt-3 flex justify-center gap-4 text-sm text-gray-400">
          <span>{b.tested} games</span>
          <span class="text-gray-700">|</span>
          <span>{b.price}</span>
        </div>
      </div>
    </div>

    <!-- Spec Comparison -->
    <div class="rounded-xl border border-gray-800 bg-gray-900 overflow-hidden mb-8">
      <div class="px-5 py-4 border-b border-gray-800">
        <h2 class="text-lg font-bold text-white">Specifications</h2>
      </div>
      <div class="divide-y divide-gray-800">
        {specs.map((s) => (
          <div class="grid grid-cols-3 px-5 py-3 text-sm">
            <div class="text-gray-500 font-medium">{s.label}</div>
            <div class="text-center text-gray-300">{s.a}</div>
            <div class="text-center text-gray-300">{s.b}</div>
          </div>
        ))}
      </div>
    </div>

    <!-- Performance Stats Side-by-Side -->
    <div class="grid grid-cols-2 gap-4 mb-8">
      <div class="rounded-xl border border-gray-800 bg-gray-900 p-5">
        <h3 class="text-sm font-semibold text-gray-400 mb-3">Performance Summary</h3>
        <div class="grid grid-cols-2 gap-3">
          <div class="rounded-lg bg-gray-800 p-3 text-center">
            <p class="text-xl font-bold text-green-400">{a.at60}</p>
            <p class="text-xs text-gray-500">60fps games</p>
          </div>
          <div class="rounded-lg bg-gray-800 p-3 text-center">
            <p class="text-xl font-bold text-emerald-400">{a.at40}</p>
            <p class="text-xs text-gray-500">40fps games</p>
          </div>
        </div>
        <p class="mt-3 text-sm text-gray-400 text-center">Avg battery: <span class="text-white font-medium">{a.avgBattery}</span></p>
      </div>
      <div class="rounded-xl border border-gray-800 bg-gray-900 p-5">
        <h3 class="text-sm font-semibold text-gray-400 mb-3">Performance Summary</h3>
        <div class="grid grid-cols-2 gap-3">
          <div class="rounded-lg bg-gray-800 p-3 text-center">
            <p class="text-xl font-bold text-green-400">{b.at60}</p>
            <p class="text-xs text-gray-500">60fps games</p>
          </div>
          <div class="rounded-lg bg-gray-800 p-3 text-center">
            <p class="text-xl font-bold text-emerald-400">{b.at40}</p>
            <p class="text-xs text-gray-500">40fps games</p>
          </div>
        </div>
        <p class="mt-3 text-sm text-gray-400 text-center">Avg battery: <span class="text-white font-medium">{b.avgBattery}</span></p>
      </div>
    </div>

    <!-- Game-by-Game Comparison -->
    <div class="rounded-xl border border-gray-800 bg-gray-900 overflow-hidden">
      <div class="px-5 py-4 border-b border-gray-800">
        <h2 class="text-lg font-bold text-white">Game-by-Game Comparison</h2>
        <p class="text-xs text-gray-500 mt-1">Balanced profile, {sharedGames.length} games tested on both devices</p>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-gray-800 text-gray-500">
              <th class="py-3 px-4 text-left font-medium">Game</th>
              <th class="py-3 px-3 text-center font-medium">
                <span class="text-emerald-400">{a.name.replace('Steam Deck ', 'Deck ')}</span>
              </th>
              <th class="py-3 px-3 text-center font-medium">
                <span class="text-blue-400">{b.name.replace('ASUS ', '')}</span>
              </th>
              <th class="py-3 px-3 text-center font-medium">Diff</th>
              <th class="py-3 px-3 text-center font-medium">Battery A</th>
              <th class="py-3 px-3 text-center font-medium">Battery B</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-800/50">
            {sharedGames.map((g) => {
              const diff = g.fpsB - g.fpsA;
              return (
                <tr class="hover:bg-gray-800/30 transition-colors">
                  <td class="py-3 px-4 font-medium text-white">{g.name}</td>
                  <td class="py-3 px-3 text-center"><PerformanceBadge fps={g.fpsA} size="sm" /></td>
                  <td class="py-3 px-3 text-center"><PerformanceBadge fps={g.fpsB} size="sm" /></td>
                  <td class="py-3 px-3 text-center">
                    <span class={diff > 0 ? 'text-blue-400' : diff < 0 ? 'text-emerald-400' : 'text-gray-500'}>
                      {diff > 0 ? `+${diff}` : diff === 0 ? '=' : diff}
                    </span>
                  </td>
                  <td class="py-3 px-3 text-center text-gray-400">{g.battA}</td>
                  <td class="py-3 px-3 text-center text-gray-400">{g.battB}</td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </div>

    <!-- Verdict -->
    <div class="mt-8 rounded-xl border border-gray-800 bg-gray-900 p-6">
      <h2 class="text-lg font-bold text-white mb-4">Summary</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
          <h3 class="font-semibold text-emerald-400 mb-2">{a.name} wins at:</h3>
          <ul class="space-y-1 text-sm text-gray-400">
            <li>Better battery life in most games</li>
            <li>Lighter weight (640g vs {b.weight})</li>
            <li>HDR OLED display</li>
            <li>SteamOS + ProtonDB ecosystem</li>
            <li>Lower price ({a.price})</li>
          </ul>
        </div>
        <div>
          <h3 class="font-semibold text-blue-400 mb-2">{b.name} wins at:</h3>
          <ul class="space-y-1 text-sm text-gray-400">
            <li>Higher FPS in demanding games (+10-15fps avg)</li>
            <li>More RAM (24GB vs 16GB)</li>
            <li>Higher native resolution (1080p)</li>
            <li>Windows game compatibility</li>
            <li>Larger battery capacity (80Wh)</li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
