---
import BaseLayout from '@layouts/BaseLayout.astro';
import GameCard from '@components/astro/GameCard.astro';
import GameCardFeatured from '@components/astro/GameCardFeatured.astro';
import SectionHeader from '@components/astro/SectionHeader.astro';
import SearchBar from '@components/react/SearchBar';
import { supabaseAdmin } from '@lib/db/client';

// ─── Fetch data ───
const [devicesRes, gamesRes, gameCountRes, deviceCountRes] = await Promise.all([
  supabaseAdmin
    .from('devices')
    .select('slug, name, manufacturer, screen_size, battery_wh, chip, image, msrp_usd, is_active')
    .eq('is_active', true)
    .order('name'),
  supabaseAdmin
    .from('games')
    .select('slug, name, header_image, genres, deck_compatibility')
    .not('header_image', 'is', null)
    .order('metacritic_score', { ascending: false, nullsFirst: false })
    .limit(5),
  supabaseAdmin.from('games').select('*', { count: 'exact', head: true }),
  supabaseAdmin.from('devices').select('*', { count: 'exact', head: true }),
]);

const devices = (devicesRes.data ?? []).map(d => ({
  slug: d.slug,
  name: d.name,
  manufacturer: d.manufacturer,
  screenSize: d.screen_size,
  batteryWh: d.battery_wh,
  chip: d.chip,
  image: d.image,
  msrpUsd: d.msrp_usd,
}));

const games = (gamesRes.data ?? []).map(g => ({
  slug: g.slug,
  name: g.name,
  headerImage: g.header_image,
  genres: (g.genres as string[]) ?? [],
  deckCompatibility: g.deck_compatibility,
}));

const gameCount = gameCountRes.count ?? 0;
const deviceCount = deviceCountRes.count ?? 0;
const featuredGame = games[0];
const restGames = games.slice(1);
---

<BaseLayout title="Handheld GameDB — Performance Database for Handheld Gaming">

  <!-- ══════ HERO ══════ -->
  <section class="relative min-h-[70vh] flex items-center overflow-hidden">
    <!-- Atmospheric background -->
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_20%_50%,rgba(96,165,250,0.06),transparent_60%),radial-gradient(ellipse_at_80%_80%,rgba(96,165,250,0.03),transparent_50%)]"></div>

    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-20 w-full">
      <div class="grid grid-cols-1 lg:grid-cols-5 gap-8 lg:gap-12 items-center">

        <!-- Left: Editorial text -->
        <div class="lg:col-span-3">
          <p class="editorial-label mb-4">Performance Database</p>

          <h1 class="text-4xl sm:text-5xl lg:text-6xl xl:text-7xl font-bold text-[#E8EAED] tracking-tight leading-[0.95]">
            Find the <span class="text-gradient-copper">best settings</span> for every game on your handheld
          </h1>

          <p class="mt-6 max-w-lg text-lg text-[#9CA3AF] leading-relaxed">
            Community-driven performance data for Steam Deck, ROG Ally, Legion Go and more. Optimal settings, FPS benchmarks, battery life.
          </p>

          <!-- Search Bar -->
          <div class="mt-8 max-w-xl">
            <SearchBar client:load variant="hero" placeholder="Search games... (e.g. Elden Ring, Cyberpunk 2077)" />
          </div>

          <!-- Inline Stats -->
          <div class="mt-10 flex items-center gap-8 sm:gap-12">
            <div>
              <span class="text-3xl sm:text-4xl font-bold text-[#60A5FA] font-mono">{gameCount.toLocaleString()}</span>
              <span class="block text-xs text-[#6B7280] mt-1">Games</span>
            </div>
            <div class="h-8 w-px bg-[#2A2D35]"></div>
            <div>
              <span class="text-3xl sm:text-4xl font-bold text-[#60A5FA] font-mono">{deviceCount}</span>
              <span class="block text-xs text-[#6B7280] mt-1">Devices</span>
            </div>
            <div class="h-8 w-px bg-[#2A2D35]"></div>
            <div>
              <span class="text-3xl sm:text-4xl font-bold text-[#60A5FA] font-mono">0</span>
              <span class="block text-xs text-[#6B7280] mt-1">Reports</span>
            </div>
          </div>
        </div>

        <!-- Right: Featured game card -->
        {featuredGame && (
          <div class="lg:col-span-2 hidden lg:block">
            <div class="relative">
              <div class="absolute -inset-4 bg-[radial-gradient(circle,rgba(96,165,250,0.04),transparent_70%)]"></div>
              <div class="relative rounded-xl overflow-hidden border border-[#2A2D35] shadow-elevated aspect-[460/400]">
                <GameCardFeatured {...featuredGame} />
              </div>
              <p class="text-center mt-3 text-xs text-[#4B5563]">Featured Game</p>
            </div>
          </div>
        )}
      </div>
    </div>
  </section>

  <!-- ══════ TOP GAMES — BENTO GRID ══════ -->
  {games.length > 0 && (
    <section class="py-14 section-spotlight">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <SectionHeader title="Top Games" subtitle="Highest rated games in the database" href="/games" />

        <div class="grid grid-cols-2 lg:grid-cols-4 grid-rows-2 gap-3">
          <!-- Featured: 2col x 2row -->
          {featuredGame && (
            <div class="col-span-2 row-span-2">
              <GameCardFeatured {...featuredGame} />
            </div>
          )}
          <!-- Remaining 4 smaller cards -->
          {restGames.map((game) => (
            <GameCard {...game} />
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ══════ DEVICES — HORIZONTAL SCROLL ══════ -->
  {devices.length > 0 && (
    <section class="py-14">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <SectionHeader title="Pick Your Device" subtitle="Select your handheld to see compatible games" href="/devices" linkText="All devices" />
      </div>
      <div class="mx-auto max-w-7xl pl-4 sm:pl-6 lg:pl-8">
        <div class="flex gap-4 scroll-strip snap-x snap-mandatory pb-4 pr-4">
          {devices.map((device) => (
            <a
              href={`/devices/${device.slug}`}
              class="luxury-card flex-shrink-0 w-64 sm:w-72 snap-center rounded-xl border border-[#2A2D35] bg-[#16181D] overflow-hidden group"
            >
              <div class="h-36 bg-[#1E2128] flex items-center justify-center p-4 overflow-hidden">
                {device.image ? (
                  <img src={device.image} alt={device.name} class="h-full w-full object-contain transition-transform group-hover:scale-105" loading="lazy" />
                ) : (
                  <svg class="h-16 w-16 text-[#3A3D45]" fill="none" stroke="currentColor" stroke-width="1" viewBox="0 0 24 24">
                    <rect x="2" y="6" width="20" height="12" rx="3" />
                  </svg>
                )}
              </div>
              <div class="p-4">
                <p class="text-[10px] text-[#6B7280]">{device.manufacturer}</p>
                <p class="text-lg font-semibold text-white group-hover:text-[#60A5FA] transition-colors">{device.name}</p>
                <div class="mt-2 flex items-center gap-3 text-xs text-[#6B7280]">
                  <span>{device.chip}</span>
                  <span class="text-[#2A2D35]">·</span>
                  <span>{device.batteryWh}Wh</span>
                  {device.msrpUsd && (
                    <>
                      <span class="text-[#2A2D35]">·</span>
                      <span>${device.msrpUsd}</span>
                    </>
                  )}
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ══════ HOW IT WORKS — ASYMMETRIC ══════ -->
  <section class="py-16 section-atmospheric">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">

        <!-- Left: Pull quote -->
        <div>
          <p class="editorial-label mb-6">How It Works</p>
          <blockquote class="pull-quote">
            The community tells the truth. Real performance data from real gamers, not marketing specs.
          </blockquote>
          <p class="mt-6 text-[#9CA3AF] leading-relaxed max-w-md">
            Every report is submitted by a real user, voted on by the community, and aggregated into consensus recommendations you can trust.
          </p>
        </div>

        <!-- Right: Numbered steps -->
        <div class="space-y-8">
          <div class="flex gap-5">
            <span class="step-number">01</span>
            <div>
              <h3 class="text-lg font-semibold text-white">Search Your Game</h3>
              <p class="mt-1 text-sm text-[#9CA3AF] leading-relaxed">
                Instant search across {gameCount.toLocaleString()}+ games. Filter by device, genre, or compatibility.
              </p>
            </div>
          </div>
          <div class="flex gap-5">
            <span class="step-number">02</span>
            <div>
              <h3 class="text-lg font-semibold text-white">Get Best Settings</h3>
              <p class="mt-1 text-sm text-[#9CA3AF] leading-relaxed">
                3 TDP profiles per game: Battery Saver, Balanced, Performance. With FPS, thermal, and battery data.
              </p>
            </div>
          </div>
          <div class="flex gap-5">
            <span class="step-number">03</span>
            <div>
              <h3 class="text-lg font-semibold text-white">Share Your Results</h3>
              <p class="mt-1 text-sm text-[#9CA3AF] leading-relaxed">
                Submit performance reports, earn points, climb the leaderboard. Every report helps the community.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════ CTA — SPLIT ══════ -->
  <section class="py-0">
    <div class="grid grid-cols-1 lg:grid-cols-2 min-h-[300px]">
      <!-- Left: atmospheric -->
      <div class="flex items-center justify-center p-12 lg:p-16 relative overflow-hidden">
        <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,rgba(96,165,250,0.03),transparent_70%)]"></div>
        <div class="relative text-center lg:text-right">
          <h2 class="text-4xl sm:text-5xl font-bold text-white leading-tight">
            Got a<br />handheld?
          </h2>
          <p class="mt-4 text-[#6B7280] text-lg">
            Your data matters to the community.
          </p>
        </div>
      </div>

      <!-- Right: accent tinted -->
      <div class="flex items-center justify-center p-12 lg:p-16 bg-gradient-to-br from-[#60A5FA]/5 to-[#3B82F6]/3 border-l border-[#2A2D35]">
        <div class="text-center lg:text-left">
          <p class="text-[#9CA3AF] mb-6 max-w-sm">
            Every performance report helps thousands of gamers optimize their experience. Be one of the first testers.
          </p>
          <div class="flex flex-col sm:flex-row gap-3 justify-center lg:justify-start">
            <a
              href="/report/new"
              class="inline-flex items-center justify-center gap-2 rounded-xl bg-[#60A5FA] px-8 py-3.5 text-sm font-semibold text-[#0F1115] hover:bg-[#93C5FD] transition-colors"
            >
              <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
              </svg>
              Submit a Report
            </a>
            <a
              href="/auth/login"
              class="inline-flex items-center justify-center gap-2 rounded-xl border border-[#3A3D45] px-8 py-3.5 text-sm font-semibold text-[#9CA3AF] hover:border-[#60A5FA] hover:text-white transition-colors"
            >
              Sign in with Steam
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>
