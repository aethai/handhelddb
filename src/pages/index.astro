---
import BaseLayout from '@layouts/BaseLayout.astro';
import SearchBar from '@components/react/SearchBar';
import SectionHeader from '@components/astro/SectionHeader.astro';
import { supabaseAdmin } from '@lib/db/client';
import { getCached, setCache } from '@lib/cache';

// ─── Cached homepage data (2 min TTL) ───
const CACHE_KEY = 'homepage:data';
let _cached = getCached<any>(CACHE_KEY);

if (!_cached) {
const [
  devicesRes, topGamesRes, gameCountRes, deviceCountRes,
  reportCountRes, articlesRes, trendingRes, userCountRes,
] = await Promise.all([
  supabaseAdmin
    .from('devices')
    .select('id, slug, name, manufacturer, chip, battery_wh, msrp_usd')
    .eq('is_active', true)
    .order('name'),
  supabaseAdmin
    .from('games')
    .select('slug, name, header_image, genres, metacritic_score')
    .not('header_image', 'is', null)
    .not('metacritic_score', 'is', null)
    .order('metacritic_score', { ascending: false, nullsFirst: false })
    .limit(8),
  supabaseAdmin.from('games').select('*', { count: 'exact', head: true }),
  supabaseAdmin.from('devices').select('*', { count: 'exact', head: true }).eq('is_active', true),
  supabaseAdmin.from('performance_reports').select('*', { count: 'exact', head: true }),
  supabaseAdmin
    .from('articles')
    .select('slug, title, lead, category, published_at, cover_image')
    .eq('status', 'published')
    .not('published_at', 'is', null)
    .order('published_at', { ascending: false })
    .limit(4),
  supabaseAdmin
    .from('performance_reports')
    .select('fps_avg, graphics_preset, resolution, overall_rating, created_at, estimated_battery, games(name, slug, header_image), devices(name)')
    .eq('moderation_status', 'approved')
    .order('created_at', { ascending: false })
    .limit(12),
  supabaseAdmin.from('users').select('*', { count: 'exact', head: true }),
]);

const gameCount = gameCountRes.count ?? 0;
const deviceCount = deviceCountRes.count ?? 0;
const reportCount = reportCountRes.count ?? 0;
const userCount = userCountRes.count ?? 0;

const devices = (devicesRes.data ?? []).map(d => ({
  slug: d.slug, name: d.name, manufacturer: d.manufacturer,
  chip: d.chip, batteryWh: d.battery_wh, msrpUsd: d.msrp_usd,
}));

const topGames = (topGamesRes.data ?? []).slice(0, 8).map(g => ({
  slug: g.slug, name: g.name, headerImage: g.header_image,
  genres: ((g.genres as string[]) ?? []).slice(0, 2),
  metacritic: g.metacritic_score,
}));

const articles = (articlesRes.data ?? []).map(a => ({
  slug: a.slug, title: a.title, lead: a.lead, category: a.category,
  publishedAt: a.published_at ? new Date(a.published_at) : null,
  coverImage: a.cover_image,
}));

// Live feed — recent reports
const seenGames = new Set<string>();
const liveFeed = (trendingRes.data ?? [])
  .filter(r => {
    const name = (r.games as any)?.name;
    if (!name || seenGames.has(name)) return false;
    seenGames.add(name);
    return true;
  })
  .slice(0, 8)
  .map(r => {
    const fps = Math.round(r.fps_avg ?? 0);
    const diffMin = Math.round((Date.now() - new Date(r.created_at).getTime()) / 60000);
    let timeAgo: string;
    if (diffMin < 1) timeAgo = 'now';
    else if (diffMin < 60) timeAgo = `${diffMin}m`;
    else if (diffMin < 1440) timeAgo = `${Math.round(diffMin / 60)}h`;
    else timeAgo = `${Math.round(diffMin / 1440)}d`;
    return {
      name: (r.games as any).name,
      slug: (r.games as any).slug,
      thumb: (r.games as any)?.header_image ?? null,
      device: (r.devices as any)?.name?.replace('ASUS ', '').replace('Lenovo ', '') ?? '',
      fps,
      preset: r.graphics_preset ?? '—',
      battery: r.estimated_battery ? `~${r.estimated_battery.toFixed(1)}h` : '—',
      timeAgo,
    };
  });

  _cached = { gameCount, deviceCount, reportCount, userCount, devices, topGames, articles, liveFeed };
  setCache(CACHE_KEY, _cached, 120);
}

const { gameCount, deviceCount, reportCount, userCount, devices, topGames, articles, liveFeed } = _cached;

// Helpers
const fmtDate = (d: Date | null) => d ? d.toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) : '';
const categoryTag: Record<string, string> = {
  game_launch: 'EDITORIAL', game_patch: 'UPDATE', os_update: 'UPDATE',
  performance_analysis: 'EDITORIAL', device_launch: 'UPDATE',
  editorial: 'EDITORIAL', sale_event: 'GUIDE',
};

const featuredDevices = [
  { name: 'Deck', slug: 'steam-deck-oled' },
  { name: 'Ally', slug: 'rog-ally' },
  { name: 'Ally X', slug: 'rog-ally-x' },
  { name: 'Legion Go', slug: 'legion-go' },
  { name: 'Claw 8', slug: 'msi-claw-8-ai-plus' },
].filter(fd => devices.some(d => d.slug === fd.slug));
const extraDeviceCount = Math.max(0, (devices.length) - featuredDevices.length);

// Milestone for CTA
const milestones = [50, 100, 250, 500, 1000, 2000, 5000, 10000, 25000, 50000];
const nextMilestone = milestones.find(m => m > reportCount) ?? milestones[milestones.length - 1];
const prevMilestone = milestones[milestones.indexOf(nextMilestone) - 1] ?? 0;
const ctaPct = Math.min(((reportCount - prevMilestone) / (nextMilestone - prevMilestone)) * 100, 100);

// Manufacturer logo mapping
const mfrLogo: Record<string, string> = {
  'Valve': '/img/devices/steam.svg',
  'ASUS': '/img/devices/rog.svg',
  'Lenovo': '/img/devices/lenovo.svg',
  'MSI': '/img/devices/msi.svg',
  'Ayaneo': '/img/devices/ayaneo.svg',
  'GPD': '/img/devices/gpd.svg',
  'Nintendo': '/img/devices/nintendo.svg',
};

// Schema.org
const siteUrl = import.meta.env.PUBLIC_SITE_URL ?? 'https://handheldgamedb.com';
const schemaWebSite = {
  '@context': 'https://schema.org', '@type': 'WebSite',
  name: 'HandheldDB', url: siteUrl,
  description: `Performance database for handheld gaming. ${gameCount.toLocaleString()} games, ${deviceCount} devices, ${reportCount.toLocaleString()} community reports.`,
  potentialAction: { '@type': 'SearchAction', target: `${siteUrl}/games?q={search_term_string}`, 'query-input': 'required name=search_term_string' },
};
---

<BaseLayout title="HandheldDB — Does it run on your handheld?" description={`The handheld gaming performance database. ${gameCount.toLocaleString()} games tested across ${deviceCount} devices with ${reportCount.toLocaleString()} community reports.`}>

<script type="application/ld+json" set:html={JSON.stringify(schemaWebSite)} />

<div class="hp-wrap">
  <div class="hp-scanlines" aria-hidden="true"></div>

  <!-- ══════ 1. COMMAND CENTER (Hero) ══════ -->
  <section class="hp-hero">
    <div class="hp-hero-glow"></div>
    <div class="hp-hero-grid-bg"></div>
    <div class="hp-hero-inner">
      <div class="hp-hero-content">
        <p class="hp-hero-eyebrow">COMMUNITY-POWERED PERFORMANCE DATABASE</p>
        <h1 class="hp-hero-title">
          DOES IT RUN<br/>ON YOUR<br/><span class="hp-hero-accent">HANDHELD?</span>
        </h1>
        <p class="hp-hero-subtitle">Real FPS data from real devices. Find out before you buy.</p>

        <div class="hp-hero-search">
          <SearchBar client:load variant="hero" placeholder={`Search ${gameCount.toLocaleString()} games...`} />
        </div>

        <div class="hp-hero-stats">
          <div class="hp-hero-stat">
            <svg class="hp-stat-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="6" width="20" height="12" rx="2"/><path d="M6 12h4m-2-2v4m8-1h.01M18 11h.01"/></svg>
            <span class="hp-hero-stat-val">{gameCount.toLocaleString()}</span>
            <span class="hp-hero-stat-lbl">GAMES</span>
          </div>
          <div class="hp-hero-stat-sep"></div>
          <div class="hp-hero-stat">
            <svg class="hp-stat-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
            <span class="hp-hero-stat-val">{reportCount.toLocaleString()}</span>
            <span class="hp-hero-stat-lbl">REPORTS</span>
          </div>
          <div class="hp-hero-stat-sep"></div>
          <div class="hp-hero-stat">
            <svg class="hp-stat-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="2" width="14" height="20" rx="2"/><line x1="12" y1="18" x2="12" y2="18.01"/></svg>
            <span class="hp-hero-stat-val">{deviceCount}</span>
            <span class="hp-hero-stat-lbl">DEVICES</span>
          </div>
          {userCount > 0 && (
            <>
              <div class="hp-hero-stat-sep"></div>
              <div class="hp-hero-stat">
                <svg class="hp-stat-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                <span class="hp-hero-stat-val">{userCount.toLocaleString()}</span>
                <span class="hp-hero-stat-lbl">USERS</span>
              </div>
            </>
          )}
        </div>

        <div class="hp-hero-devices">
          {featuredDevices.map(d => (
            <a href={`/devices/${d.slug}`} class="hp-hero-device">{d.name}</a>
          ))}
          {extraDeviceCount > 0 && (
            <a href="/devices" class="hp-hero-device hp-hero-device-more">+{extraDeviceCount} more</a>
          )}
        </div>
      </div>

      {liveFeed.length > 0 && (
        <div class="hp-hero-visual">
          <div class="hp-widget">
            <div class="hp-widget-head">
              <span class="hp-widget-label">LATEST BENCHMARKS</span>
              <span class="hp-widget-live"><span class="hp-widget-dot"></span> LIVE</span>
            </div>
            {liveFeed.slice(0, 4).map(r => {
              const cls = r.fps >= 55 ? 'fps-green' : r.fps >= 40 ? 'fps-yellow' : r.fps >= 30 ? 'fps-orange' : 'fps-red';
              return (
                <div class="hp-widget-row">
                  <div class="hp-widget-info">
                    <span class="hp-widget-game">{r.name}</span>
                    <span class="hp-widget-device">{r.device}</span>
                  </div>
                  <span class={`hp-widget-fps ${cls}`}>{r.fps}<span class="hp-fps-unit">fps</span></span>
                </div>
              );
            })}
          </div>
        </div>
      )}
    </div>
  </section>

  <!-- ══════ LIVE TICKER ══════ -->
  {liveFeed.length > 0 && (
    <div class="hp-ticker" aria-hidden="true">
      <div class="hp-ticker-track">
        {[...liveFeed, ...liveFeed, ...liveFeed].map(r => {
          const cls = r.fps >= 55 ? 'fps-green' : r.fps >= 40 ? 'fps-yellow' : r.fps >= 30 ? 'fps-orange' : 'fps-red';
          return (
            <span class="hp-ticker-item">
              <span class="hp-ticker-game">{r.name}</span>
              <span class="hp-ticker-sep">—</span>
              <span class="hp-ticker-device">{r.device}</span>
              <span class={`hp-ticker-fps ${cls}`}>{r.fps} FPS</span>
              <span class="hp-ticker-dot"></span>
            </span>
          );
        })}
      </div>
    </div>
  )}

  <div class="hp-main">

    <!-- ══════ 2. LIVE FEED ══════ -->
    {liveFeed.length > 0 && (
      <section class="hp-section hp-section-animate hp-section-divider">
        <SectionHeader title="Latest Reports" href="/games" linkText="View all" editorial="LIVE" />
        <div class="hp-feed">
          <div class="hp-feed-header">
            <span class="hp-feed-col-game">Game</span>
            <span class="hp-feed-col-device">Device</span>
            <span class="hp-feed-col-fps">FPS</span>
            <span class="hp-feed-col-preset">Preset</span>
            <span class="hp-feed-col-battery">Battery</span>
            <span class="hp-feed-col-time">When</span>
          </div>
          {liveFeed.map(r => {
            const fpsClass = r.fps >= 55 ? 'fps-green' : r.fps >= 40 ? 'fps-yellow' : r.fps >= 30 ? 'fps-orange' : 'fps-red';
            return (
              <a href={`/games/${r.slug}`} class="hp-feed-row">
                <span class="hp-feed-col-game hp-feed-name">
                  {r.thumb && <img src={r.thumb} alt="" class="hp-feed-thumb" loading="lazy" />}
                  <span class="hp-feed-name-text">{r.name}</span>
                </span>
                <span class="hp-feed-col-device">{r.device}</span>
                <span class={`hp-feed-col-fps hp-fps-badge ${fpsClass}`}>{r.fps}<span class="hp-fps-unit">fps</span></span>
                <span class="hp-feed-col-preset">{r.preset}</span>
                <span class="hp-feed-col-battery">{r.battery}</span>
                <span class="hp-feed-col-time">{r.timeAgo}</span>
              </a>
            );
          })}
        </div>
      </section>
    )}

    <!-- ══════ 3. TOP GAMES ══════ -->
    <section class="hp-section hp-section-alt hp-section-animate hp-section-divider">
      <SectionHeader title="Top Rated" href="/games" linkText="All games" editorial="METACRITIC" />
      <div class="hp-games-grid">
        {topGames.map(g => (
          <a href={`/games/${g.slug}`} class="hp-game-card">
            <div class="hp-game-card-img">
              {g.headerImage && <img src={g.headerImage} alt="" loading="lazy" />}
              {g.metacritic && (
                <span class={`hp-game-card-score ${g.metacritic >= 80 ? 'score-high' : g.metacritic >= 60 ? 'score-mid' : 'score-low'}`}>{g.metacritic}</span>
              )}
            </div>
            <div class="hp-game-card-body">
              <span class="hp-game-card-name">{g.name}</span>
              {g.genres.length > 0 && <span class="hp-game-card-genre">{g.genres.join(' · ')}</span>}
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- ══════ 4. DEVICES ══════ -->
    <section class="hp-section hp-section-animate hp-section-divider">
      <SectionHeader title="Devices" href="/devices" linkText="All devices" />
      <div class="hp-devices-grid">
        {devices.slice(0, 6).map(d => (
          <a href={`/devices/${d.slug}`} class="hp-device-card">
            <div class="hp-device-card-header">
              <div class="hp-device-card-info">
                <span class="hp-device-card-mfr">{d.manufacturer}</span>
                <span class="hp-device-card-name">{d.name}</span>
                <span class="hp-device-card-chip">{d.chip}</span>
              </div>
              {mfrLogo[d.manufacturer] && (
                <img src={mfrLogo[d.manufacturer]} alt="" class="hp-device-card-logo" loading="lazy" />
              )}
            </div>
            <div class="hp-device-card-footer">
              {d.batteryWh && <span class="hp-device-card-spec">
                <svg class="hp-device-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="6" width="18" height="12" rx="2"/><line x1="23" y1="10" x2="23" y2="14"/></svg>
                {d.batteryWh} Wh
              </span>}
              {d.msrpUsd && <span class="hp-device-card-price">${d.msrpUsd}</span>}
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- ══════ 5. NEWS ══════ -->
    {articles.length > 0 && (
      <section class="hp-section hp-section-alt hp-section-animate hp-section-divider">
        <SectionHeader title="Latest News" href="/news" linkText="All news" />
        <div class="hp-news">
          {articles.map((a, i) => {
            const tag = categoryTag[a.category] ?? 'NEWS';
            if (i === 0) {
              return (
                <a href={`/news/${a.slug}`} class="hp-news-featured">
                  <div class="hp-news-featured-img">
                    {a.coverImage ? (
                      <img src={a.coverImage} alt={a.title} loading="lazy" />
                    ) : (
                      <div class="hp-news-featured-placeholder"></div>
                    )}
                  </div>
                  <div class="hp-news-featured-body">
                    <span class="hp-news-tag">{tag}</span>
                    <h3 class="hp-news-featured-title">{a.title}</h3>
                    {a.lead && <p class="hp-news-featured-lead">{a.lead}</p>}
                    <span class="hp-news-date">{fmtDate(a.publishedAt)}</span>
                  </div>
                </a>
              );
            }
            return (
              <a href={`/news/${a.slug}`} class="hp-news-row">
                <span class="hp-news-row-title">{a.title}</span>
                <span class="hp-news-row-meta">
                  <span class="hp-news-tag">{tag}</span>
                  <span class="hp-news-date">{fmtDate(a.publishedAt)}</span>
                </span>
              </a>
            );
          })}
        </div>
      </section>
    )}

    <!-- ══════ 6. CTA ══════ -->
    <section class="hp-section hp-section-animate">
      <div class="hp-cta">
        <div class="hp-cta-icon" aria-hidden="true">
          <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="24" cy="24" r="20"/>
            <path d="M24 8v16l11 6.5"/>
            <path d="M16 38l3-6m13 6l-3-6" opacity="0.4"/>
            <circle cx="24" cy="24" r="3" fill="currentColor" stroke="none"/>
          </svg>
        </div>
        <div class="hp-cta-text">
          <p class="hp-cta-eyebrow">COMMUNITY MILESTONE</p>
          <h2 class="hp-cta-title">HELP US BENCHMARK<br/>HANDHELD GAMING.</h2>
          <div class="hp-cta-progress-wrap">
            <div class="hp-cta-progress">
              <div class="hp-cta-progress-fill" style={`width:${ctaPct}%;`}></div>
            </div>
            <span class="hp-cta-milestone">
              <strong>{reportCount.toLocaleString()}</strong> / {nextMilestone.toLocaleString()} reports — every one counts
            </span>
          </div>
        </div>
        <div class="hp-cta-action">
          <a href="/report/new" class="btn-primary hp-cta-btn">SUBMIT A REPORT</a>
          <span class="hp-cta-hint">Takes ~2 minutes</span>
        </div>
      </div>
    </section>

  </div>
</div>

</BaseLayout>

<script>
  // Animated stat counters
  function animateCounters() {
    const vals = document.querySelectorAll('.hp-hero-stat-val');
    vals.forEach(el => {
      const raw = (el as HTMLElement).textContent ?? '0';
      const target = parseInt(raw.replace(/,/g, ''), 10);
      if (isNaN(target) || target === 0) return;
      const duration = 1200;
      const start = performance.now();
      const fmt = (n: number) => n.toLocaleString();
      (el as HTMLElement).textContent = '0';
      function tick(now: number) {
        const t = Math.min((now - start) / duration, 1);
        const ease = 1 - Math.pow(1 - t, 3); // ease-out cubic
        (el as HTMLElement).textContent = fmt(Math.round(target * ease));
        if (t < 1) requestAnimationFrame(tick);
      }
      requestAnimationFrame(tick);
    });
  }
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    animateCounters();
  }
</script>

<style>
  /* ─── CRT Scanlines ─── */
  .hp-scanlines {
    position: fixed;
    inset: 0;
    background: repeating-linear-gradient(
      0deg,
      transparent,
      transparent 2px,
      rgba(0,0,0,0.03) 2px,
      rgba(0,0,0,0.03) 4px
    );
    pointer-events: none;
    z-index: 9999;
  }

  /* ─── Page wrap ─── */
  .hp-wrap { position: relative; }
  .hp-main {
    max-width: 1120px;
    margin: 0 auto;
    padding: 0 24px;
  }
  .hp-section {
    margin-bottom: 56px;
  }

  /* ─── Alternating section backgrounds ─── */
  .hp-section-alt {
    position: relative;
    padding-top: 8px;
  }
  .hp-section-alt::before {
    content: '';
    position: absolute;
    top: -28px;
    bottom: -28px;
    left: 50%;
    width: 100vw;
    transform: translateX(-50%);
    background: var(--color-raised);
    border-top: 1px solid var(--color-border-subtle);
    border-bottom: 1px solid var(--color-border-subtle);
    z-index: -1;
    pointer-events: none;
  }

  /* ─── Entrance animations ─── */
  .hp-section-animate {
    animation: hp-rise 0.5s ease-out both;
  }
  .hp-section-animate:nth-child(1) { animation-delay: 0s; }
  .hp-section-animate:nth-child(2) { animation-delay: 0.06s; }
  .hp-section-animate:nth-child(3) { animation-delay: 0.12s; }
  .hp-section-animate:nth-child(4) { animation-delay: 0.18s; }
  .hp-section-animate:nth-child(5) { animation-delay: 0.24s; }

  @keyframes hp-rise {
    from { opacity: 0; transform: translateY(16px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* ─── 1. HERO ─── */
  .hp-hero {
    position: relative;
    padding: 72px 24px 56px;
    max-width: 1120px;
    margin: 0 auto;
    overflow: hidden;
  }
  .hp-hero-grid-bg {
    position: absolute;
    inset: 0;
    background-image:
      radial-gradient(circle, rgba(212,255,0,0.08) 1px, transparent 1px);
    background-size: 32px 32px;
    mask-image: radial-gradient(ellipse 70% 60% at 80% 40%, black 20%, transparent 70%);
    -webkit-mask-image: radial-gradient(ellipse 70% 60% at 80% 40%, black 20%, transparent 70%);
    pointer-events: none;
    z-index: 0;
  }
  .hp-hero-glow {
    position: absolute;
    top: -120px;
    left: -60px;
    width: 480px;
    height: 480px;
    background: radial-gradient(circle, rgba(212,255,0,0.06) 0%, transparent 70%);
    pointer-events: none;
    z-index: 0;
  }
  .hp-hero-inner {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: 48px;
    align-items: start;
    z-index: 1;
    animation: hp-hero-enter 0.6s ease-out both;
  }
  @keyframes hp-hero-enter {
    from { opacity: 0; transform: translateY(20px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  .hp-hero-content {
    max-width: 640px;
  }
  .hp-hero-eyebrow {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    color: var(--color-accent);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: 16px;
  }
  .hp-hero-title {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: clamp(40px, 6.5vw, 68px);
    line-height: 0.93;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    color: var(--color-text);
    margin-bottom: 16px;
  }
  .hp-hero-subtitle {
    font-size: 15px;
    color: var(--color-text-2);
    line-height: 1.5;
    margin-bottom: 28px;
    max-width: 440px;
  }
  .hp-hero-search {
    margin-bottom: 24px;
    max-width: 600px;
  }
  .hp-hero-stats {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 20px;
    padding: 14px 0;
    border-top: 1px solid var(--color-border-subtle);
    border-bottom: 1px solid var(--color-border-subtle);
  }
  .hp-stat-icon {
    width: 16px;
    height: 16px;
    color: var(--color-accent);
    flex-shrink: 0;
    position: relative;
    top: 2px;
  }
  .hp-hero-stat {
    display: flex;
    align-items: baseline;
    gap: 6px;
  }
  .hp-hero-stat-val {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 18px;
    color: var(--color-text);
  }
  .hp-hero-stat-lbl {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 10px;
    color: var(--color-text-3);
    letter-spacing: 0.1em;
  }
  .hp-hero-stat-sep {
    width: 1px;
    height: 16px;
    background: var(--color-border);
  }
  .hp-hero-devices {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 20px;
  }
  .hp-hero-device {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    color: var(--color-text-2);
    text-decoration: none;
    border: 1px solid var(--color-border);
    padding: 7px 16px;
    transition: border-color 0.15s, color 0.15s, background 0.15s;
  }
  .hp-hero-device:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
    background: rgba(212,255,0,0.05);
  }
  .hp-hero-device-more {
    color: var(--color-text-3);
  }

  /* ─── Hero performance widget ─── */
  .hp-hero-visual {
    padding-top: 48px;
  }
  .hp-widget-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 10px 14px;
    background: var(--color-elevated);
    border-bottom: 1px solid var(--color-border);
  }
  .hp-widget-label {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 600;
    color: var(--color-text-2);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .hp-widget-live {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 600;
    color: var(--color-fps-green);
    display: flex;
    align-items: center;
    gap: 5px;
  }
  .hp-widget-dot {
    display: inline-block;
    width: 6px;
    height: 6px;
    background: var(--color-fps-green);
    border-radius: 50%;
    animation: hp-pulse 2s ease-in-out infinite;
  }
  @keyframes hp-pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.3; }
  }
  .hp-widget-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 10px 14px;
    border-bottom: 1px solid var(--color-border-subtle);
    gap: 12px;
  }
  .hp-widget-row:last-child { border-bottom: none; }
  .hp-widget-info {
    min-width: 0;
    flex: 1;
  }
  .hp-widget-game {
    display: block;
    font-size: 12px;
    font-weight: 500;
    color: var(--color-text);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .hp-widget-device {
    display: block;
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--color-text-dim);
    margin-top: 1px;
  }
  .hp-widget-fps {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 13px;
    flex-shrink: 0;
    display: inline-flex;
    align-items: baseline;
    gap: 2px;
  }

  /* ─── 2. LIVE FEED ─── */
  .hp-feed {
    border: 1px solid var(--color-border);
    border-radius: 8px;
    overflow: hidden;
  }
  .hp-feed-header,
  .hp-feed-row {
    display: grid;
    grid-template-columns: 2fr 1.2fr 0.7fr 0.8fr 0.7fr 0.5fr;
    gap: 8px;
    padding: 10px 16px;
    align-items: center;
    font-size: 13px;
  }
  .hp-feed-header {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 500;
    color: var(--color-text-dim);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    background: var(--color-elevated);
    border-bottom: 1px solid var(--color-border);
  }
  .hp-feed-row {
    text-decoration: none;
    color: var(--color-text-2);
    border-bottom: 1px solid var(--color-border-subtle);
    transition: background 0.12s;
  }
  .hp-feed-row:last-child { border-bottom: none; }
  .hp-feed-row:hover .hp-feed-name { color: var(--color-accent); }
  .hp-feed-name {
    color: var(--color-text);
    font-weight: 500;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    transition: color 0.12s;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .hp-feed-thumb {
    width: 40px;
    height: 19px;
    object-fit: cover;
    border-radius: 2px;
    flex-shrink: 0;
    border: 1px solid var(--color-border-subtle);
  }
  .hp-feed-name-text {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .hp-fps-badge {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 12px;
    display: inline-flex;
    align-items: baseline;
    gap: 2px;
  }
  .hp-fps-unit {
    font-size: 9px;
    font-weight: 500;
    opacity: 0.6;
    text-transform: uppercase;
  }
  .fps-green  { color: var(--color-fps-green); }
  .fps-yellow { color: var(--color-fps-yellow); }
  .fps-orange { color: var(--color-fps-orange); }
  .fps-red    { color: var(--color-fps-red); }
  .hp-feed-col-device,
  .hp-feed-col-preset,
  .hp-feed-col-battery,
  .hp-feed-col-time {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-text-3);
  }

  /* ─── 3. TOP GAMES (card grid) ─── */
  .hp-games-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 14px;
  }
  .hp-game-card {
    border: 1px solid var(--color-border);
    border-radius: 8px;
    overflow: hidden;
    text-decoration: none;
    background: var(--color-base);
    transition: border-color 0.15s, transform 0.2s, box-shadow 0.2s;
  }
  .hp-game-card-img {
    aspect-ratio: 460/215;
    position: relative;
    overflow: hidden;
    background: var(--color-elevated);
  }
  .hp-game-card-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }
  .hp-game-card:hover .hp-game-card-img img {
    transform: scale(1.05);
  }
  .hp-game-card-score {
    position: absolute;
    top: 6px;
    right: 6px;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    padding: 2px 6px;
    border-radius: 3px;
    line-height: 1.3;
  }
  .hp-game-card-score.score-high {
    background: rgba(34,197,94,0.9);
    color: #fff;
  }
  .hp-game-card-score.score-mid {
    background: rgba(234,179,8,0.9);
    color: #fff;
  }
  .hp-game-card-score.score-low {
    background: rgba(249,115,22,0.9);
    color: #fff;
  }
  .hp-game-card-body {
    padding: 10px 12px;
  }
  .hp-game-card-name {
    display: block;
    font-size: 13px;
    font-weight: 500;
    color: var(--color-text);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .hp-game-card:hover .hp-game-card-name {
    color: var(--color-accent);
  }
  .hp-game-card-genre {
    display: block;
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--color-text-dim);
    margin-top: 3px;
  }

  /* ─── 4. DEVICES (card grid) ─── */
  .hp-devices-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
  }
  .hp-device-card {
    display: block;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: 18px 16px;
    text-decoration: none;
    transition: border-color 0.15s, background 0.15s;
  }
  .hp-device-card:hover .hp-device-card-name {
    color: var(--color-accent);
  }
  .hp-device-card-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 12px;
  }
  .hp-device-card-info {
    min-width: 0;
    flex: 1;
  }
  .hp-device-card-logo {
    width: 36px;
    height: 36px;
    flex-shrink: 0;
    opacity: 0.25;
    transition: opacity 0.2s;
    filter: grayscale(100%);
  }
  .hp-device-card:hover .hp-device-card-logo {
    opacity: 0.6;
    filter: grayscale(0%);
  }
  .hp-device-card-mfr {
    display: block;
    font-family: var(--font-mono);
    font-size: 9px;
    font-weight: 600;
    color: var(--color-accent);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 4px;
  }
  .hp-device-card-name {
    display: block;
    font-size: 15px;
    font-weight: 600;
    color: var(--color-text);
    transition: color 0.12s;
    margin-bottom: 4px;
  }
  .hp-device-card-chip {
    display: block;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-text-3);
  }
  .hp-device-card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 10px;
    padding-top: 8px;
    border-top: 1px solid var(--color-border-subtle);
  }
  .hp-device-card-spec {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-text-3);
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }
  .hp-device-icon {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
    color: var(--color-text-dim);
  }
  .hp-device-card-price {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 600;
    color: var(--color-text-2);
  }

  /* ─── 5. NEWS ─── */
  .hp-news {
    border: 1px solid var(--color-border);
    border-radius: 8px;
    overflow: hidden;
  }
  .hp-news-featured {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    text-decoration: none;
    border-bottom: 1px solid var(--color-border);
    transition: background 0.12s;
    min-height: 200px;
  }
  .hp-news-featured:hover { background: var(--color-elevated); }
  .hp-news-featured:hover .hp-news-featured-title { color: var(--color-accent); }
  .hp-news-featured-img {
    aspect-ratio: 16/10;
    overflow: hidden;
    background: var(--color-elevated);
    position: relative;
  }
  .hp-news-featured-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }
  .hp-news-featured:hover .hp-news-featured-img img { transform: scale(1.03); }
  .hp-news-featured-placeholder {
    width: 100%;
    height: 100%;
    background: var(--color-elevated);
  }
  .hp-news-featured-body {
    padding: 24px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .hp-news-tag {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 600;
    color: var(--color-accent);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 8px;
  }
  .hp-news-featured-title {
    font-family: var(--font-heading);
    font-size: 20px;
    font-weight: 700;
    color: var(--color-text);
    line-height: 1.25;
    margin-bottom: 8px;
    transition: color 0.12s;
  }
  .hp-news-featured-lead {
    font-size: 13px;
    color: var(--color-text-3);
    line-height: 1.55;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin-bottom: 12px;
  }
  .hp-news-date {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--color-text-dim);
    letter-spacing: 0.04em;
  }
  .hp-news-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 12px 16px;
    text-decoration: none;
    border-bottom: 1px solid var(--color-border-subtle);
    transition: background 0.12s;
  }
  .hp-news-row:last-child { border-bottom: none; }
  .hp-news-row:hover { background: var(--color-elevated); }
  .hp-news-row:hover .hp-news-row-title { color: var(--color-accent); }
  .hp-news-row-title {
    font-size: 13px;
    font-weight: 500;
    color: var(--color-text);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    transition: color 0.12s;
  }
  .hp-news-row-meta {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-shrink: 0;
  }

  /* ─── 6. CTA ─── */
  .hp-cta-icon {
    width: 56px;
    height: 56px;
    flex-shrink: 0;
    color: var(--color-accent);
    opacity: 0.7;
  }
  .hp-cta-icon svg {
    width: 100%;
    height: 100%;
  }
  .hp-cta-text { flex: 1; }
  .hp-cta-eyebrow {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 600;
    color: var(--color-accent);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: 8px;
  }
  .hp-cta-title {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: clamp(18px, 2.5vw, 24px);
    color: var(--color-text);
    text-transform: uppercase;
    letter-spacing: -0.02em;
    line-height: 1.2;
    margin-bottom: 16px;
  }
  .hp-cta-progress-wrap { max-width: 400px; }
  .hp-cta-progress {
    height: 6px;
    background: var(--color-border);
    border-radius: 3px;
    width: 100%;
    margin-bottom: 8px;
    overflow: hidden;
  }
  .hp-cta-progress-fill {
    height: 100%;
    background: var(--color-accent);
    border-radius: 3px;
    transition: width 0.5s ease;
    box-shadow: 0 0 8px rgba(212,255,0,0.3);
  }
  .hp-cta-milestone {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-text-3);
  }
  .hp-cta-milestone strong {
    color: var(--color-text);
    font-weight: 700;
  }
  .hp-cta-action {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
  }
  .hp-cta-btn {
    padding: 14px 32px;
    font-size: 13px;
  }
  .hp-cta-hint {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--color-text-dim);
    letter-spacing: 0.04em;
  }

  /* ─── LIVE TICKER ─── */
  .hp-ticker {
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    background: var(--color-raised);
    overflow: hidden;
    position: relative;
    padding: 10px 0;
  }
  .hp-ticker::before,
  .hp-ticker::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    width: 80px;
    z-index: 2;
    pointer-events: none;
  }
  .hp-ticker::before {
    left: 0;
    background: linear-gradient(90deg, var(--color-raised), transparent);
  }
  .hp-ticker::after {
    right: 0;
    background: linear-gradient(270deg, var(--color-raised), transparent);
  }
  .hp-ticker-track {
    display: flex;
    gap: 0;
    white-space: nowrap;
    animation: hp-scroll 40s linear infinite;
    width: max-content;
  }
  @keyframes hp-scroll {
    from { transform: translateX(0); }
    to { transform: translateX(-33.333%); }
  }
  .hp-ticker-item {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 0 24px;
    font-size: 12px;
  }
  .hp-ticker-game {
    font-weight: 600;
    color: var(--color-text);
  }
  .hp-ticker-sep {
    color: var(--color-text-dim);
  }
  .hp-ticker-device {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-text-3);
  }
  .hp-ticker-fps {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 11px;
  }
  .hp-ticker-dot {
    width: 3px;
    height: 3px;
    background: var(--color-accent);
    border-radius: 50%;
    opacity: 0.5;
  }

  /* ─── Hero title shimmer ─── */
  .hp-hero-accent {
    color: var(--color-accent);
    text-shadow: 0 0 60px rgba(212,255,0,0.25);
    position: relative;
    background: linear-gradient(
      90deg,
      var(--color-accent) 0%,
      var(--color-accent) 40%,
      #fff 50%,
      var(--color-accent) 60%,
      var(--color-accent) 100%
    );
    background-size: 200% 100%;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    animation: hp-shimmer 3s ease-in-out infinite;
  }
  @keyframes hp-shimmer {
    0%, 100% { background-position: 100% 0; }
    50% { background-position: -100% 0; }
  }

  /* ─── Section dividers ─── */
  .hp-section-divider {
    position: relative;
  }
  .hp-section-divider::after {
    content: '';
    position: absolute;
    bottom: -28px;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent 0%,
      var(--color-accent) 20%,
      var(--color-accent) 80%,
      transparent 100%
    );
    opacity: 0.15;
  }

  /* ─── Neon glow hovers ─── */
  .hp-game-card:hover {
    border-color: rgba(212,255,0,0.3);
    transform: translateY(-3px);
    box-shadow: 0 4px 20px rgba(212,255,0,0.08), 0 0 40px rgba(212,255,0,0.04);
  }
  .hp-device-card:hover {
    border-color: rgba(212,255,0,0.25);
    background: var(--color-elevated);
    box-shadow: 0 2px 16px rgba(212,255,0,0.06);
    border-left: 3px solid var(--color-accent);
    padding-left: 13px;
  }
  .hp-feed-row:hover {
    background: var(--color-elevated);
    box-shadow: inset 3px 0 0 var(--color-accent);
  }
  .hp-widget {
    border: 1px solid var(--color-border);
    border-radius: 8px;
    overflow: hidden;
    background: var(--color-raised);
    width: 320px;
    box-shadow: 0 0 30px rgba(212,255,0,0.04);
  }

  /* ─── News gradient overlay ─── */
  .hp-news-featured-img::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      135deg,
      rgba(212,255,0,0.08) 0%,
      transparent 40%,
      transparent 60%,
      rgba(0,0,0,0.4) 100%
    );
    pointer-events: none;
  }

  /* ─── CTA animated gradient ─── */
  .hp-cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    padding: 36px 40px;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    background:
      linear-gradient(135deg, rgba(212,255,0,0.03) 0%, transparent 50%, rgba(212,255,0,0.02) 100%),
      var(--color-raised);
    position: relative;
    overflow: hidden;
  }
  .hp-cta::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--color-accent), transparent);
    animation: hp-cta-glow 4s ease-in-out infinite;
  }
  @keyframes hp-cta-glow {
    0%, 100% { opacity: 0.5; }
    50% { opacity: 1; }
  }
  .hp-cta::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--color-accent), transparent);
    opacity: 0.3;
