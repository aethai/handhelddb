---
import BaseLayout from '@layouts/BaseLayout.astro';
import GameCard from '@components/astro/GameCard.astro';
import DeviceCard from '@components/astro/DeviceCard.astro';
import SearchBar from '@components/react/SearchBar';
import { supabaseAdmin } from '@lib/db/client';

// ─── Fetch real data from Supabase ───
const { data: devicesData } = await supabaseAdmin
  .from('devices')
  .select('slug, name, manufacturer, screen_size, battery_wh, chip, image, msrp_usd, is_active')
  .eq('is_active', true)
  .order('name');

const { data: gamesData } = await supabaseAdmin
  .from('games')
  .select('slug, name, header_image, genres, deck_compatibility')
  .not('header_image', 'is', null)
  .order('metacritic_score', { ascending: false, nullsFirst: false })
  .limit(8);

const { count: gameCount } = await supabaseAdmin
  .from('games')
  .select('*', { count: 'exact', head: true });

const { count: deviceCount } = await supabaseAdmin
  .from('devices')
  .select('*', { count: 'exact', head: true });

const devices = (devicesData ?? []).map(d => ({
  slug: d.slug,
  name: d.name,
  manufacturer: d.manufacturer,
  screenSize: d.screen_size,
  batteryWh: d.battery_wh,
  chip: d.chip,
  image: d.image,
  msrpUsd: d.msrp_usd,
}));

const trendingGames = (gamesData ?? []).map(g => ({
  slug: g.slug,
  name: g.name,
  headerImage: g.header_image,
  genres: (g.genres as string[]) ?? [],
  deckCompatibility: g.deck_compatibility,
  bestFps: null as number | null,
  reportCount: 0,
}));
---

<BaseLayout title="Handheld GameDB">
  <!-- HERO -->
  <section class="relative overflow-hidden pt-16 pb-20 sm:pt-24 sm:pb-28">
    <div class="absolute inset-0 bg-gradient-to-b from-emerald-950/30 via-emerald-950/10 to-transparent"></div>
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[500px] bg-emerald-500/5 rounded-full blur-3xl"></div>

    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 text-center">
      <!-- Live badge -->
      <div class="inline-flex items-center gap-2 rounded-full border border-emerald-500/20 bg-emerald-500/10 px-4 py-1.5 text-sm text-emerald-400 mb-6">
        <span class="relative flex h-2 w-2">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-500"></span>
        </span>
        Now live — building the database
      </div>

      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-white tracking-tight leading-tight">
        Find the <span class="bg-gradient-to-r from-emerald-400 to-cyan-400 bg-clip-text text-transparent">best settings</span> for<br class="hidden sm:block" />
        every game on your handheld
      </h1>
      <p class="mt-6 text-lg sm:text-xl text-gray-400 max-w-2xl mx-auto leading-relaxed">
        Community-driven performance data for Steam Deck, ROG Ally, Legion Go and more. Optimal settings, FPS benchmarks, battery life &mdash; all in one place.
      </p>

      <!-- Search Bar -->
      <div class="mt-10 max-w-2xl mx-auto">
        <SearchBar client:load variant="hero" placeholder="Search games... (e.g. Elden Ring, Cyberpunk 2077, Stardew Valley)" />
      </div>

      <!-- Quick Stats -->
      <div class="mt-14 grid grid-cols-2 sm:grid-cols-4 gap-4 max-w-2xl mx-auto">
        <div class="rounded-xl border border-gray-800 bg-gray-900/50 p-4">
          <p class="text-2xl sm:text-3xl font-bold text-white">{gameCount ?? 0}</p>
          <p class="text-sm text-gray-500">Games</p>
        </div>
        <div class="rounded-xl border border-gray-800 bg-gray-900/50 p-4">
          <p class="text-2xl sm:text-3xl font-bold text-white">{deviceCount ?? 0}</p>
          <p class="text-sm text-gray-500">Devices</p>
        </div>
        <div class="rounded-xl border border-gray-800 bg-gray-900/50 p-4">
          <p class="text-2xl sm:text-3xl font-bold text-white">0</p>
          <p class="text-sm text-gray-500">Reports</p>
        </div>
        <div class="rounded-xl border border-gray-800 bg-gray-900/50 p-4">
          <p class="text-2xl sm:text-3xl font-bold text-white">0</p>
          <p class="text-sm text-gray-500">Testers</p>
        </div>
      </div>
    </div>
  </section>

  <!-- TOP GAMES -->
  {trendingGames.length > 0 && (
    <section class="py-12">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between mb-6">
          <div>
            <h2 class="text-2xl font-bold text-white">Top Games</h2>
            <p class="mt-1 text-sm text-gray-500">Highest rated games in the database</p>
          </div>
          <a href="/games" class="text-sm text-emerald-400 hover:text-emerald-300 transition-colors">
            View all &rarr;
          </a>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          {trendingGames.map((game) => (
            <GameCard {...game} />
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- SUPPORTED DEVICES -->
  {devices.length > 0 && (
    <section class="py-12">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between mb-6">
          <div>
            <h2 class="text-2xl font-bold text-white">Supported Devices</h2>
            <p class="mt-1 text-sm text-gray-500">Pick your handheld to see compatible games</p>
          </div>
          <a href="/devices" class="text-sm text-emerald-400 hover:text-emerald-300 transition-colors">
            All devices &rarr;
          </a>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          {devices.map((device) => (
            <DeviceCard {...device} />
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- HOW IT WORKS -->
  <section class="py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold text-white mb-10 text-center">How It Works</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="relative text-center group">
          <div class="mx-auto mb-5 flex h-14 w-14 items-center justify-center rounded-2xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 group-hover:bg-emerald-500/20 transition-colors">
            <svg class="h-7 w-7" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M11 19a8 8 0 100-16 8 8 0 000 16z" />
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-white">1. Search Your Game</h3>
          <p class="mt-2 text-sm text-gray-400 leading-relaxed">
            Instant search across {gameCount ?? 0}+ games. Filter by device, genre, FPS target, or compatibility.
          </p>
        </div>
        <div class="relative text-center group">
          <div class="mx-auto mb-5 flex h-14 w-14 items-center justify-center rounded-2xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 group-hover:bg-emerald-500/20 transition-colors">
            <svg class="h-7 w-7" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 6h9.75M10.5 6a1.5 1.5 0 11-3 0m3 0a1.5 1.5 0 10-3 0M3.75 6H7.5m3 12h9.75m-9.75 0a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m-3.75 0H7.5m9-6h3.75m-3.75 0a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m-9.75 0h9.75" />
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-white">2. Get Best Settings</h3>
          <p class="mt-2 text-sm text-gray-400 leading-relaxed">
            3 TDP profiles per game: Battery Saver, Balanced, Performance. With FPS, thermal, and battery data.
          </p>
        </div>
        <div class="relative text-center group">
          <div class="mx-auto mb-5 flex h-14 w-14 items-center justify-center rounded-2xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 group-hover:bg-emerald-500/20 transition-colors">
            <svg class="h-7 w-7" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-white">3. Share Your Results</h3>
          <p class="mt-2 text-sm text-gray-400 leading-relaxed">
            Submit performance reports, earn points, climb the leaderboard. Every report helps the community.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-12 pb-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="relative overflow-hidden rounded-2xl border border-gray-800 bg-gradient-to-br from-gray-900 to-gray-900/50 p-8 sm:p-12">
        <div class="absolute top-0 right-0 -mt-16 -mr-16 h-64 w-64 rounded-full bg-emerald-500/5 blur-3xl"></div>
        <div class="relative text-center">
          <h2 class="text-2xl sm:text-3xl font-bold text-white">Got a handheld? Your data matters.</h2>
          <p class="mt-3 text-gray-400 max-w-xl mx-auto">
            Every performance report helps thousands of gamers optimize their experience. Be one of the first testers.
          </p>
          <div class="mt-8 flex flex-col sm:flex-row justify-center gap-4">
            <a
              href="/report/new"
              class="inline-flex items-center justify-center gap-2 rounded-xl bg-emerald-600 px-8 py-3.5 text-sm font-semibold text-white hover:bg-emerald-500 transition-colors shadow-lg shadow-emerald-500/20"
            >
              <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
              </svg>
              Submit a Report
            </a>
            <a
              href="/auth/login"
              class="inline-flex items-center justify-center gap-2 rounded-xl border border-gray-700 px-8 py-3.5 text-sm font-semibold text-gray-300 hover:border-gray-500 hover:text-white transition-colors"
            >
              Sign in with Steam
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
