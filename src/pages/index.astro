---
import BaseLayout from '@layouts/BaseLayout.astro';
import SearchBar from '@components/react/SearchBar';
import SectionHeader from '@components/astro/SectionHeader.astro';
import { supabaseAdmin } from '@lib/db/client';
import { getCached, setCache } from '@lib/cache';

// ─── Cached homepage data (2 min TTL) ───
const CACHE_KEY = 'homepage:data';
let _cached = getCached<any>(CACHE_KEY);

if (!_cached) {
const [
  devicesRes, topGamesRes, gameCountRes, deviceCountRes,
  reportCountRes, articlesRes, trendingRes, userCountRes,
] = await Promise.all([
  supabaseAdmin
    .from('devices')
    .select('id, slug, name, manufacturer, chip, battery_wh, msrp_usd')
    .eq('is_active', true)
    .order('name'),
  supabaseAdmin
    .from('games')
    .select('slug, name, header_image, genres, metacritic_score')
    .not('header_image', 'is', null)
    .not('metacritic_score', 'is', null)
    .order('metacritic_score', { ascending: false, nullsFirst: false })
    .limit(8),
  supabaseAdmin.from('games').select('*', { count: 'exact', head: true }),
  supabaseAdmin.from('devices').select('*', { count: 'exact', head: true }).eq('is_active', true),
  supabaseAdmin.from('performance_reports').select('*', { count: 'exact', head: true }),
  supabaseAdmin
    .from('articles')
    .select('slug, title, lead, category, published_at, cover_image')
    .eq('status', 'published')
    .not('published_at', 'is', null)
    .order('published_at', { ascending: false })
    .limit(4),
  supabaseAdmin
    .from('performance_reports')
    .select('fps_avg, graphics_preset, resolution, overall_rating, created_at, estimated_battery, games(name, slug), devices(name)')
    .eq('moderation_status', 'approved')
    .order('created_at', { ascending: false })
    .limit(12),
  supabaseAdmin.from('users').select('*', { count: 'exact', head: true }),
]);

const gameCount = gameCountRes.count ?? 0;
const deviceCount = deviceCountRes.count ?? 0;
const reportCount = reportCountRes.count ?? 0;
const userCount = userCountRes.count ?? 0;

const devices = (devicesRes.data ?? []).map(d => ({
  slug: d.slug, name: d.name, manufacturer: d.manufacturer,
  chip: d.chip, batteryWh: d.battery_wh, msrpUsd: d.msrp_usd,
}));

const topGames = (topGamesRes.data ?? []).slice(0, 8).map(g => ({
  slug: g.slug, name: g.name, headerImage: g.header_image,
  genres: ((g.genres as string[]) ?? []).slice(0, 2),
  metacritic: g.metacritic_score,
}));

const articles = (articlesRes.data ?? []).map(a => ({
  slug: a.slug, title: a.title, lead: a.lead, category: a.category,
  publishedAt: a.published_at ? new Date(a.published_at) : null,
  coverImage: a.cover_image,
}));

// Live feed — recent reports
const seenGames = new Set<string>();
const liveFeed = (trendingRes.data ?? [])
  .filter(r => {
    const name = (r.games as any)?.name;
    if (!name || seenGames.has(name)) return false;
    seenGames.add(name);
    return true;
  })
  .slice(0, 8)
  .map(r => {
    const fps = Math.round(r.fps_avg ?? 0);
    const diffMin = Math.round((Date.now() - new Date(r.created_at).getTime()) / 60000);
    let timeAgo: string;
    if (diffMin < 1) timeAgo = 'now';
    else if (diffMin < 60) timeAgo = `${diffMin}m`;
    else if (diffMin < 1440) timeAgo = `${Math.round(diffMin / 60)}h`;
    else timeAgo = `${Math.round(diffMin / 1440)}d`;
    return {
      name: (r.games as any).name,
      slug: (r.games as any).slug,
      device: (r.devices as any)?.name?.replace('ASUS ', '').replace('Lenovo ', '') ?? '',
      fps,
      preset: r.graphics_preset ?? '—',
      battery: r.estimated_battery ? `~${r.estimated_battery.toFixed(1)}h` : '—',
      timeAgo,
    };
  });

  _cached = { gameCount, deviceCount, reportCount, userCount, devices, topGames, articles, liveFeed };
  setCache(CACHE_KEY, _cached, 120);
}

const { gameCount, deviceCount, reportCount, userCount, devices, topGames, articles, liveFeed } = _cached;

// Helpers
const fmtDate = (d: Date | null) => d ? d.toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) : '';
const fpsColor = (fps: number) => fps >= 55 ? '#22c55e' : fps >= 40 ? '#eab308' : fps >= 30 ? '#f97316' : '#ef4444';

const categoryTag: Record<string, string> = {
  game_launch: 'EDITORIAL', game_patch: 'UPDATE', os_update: 'UPDATE',
  performance_analysis: 'EDITORIAL', device_launch: 'UPDATE',
  editorial: 'EDITORIAL', sale_event: 'GUIDE',
};

const featuredDevices = [
  { name: 'Deck', slug: 'steam-deck-oled' },
  { name: 'Ally', slug: 'rog-ally' },
  { name: 'Ally X', slug: 'rog-ally-x' },
  { name: 'Legion Go', slug: 'legion-go' },
  { name: 'Claw 8', slug: 'msi-claw-8-ai-plus' },
].filter(fd => devices.some(d => d.slug === fd.slug));
const extraDeviceCount = Math.max(0, (devices.length) - featuredDevices.length);

// Milestone for CTA
const milestones = [50, 100, 250, 500, 1000, 2000, 5000, 10000, 25000, 50000];
const nextMilestone = milestones.find(m => m > reportCount) ?? milestones[milestones.length - 1];
const prevMilestone = milestones[milestones.indexOf(nextMilestone) - 1] ?? 0;
const ctaPct = Math.min(((reportCount - prevMilestone) / (nextMilestone - prevMilestone)) * 100, 100);

// Schema.org
const siteUrl = import.meta.env.PUBLIC_SITE_URL ?? 'https://handheldgamedb.com';
const schemaWebSite = {
  '@context': 'https://schema.org', '@type': 'WebSite',
  name: 'HandheldDB', url: siteUrl,
  description: `Performance database for handheld gaming. ${gameCount.toLocaleString()} games, ${deviceCount} devices, ${reportCount.toLocaleString()} community reports.`,
  potentialAction: { '@type': 'SearchAction', target: `${siteUrl}/games?q={search_term_string}`, 'query-input': 'required name=search_term_string' },
};
---

<BaseLayout title="HandheldDB — Does it run on your handheld?" description={`The handheld gaming performance database. ${gameCount.toLocaleString()} games tested across ${deviceCount} devices with ${reportCount.toLocaleString()} community reports.`}>

<script type="application/ld+json" set:html={JSON.stringify(schemaWebSite)} />

<div class="hp-wrap">

  <!-- ══════ 1. COMMAND CENTER (Hero) ══════ -->
  <section class="hp-hero">
    <div class="hp-hero-glow"></div>
    <div class="hp-hero-inner">
      <p class="hp-hero-eyebrow">COMMUNITY-POWERED PERFORMANCE DATABASE</p>
      <h1 class="hp-hero-title">
        DOES IT RUN<br/>ON YOUR<br/><span class="hp-hero-accent">HANDHELD?</span>
      </h1>
      <p class="hp-hero-subtitle">Real FPS data from real devices. Find out before you buy.</p>

      <div class="hp-hero-search">
        <SearchBar client:load variant="hero" placeholder={`Search ${gameCount.toLocaleString()} games...`} />
      </div>

      <div class="hp-hero-stats">
        <div class="hp-hero-stat">
          <span class="hp-hero-stat-val">{gameCount.toLocaleString()}</span>
          <span class="hp-hero-stat-lbl">GAMES</span>
        </div>
        <div class="hp-hero-stat-sep"></div>
        <div class="hp-hero-stat">
          <span class="hp-hero-stat-val">{reportCount.toLocaleString()}</span>
          <span class="hp-hero-stat-lbl">REPORTS</span>
        </div>
        <div class="hp-hero-stat-sep"></div>
        <div class="hp-hero-stat">
          <span class="hp-hero-stat-val">{deviceCount}</span>
          <span class="hp-hero-stat-lbl">DEVICES</span>
        </div>
        {userCount > 0 && (
          <>
            <div class="hp-hero-stat-sep"></div>
            <div class="hp-hero-stat">
              <span class="hp-hero-stat-val">{userCount.toLocaleString()}</span>
              <span class="hp-hero-stat-lbl">USERS</span>
            </div>
          </>
        )}
      </div>

      <div class="hp-hero-devices">
        {featuredDevices.map(d => (
          <a href={`/devices/${d.slug}`} class="hp-hero-device">{d.name}</a>
        ))}
        {extraDeviceCount > 0 && (
          <a href="/devices" class="hp-hero-device hp-hero-device-more">+{extraDeviceCount} more</a>
        )}
      </div>
    </div>
  </section>

  <div class="hp-main">

    <!-- ══════ 2. LIVE FEED ══════ -->
    {liveFeed.length > 0 && (
      <section class="hp-section hp-section-animate">
        <SectionHeader title="Latest Reports" href="/games" linkText="View all" editorial="LIVE" />
        <div class="hp-feed">
          <div class="hp-feed-header">
            <span class="hp-feed-col-game">Game</span>
            <span class="hp-feed-col-device">Device</span>
            <span class="hp-feed-col-fps">FPS</span>
            <span class="hp-feed-col-preset">Preset</span>
            <span class="hp-feed-col-battery">Battery</span>
            <span class="hp-feed-col-time">When</span>
          </div>
          {liveFeed.map(r => {
            const fpsClass = r.fps >= 55 ? 'fps-green' : r.fps >= 40 ? 'fps-yellow' : r.fps >= 30 ? 'fps-orange' : 'fps-red';
            return (
              <a href={`/games/${r.slug}`} class="hp-feed-row">
                <span class="hp-feed-col-game hp-feed-name">{r.name}</span>
                <span class="hp-feed-col-device">{r.device}</span>
                <span class={`hp-feed-col-fps hp-fps-badge ${fpsClass}`}>{r.fps}<span class="hp-fps-unit">fps</span></span>
                <span class="hp-feed-col-preset">{r.preset}</span>
                <span class="hp-feed-col-battery">{r.battery}</span>
                <span class="hp-feed-col-time">{r.timeAgo}</span>
              </a>
            );
          })}
        </div>
      </section>
    )}

    <!-- ══════ 3. TOP GAMES + DEVICES ══════ -->
    <section class="hp-section hp-split hp-section-animate">
      <div class="hp-split-left">
        <SectionHeader title="Top Rated" href="/games" linkText="All games" editorial="METACRITIC" />
        <div class="hp-top-games">
          {topGames.map((g, i) => (
            <a href={`/games/${g.slug}`} class="hp-top-game-row">
              <span class="hp-top-game-rank">#{i + 1}</span>
              <div class="hp-top-game-thumb">
                {g.headerImage && <img src={g.headerImage} alt="" loading="lazy" />}
              </div>
              <div class="hp-top-game-info">
                <span class="hp-top-game-name">{g.name}</span>
                {g.genres.length > 0 && <span class="hp-top-game-genre">{g.genres.join(', ')}</span>}
              </div>
              {g.metacritic && <span class={`hp-top-game-score ${g.metacritic >= 80 ? 'score-high' : g.metacritic >= 60 ? 'score-mid' : 'score-low'}`}>{g.metacritic}</span>}
            </a>
          ))}
        </div>
      </div>
      <div class="hp-split-right">
        <SectionHeader title="Devices" href="/devices" linkText="All devices" />
        <div class="hp-device-list">
          {devices.slice(0, 6).map(d => (
            <a href={`/devices/${d.slug}`} class="hp-device-row">
              <div class="hp-device-row-info">
                <span class="hp-device-row-mfr">{d.manufacturer}</span>
                <span class="hp-device-row-name">{d.name}</span>
                <span class="hp-device-row-specs">
                  {[d.chip, d.batteryWh ? `${d.batteryWh}Wh` : null].filter(Boolean).join(' · ')}
                </span>
              </div>
              {d.msrpUsd && <span class="hp-device-row-price">${d.msrpUsd}</span>}
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- ══════ 4. NEWS ══════ -->
    {articles.length > 0 && (
      <section class="hp-section hp-section-animate">
        <SectionHeader title="Latest News" href="/news" linkText="All news" />
        <div class="hp-news">
          {articles.map((a, i) => {
            const tag = categoryTag[a.category] ?? 'NEWS';
            if (i === 0) {
              return (
                <a href={`/news/${a.slug}`} class="hp-news-featured">
                  <div class="hp-news-featured-img">
                    {a.coverImage ? (
                      <img src={a.coverImage} alt={a.title} loading="lazy" />
                    ) : (
                      <div class="hp-news-featured-placeholder"></div>
                    )}
                  </div>
                  <div class="hp-news-featured-body">
                    <span class="hp-news-tag">{tag}</span>
                    <h3 class="hp-news-featured-title">{a.title}</h3>
                    {a.lead && <p class="hp-news-featured-lead">{a.lead}</p>}
                    <span class="hp-news-date">{fmtDate(a.publishedAt)}</span>
                  </div>
                </a>
              );
            }
            return (
              <a href={`/news/${a.slug}`} class="hp-news-row">
                <span class="hp-news-row-title">{a.title}</span>
                <span class="hp-news-row-meta">
                  <span class="hp-news-tag">{tag}</span>
                  <span class="hp-news-date">{fmtDate(a.publishedAt)}</span>
                </span>
              </a>
            );
          })}
        </div>
      </section>
    )}

    <!-- ══════ 5. CTA ══════ -->
    <section class="hp-section hp-section-animate">
      <div class="hp-cta">
        <div class="hp-cta-text">
          <p class="hp-cta-eyebrow">COMMUNITY MILESTONE</p>
          <h2 class="hp-cta-title">HELP US BENCHMARK<br/>HANDHELD GAMING.</h2>
          <div class="hp-cta-progress-wrap">
            <div class="hp-cta-progress">
              <div class="hp-cta-progress-fill" style={`width:${ctaPct}%;`}></div>
            </div>
            <span class="hp-cta-milestone">
              <strong>{reportCount.toLocaleString()}</strong> / {nextMilestone.toLocaleString()} reports — every one counts
            </span>
          </div>
        </div>
        <div class="hp-cta-action">
          <a href="/report/new" class="btn-primary hp-cta-btn">SUBMIT A REPORT</a>
          <span class="hp-cta-hint">Takes ~2 minutes</span>
        </div>
      </div>
    </section>

  </div>
</div>

</BaseLayout>

<style>
  /* ─── Page wrap ─── */
  .hp-wrap { }
  .hp-main {
    max-width: 1120px;
    margin: 0 auto;
    padding: 0 24px;
  }
  .hp-section {
    margin-bottom: 56px;
  }

  /* ─── Entrance animations ─── */
  .hp-section-animate {
    animation: hp-rise 0.5s ease-out both;
  }
  .hp-section-animate:nth-child(1) { animation-delay: 0s; }
  .hp-section-animate:nth-child(2) { animation-delay: 0.08s; }
  .hp-section-animate:nth-child(3) { animation-delay: 0.16s; }
  .hp-section-animate:nth-child(4) { animation-delay: 0.24s; }

  @keyframes hp-rise {
    from { opacity: 0; transform: translateY(16px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* ─── 1. HERO ─── */
  .hp-hero {
    position: relative;
    padding: 72px 24px 56px;
    max-width: 1120px;
    margin: 0 auto;
    overflow: hidden;
  }
  .hp-hero-glow {
    position: absolute;
    top: -120px;
    left: -60px;
    width: 480px;
    height: 480px;
    background: radial-gradient(circle, rgba(212,255,0,0.06) 0%, transparent 70%);
    pointer-events: none;
    z-index: 0;
  }
  .hp-hero-inner {
    position: relative;
    max-width: 720px;
    z-index: 1;
    animation: hp-hero-enter 0.6s ease-out both;
  }
  @keyframes hp-hero-enter {
    from { opacity: 0; transform: translateY(20px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  .hp-hero-eyebrow {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    color: var(--color-accent);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: 16px;
  }
  .hp-hero-title {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: clamp(40px, 6.5vw, 68px);
    line-height: 0.93;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    color: var(--color-text);
    margin-bottom: 16px;
  }
  .hp-hero-accent {
    color: var(--color-accent);
    text-shadow: 0 0 60px rgba(212,255,0,0.25);
  }
  .hp-hero-subtitle {
    font-size: 15px;
    color: var(--color-text-2);
    line-height: 1.5;
    margin-bottom: 28px;
    max-width: 440px;
  }
  .hp-hero-search {
    margin-bottom: 24px;
    max-width: 600px;
  }
  .hp-hero-stats {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 20px;
    padding: 14px 0;
    border-top: 1px solid var(--color-border-subtle);
  }
  .hp-hero-stat {
    display: flex;
    align-items: baseline;
    gap: 6px;
  }
  .hp-hero-stat-val {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 18px;
    color: var(--color-text);
  }
  .hp-hero-stat-lbl {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 10px;
    color: var(--color-text-3);
    letter-spacing: 0.1em;
  }
  .hp-hero-stat-sep {
    width: 1px;
    height: 16px;
    background: var(--color-border);
  }
  .hp-hero-devices {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .hp-hero-device {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    color: var(--color-text-2);
    text-decoration: none;
    border: 1px solid var(--color-border);
    padding: 7px 16px;
    transition: border-color 0.15s, color 0.15s, background 0.15s;
  }
  .hp-hero-device:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
    background: rgba(212,255,0,0.05);
  }
  .hp-hero-device-more {
    color: var(--color-text-3);
  }

  /* ─── 2. LIVE FEED ─── */
  .hp-feed {
    border: 1px solid var(--color-border);
    border-radius: 8px;
    overflow: hidden;
  }
  .hp-feed-header,
  .hp-feed-row {
    display: grid;
    grid-template-columns: 2fr 1.2fr 0.7fr 0.8fr 0.7fr 0.5fr;
    gap: 8px;
    padding: 10px 16px;
    align-items: center;
    font-size: 13px;
  }
  .hp-feed-header {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 500;
    color: var(--color-text-dim);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    background: var(--color-elevated);
    border-bottom: 1px solid var(--color-border);
  }
  .hp-feed-row {
    text-decoration: none;
    color: var(--color-text-2);
    border-bottom: 1px solid var(--color-border-subtle);
    transition: background 0.12s;
  }
  .hp-feed-row:last-child {
    border-bottom: none;
  }
  .hp-feed-row:hover {
    background: var(--color-elevated);
  }
  .hp-feed-row:hover .hp-feed-name {
    color: var(--color-accent);
  }
  .hp-feed-name {
    color: var(--color-text);
    font-weight: 500;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    transition: color 0.12s;
  }
  .hp-fps-badge {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 12px;
    display: inline-flex;
    align-items: baseline;
    gap: 2px;
  }
  .hp-fps-unit {
    font-size: 9px;
    font-weight: 500;
    opacity: 0.6;
    text-transform: uppercase;
  }
  .fps-green  { color: var(--color-fps-green); }
  .fps-yellow { color: var(--color-fps-yellow); }
  .fps-orange { color: var(--color-fps-orange); }
  .fps-red    { color: var(--color-fps-red); }
  .hp-feed-col-device,
  .hp-feed-col-preset,
  .hp-feed-col-battery,
  .hp-feed-col-time {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-text-3);
  }

  /* ─── 3. TOP GAMES + DEVICES ─── */
  .hp-split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
  }
  .hp-top-games {
    border: 1px solid var(--color-border);
    border-radius: 8px;
    overflow: hidden;
  }
  .hp-top-game-row {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 8px 14px;
    text-decoration: none;
    border-bottom: 1px solid var(--color-border-subtle);
    transition: background 0.12s;
  }
  .hp-top-game-row:last-child { border-bottom: none; }
  .hp-top-game-row:hover { background: var(--color-elevated); }
  .hp-top-game-row:hover .hp-top-game-name {
    color: var(--color-accent);
  }
  .hp-top-game-rank {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 500;
    color: var(--color-text-dim);
    width: 22px;
    flex-shrink: 0;
  }
  .hp-top-game-thumb {
    width: 56px;
    height: 26px;
    border-radius: 3px;
    overflow: hidden;
    flex-shrink: 0;
    background: var(--color-elevated);
  }
  .hp-top-game-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hp-top-game-info {
    flex: 1;
    min-width: 0;
  }
  .hp-top-game-name {
    display: block;
    font-size: 13px;
    font-weight: 500;
    color: var(--color-text);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    transition: color 0.12s;
  }
  .hp-top-game-genre {
    display: block;
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--color-text-dim);
    margin-top: 1px;
  }
  .hp-top-game-score {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 13px;
    flex-shrink: 0;
    min-width: 28px;
    text-align: right;
  }
  .hp-top-game-score.score-high { color: #22c55e; }
  .hp-top-game-score.score-mid  { color: #eab308; }
