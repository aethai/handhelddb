---
import BaseLayout from '@layouts/BaseLayout.astro';
import SearchBar from '@components/react/SearchBar';
import SectionHeader from '@components/astro/SectionHeader.astro';
import { supabaseAdmin } from '@lib/db/client';
import { getCached, setCache } from '@lib/cache';

// ─── Cached homepage data (2 min TTL) ───
const CACHE_KEY = 'homepage:data';
let _cached = getCached<any>(CACHE_KEY);

if (!_cached) {
const [
  devicesRes, gameCountRes, deviceCountRes,
  reportCountRes, articlesRes, trendingRes, userCountRes,
  perfReportsRes,
] = await Promise.all([
  supabaseAdmin
    .from('devices')
    .select('id, slug, name, manufacturer, chip, battery_wh, msrp_usd')
    .eq('is_active', true)
    .order('name'),
  supabaseAdmin.from('games').select('*', { count: 'exact', head: true }),
  supabaseAdmin.from('devices').select('*', { count: 'exact', head: true }).eq('is_active', true),
  supabaseAdmin.from('performance_reports').select('*', { count: 'exact', head: true }),
  supabaseAdmin
    .from('articles')
    .select('slug, title, lead, category, published_at, cover_image')
    .eq('status', 'published')
    .not('published_at', 'is', null)
    .order('published_at', { ascending: false })
    .limit(4),
  supabaseAdmin
    .from('performance_reports')
    .select('fps_avg, graphics_preset, resolution, overall_rating, created_at, estimated_battery, games(name, slug, header_image), devices(name)')
    .eq('moderation_status', 'approved')
    .order('created_at', { ascending: false })
    .limit(12),
  supabaseAdmin.from('users').select('*', { count: 'exact', head: true }),
  // Combined query for Spotlight + Battle Tested (was 2 separate queries)
  supabaseAdmin
    .from('performance_reports')
    .select('fps_avg, graphics_preset, estimated_battery, overall_rating, games(name, slug, header_image, genres, metacritic_score), devices(name)')
    .eq('moderation_status', 'approved')
    .order('fps_avg', { ascending: false })
    .limit(60),
]);

const gameCount = gameCountRes.count ?? 0;
const deviceCount = deviceCountRes.count ?? 0;
const reportCount = reportCountRes.count ?? 0;
const userCount = userCountRes.count ?? 0;

const devices = (devicesRes.data ?? []).map(d => ({
  slug: d.slug, name: d.name, manufacturer: d.manufacturer,
  chip: d.chip, batteryWh: d.battery_wh, msrpUsd: d.msrp_usd,
}));

const articles = (articlesRes.data ?? []).map(a => ({
  slug: a.slug, title: a.title, lead: a.lead, category: a.category,
  publishedAt: a.published_at ? new Date(a.published_at) : null,
  coverImage: a.cover_image,
}));

// Live feed — recent reports
const seenGames = new Set<string>();
const liveFeed = (trendingRes.data ?? [])
  .filter(r => {
    const name = (r.games as any)?.name;
    if (!name || seenGames.has(name)) return false;
    seenGames.add(name);
    return true;
  })
  .slice(0, 8)
  .map(r => {
    const fps = Math.round(r.fps_avg ?? 0);
    const diffMin = Math.round((Date.now() - new Date(r.created_at).getTime()) / 60000);
    let timeAgo: string;
    if (diffMin < 1) timeAgo = 'now';
    else if (diffMin < 60) timeAgo = `${diffMin}m`;
    else if (diffMin < 1440) timeAgo = `${Math.round(diffMin / 60)}h`;
    else timeAgo = `${Math.round(diffMin / 1440)}d`;
    return {
      name: (r.games as any).name,
      slug: (r.games as any).slug,
      thumb: (r.games as any)?.header_image ?? null,
      device: (r.devices as any)?.name?.replace('ASUS ', '').replace('Lenovo ', '') ?? '',
      fps,
      preset: r.graphics_preset ?? '—',
      battery: r.estimated_battery ? `~${r.estimated_battery.toFixed(1)}h` : '—',
      timeAgo,
    };
  });

// Performance data — single query powers both Spotlight and Battle Tested
const perfData = perfReportsRes.data ?? [];

// Spotlight: aggregate cross-device data for the most-tested game
const spotlightMap = new Map<string, { name: string; slug: string; image: string; genres: string[]; metacritic: number | null; devices: { name: string; fps: number; preset: string; battery: number | null }[] }>();
for (const r of perfData) {
  const g = r.games as any;
  const d = r.devices as any;
  if (!g?.name || !d?.name) continue;
  if (!spotlightMap.has(g.slug)) {
    spotlightMap.set(g.slug, {
      name: g.name, slug: g.slug, image: g.header_image ?? '',
      genres: ((g.genres as string[]) ?? []).slice(0, 2),
      metacritic: g.metacritic_score,
      devices: [],
    });
  }
  const entry = spotlightMap.get(g.slug)!;
  const deviceName = d.name.replace('ASUS ', '').replace('Lenovo ', '');
  if (!entry.devices.some(dd => dd.name === deviceName)) {
    entry.devices.push({
      name: deviceName,
      fps: Math.round(r.fps_avg ?? 0),
      preset: r.graphics_preset ?? '—',
      battery: r.estimated_battery ?? null,
    });
  }
}
const spotlight = [...spotlightMap.values()]
  .filter(s => s.devices.length >= 2 && s.image)
  .sort((a, b) => b.devices.length - a.devices.length)[0] ?? null;

// Battle Tested: top game+device combos (data already sorted by fps desc)
const seenBattle = new Set<string>();
const battleTested = perfData
  .filter(r => {
    const g = r.games as any;
    const d = r.devices as any;
    if (!g?.name || !d?.name) return false;
    const key = `${g.slug}|${d.name}`;
    if (seenBattle.has(key)) return false;
    seenBattle.add(key);
    return true;
  })
  .slice(0, 6)
  .map((r, i) => {
    const g = r.games as any;
    const d = r.devices as any;
    return {
      rank: i + 1,
      game: g.name,
      gameSlug: g.slug,
      gameImage: g.header_image ?? '',
      device: d.name.replace('ASUS ', '').replace('Lenovo ', ''),
      fps: Math.round(r.fps_avg ?? 0),
      preset: r.graphics_preset ?? '—',
      battery: r.estimated_battery ? `~${r.estimated_battery.toFixed(1)}h` : null,
      rating: r.overall_rating ?? null,
    };
  });

  _cached = { gameCount, deviceCount, reportCount, userCount, devices, articles, liveFeed, spotlight, battleTested };
  setCache(CACHE_KEY, _cached, 120);
}

const { gameCount, deviceCount, reportCount, userCount, devices, articles, liveFeed, spotlight, battleTested } = _cached;

// Helpers
const fmtDate = (d: Date | null) => d ? d.toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) : '';
const categoryTag: Record<string, string> = {
  game_launch: 'EDITORIAL', game_patch: 'UPDATE', os_update: 'UPDATE',
  performance_analysis: 'EDITORIAL', device_launch: 'UPDATE',
  editorial: 'EDITORIAL', sale_event: 'GUIDE',
};

const featuredDevices = [
  { name: 'Deck', slug: 'steam-deck-oled' },
  { name: 'Ally', slug: 'rog-ally' },
  { name: 'Ally X', slug: 'rog-ally-x' },
  { name: 'Legion Go', slug: 'legion-go' },
  { name: 'Claw 8', slug: 'msi-claw-8-ai-plus' },
].filter(fd => devices.some(d => d.slug === fd.slug));
const extraDeviceCount = Math.max(0, (devices.length) - featuredDevices.length);

// Milestone for CTA
const milestones = [50, 100, 250, 500, 1000, 2000, 5000, 10000, 25000, 50000];
const nextMilestone = milestones.find(m => m > reportCount) ?? milestones[milestones.length - 1];
const prevMilestone = milestones[milestones.indexOf(nextMilestone) - 1] ?? 0;
const ctaPct = Math.min(((reportCount - prevMilestone) / (nextMilestone - prevMilestone)) * 100, 100);

// Manufacturer logo mapping
const mfrLogo: Record<string, string> = {
  'Valve': '/img/devices/steam.svg',
  'ASUS': '/img/devices/rog.svg',
  'Lenovo': '/img/devices/lenovo.svg',
  'MSI': '/img/devices/msi.svg',
  'Ayaneo': '/img/devices/ayaneo.svg',
  'GPD': '/img/devices/gpd.svg',
  'Nintendo': '/img/devices/nintendo.svg',
};

// Schema.org
const siteUrl = import.meta.env.PUBLIC_SITE_URL ?? 'https://handheldgamedb.com';
const schemaWebSite = {
  '@context': 'https://schema.org', '@type': 'WebSite',
  name: 'HandheldDB', url: siteUrl,
  description: `Performance database for handheld gaming. ${gameCount.toLocaleString()} games, ${deviceCount} devices, ${reportCount.toLocaleString()} community reports.`,
  potentialAction: { '@type': 'SearchAction', target: `${siteUrl}/games?q={search_term_string}`, 'query-input': 'required name=search_term_string' },
};
---

<BaseLayout title="HandheldDB — Does it run on your handheld?" description={`The handheld gaming performance database. ${gameCount.toLocaleString()} games tested across ${deviceCount} devices with ${reportCount.toLocaleString()} community reports.`}>

<script type="application/ld+json" set:html={JSON.stringify(schemaWebSite)} />

<div class="hp-wrap">
  <div class="hp-scanlines" aria-hidden="true"></div>

  <!-- ══════ 1. COMMAND CENTER (Hero) ══════ -->
  <section class="hp-hero">
    <div class="hp-hero-glow"></div>
    <div class="hp-hero-grid-bg"></div>
    <div class="hp-hero-inner">
      <div class="hp-hero-content">
        <p class="hp-hero-eyebrow">COMMUNITY-POWERED PERFORMANCE DATABASE</p>
        <h1 class="hp-hero-title">
          DOES IT RUN<br/>ON YOUR<br/><span class="hp-hero-accent">HANDHELD?</span>
        </h1>
        <p class="hp-hero-subtitle">Real FPS data from real devices. Find out before you buy.</p>

        <div class="hp-hero-search">
          <SearchBar client:load variant="hero" placeholder={`Search ${gameCount.toLocaleString()} games...`} />
        </div>

        <div class="hp-hero-stats">
          <div class="hp-hero-stat">
            <svg class="hp-stat-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="6" width="20" height="12" rx="2"/><path d="M6 12h4m-2-2v4m8-1h.01M18 11h.01"/></svg>
            <span class="hp-hero-stat-val">{gameCount.toLocaleString()}</span>
            <span class="hp-hero-stat-lbl">GAMES</span>
          </div>
          <div class="hp-hero-stat-sep"></div>
          <div class="hp-hero-stat">
            <svg class="hp-stat-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
            <span class="hp-hero-stat-val">{reportCount.toLocaleString()}</span>
            <span class="hp-hero-stat-lbl">REPORTS</span>
          </div>
          <div class="hp-hero-stat-sep"></div>
          <div class="hp-hero-stat">
            <svg class="hp-stat-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="2" width="14" height="20" rx="2"/><line x1="12" y1="18" x2="12" y2="18.01"/></svg>
            <span class="hp-hero-stat-val">{deviceCount}</span>
            <span class="hp-hero-stat-lbl">DEVICES</span>
          </div>
          {userCount > 0 && (
            <>
              <div class="hp-hero-stat-sep"></div>
              <div class="hp-hero-stat">
                <svg class="hp-stat-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                <span class="hp-hero-stat-val">{userCount.toLocaleString()}</span>
                <span class="hp-hero-stat-lbl">USERS</span>
              </div>
            </>
          )}
        </div>

        <div class="hp-hero-devices">
          {featuredDevices.map(d => (
            <a href={`/devices/${d.slug}`} class="hp-hero-device">{d.name}</a>
          ))}
          {extraDeviceCount > 0 && (
            <a href="/devices" class="hp-hero-device hp-hero-device-more">+{extraDeviceCount} more</a>
          )}
        </div>
      </div>

      {liveFeed.length > 0 && (
        <div class="hp-hero-visual">
          <div class="hp-widget">
            <div class="hp-widget-head">
              <span class="hp-widget-label">LATEST BENCHMARKS</span>
              <span class="hp-widget-live"><span class="hp-widget-dot"></span> LIVE</span>
            </div>
            {liveFeed.slice(0, 4).map(r => {
              const cls = r.fps >= 55 ? 'fps-green' : r.fps >= 40 ? 'fps-yellow' : r.fps >= 30 ? 'fps-orange' : 'fps-red';
              return (
                <div class="hp-widget-row">
                  <div class="hp-widget-info">
                    <span class="hp-widget-game">{r.name}</span>
                    <span class="hp-widget-device">{r.device}</span>
                  </div>
                  <span class={`hp-widget-fps ${cls}`}>{r.fps}<span class="hp-fps-unit">fps</span></span>
                </div>
              );
            })}
          </div>
        </div>
      )}
    </div>
  </section>

  <!-- ══════ LIVE TICKER ══════ -->
  {liveFeed.length > 0 && (
    <div class="hp-ticker" aria-hidden="true">
      <div class="hp-ticker-track">
        {[...liveFeed, ...liveFeed, ...liveFeed].map(r => {
          const cls = r.fps >= 55 ? 'fps-green' : r.fps >= 40 ? 'fps-yellow' : r.fps >= 30 ? 'fps-orange' : 'fps-red';
          return (
            <span class="hp-ticker-item">
              <span class="hp-ticker-game">{r.name}</span>
              <span class="hp-ticker-sep">—</span>
              <span class="hp-ticker-device">{r.device}</span>
              <span class={`hp-ticker-fps ${cls}`}>{r.fps} FPS</span>
              <span class="hp-ticker-dot"></span>
            </span>
          );
        })}
      </div>
    </div>
  )}

  <div class="hp-main">

    <!-- ══════ 2. COMMUNITY PULSE — Visual Cards ══════ -->
    {liveFeed.length > 0 && (
      <section class="hp-section hp-section-animate hp-section-divider">
        <SectionHeader title="Community Pulse" href="/games" linkText="View all" editorial="JUST TESTED" />
        <div class="hp-pulse-grid">
          {liveFeed.slice(0, 6).map((r, i) => {
            const fpsClass = r.fps >= 55 ? 'fps-green' : r.fps >= 40 ? 'fps-yellow' : r.fps >= 30 ? 'fps-orange' : 'fps-red';
            const isLarge = i < 2;
            return (
              <a href={`/games/${r.slug}`} class={`hp-pulse-card ${isLarge ? 'hp-pulse-card-lg' : ''}`}>
                <div class="hp-pulse-card-img">
                  {r.thumb ? (
                    <img src={r.thumb} alt="" loading="lazy" />
                  ) : (
                    <div class="hp-pulse-card-placeholder"></div>
                  )}
                  <div class="hp-pulse-card-gradient"></div>
                  <span class={`hp-pulse-card-fps ${fpsClass}`}>{r.fps}<span class="hp-fps-unit">fps</span></span>
                  <span class="hp-pulse-card-time">{r.timeAgo}</span>
                </div>
                <div class="hp-pulse-card-body">
                  <span class="hp-pulse-card-name">{r.name}</span>
                  <div class="hp-pulse-card-meta">
                    <span class="hp-pulse-card-device">
                      <svg class="hp-pulse-device-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="5" y="2" width="14" height="20" rx="2"/><line x1="12" y1="18" x2="12" y2="18.01"/></svg>
                      {r.device}
                    </span>
                    <span class="hp-pulse-card-preset">{r.preset}</span>
                  </div>
                </div>
              </a>
            );
          })}
        </div>
      </section>
    )}

    <!-- ══════ 3. PERFORMANCE HUB (Spotlight + Leaderboard combined) ══════ -->
    {(spotlight || battleTested.length > 0) && (
      <section class="hp-section hp-section-alt hp-section-animate hp-section-divider">
        <SectionHeader title="Performance Hub" href="/games" linkText="Explore all" editorial="BENCHMARKS" />

        <div class="hp-perfhub">
          {/* Left: Featured game spotlight */}
          {spotlight && (
            <a href={`/games/${spotlight.slug}`} class="hp-perfhub-spotlight">
              <div class="hp-spotlight-hero">
                <img src={spotlight.image} alt={spotlight.name} class="hp-spotlight-bg" loading="lazy" />
                <div class="hp-spotlight-overlay"></div>
                <div class="hp-spotlight-info">
                  <div class="hp-spotlight-meta">
                    {spotlight.metacritic && (
                      <span class={`hp-spotlight-score ${spotlight.metacritic >= 80 ? 'score-high' : spotlight.metacritic >= 60 ? 'score-mid' : 'score-low'}`}>{spotlight.metacritic}</span>
                    )}
                    {spotlight.genres.length > 0 && <span class="hp-spotlight-genre">{spotlight.genres.join(' · ')}</span>}
                  </div>
                  <h3 class="hp-spotlight-title">{spotlight.name}</h3>
                  <p class="hp-spotlight-subtitle">Tested on {spotlight.devices.length} devices</p>
                </div>
              </div>
              <div class="hp-spotlight-bars">
                <div class="hp-spotlight-bars-header">
                  <span class="hp-spotlight-bars-label">CROSS-DEVICE FPS</span>
                  <span class="hp-spotlight-bars-unit">AVG</span>
                </div>
                {spotlight.devices.slice(0, 4).map(d => {
                  const maxFps = Math.max(...spotlight.devices.map(dd => dd.fps));
                  const pct = maxFps > 0 ? (d.fps / maxFps) * 100 : 0;
                  const cls = d.fps >= 55 ? 'bar-green' : d.fps >= 40 ? 'bar-yellow' : d.fps >= 30 ? 'bar-orange' : 'bar-red';
                  return (
                    <div class="hp-spotlight-bar-row">
                      <span class="hp-spotlight-bar-device">{d.name}</span>
                      <div class="hp-spotlight-bar-track">
                        <div class={`hp-spotlight-bar-fill ${cls}`} style={`width:${pct}%`}></div>
                      </div>
                      <span class={`hp-spotlight-bar-fps ${cls}`}>{d.fps}<span class="hp-fps-unit">fps</span></span>
                    </div>
                  );
                })}
              </div>
            </a>
          )}

          {/* Right: Leaderboard */}
          {battleTested.length > 0 && (
            <div class="hp-perfhub-board">
              <div class="hp-perfhub-board-header">
                <span class="hp-perfhub-board-label">TOP COMBOS</span>
                <span class="hp-perfhub-board-label">FPS</span>
              </div>
              {battleTested.map(b => {
                const fpsClass = b.fps >= 55 ? 'fps-green' : b.fps >= 40 ? 'fps-yellow' : b.fps >= 30 ? 'fps-orange' : 'fps-red';
                return (
                  <a href={`/games/${b.gameSlug}`} class="hp-battle-row">
                    <span class="hp-battle-rank">#{b.rank}</span>
                    <div class="hp-battle-thumb-wrap">
                      {b.gameImage && <img src={b.gameImage} alt="" class="hp-battle-thumb" loading="lazy" />}
                    </div>
                    <div class="hp-battle-info">
                      <span class="hp-battle-game">{b.game}</span>
                      <span class="hp-battle-device">
                        <svg class="hp-battle-device-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="2" width="14" height="20" rx="2"/><line x1="12" y1="18" x2="12" y2="18.01"/></svg>
                        {b.device}
                      </span>
                    </div>
                    <div class="hp-battle-stats">
                      <span class={`hp-battle-fps ${fpsClass}`}>{b.fps}<span class="hp-fps-unit">fps</span></span>
                      <span class="hp-battle-preset">{b.preset}</span>
                    </div>
                  </a>
                );
              })}
            </div>
          )}
        </div>
      </section>
    )}

    <!-- ══════ 4b. PICK YOUR DEVICE ══════ -->
    <section class="hp-section hp-section-animate hp-section-divider">
      <SectionHeader title="Pick Your Device" href="/devices" linkText="All devices" editorial="COMPARE" />
      <div class="hp-devices2-grid">
        {devices.slice(0, 6).map(d => (
          <a href={`/devices/${d.slug}`} class="hp-device2-card">
            <div class="hp-device2-top">
              {mfrLogo[d.manufacturer] && (
                <img src={mfrLogo[d.manufacturer]} alt="" class="hp-device2-logo" loading="lazy" />
              )}
              <span class="hp-device2-mfr">{d.manufacturer}</span>
            </div>
            <span class="hp-device2-name">{d.name}</span>
            <div class="hp-device2-specs">
              <div class="hp-device2-spec">
                <svg class="hp-device2-spec-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="16" height="16" rx="2"/><rect x="9" y="9" width="6" height="6"/><line x1="9" y1="1" x2="9" y2="4"/><line x1="15" y1="1" x2="15" y2="4"/><line x1="9" y1="20" x2="9" y2="23"/><line x1="15" y1="20" x2="15" y2="23"/><line x1="20" y1="9" x2="23" y2="9"/><line x1="20" y1="14" x2="23" y2="14"/><line x1="1" y1="9" x2="4" y2="9"/><line x1="1" y1="14" x2="4" y2="14"/></svg>
                <span>{d.chip}</span>
              </div>
              {d.batteryWh && (
                <div class="hp-device2-spec">
                  <svg class="hp-device2-spec-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="6" width="18" height="12" rx="2"/><line x1="23" y1="10" x2="23" y2="14"/></svg>
                  <span>{d.batteryWh} Wh</span>
                </div>
              )}
            </div>
            {d.msrpUsd && (
              <div class="hp-device2-price">
                <span class="hp-device2-price-from">from</span>
                <span class="hp-device2-price-val">${d.msrpUsd}</span>
              </div>
            )}
            <span class="hp-device2-cta">View benchmarks →</span>
          </a>
        ))}
      </div>
    </section>

    <!-- ══════ 5. NEWS — Editorial Highlights ══════ -->
    {articles.length > 0 && (
      <section class="hp-section hp-section-alt hp-section-animate hp-section-divider">
        <SectionHeader title="Editorial" href="/news" linkText="All articles" editorial="NEWS & GUIDES" />
        <div class="hp-editorial">
          {articles[0] && (
            <a href={`/news/${articles[0].slug}`} class="hp-editorial-hero">
              <div class="hp-editorial-hero-img">
                {articles[0].coverImage ? (
                  <img src={articles[0].coverImage} alt={articles[0].title} loading="lazy" />
                ) : (
                  <div class="hp-editorial-hero-placeholder"></div>
                )}
                <div class="hp-editorial-hero-gradient"></div>
              </div>
              <div class="hp-editorial-hero-content">
