---
import BaseLayout from '@layouts/BaseLayout.astro';
import SearchBar from '@components/react/SearchBar';
import { supabaseAdmin } from '@lib/db/client';
import { getCached, setCache } from '@lib/cache';

// ─── Cached homepage data (2 min TTL) ───
const CACHE_KEY = 'homepage:data';
let _cached = getCached<any>(CACHE_KEY);

if (!_cached) {
const [
  devicesRes, topGamesRes, gameCountRes, deviceCountRes,
  reportCountRes, articlesRes, bestOnDeckRes, trendingRes,
  mostTestedRes, userCountRes, featuredGameRes,
] = await Promise.all([
  supabaseAdmin
    .from('devices')
    .select('id, slug, name, manufacturer, chip, battery_wh, msrp_usd, tdp_min, tdp_max')
    .eq('is_active', true)
    .order('name'),
  supabaseAdmin
    .from('games')
    .select('slug, name, header_image, genres, deck_compatibility, metacritic_score, developers, steam_review_score')
    .not('header_image', 'is', null)
    .not('metacritic_score', 'is', null)
    .order('metacritic_score', { ascending: false, nullsFirst: false })
    .limit(8),
  supabaseAdmin.from('games').select('*', { count: 'exact', head: true }),
  supabaseAdmin.from('devices').select('*', { count: 'exact', head: true }).eq('is_active', true),
  supabaseAdmin.from('performance_reports').select('*', { count: 'exact', head: true }),
  supabaseAdmin
    .from('articles')
    .select('slug, title, lead, category, tags, devices, published_at, cover_image')
    .eq('status', 'published')
    .not('published_at', 'is', null)
    .order('published_at', { ascending: false })
    .limit(3),
  supabaseAdmin
    .from('consensus_ratings')
    .select('fps_avg, estimated_battery, overall_verdict, confidence_level, report_count, games(name, slug, header_image, genres), devices(slug, name)')
    .gte('fps_avg', 55)
    .order('report_count', { ascending: false })
    .limit(8),
  supabaseAdmin
    .from('performance_reports')
    .select('fps_avg, overall_rating, created_at, games(name, slug, genres), devices(name)')
    .eq('moderation_status', 'approved')
    .order('created_at', { ascending: false })
    .limit(20),
  supabaseAdmin
    .from('consensus_ratings')
    .select('fps_avg, report_count, overall_verdict, games(name, slug, header_image), devices(slug)')
    .order('report_count', { ascending: false })
    .limit(10),
  supabaseAdmin.from('users').select('*', { count: 'exact', head: true }),
  supabaseAdmin
    .from('consensus_ratings')
    .select('fps_avg, overall_verdict, report_count, games(name, slug, header_image, genres, developers, metacritic_score), devices(name, slug)')
    .order('report_count', { ascending: false })
    .limit(5),
]);

// ─── Process data ───
const gameCount = gameCountRes.count ?? 0;
const deviceCount = deviceCountRes.count ?? 0;
const reportCount = reportCountRes.count ?? 0;
const userCount = userCountRes.count ?? 0;

const devices = (devicesRes.data ?? []).map(d => ({
  id: d.id, slug: d.slug, name: d.name, manufacturer: d.manufacturer,
  chip: d.chip, batteryWh: d.battery_wh, msrpUsd: d.msrp_usd,
  tdpMin: d.tdp_min, tdpMax: d.tdp_max,
}));

const gameGrid = (topGamesRes.data ?? []).slice(0, 8).map(g => ({
  slug: g.slug, name: g.name, headerImage: g.header_image,
  genres: ((g.genres as string[]) ?? []).slice(0, 2),
  developers: ((g.developers as string[]) ?? [])[0] ?? '',
  metacritic: g.metacritic_score, deckCompat: g.deck_compatibility,
}));

// Featured game for hero — pick one with header_image on Deck
const featuredRaw = (featuredGameRes.data ?? []).find(r =>
  (r.games as any)?.header_image && (r.devices as any)?.slug?.includes('deck')
);
const featured = featuredRaw ? {
  name: (featuredRaw.games as any).name,
  slug: (featuredRaw.games as any).slug,
  headerImage: (featuredRaw.games as any).header_image,
  fps: Math.round(featuredRaw.fps_avg ?? 0),
  verdict: featuredRaw.overall_verdict,
  device: (featuredRaw.devices as any)?.name ?? '',
  reports: featuredRaw.report_count ?? 0,
} : null;

const articles = (articlesRes.data ?? []).map(a => ({
  slug: a.slug, title: a.title, lead: a.lead, category: a.category,
  tags: (a.tags as string[]) ?? [], devices: (a.devices as string[]) ?? [],
  publishedAt: a.published_at ? new Date(a.published_at) : null,
  coverImage: a.cover_image,
}));

// Best on Deck — need >= 2 to show section
const bestOnDeck = (bestOnDeckRes.data ?? [])
  .filter(r => (r.games as any)?.name && (r.devices as any)?.slug?.includes('deck'))
  .slice(0, 4)
  .map(r => ({
    name: (r.games as any).name, slug: (r.games as any).slug,
    headerImage: (r.games as any).header_image,
    fps: Math.round(r.fps_avg ?? 0),
    battery: r.estimated_battery ? `~${r.estimated_battery.toFixed(0)}h` : '?',
    reportCount: r.report_count ?? 0,
  }));

// Cross-dedup: collect slugs already shown in featured + best-on-deck
const shownSlugs = new Set<string>();
if (featured) shownSlugs.add(featured.slug);
for (const b of bestOnDeck) shownSlugs.add(b.slug);

// Trending — deduplicate, exclude already-shown games
const seenGames = new Set<string>();
const trending = (trendingRes.data ?? [])
  .filter(r => {
    const name = (r.games as any)?.name;
    const slug = (r.games as any)?.slug;
    if (!name || seenGames.has(name) || shownSlugs.has(slug)) return false;
    seenGames.add(name);
    return true;
  })
  .slice(0, 6)
  .map(r => {
    const fps = Math.round(r.fps_avg ?? 0);
    const diffH = Math.round((Date.now() - new Date(r.created_at).getTime()) / 3600000);
    const timeAgo = diffH < 1 ? 'now' : diffH < 24 ? `${diffH}h ago` : `${Math.round(diffH / 24)}d ago`;
    return {
      name: (r.games as any).name, slug: (r.games as any).slug,
      genres: (((r.games as any).genres as string[]) ?? []).slice(0, 1),
      device: (r.devices as any)?.name?.replace('ASUS ', '').replace('Lenovo ', '').replace(' OLED', '') ?? '',
      fps, rating: r.overall_rating, timeAgo,
    };
  });

// Most tested — aggregate by game, exclude already-shown
const gameMap = new Map<string, { name: string; slug: string; rpts: number; devs: number; headerImage: string | null }>();
for (const r of (mostTestedRes.data ?? [])) {
  const name = (r.games as any)?.name;
  const slug = (r.games as any)?.slug;
  const headerImage = (r.games as any)?.header_image ?? null;
  if (!name || shownSlugs.has(slug)) continue;
  const existing = gameMap.get(slug);
  if (existing) { existing.rpts += r.report_count ?? 0; existing.devs += 1; }
  else { gameMap.set(slug, { name, slug, rpts: r.report_count ?? 0, devs: 1, headerImage }); }
}
const mostTested = Array.from(gameMap.values())
  .sort((a, b) => b.rpts - a.rpts).slice(0, 6)
  .map((g, i) => ({ ...g, rank: i + 1 }));

  _cached = { gameCount, deviceCount, reportCount, userCount, devices, gameGrid, featured, articles, bestOnDeck, trending, mostTested };
  setCache(CACHE_KEY, _cached, 120); // 2 minutes
}

const { gameCount, deviceCount, reportCount, userCount, devices, gameGrid, featured, articles, bestOnDeck, trending, mostTested } = _cached;

// ─── Helpers ───
const fmtDate = (d: Date | null) => d ? d.toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) : '';
const fpsColor = (fps: number) => fps >= 55 ? '#4ade80' : fps >= 45 ? '#a3e635' : fps >= 35 ? '#facc15' : fps >= 25 ? '#fb923c' : '#f87171';
const fpsTierIcon = (fps: number) => fps >= 55 ? '★' : fps >= 45 ? '◆' : fps >= 35 ? '●' : fps >= 25 ? '▼' : '✕';
const tierLabel = (rating: string | null) => {
  if (!rating) return { label: 'Unknown', color: '#6d6882' };
  const map: Record<string, { label: string; color: string }> = {
    excellent: { label: 'Portable Perfect', color: '#4ade80' },
    good: { label: 'Commute Ready', color: '#a3e635' },
    fair: { label: 'Playable', color: '#facc15' },
    poor: { label: 'Rough Ride', color: '#fb923c' },
    unplayable: { label: 'Unplayable', color: '#f87171' },
  };
  return map[rating] ?? { label: rating, color: '#6d6882' };
};
const categoryTag: Record<string, { label: string; color: string }> = {
  'game_launch': { label: 'EDITORIAL', color: '#a78bfa' },
  'game_patch': { label: 'UPDATE', color: '#60a5fa' },
  'os_update': { label: 'UPDATE', color: '#60a5fa' },
  'performance_analysis': { label: 'EDITORIAL', color: '#a78bfa' },
  'device_launch': { label: 'UPDATE', color: '#60a5fa' },
  'editorial': { label: 'EDITORIAL', color: '#a78bfa' },
  'sale_event': { label: 'GUIDE', color: '#4ade80' },
};

const featuredDevices = [
  { name: 'Steam Deck', slug: 'steam-deck-oled', short: 'Deck', color: '#4ea8f0' },
  { name: 'ROG Ally', slug: 'rog-ally', short: 'Ally', color: '#ff4060' },
  { name: 'ROG Ally X', slug: 'rog-ally-x', short: 'Ally X', color: '#ff4060' },
  { name: 'Legion Go', slug: 'legion-go', short: 'Legion', color: '#e04040' },
  { name: 'Legion Go S', slug: 'legion-go-s', short: 'Go S', color: '#e06040' },
  { name: 'MSI Claw 8', slug: 'msi-claw-8-ai-plus', short: 'Claw 8', color: '#ff2020' },
].filter(fd => devices.some(d => d.slug === fd.slug));

const heroFpsColor = featured ? fpsColor(featured.fps) : '#4ade80';
const heroTier = featured ? tierLabel(featured.verdict) : { label: 'Unknown', color: '#6d6882' };

// Minimum thresholds — graceful degradation
const showTicker = trending.length >= 3;
const showBestOnDeck = bestOnDeck.length >= 2;
const showTrending = trending.length >= 2;
const showMostTested = mostTested.length >= 2;
const showCommunityActivity = showTrending || showMostTested;
const showContributors = userCount >= 10;

// Schema.org
const siteUrl = import.meta.env.PUBLIC_SITE_URL ?? 'https://handheldgamedb.com';
const schemaWebSite = {
  '@context': 'https://schema.org', '@type': 'WebSite',
  name: 'HandheldDB', url: siteUrl,
  description: `Performance database for handheld gaming. ${gameCount.toLocaleString()} games, ${deviceCount} devices, ${reportCount.toLocaleString()} community reports.`,
  potentialAction: { '@type': 'SearchAction', target: `${siteUrl}/games?q={search_term_string}`, 'query-input': 'required name=search_term_string' },
};
const schemaItemList = {
  '@context': 'https://schema.org', '@type': 'ItemList',
  name: 'Best Games on Steam Deck', numberOfItems: bestOnDeck.length,
  itemListElement: bestOnDeck.map((g, i) => ({ '@type': 'ListItem', position: i + 1, url: `${siteUrl}/games/${g.slug}`, name: g.name })),
};
---

<BaseLayout title="HandheldDB — Does it run on your handheld?" description={`The handheld gaming performance database. ${gameCount.toLocaleString()} games tested across ${deviceCount} devices with ${reportCount.toLocaleString()} community reports. Find optimal settings for Steam Deck, ROG Ally, Legion Go and more.`}>

<script type="application/ld+json" set:html={JSON.stringify(schemaWebSite)} />
<script type="application/ld+json" set:html={JSON.stringify(schemaItemList)} />

<div class="page-wrap">

  <!-- ══════ 1. HERO — Split Data Hero ══════ -->
  <section class="hp-hero">
    <div class="hp-hero-bg">
      {featured?.headerImage && <img src={featured.headerImage} alt="" class="hp-hero-bg-img" fetchpriority="high" />}
    </div>
    <div class="hp-hero-overlay"></div>
    <div class="hp-hero-grain"></div>

    <div class="hw" style="position:relative;z-index:2;">
      <div class="hp-hero-split">
        <!-- Left: Editorial hero content -->
        <div>
          <span class="editorial-label" style="margin-bottom:12px;">PERFORMANCE DATABASE</span>
          <h1 class="hp-hero-title" style="line-height:1.05;">
            Real FPS.<br/>Real hardware.<br/><span style="color:#4ade80;">Every handheld.</span>
          </h1>
          <p class="hp-hero-sub" style="margin-top:14px;">
            Community-tested performance data from <strong style="color:#9890a8;font-weight:600;">{reportCount.toLocaleString()}</strong> reports across <strong style="color:#9890a8;font-weight:600;">{deviceCount}</strong> devices. Find the settings that actually work.
          </p>

          <div class="hp-hero-search" style="margin-top:20px;">
            <SearchBar client:load variant="hero" placeholder={`Search ${gameCount.toLocaleString()} games...`} />
          </div>

          <div class="hp-device-pills" style="margin-top:14px;">
            {featuredDevices.map(d => (
              <a href={`/devices/${d.slug}`} class="hp-device-pill" style={`--pill-color:${d.color};`}>{d.short}</a>
            ))}
            <a href="/devices" class="hp-device-pill hp-device-pill-all">All {deviceCount} →</a>
          </div>
        </div>

        <!-- Right: FPS Showcase Card -->
        {featured && (
          <div class="hp-showcase">
            <a href={`/games/${featured.slug}`} style="text-decoration:none;display:block;">
              <div class="hp-showcase-main">
                <div class="hp-showcase-img">
                  {featured.headerImage && <img src={featured.headerImage} alt={featured.name} />}
                </div>
                <div class="hp-showcase-data">
                  <div>
                    <span class="hp-showcase-fps" style={`color:${heroFpsColor};text-shadow:0 0 30px ${heroFpsColor}30;`}>{featured.fps}</span>
                    <span class="hp-showcase-fps-unit">FPS</span>
                  </div>
                  <div class="hp-showcase-game">{featured.name}</div>
                  <div class="hp-showcase-device">{featured.device} · {featured.reports} reports</div>
                </div>
              </div>

              <div class="hp-showcase-meta">
                <div class="hp-showcase-meta-item">
                  <span class="hp-showcase-meta-val" style={`color:${heroTier.color};`}>{heroTier.label}</span>
                  <span class="hp-showcase-meta-lbl">Verdict</span>
                </div>
                <div class="hp-showcase-meta-item">
                  <span class="hp-showcase-meta-val">{featured.reports}</span>
                  <span class="hp-showcase-meta-lbl">Reports</span>
                </div>
              </div>
            </a>

            {bestOnDeck.length > 0 && (
              <div class="hp-showcase-also">
                <div class="hp-showcase-also-label">Also tested on Deck</div>
                {bestOnDeck.slice(0, 3).map(g => (
                  <a href={`/games/${g.slug}`} class="hp-showcase-also-row">
                    <span class="hp-showcase-also-name">{g.name}</span>
                    <span class="hp-showcase-also-fps" style={`color:${fpsColor(g.fps)};`}>{g.fps} fps</span>
                  </a>
                ))}
              </div>
            )}
          </div>
        )}
      </div>
    </div>
  </section>

  <div class="hw">

    <!-- ══════ 2. DATA PROOF BAR — Enhanced Stats ══════ -->
    <section class="hp-stats stagger" aria-label="Site statistics">
      <div class="hp-stat" data-tooltip="Games in our database">
        <div class="hp-stat-value" data-count={gameCount} aria-live="polite">{gameCount.toLocaleString()}</div>
        <div class="hp-stat-label">Games</div>
      </div>
      <div class="hp-stat-divider" aria-hidden="true"></div>
      <div class="hp-stat" data-tooltip="Community performance reports">
        <div class="hp-stat-value" data-count={reportCount} aria-live="polite">{reportCount.toLocaleString()}</div>
        <div class="hp-stat-label">Reports</div>
      </div>
      <div class="hp-stat-divider" aria-hidden="true"></div>
      <div class="hp-stat" data-tooltip="Supported handheld devices">
        <div class="hp-stat-value" data-count={deviceCount} aria-live="polite">{deviceCount}</div>
        <div class="hp-stat-label">Devices</div>
      </div>
      {showContributors && (
        <>
          <div class="hp-stat-divider"></div>
          <div class="hp-stat" data-tooltip="Community members">
            <div class="hp-stat-value" data-count={userCount}>{userCount.toLocaleString()}</div>
            <div class="hp-stat-label">Contributors</div>
          </div>
        </>
      )}
      <div class="hp-stats-live">
        <span class="hp-stats-live-dot"></span>
        LIVE
      </div>
    </section>

    <!-- ══════ 3. FPS TICKER — Enhanced Marquee ══════ -->
    {showTicker && (
      <div class="hp-ticker" style="margin-bottom:40px;">
        <div class="hp-ticker-inner">
          {[...trending, ...trending, ...trending].map((t) => (
            <a href={`/games/${t.slug}`} class="hp-ticker-item" style="text-decoration:none;">
              <span style={`display:inline-block;width:6px;height:6px;border-radius:50%;background:${fpsColor(t.fps)};vertical-align:middle;margin-right:4px;`}></span>
              <span style="color:#9890a8;">{t.name}</span>{' on '}{t.device}
              {' '}<span style={`color:${fpsColor(t.fps)};font-weight:600;`}>{t.fps} fps</span>
              {' · '}<span style="color:#4a4560;">{t.timeAgo}</span>
            </a>
          ))}
        </div>
      </div>
    )}

    <!-- ══════ 4. TOP GAMES — Static Bento Grid ══════ -->
    <section style="margin-bottom:48px;">
      <div class="hp-section-head">
        <h2>Top Rated</h2>
        <a href="/games">View all →</a>
      </div>
      <div class="hp-bento-grid stagger">
        {gameGrid.map((g, i) => {
          const mcColor = g.metacritic >= 80 ? '#4ade80' : g.metacritic >= 60 ? '#facc15' : '#f87171';
          if (i === 0) {
            return (
              <a href={`/games/${g.slug}`} class="hp-bento-card hp-bento-feature">
                <div class="hp-bento-card-img-wrap">
                  {g.headerImage && <img src={g.headerImage} alt={g.name} class="hp-bento-card-img" />}
                </div>
                <div class="hp-bento-overlay"></div>
                {g.metacritic && <span class="hp-bento-mc" style={`color:${mcColor};`}>{g.metacritic}</span>}
                <div class="hp-bento-content">
                  <div class="hp-bento-title">{g.name}</div>
                  <div class="hp-bento-sub">{g.genres.join(' · ')}{g.developers ? ` · ${g.developers}` : ''}</div>
                </div>
              </a>
            );
          }
          return (
            <a href={`/games/${g.slug}`} class="hp-bento-card">
              <div class="hp-bento-small-wrap">
                {g.headerImage ? (
                  <img src={g.headerImage} alt={g.name} class="hp-bento-card-img" loading="lazy" />
                ) : (
                  <div style="width:100%;height:100%;background:#12101a;"></div>
                )}
              </div>
              {g.metacritic && <span class="hp-bento-mc" style={`color:${mcColor};`}>{g.metacritic}</span>}
              <div class="hp-bento-small-body">
                <div class="hp-bento-small-title">{g.name}</div>
                <div class="hp-bento-small-genre">{g.genres.join(' · ')}</div>
              </div>
            </a>
          );
        })}
      </div>
    </section>

    <!-- ══════ 5. BEST ON DECK — Performance Data Table ══════ -->
    {showBestOnDeck && (
      <section style="margin-bottom:48px;">
        <div class="hp-section-head">
          <h2>Best on <span style="color:#4ade80;">Deck</span></h2>
          <a href="/games">View all →</a>
        </div>
        <div class="hp-perf-table">
          <div class="hp-perf-header">
            <span class="hp-perf-col-game">Game</span>
            <span class="hp-perf-col-fps">FPS</span>
            <span class="hp-perf-col-verdict">Verdict</span>
            <span class="hp-perf-col-battery">Battery</span>
            <span class="hp-perf-col-reports">Reports</span>
          </div>
          {bestOnDeck.map((g) => {
            const gc = fpsColor(g.fps);
            const tier = tierLabel(g.fps >= 55 ? 'excellent' : g.fps >= 45 ? 'good' : g.fps >= 35 ? 'fair' : 'poor');
            return (
              <a href={`/games/${g.slug}`} class="hp-perf-row">
                <div class="hp-perf-col-game">
                  <div class="hp-perf-thumb">
                    {g.headerImage && <img src={g.headerImage} alt="" loading="lazy" />}
                  </div>
                  <span class="hp-perf-name">{g.name}</span>
                </div>
                <div class="hp-perf-col-fps">
                  <span class="hp-perf-fps" style={`color:${gc};text-shadow:0 0 12px ${gc}25;`}>{g.fps}</span>
                </div>
                <div class="hp-perf-col-verdict">
                  <span class="hp-perf-verdict" style={`color:${tier.color};background:${tier.color}12;`}>{tier.label}</span>
                </div>
                <div class="hp-perf-col-battery">
                  <span class="hp-perf-battery">{g.battery}</span>
                </div>
                <div class="hp-perf-col-reports">
                  <span class="hp-perf-reports">{g.reportCount} rpts</span>
                </div>
              </a>
            );
          })}
        </div>
      </section>
    )}

    <!-- ══════ 6. LATEST NEWS — Editorial Layout ══════ -->
    {articles.length >= 2 && (
      <section style="margin-bottom:48px;">
        <div class="hp-section-head">
          <h2>Latest News</h2>
          <a href="/news">All articles →</a>
        </div>
        <div class="hp-news-editorial">
          {articles.map((n, i) => {
            const tag = categoryTag[n.category] ?? { label: 'NEWS', color: '#60a5fa' };
            const gradients = [
              'linear-gradient(135deg,#1a0e2e 0%,#0e0c16 60%,rgba(167,139,250,0.08) 100%)',
              'linear-gradient(135deg,#0e0c16 0%,#0c1a1a 50%,rgba(74,222,128,0.06) 100%)',
              'linear-gradient(135deg,#0e0c16 0%,#1a140e 50%,rgba(251,146,60,0.06) 100%)',
            ];
            if (i === 0) {
              return (
                <a href={`/news/${n.slug}`} class="hp-bento-card hp-news-feature" style="text-decoration:none;">
                  {n.coverImage ? (
                    <img src={n.coverImage} alt={n.title} loading="lazy" />
                  ) : (
                    <div style={`position:absolute;inset:0;background:${gradients[0]};`}></div>
                  )}
                  <div class="hp-news-feature-overlay"></div>
                  <div class="hp-news-feature-content">
                    <span style={`font-family:var(--font-mono);font-size:9px;font-weight:700;letter-spacing:0.08em;color:${tag.color};background:${tag.color}12;padding:3px 8px;border-radius:4px;display:inline-block;margin-bottom:8px;`}>{tag.label}</span>
                    <h3 style="font-family:var(--font-display);font-size:20px;font-weight:800;color:#eae6f4;line-height:1.25;margin-bottom:6px;">{n.title}</h3>
                    {n.lead && <p style="font-family:var(--font-display);font-size:13px;color:#9890a8;line-height:1.4;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;">{n.lead}</p>}
                    <div style="font-family:var(--font-mono);font-size:9px;color:#4a4560;margin-top:8px;">HandheldDB · {fmtDate(n.publishedAt)}</div>
                  </div>
                </a>
              );
            }
            return (
              <a href={`/news/${n.slug}`} class="hp-bento-card hp-news-side" style="text-decoration:none;display:flex;gap:12px;padding:14px;">
                <div style="width:80px;height:52px;border-radius:8px;overflow:hidden;flex-shrink:0;background:#12101a;">
                  {n.coverImage ? (
                    <img src={n.coverImage} alt="" style="width:100%;height:100%;object-fit:cover;" loading="lazy" />
                  ) : (
                    <div style={`width:100%;height:100%;background:${gradients[i % gradients.length]};`}></div>
                  )}
                </div>
                <div style="flex:1;min-width:0;">
                  <span style={`font-family:var(--font-mono);font-size:8px;font-weight:700;letter-spacing:0.08em;color:${tag.color};`}>{tag.label}</span>
                  <h3 style="font-family:var(--font-display);font-size:13px;font-weight:700;color:#eae6f4;line-height:1.3;margin-top:2px;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;">{n.title}</h3>
                  <div style="font-family:var(--font-mono);font-size:9px;color:#4a4560;margin-top:4px;">{fmtDate(n.publishedAt)}</div>
                </div>
              </a>
            );
          })}
        </div>
      </section>
    )}

    <!-- ══════ 7. COMMUNITY ACTIVITY — Side-by-Side ══════ -->
    {showCommunityActivity && (
      <section style="margin-bottom:48px;">
        <div class="hp-section-head">
          <h2>Community Activity</h2>
          <a href="/games">Browse all →</a>
        </div>
        <div class="hp-community-grid">
          {showTrending && (
            <div class="hp-community-panel">
              <div class="hp-community-panel-head">Recent Reports</div>
              {trending.map((g, i) => {
                const gc = fpsColor(g.fps);
                const tier = tierLabel(g.rating);
                return (
                  <a href={`/games/${g.slug}`} class="hp-trending-row" style={`border-bottom:${i < trending.length - 1 ? '1px solid rgba(255,255,255,0.04)' : 'none'};`}>
                    <div style={`font-family:var(--font-mono);font-size:24px;font-weight:800;color:${gc};text-shadow:0 0 12px ${gc}20;width:44px;text-align:center;letter-spacing:-0.04em;flex-shrink:0;`}>{g.fps}</div>
                    <div style="flex:1;min-width:0;">
                      <div style="font-family:var(--font-display);font-size:13px;font-weight:700;color:#eae6f4;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">{g.name}</div>
                      <div style="font-family:var(--font-mono);font-size:9px;color:#4a4560;">{g.device} · {g.genres.join(' · ')}</div>
                    </div>
                    <span style={`font-family:var(--font-mono);font-size:9px;font-weight:700;color:${tier.color};letter-spacing:0.04em;flex-shrink:0;`}>{tier.label.toUpperCase()}</span>
                  </a>
                );
              })}
            </div>
          )}

          {showMostTested && (
            <div class="hp-community-panel">
              <div class="hp-community-panel-head">Most Tested</div>
              {mostTested.map((g) => (
                <a href={`/games/${g.slug}`} class="hp-ranked-row">
                  <span class="hp-ranked-num">#{g.rank}</span>
                  <span class="hp-ranked-name">{g.name}</span>
                  <span class="hp-ranked-stat">{g.rpts} rpts · {g.devs} dev</span>
                </a>
              ))}
            </div>
          )}
        </div>
      </section>
    )}

    <!-- ══════ 8. DEVICE SHOWCASE — Featured Device Cards ══════ -->
    <section style="margin-bottom:48px;">
      <div class="hp-section-head">
        <h2>Devices</h2>
        <a href="/devices">All {deviceCount} →</a>
      </div>
      <div class="hp-device-showcase">
        {devices.slice(0, 6).map(d => {
          const accentMap = { 'Valve': '#4ea8f0', 'ASUS': '#ff4060', 'Lenovo': '#e04040', 'MSI': '#ff2020', 'AYANEO': '#ff8040' };
          const accent = accentMap[d.manufacturer] ?? '#a78bfa';
          return (
            <a href={`/devices/${d.slug}`} class="hp-device-showcase-card" style={`--accent-color:${accent};`}>
              <div class="hp-device-showcase-mfr">{d.manufacturer}</div>
              <div class="hp-device-showcase-name">{d.name.replace('ASUS ', '').replace('Lenovo ', '')}</div>
              <div class="hp-device-showcase-specs">
                {d.chip && <span>{d.chip}</span>}
                {d.batteryWh && <span>{d.batteryWh} Wh</span>}
                {d.msrpUsd && <span>${d.msrpUsd}</span>}
              </div>
              <div class="hp-device-showcase-link">View performance →</div>
            </a>
          );
        })}
      </div>
    </section>

    <!-- ══════ 9. CTA — With Progress Bar ══════ -->
    <section style="margin-bottom:48px;">
      <div class="hp-cta">
        <div class="hp-cta-glow"></div>
        <div style="position:relative;z-index:1;">
          <h2 style="font-family:var(--font-display);font-size:clamp(20px,3vw,26px);font-weight:800;color:#eae6f4;margin-bottom:8px;letter-spacing:-0.02em;">Help us benchmark handheld gaming</h2>
          <p style="font-family:var(--font-display);font-size:14px;color:#6d6882;margin-bottom:16px;line-height:1.5;">
            Share your real-world performance data. Every report makes the database more accurate.
          </p>

          {(() => {
            const milestones = [500, 1000, 2000, 5000, 10000, 25000, 50000, 100000];
            const next = milestones.find(m => m > reportCount) ?? milestones[milestones.length - 1];
            const prev = milestones[milestones.indexOf(next) - 1] ?? 0;
            const pct = Math.min(((reportCount - prev) / (next - prev)) * 100, 100);
            return (
              <>
                <div class="hp-cta-progress">
                  <div class="hp-cta-progress-fill" style={`width:${pct}%;`}></div>
                </div>
                <div class="hp-cta-milestone">{reportCount.toLocaleString()} / {next.toLocaleString()} reports — {Math.round(pct)}% to next milestone</div>
              </>
            );
          })()}

          <div style="display:flex;gap:28px;flex-wrap:wrap;margin-top:20px;">
            <div>
              <div style="font-family:var(--font-mono);font-size:16px;font-weight:700;color:#eae6f4;">{reportCount.toLocaleString()}</div>
              <div style="font-family:var(--font-mono);font-size:10px;color:#6d6882;letter-spacing:0.04em;">REPORTS</div>
            </div>
            <div>
              <div style="font-family:var(--font-mono);font-size:16px;font-weight:700;color:#eae6f4;">{gameCount.toLocaleString()}</div>
              <div style="font-family:var(--font-mono);font-size:10px;color:#6d6882;letter-spacing:0.04em;">GAMES</div>
            </div>
            <div>
              <div style="font-family:var(--font-mono);font-size:16px;font-weight:700;color:#eae6f4;">{deviceCount}</div>
              <div style="font-family:var(--font-mono);font-size:10px;color:#6d6882;letter-spacing:0.04em;">DEVICES</div>
            </div>
          </div>
        </div>
        <a href="/report/new" class="hp-cta-btn">SUBMIT A REPORT</a>
      </div>
    </section>

  </div>
</div>

<script>
  // Animated stat counters
  const counters = document.querySelectorAll('.hp-stat-value[data-count]');
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        const el = entry.target as HTMLElement;
        const target = parseInt(el.dataset.count ?? '0', 10);
        if (target === 0) return;
        const start = performance.now();
        const duration = 1200;
        const format = (n: number) => n.toLocaleString();
        const animate = (now: number) => {
          const progress = Math.min((now - start) / duration, 1);
          const eased = 1 - Math.pow(1 - progress, 3);
          el.textContent = format(Math.round(eased * target));
          if (progress < 1) requestAnimationFrame(animate);
        };
        el.textContent = '0';
        requestAnimationFrame(animate);
        observer.unobserve(el);
      }
    });
  }, { threshold: 0.3 });
  counters.forEach(c => observer.observe(c));
</script>

</BaseLayout>
