---
import BaseLayout from '@layouts/BaseLayout.astro';
import SearchBar from '@components/react/SearchBar';
import SectionHeader from '@components/astro/SectionHeader.astro';
import { supabaseAdmin } from '@lib/db/client';
import { getCached, setCache } from '@lib/cache';

// ─── Cached homepage data (2 min TTL) ───
const CACHE_KEY = 'homepage:v2';
let _cached = getCached<any>(CACHE_KEY);

if (!_cached) {
const [
  devicesRes, gameCountRes, deviceCountRes,
  reportCountRes, userCountRes, articlesRes,
  consensusRes, topGamesRes,
] = await Promise.all([
  supabaseAdmin
    .from('devices')
    .select('id, slug, name, manufacturer, chip, battery_wh, msrp_usd')
    .eq('is_active', true)
    .order('name'),
  supabaseAdmin.from('games').select('*', { count: 'exact', head: true }),
  supabaseAdmin.from('devices').select('*', { count: 'exact', head: true }).eq('is_active', true),
  supabaseAdmin.from('performance_reports').select('*', { count: 'exact', head: true }),
  supabaseAdmin.from('users').select('*', { count: 'exact', head: true }),
  supabaseAdmin
    .from('articles')
    .select('slug, title, lead, category, published_at, cover_image')
    .eq('status', 'published')
    .not('published_at', 'is', null)
    .order('published_at', { ascending: false })
    .limit(4),
  // Consensus ratings — all tested game+device combos
  supabaseAdmin
    .from('consensus_ratings')
    .select('fps_avg, overall_verdict, report_count, weighted_score, games(name, slug, header_image), devices(name, slug, manufacturer)')
    .order('report_count', { ascending: false })
    .limit(20),
  // Top games by metacritic — catalog showcase
  supabaseAdmin
    .from('games')
    .select('name, slug, header_image, metacritic_score, deck_compatibility')
    .not('header_image', 'is', null)
    .not('metacritic_score', 'is', null)
    .order('metacritic_score', { ascending: false })
    .limit(12),
]);

const gameCount = gameCountRes.count ?? 0;
const deviceCount = deviceCountRes.count ?? 0;
const reportCount = reportCountRes.count ?? 0;
const userCount = userCountRes.count ?? 0;

const devices = (devicesRes.data ?? []).map(d => ({
  slug: d.slug, name: d.name, manufacturer: d.manufacturer,
  chip: d.chip, batteryWh: d.battery_wh, msrpUsd: d.msrp_usd,
}));

const articles = (articlesRes.data ?? []).map(a => ({
  slug: a.slug, title: a.title, lead: a.lead, category: a.category,
  publishedAt: a.published_at ? new Date(a.published_at) : null,
  coverImage: a.cover_image,
}));

// Community tested — consensus entries with dedup by game
const seenGames = new Set<string>();
const communityTested = (consensusRes.data ?? [])
  .filter(r => {
    const g = r.games as any;
    if (!g?.name || !g?.header_image) return false;
    if (seenGames.has(g.slug)) return false;
    seenGames.add(g.slug);
    return true;
  })
  .map(r => {
    const g = r.games as any;
    const d = r.devices as any;
    const fps = Math.round(r.fps_avg ?? 0);
    return {
      game: g.name, gameSlug: g.slug, gameImage: g.header_image,
      device: d?.name?.replace('ASUS ', '').replace('Lenovo ', '') ?? '',
      deviceSlug: d?.slug ?? '',
      fps, verdict: r.overall_verdict ?? 'unknown',
      reports: r.report_count ?? 0,
    };
  });

// Top metacritic games — catalog showcase
const topGames = (topGamesRes.data ?? [])
  .filter(g => g.header_image)
  .slice(0, 8)
  .map(g => ({
    name: g.name, slug: g.slug, image: g.header_image ?? '',
    metacritic: g.metacritic_score,
    deckCompat: g.deck_compatibility === 'verified' ? 'Verified' : g.deck_compatibility === 'playable' ? 'Playable' : null,
  }));

  _cached = { gameCount, deviceCount, reportCount, userCount, devices, articles, communityTested, topGames };
  setCache(CACHE_KEY, _cached, 120);
}

const { gameCount, deviceCount, reportCount, userCount, devices, articles, communityTested, topGames } = _cached;

// Helpers
const fmtDate = (d: Date | null) => d ? d.toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) : '';
const categoryTag: Record<string, string> = {
  game_launch: 'EDITORIAL', game_patch: 'UPDATE', os_update: 'UPDATE',
  performance_analysis: 'EDITORIAL', device_launch: 'UPDATE',
  editorial: 'EDITORIAL', sale_event: 'GUIDE',
};

const featuredDevices = [
  { name: 'Deck', slug: 'steam-deck-oled' },
  { name: 'Ally', slug: 'rog-ally' },
  { name: 'Ally X', slug: 'rog-ally-x' },
  { name: 'Legion Go', slug: 'legion-go' },
  { name: 'Legion Go S', slug: 'legion-go-s' },
  { name: 'Claw 8', slug: 'msi-claw-8-ai-plus' },
].filter(fd => devices.some(d => d.slug === fd.slug));

// Milestone for CTA
const milestones = [50, 100, 250, 500, 1000, 2000, 5000, 10000, 25000, 50000];
const nextMilestone = milestones.find(m => m > reportCount) ?? milestones[milestones.length - 1];
const prevMilestone = milestones[milestones.indexOf(nextMilestone) - 1] ?? 0;
const ctaPct = Math.min(((reportCount - prevMilestone) / (nextMilestone - prevMilestone)) * 100, 100);

// Schema.org
const siteUrl = import.meta.env.PUBLIC_SITE_URL ?? 'https://handhelddb.com';
const schemaWebSite = {
  '@context': 'https://schema.org', '@type': 'WebSite',
  name: 'HandheldDB', url: siteUrl,
  description: `Performance database for handheld gaming. ${gameCount.toLocaleString()} games, ${deviceCount} devices, ${reportCount.toLocaleString()} community reports.`,
  potentialAction: { '@type': 'SearchAction', target: `${siteUrl}/games?q={search_term_string}`, 'query-input': 'required name=search_term_string' },
};
---

<BaseLayout title="HandheldDB — Does it run on your handheld?" description={`The handheld gaming performance database. ${gameCount.toLocaleString()} games tested across ${deviceCount} devices with ${reportCount.toLocaleString()} community reports.`}>

<script type="application/ld+json" set:html={JSON.stringify(schemaWebSite)} />

<div class="hp-wrap">

  <!-- ══════ 1. HERO — Centered, search-first ══════ -->
  <section class="hp-hero">
    <div class="hp-hero-glow" aria-hidden="true"></div>
    <div class="hp-hero-glow hp-hero-glow-2" aria-hidden="true"></div>
    <div class="hp-hero-grid-bg" aria-hidden="true"></div>
    <div class="hp-hero-inner">
      <p class="hp-hero-eyebrow">COMMUNITY-POWERED PERFORMANCE DATABASE</p>
      <h1 class="hp-hero-title">
        DOES IT RUN<br/>ON YOUR<br/><span class="hp-hero-accent">HANDHELD?</span>
      </h1>
      <p class="hp-hero-subtitle">Real FPS data from real devices. Find out before you buy.</p>

      <div class="hp-hero-search">
        <SearchBar client:load variant="hero" placeholder={`Search ${gameCount.toLocaleString()} games...`} />
      </div>

      <div class="hp-hero-stats">
        <div class="hp-hero-stat">
          <span class="hp-hero-stat-val" data-target={gameCount}>{gameCount.toLocaleString()}</span>
          <span class="hp-hero-stat-lbl">GAMES</span>
        </div>
        <div class="hp-hero-stat-sep"></div>
        <div class="hp-hero-stat">
          <span class="hp-hero-stat-val" data-target={reportCount}>{reportCount.toLocaleString()}</span>
          <span class="hp-hero-stat-lbl">REPORTS</span>
        </div>
        <div class="hp-hero-stat-sep"></div>
        <div class="hp-hero-stat">
          <span class="hp-hero-stat-val" data-target={deviceCount}>{deviceCount}</span>
          <span class="hp-hero-stat-lbl">DEVICES</span>
        </div>
        {userCount > 0 && (
          <>
            <div class="hp-hero-stat-sep"></div>
            <div class="hp-hero-stat">
              <span class="hp-hero-stat-val" data-target={userCount}>{userCount.toLocaleString()}</span>
              <span class="hp-hero-stat-lbl">USERS</span>
            </div>
          </>
        )}
      </div>

      <div class="hp-hero-devices">
        {featuredDevices.map(d => (
          <a href={`/devices/${d.slug}`} class="hp-hero-device">{d.name}</a>
        ))}
      </div>
    </div>
  </section>

  <div class="hp-main">

    <!-- ══════ 2. COMMUNITY TESTED — Visual proof the DB is real ══════ -->
    {communityTested.length > 0 && (
      <section class="hp-section hp-section-animate">
        <SectionHeader title="Community Tested" href="/games" linkText="View all" editorial="REAL DATA" />
        <div class="hp-tested-grid">
          {communityTested.map((r, i) => {
            const fpsClass = r.fps >= 55 ? 'fps-green' : r.fps >= 40 ? 'fps-yellow' : r.fps >= 30 ? 'fps-orange' : 'fps-red';
            const verdictLabel = r.verdict === 'excellent' ? 'Excellent' : r.verdict === 'good' ? 'Good' : r.verdict === 'fair' ? 'Fair' : r.verdict === 'poor' ? 'Poor' : 'Unplayable';
            return (
              <a href={`/games/${r.gameSlug}`} class="hp-tested-card">
                <div class="hp-tested-card-img">
                  <img src={r.gameImage} alt={r.game} loading={i < 3 ? 'eager' : 'lazy'} />
                  <div class="hp-tested-card-gradient"></div>
                  <span class={`hp-tested-card-fps ${fpsClass}`}>{r.fps}<span class="hp-fps-unit">fps</span></span>
                  <span class={`hp-tested-card-verdict verdict-${r.verdict}`}>{verdictLabel}</span>
                </div>
                <div class="hp-tested-card-body">
                  <span class="hp-tested-card-name">{r.game}</span>
                  <div class="hp-tested-card-meta">
                    <span class="hp-tested-card-device">{r.device}</span>
                    {r.reports > 0 && <span class="hp-tested-card-reports">{r.reports} report{r.reports !== 1 ? 's' : ''}</span>}
                  </div>
                </div>
              </a>
            );
          })}
        </div>
      </section>
    )}

    <!-- ══════ 3. TOP RATED — Catalog showcase ══════ -->
    {topGames.length > 0 && (
      <section class="hp-section hp-section-alt hp-section-animate">
        <SectionHeader title="Top Rated" href="/games" linkText="Browse all" editorial="FROM THE CATALOG" />
        <div class="hp-catalog-grid">
          {topGames.map((g, i) => (
            <a href={`/games/${g.slug}`} class={`hp-catalog-card ${i < 2 ? 'hp-catalog-card-lg' : ''}`}>
              <div class="hp-catalog-card-img">
                <img src={g.image} alt={g.name} loading="lazy" />
                <div class="hp-catalog-card-gradient"></div>
                {g.metacritic && <span class={`hp-catalog-mc ${g.metacritic >= 90 ? 'mc-high' : g.metacritic >= 75 ? 'mc-mid' : 'mc-low'}`}>{g.metacritic}</span>}
                {g.deckCompat && <span class="hp-catalog-deck">{g.deckCompat}</span>}
              </div>
              <div class="hp-catalog-card-body">
                <span class="hp-catalog-card-name">{g.name}</span>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- ══════ 4. PICK YOUR DEVICE — Entry points ══════ -->
    <section class="hp-section hp-section-animate">
      <SectionHeader title="Pick Your Device" href="/devices" linkText="All devices" editorial="HANDHELDS" />
      <div class="hp-device-grid">
        {devices.map(d => {
          const displayName = d.name.replace('ASUS ', '').replace('Lenovo ', '').replace('MSI ', '');
          return (
            <a href={`/devices/${d.slug}`} class="hp-device-card">
              <div class="hp-device-card-inner">
                <span class="hp-device-mfr">{d.manufacturer}</span>
                <h3 class="hp-device-name">{displayName}</h3>
                <div class="hp-device-specs">
                  <span class="hp-device-spec">{d.chip}</span>
                  {d.batteryWh && <span class="hp-device-spec">{d.batteryWh} Wh</span>}
                </div>
                <span class="hp-device-cta">View benchmarks →</span>
              </div>
            </a>
          );
        })}
      </div>
    </section>

    <!-- ══════ 5. EDITORIAL — News & Guides ══════ -->
    {articles.length >= 2 && (
      <section class="hp-section hp-section-alt hp-section-animate">
        <SectionHeader title="Editorial" href="/news" linkText="All articles" editorial="NEWS & GUIDES" />
        <div class="hp-editorial">
          {articles[0] && (
            <a href={`/news/${articles[0].slug}`} class="hp-editorial-hero">
              <div class="hp-editorial-hero-img">
                {articles[0].coverImage ? (
                  <img src={articles[0].coverImage} alt={articles[0].title} loading="lazy" />
                ) : (
                  <div class="hp-editorial-hero-placeholder"></div>
                )}
                <div class="hp-editorial-hero-gradient"></div>
              </div>
              <div class="hp-editorial-hero-content">
                <span class="hp-editorial-tag">{categoryTag[articles[0].category] ?? 'NEWS'}</span>
                <h3 class="hp-editorial-hero-title">{articles[0].title}</h3>
                {articles[0].lead && <p class="hp-editorial-hero-lead">{articles[0].lead}</p>}
                <div class="hp-editorial-hero-footer">
                  <span class="hp-editorial-date">{fmtDate(articles[0].publishedAt)}</span>
                  <span class="hp-editorial-read">Read article →</span>
                </div>
              </div>
            </a>
          )}
          <div class="hp-editorial-cards">
            {articles.slice(1).map(a => {
              const tag = categoryTag[a.category] ?? 'NEWS';
              return (
                <a href={`/news/${a.slug}`} class="hp-editorial-card">
                  {a.coverImage && (
                    <div class="hp-editorial-card-img">
                      <img src={a.coverImage} alt="" loading="lazy" />
                    </div>
                  )}
                  <div class="hp-editorial-card-body">
                    <span class="hp-editorial-tag">{tag}</span>
                    <h4 class="hp-editorial-card-title">{a.title}</h4>
                    <span class="hp-editorial-date">{fmtDate(a.publishedAt)}</span>
                  </div>
                </a>
              );
            })}
          </div>
        </div>
      </section>
    )}

    <!-- ══════ 6. CTA — Join the Mission ══════ -->
    <section class="hp-section hp-section-animate">
      <div class="hp-cta">
        <div class="hp-cta-bg" aria-hidden="true">
          <div class="hp-cta-orb hp-cta-orb-1"></div>
          <div class="hp-cta-orb hp-cta-orb-2"></div>
        </div>
        <div class="hp-cta-content">
          <p class="hp-cta-eyebrow">JOIN THE MISSION</p>
          <h2 class="hp-cta-title">YOUR BENCHMARKS<br/>HELP EVERYONE.</h2>
          <p class="hp-cta-desc">Every report you submit helps another gamer decide if a game runs on their device.</p>

          <div class="hp-cta-progress-wrap">
            <div class="hp-cta-progress">
              <div class="hp-cta-progress-fill" style={`width:${ctaPct}%;`}></div>
            </div>
            <span class="hp-cta-milestone">
              <strong>{reportCount.toLocaleString()}</strong> / {nextMilestone.toLocaleString()} reports — next milestone
            </span>
          </div>

          <div class="hp-cta-actions">
            <a href="/report/new" class="btn-primary hp-cta-btn">SUBMIT A REPORT</a>
            <span class="hp-cta-hint">Takes ~2 min · No account needed</span>
          </div>
        </div>
      </div>
    </section>

  </div>
</div>

</BaseLayout>

<script>
  // Animated stat counters with IntersectionObserver
  function animateCounters() {
    const vals = document.querySelectorAll('.hp-hero-stat-val');
    vals.forEach(el => {
      const raw = (el as HTMLElement).textContent ?? '0';
      const target = parseInt(raw.replace(/,/g, ''), 10);
      if (isNaN(target) || target === 0) return;
      const duration = 1200;
      const start = performance.now();
      const fmt = (n: number) => n.toLocaleString();
      (el as HTMLElement).textContent = '0';
      function tick(now: number) {
        const t = Math.min((now - start) / duration, 1);
        const ease = 1 - Math.pow(1 - t, 3);
        (el as HTMLElement).textContent = fmt(Math.round(target * ease));
        if (t < 1) requestAnimationFrame(tick);
      }
      requestAnimationFrame(tick);
    });
  }
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const heroSection = document.querySelector('.hp-hero');
    if (heroSection) {
      const obs = new IntersectionObserver(entries => {
        if (entries[0].isIntersecting) {
          animateCounters();
          obs.disconnect();
        }
      }, { threshold: 0.3 });
      obs.observe(heroSection);
    }
  }
</script>

<style>
  /* ─── Page wrap ─── */
  .hp-wrap { position: relative; }
  .hp-main {
    max-width: 1120px;
    margin: 0 auto;
    padding: 0 24px;
  }
  .hp-section {
    margin-bottom: 56px;
  }
  .hp-section-alt {
    position: relative;
    padding-top: 8px;
  }
  .hp-section-alt::before {
    content: '';
    position: absolute;
    top: -28px; bottom: -28px; left: 50%;
    width: 100vw;
    transform: translateX(-50%);
    background: var(--color-raised);
    border-top: 1px solid var(--color-border-subtle);
    border-bottom: 1px solid var(--color-border-subtle);
    z-index: -1;
    pointer-events: none;
  }

  /* ─── Entrance animations ─── */
  .hp-section-animate {
    animation: hp-rise 0.5s ease-out both;
  }
  .hp-section-animate:nth-child(1) { animation-delay: 0s; }
  .hp-section-animate:nth-child(2) { animation-delay: 0.06s; }
  .hp-section-animate:nth-child(3) { animation-delay: 0.12s; }
  .hp-section-animate:nth-child(4) { animation-delay: 0.18s; }
  .hp-section-animate:nth-child(5) { animation-delay: 0.24s; }
  @keyframes hp-rise {
    from { opacity: 0; transform: translateY(16px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* ═══════════════════════════════════════════
     1. HERO — Centered, search-first
     ═══════════════════════════════════════════ */
  .hp-hero {
    position: relative;
    padding: 80px 24px 64px;
    max-width: 1120px;
    margin: 0 auto;
    text-align: center;
  }
  .hp-hero-grid-bg {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle, rgba(212,255,0,0.06) 1px, transparent 1px);
    background-size: 32px 32px;
    mask-image: radial-gradient(ellipse 80% 70% at 50% 40%, black 10%, transparent 70%);
    -webkit-mask-image: radial-gradient(ellipse 80% 70% at 50% 40%, black 10%, transparent 70%);
    pointer-events: none;
    z-index: 0;
  }
  .hp-hero-glow {
    position: absolute;
    top: -100px; left: 50%;
    width: 600px; height: 600px;
    transform: translateX(-50%);
    background: radial-gradient(circle, rgba(212,255,0,0.08) 0%, transparent 60%);
    pointer-events: none;
    z-index: 0;
    animation: hp-glow-pulse 4s ease-in-out infinite;
  }
  .hp-hero-glow-2 {
    top: -40px;
    width: 400px; height: 400px;
    background: radial-gradient(circle, rgba(212,255,0,0.04) 0%, transparent 70%);
    animation-delay: 2s;
  }
  @keyframes hp-glow-pulse {
    0%, 100% { opacity: 1; transform: translateX(-50%) scale(1); }
    50% { opacity: 0.6; transform: translateX(-50%) scale(1.1); }
  }
  .hp-hero-inner {
    position: relative;
    z-index: 1;
    max-width: 640px;
    margin: 0 auto;
    animation: hp-hero-enter 0.6s ease-out both;
  }
  @keyframes hp-hero-enter {
    from { opacity: 0; transform: translateY(20px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  .hp-hero-eyebrow {
    font-family: var(--font-mono);
    font-size: 11px; font-weight: 500;
    color: var(--color-accent);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: 16px;
  }
  .hp-hero-title {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: clamp(42px, 7vw, 72px);
    line-height: 0.93;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    color: var(--color-text);
    margin-bottom: 16px;
  }
  .hp-hero-accent { color: var(--color-accent); }
  .hp-hero-subtitle {
    font-size: 16px;
    color: var(--color-text-2);
    line-height: 1.5;
    margin-bottom: 32px;
    max-width: 440px;
    margin-left: auto;
    margin-right: auto;
  }
  .hp-hero-search {
    margin-bottom: 28px;
    max-width: 520px;
    margin-left: auto;
    margin-right: auto;
  }
  .hp-hero-stats {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 20px;
    flex-wrap: wrap;
    margin-bottom: 24px;
    padding: 16px 0;
    border-top: 1px solid var(--color-border-subtle);
    border-bottom: 1px solid var(--color-border-subtle);
  }
  .hp-hero-stat {
    display: flex;
    align-items: baseline;
    gap: 6px;
  }
  .hp-hero-stat-val {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 20px;
    color: var(--color-text);
  }
  .hp-hero-stat-lbl {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 10px;
    color: var(--color-text-3);
    letter-spacing: 0.1em;
  }
  .hp-hero-stat-sep {
    width: 1px; height: 16px;
    background: var(--color-border);
  }
  .hp-hero-devices {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    justify-content: center;
  }
  .hp-hero-device {
    font-family: var(--font-mono);
    font-size: 11px; font-weight: 500;
    color: var(--color-text-2);
    text-decoration: none;
    border: 1px solid var(--color-border);
    padding: 7px 16px;
    transition: border-color 0.15s, color 0.15s, background 0.15s;
  }
  .hp-hero-device:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
    background: rgba(212,255,0,0.05);
  }

  /* ═══════════════════════════════════════════
     2. COMMUNITY TESTED — Visual proof cards
     ═══════════════════════════════════════════ */
  .hp-tested-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 16px;
  }
  .hp-tested-card {
    border: 1px solid var(--color-border);
    border-radius: 12px;
    overflow: hidden;
    text-decoration: none;
    background: var(--color-base);
    transition: border-color 0.15s, transform 0.2s, box-shadow 0.2s;
  }
  .hp-tested-card:hover {
    border-color: rgba(212,255,0,0.3);
    transform: translateY(-4px);
    box-shadow: 0 8px 32px rgba(212,255,0,0.08);
  }
  .hp-tested-card-img {
    position: relative;
    aspect-ratio: 16/9;
    overflow: hidden;
    background: var(--color-elevated);
  }
  .hp-tested-card-img img {
