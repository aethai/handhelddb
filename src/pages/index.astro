    font-size: 18px;
    font-weight: 700;
    color: var(--color-accent);
    min-width: 28px;
    text-align: center;
    opacity: 0.8;
  }
  .hp-battle-row:nth-child(1) .hp-battle-rank {
    font-size: 22px;
    opacity: 1;
  }
  .hp-battle-thumb-wrap {
    width: 56px;
    height: 32px;
    border-radius: 4px;
    overflow: hidden;
    flex-shrink: 0;
    background: var(--color-elevated);
  }
  .hp-battle-thumb {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hp-battle-info {
    flex: 1;
    min-width: 0;
  }
  .hp-battle-game {
    display: block;
    font-size: 13px;
    font-weight: 600;
    color: var(--color-text);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    transition: color 0.12s;
  }
  .hp-battle-row:hover .hp-battle-game { color: var(--color-accent); }
  .hp-battle-device {
    display: flex;
    align-items: center;
    gap: 4px;
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--color-text-dim);
    margin-top: 2px;
  }
  .hp-battle-device-icon {
    width: 12px;
    height: 12px;
    flex-shrink: 0;
  }
  .hp-battle-stats {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 2px;
    flex-shrink: 0;
  }
  .hp-battle-fps {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 15px;
    display: inline-flex;
    align-items: baseline;
    gap: 2px;
  }
  .hp-battle-preset {
    font-family: var(--font-mono);
    font-size: 9px;
    color: var(--color-text-dim);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  /* ─── 4b. PICK YOUR DEVICE (redesigned) ─── */
  .hp-devices2-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
  }
  .hp-device2-card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--color-border);
    border-radius: 10px;
    padding: 0;
    text-decoration: none;
    transition: border-color 0.15s, background 0.15s, transform 0.2s;
    position: relative;
    overflow: hidden;
  }
  .hp-device2-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, var(--color-accent), transparent);
    opacity: 0;
    transition: opacity 0.2s;
    z-index: 2;
  }
  .hp-device2-card::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 80px;
    background:
      radial-gradient(circle at 80% 30%, rgba(212,255,0,0.04) 0%, transparent 60%),
      linear-gradient(180deg, var(--color-elevated) 0%, transparent 100%);
    pointer-events: none;
    z-index: 0;
  }
  .hp-device2-card:hover::before { opacity: 1; }
  .hp-device2-card:hover {
    border-color: rgba(212,255,0,0.25);
    transform: translateY(-2px);
    box-shadow: 0 4px 20px rgba(212,255,0,0.05);
  }
  .hp-device2-top {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 18px 18px 0;
    margin-bottom: 8px;
  }
  .hp-device2-logo {
    width: 32px;
    height: 32px;
    flex-shrink: 0;
    opacity: 0.4;
    filter: grayscale(100%);
    transition: opacity 0.2s, filter 0.2s;
  }
  .hp-device2-card:hover .hp-device2-logo {
    opacity: 0.8;
    filter: grayscale(0%);
  }
  .hp-device2-mfr {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 600;
    color: var(--color-accent);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 0.8;
  }
  .hp-device2-name {
    position: relative;
    z-index: 1;
    display: block;
    font-family: var(--font-heading);
    font-size: 18px;
    font-weight: 700;
    color: var(--color-text);
    transition: color 0.12s;
    margin-bottom: 14px;
    letter-spacing: -0.01em;
    padding: 0 18px;
  }
  .hp-device2-card:hover .hp-device2-name {
    color: var(--color-accent);
  }
  .hp-device2-specs {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin: 0 18px 14px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--color-border-subtle);
  }
  .hp-device2-spec {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-text-3);
  }
  .hp-device2-spec-icon {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
    color: var(--color-text-dim);
  }
  .hp-device2-price {
    display: flex;
    align-items: baseline;
    gap: 6px;
    margin-bottom: 12px;
    padding: 0 18px;
    position: relative;
    z-index: 1;
  }
  .hp-device2-price-from {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--color-text-dim);
    text-transform: uppercase;
  }
  .hp-device2-price-val {
    font-family: var(--font-mono);
    font-size: 18px;
    font-weight: 700;
    color: var(--color-text);
  }
  .hp-device2-cta {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    color: var(--color-text-dim);
    transition: color 0.12s, background 0.12s;
    margin-top: auto;
    padding: 12px 18px;
    border-top: 1px solid var(--color-border-subtle);
    position: relative;
    z-index: 1;
  }
  .hp-device2-card:hover .hp-device2-cta {
    color: var(--color-accent);
    background: rgba(212,255,0,0.03);
  }

  /* ─── 5. EDITORIAL (News redesign) ─── */
  .hp-editorial {
    display: grid;
    gap: 14px;
  }
  .hp-editorial-hero {
    display: block;
    position: relative;
    border-radius: 12px;
    overflow: hidden;
    text-decoration: none;
    min-height: 320px;
    background: var(--color-elevated);
  }
  .hp-editorial-hero:hover .hp-editorial-hero-title { color: var(--color-accent); }
  .hp-editorial-hero:hover .hp-editorial-hero-img img { transform: scale(1.03); }
  .hp-editorial-hero-img {
    position: absolute;
    inset: 0;
  }
  .hp-editorial-hero-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  .hp-editorial-hero-placeholder {
    width: 100%;
    height: 100%;
    background: var(--color-elevated);
  }
  .hp-editorial-hero-gradient {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(10,10,10,0.95) 0%,
      rgba(10,10,10,0.7) 35%,
      rgba(10,10,10,0.1) 100%
    );
  }
  .hp-editorial-hero-content {
    position: relative;
    z-index: 1;
    padding: 32px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: 320px;
  }
  .hp-editorial-tag {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 600;
    color: var(--color-accent);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: 10px;
    display: inline-block;
    background: rgba(212,255,0,0.08);
    padding: 4px 10px;
    border-radius: 3px;
    width: fit-content;
  }
  .hp-editorial-hero-title {
    font-family: var(--font-heading);
    font-size: clamp(22px, 3.5vw, 32px);
    font-weight: 700;
    color: #fff;
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin-bottom: 10px;
    transition: color 0.15s;
    text-transform: uppercase;
  }
  .hp-editorial-hero-lead {
    font-size: 14px;
    color: var(--color-text-3);
    line-height: 1.55;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    max-width: 560px;
    margin-bottom: 14px;
  }
  .hp-editorial-hero-footer {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .hp-editorial-date {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--color-text-dim);
    letter-spacing: 0.04em;
  }
  .hp-editorial-read {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    color: var(--color-accent);
    letter-spacing: 0.04em;
  }
  .hp-editorial-cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
  }
  .hp-editorial-card {
    border: 1px solid var(--color-border);
    border-radius: 8px;
    overflow: hidden;
    text-decoration: none;
    background: var(--color-base);
    transition: border-color 0.15s, transform 0.2s;
  }
  .hp-editorial-card:hover {
    border-color: rgba(212,255,0,0.3);
    transform: translateY(-2px);
  }
  .hp-editorial-card:hover .hp-editorial-card-title { color: var(--color-accent); }
  .hp-editorial-card-img {
    aspect-ratio: 16/9;
    overflow: hidden;
    background: var(--color-elevated);
  }
  .hp-editorial-card-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }
  .hp-editorial-card:hover .hp-editorial-card-img img { transform: scale(1.04); }
  .hp-editorial-card-body {
    padding: 14px 16px;
  }
  .hp-editorial-card-title {
    font-family: var(--font-heading);
    font-size: 14px;
    font-weight: 600;
    color: var(--color-text);
    line-height: 1.3;
    margin-bottom: 8px;
    transition: color 0.12s;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* ─── 6. CTA v2 — Join the Mission ─── */
  .hp-cta2 {
    position: relative;
    border: 1px solid var(--color-border);
    border-radius: 16px;
    padding: 56px 48px;
    overflow: hidden;
    text-align: center;
  }
  .hp-cta2-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
  }
  .hp-cta2-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
  }
  .hp-cta2-orb-1 {
    width: 400px;
    height: 400px;
    top: -200px;
    left: -100px;
    background: rgba(212,255,0,0.06);
    animation: hp-orb-float 8s ease-in-out infinite;
  }
  .hp-cta2-orb-2 {
    width: 300px;
    height: 300px;
    bottom: -150px;
    right: -50px;
    background: rgba(212,255,0,0.04);
    animation: hp-orb-float 8s ease-in-out infinite reverse;
  }
  @keyframes hp-orb-float {
    0%, 100% { transform: translate(0, 0); }
    50% { transform: translate(20px, -20px); }
  }
  .hp-cta2-grid-lines {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(212,255,0,0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(212,255,0,0.03) 1px, transparent 1px);
    background-size: 48px 48px;
    mask-image: radial-gradient(ellipse 70% 70% at 50% 50%, black 20%, transparent 80%);
    -webkit-mask-image: radial-gradient(ellipse 70% 70% at 50% 50%, black 20%, transparent 80%);
  }
  .hp-cta2-content {
    position: relative;
    z-index: 1;
    max-width: 560px;
    margin: 0 auto;
  }
  .hp-cta2-eyebrow {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    color: var(--color-accent);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    margin-bottom: 16px;
  }
  .hp-cta2-title {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: clamp(28px, 4vw, 42px);
    color: var(--color-text);
    text-transform: uppercase;
    letter-spacing: -0.03em;
    line-height: 1.05;
    margin-bottom: 16px;
  }
  .hp-cta2-desc {
    font-size: 15px;
    color: var(--color-text-3);
    line-height: 1.6;
    margin-bottom: 32px;
  }
  .hp-cta2-stats {
    display: flex;
    justify-content: center;
    gap: 40px;
    margin-bottom: 28px;
    padding: 20px 0;
    border-top: 1px solid var(--color-border-subtle);
    border-bottom: 1px solid var(--color-border-subtle);
  }
  .hp-cta2-stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
  }
  .hp-cta2-stat-val {
    font-family: var(--font-mono);
    font-size: 24px;
    font-weight: 700;
    color: var(--color-text);
  }
  .hp-cta2-stat-lbl {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--color-text-dim);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .hp-cta2-progress-wrap {
    max-width: 360px;
    margin: 0 auto 24px;
  }
  .hp-cta2-progress {
    height: 6px;
    background: var(--color-border);
    border-radius: 3px;
    width: 100%;
    margin-bottom: 8px;
    overflow: hidden;
  }
  .hp-cta2-progress-fill {
    height: 100%;
    background: var(--color-accent);
    border-radius: 3px;
    transition: width 0.5s ease;
    box-shadow: 0 0 12px rgba(212,255,0,0.4);
  }
  .hp-cta2-milestone {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-text-3);
  }
  .hp-cta2-milestone strong {
    color: var(--color-text);
    font-weight: 700;
  }
  .hp-cta2-actions {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
  }
  .hp-cta2-btn {
    padding: 16px 40px;
    font-size: 14px;
    letter-spacing: 0.04em;
  }
  .hp-cta2-hint {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--color-text-dim);
    letter-spacing: 0.04em;
  }

  /* ─── LIVE TICKER ─── */
  .hp-ticker {
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    background: var(--color-raised);
    overflow: hidden;
    position: relative;
    padding: 10px 0;
  }
  .hp-ticker::before,
  .hp-ticker::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    width: 80px;
    z-index: 2;
    pointer-events: none;
  }
  .hp-ticker::before {
    left: 0;
    background: linear-gradient(90deg, var(--color-raised), transparent);
  }
  .hp-ticker::after {
    right: 0;
    background: linear-gradient(270deg, var(--color-raised), transparent);
  }
  .hp-ticker-track {
    display: flex;
    gap: 0;
    white-space: nowrap;
    animation: hp-scroll 40s linear infinite;
    width: max-content;
  }
  @keyframes hp-scroll {
    from { transform: translateX(0); }
    to { transform: translateX(-33.333%); }
  }
  .hp-ticker-item {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 0 24px;
    font-size: 12px;
  }
  .hp-ticker-game {
    font-weight: 600;
    color: var(--color-text);
  }
  .hp-ticker-sep {
    color: var(--color-text-dim);
  }
  .hp-ticker-device {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-text-3);
  }
  .hp-ticker-fps {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 11px;
  }
  .hp-ticker-dot {
    width: 3px;
    height: 3px;
    background: var(--color-accent);
    border-radius: 50%;
    opacity: 0.5;
  }

  /* ─── Hero title shimmer ─── */
  .hp-hero-accent {
    color: var(--color-accent);
    text-shadow: 0 0 60px rgba(212,255,0,0.25);
    position: relative;
    background: linear-gradient(
      90deg,
      var(--color-accent) 0%,
      var(--color-accent) 40%,
      #fff 50%,
      var(--color-accent) 60%,
      var(--color-accent) 100%
    );
    background-size: 200% 100%;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    animation: hp-shimmer 3s ease-in-out infinite;
  }
  @keyframes hp-shimmer {
    0%, 100% { background-position: 100% 0; }
    50% { background-position: -100% 0; }
  }

  /* ─── Section dividers ─── */
  .hp-section-divider {
    position: relative;
  }
  .hp-section-divider::after {
    content: '';
    position: absolute;
    bottom: -28px;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent 0%,
      var(--color-accent) 20%,
      var(--color-accent) 80%,
      transparent 100%
    );
    opacity: 0.15;
  }

  /* ─── Widget ─── */
  .hp-widget {
    border: 1px solid var(--color-border);
    border-radius: 8px;
    overflow: hidden;
    background: var(--color-raised);
    width: 320px;
    box-shadow: 0 0 30px rgba(212,255,0,0.04);
  }

  /* ─── CTA2 glow line ─── */
  .hp-cta2::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--color-accent), transparent);
    animation: hp-cta2-glow 4s ease-in-out infinite;
    z-index: 1;
  }
  @keyframes hp-cta2-glow {
    0%, 100% { opacity: 0.4; }
    50% { opacity: 1; }
  }

  /* ─── Responsive: tablet ─── */
  @media (max-width: 1024px) {
    .hp-pulse-grid { grid-template-columns: repeat(2, 1fr); }
    .hp-pulse-card-lg { grid-column: span 1; }
    .hp-perfhub { grid-template-columns: 1fr; }
  }

  /* ─── Responsive: mobile ─── */
  @media (max-width: 768px) {
    .hp-hero { padding: 48px 20px 36px; }
    .hp-main { padding: 0 20px; }
    .hp-section { margin-bottom: 40px; }

    .hp-hero-inner {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    .hp-hero-visual { display: none; }

    /* Pulse cards mobile */
    .hp-pulse-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 10px;
    }
    .hp-pulse-card-lg { grid-column: span 1; }
    .hp-pulse-card-fps { font-size: 15px; }
    .hp-pulse-card-lg .hp-pulse-card-fps { font-size: 15px; }
    .hp-pulse-card-img { aspect-ratio: 16/10; }
    .hp-pulse-card-lg .hp-pulse-card-img { aspect-ratio: 16/10; }

    /* Devices mobile */
    .hp-devices2-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 10px;
    }

    .hp-section-alt::before {
      top: -20px;
      bottom: -20px;
    }

    /* Performance Hub mobile */
    .hp-perfhub { grid-template-columns: 1fr; }
    .hp-spotlight-hero { height: 200px; }
    .hp-spotlight-info { padding: 16px 20px; }
    .hp-spotlight-bars { padding: 16px 20px; }
    .hp-spotlight-bar-row {
      grid-template-columns: 80px 1fr 50px;
      gap: 8px;
    }
    .hp-battle-thumb-wrap { display: none; }

    /* Editorial mobile */
    .hp-editorial-hero { min-height: 260px; }
    .hp-editorial-hero-content { min-height: 260px; padding: 20px; }
    .hp-editorial-cards { grid-template-columns: 1fr; }

    /* CTA2 mobile */
    .hp-cta2 { padding: 36px 24px; }
    .hp-cta2-stats { gap: 20px; flex-wrap: wrap; }
    .hp-cta2-stat-val { font-size: 20px; }

    .hp-ticker-item { padding: 0 16px; font-size: 11px; }

    .hp-section-divider::after { display: none; }
  }

  /* ─── Responsive: small phone ─── */
  @media (max-width: 480px) {
    .hp-hero { padding: 36px 16px 28px; }
    .hp-main { padding: 0 16px; }
    .hp-hero-title { font-size: 34px; }
    .hp-hero-stats { gap: 10px; }
    .hp-hero-subtitle { font-size: 14px; }

    .hp-ticker { display: none; }

    .hp-devices2-grid {
      grid-template-columns: 1fr;
    }
    .hp-pulse-grid {
      grid-template-columns: 1fr;
    }

    .hp-spotlight-bar-row {
      grid-template-columns: 60px 1fr 44px;
      gap: 6px;
    }
    .hp-spotlight-bar-device { font-size: 10px; }
    .hp-spotlight-bar-track { height: 16px; }

    .hp-battle-rank { min-width: 22px; font-size: 14px; }
    .hp-battle-row:nth-child(1) .hp-battle-rank { font-size: 16px; }
  }

  /* ─── Accessibility: reduced motion ─── */
  @media (prefers-reduced-motion: reduce) {
    .hp-section-animate,
    .hp-hero-inner,
    .hp-hero-accent,
    .hp-ticker-track,
    .hp-cta2::before,
    .hp-cta2-orb {
