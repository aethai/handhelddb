---
import BaseLayout from '@layouts/BaseLayout.astro';
import { getUser } from '@lib/auth/supabase';

// Redirect if already logged in
const user = await getUser(Astro.cookies);
if (user) {
  return Astro.redirect('/');
}
---

<BaseLayout title="Set New Password" noindex>
  <section class="flex min-h-[60vh] items-center justify-center px-4 py-16">
    <div class="w-full max-w-md">
      <div class="rounded-2xl border border-white/6 bg-[#0e0c16]/50 p-8">
        <!-- Header -->
        <div class="text-center mb-8">
          <div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-2xl bg-[#a78bfa]/10 border border-[#a78bfa]/20">
            <svg class="h-7 w-7 text-[#a78bfa]" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 1 0-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 0 0 2.25-2.25v-6.75a2.25 2.25 0 0 0-2.25-2.25H6.75a2.25 2.25 0 0 0-2.25 2.25v6.75a2.25 2.25 0 0 0 2.25 2.25Z" />
            </svg>
          </div>
          <h1 class="text-2xl font-bold text-white">Set new password</h1>
          <p class="mt-2 text-sm text-[#9890a8]">
            Choose a strong password for your account.
          </p>
        </div>

        <!-- Invalid link message (shown when no tokens) -->
        <div id="invalid-link" class="hidden">
          <div class="rounded-lg border border-red-500/20 bg-red-500/10 px-4 py-3 mb-6 text-sm text-red-400">
            <div class="flex items-start gap-3">
              <svg class="h-5 w-5 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z" />
              </svg>
              <div>
                <p class="font-medium">Invalid or expired reset link</p>
                <p class="mt-1 text-red-400/80">This password reset link is invalid or has expired. Please request a new one.</p>
              </div>
            </div>
          </div>
          <a
            href="/auth/forgot-password"
            class="block w-full rounded-xl bg-[#a78bfa] px-4 py-3 text-center text-sm font-semibold text-white hover:bg-[#c4b5fd] focus:outline-none focus:ring-2 focus:ring-[#a78bfa] focus:ring-offset-2 focus:ring-offset-[#0e0c16] transition-colors"
          >
            Request new reset link
          </a>
        </div>

        <!-- Success message (hidden by default) -->
        <div id="success-message" class="hidden">
          <div class="rounded-lg border border-[#a78bfa]/20 bg-[#a78bfa]/10 px-4 py-3 mb-6 text-sm text-[#a78bfa]">
            <div class="flex items-start gap-3">
              <svg class="h-5 w-5 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
              </svg>
              <div>
                <p class="font-medium">Password updated!</p>
                <p class="mt-1 text-[#a78bfa]/80">Your password has been reset successfully. Redirecting you now...</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Error message -->
        <div id="auth-error" class="rounded-lg border border-red-500/20 bg-red-500/10 px-4 py-3 mb-6 text-sm text-red-400 hidden"></div>

        <!-- Reset Password Form -->
        <form id="reset-form" class="space-y-4">
          <div>
            <label for="password" class="block text-sm font-medium text-[#9890a8] mb-1.5">New password</label>
            <div class="relative">
              <input
                type="password"
                id="password"
                name="password"
                required
                minlength="8"
                autocomplete="new-password"
                placeholder="Min. 8 characters"
                class="w-full rounded-xl border border-white/10 bg-[#0e0c16]/50 px-4 py-3 pr-10 text-sm text-white placeholder-[#4a4560] focus:border-[#a78bfa] focus:outline-none focus:ring-1 focus:ring-[#a78bfa] transition-colors"
              />
              <button
                type="button"
                id="toggle-password"
                class="absolute right-3 top-1/2 -translate-y-1/2 text-[#4a4560] hover:text-[#9890a8] transition-colors"
                aria-label="Toggle password visibility"
              >
                <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178Z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                </svg>
              </button>
            </div>
            <p id="password-strength" class="mt-1.5 text-xs text-[#2a2838]"></p>
          </div>

          <div>
            <label for="confirmPassword" class="block text-sm font-medium text-[#9890a8] mb-1.5">Confirm new password</label>
            <input
              type="password"
              id="confirmPassword"
              name="confirmPassword"
              required
              minlength="8"
              autocomplete="new-password"
              placeholder="Repeat your new password"
              class="w-full rounded-xl border border-white/10 bg-[#0e0c16]/50 px-4 py-3 text-sm text-white placeholder-[#4a4560] focus:border-[#a78bfa] focus:outline-none focus:ring-1 focus:ring-[#a78bfa] transition-colors"
            />
            <p id="password-match" class="mt-1.5 text-xs text-red-400 hidden">Passwords do not match</p>
          </div>

          <button
            type="submit"
            id="submit-btn"
            class="w-full rounded-xl bg-[#a78bfa] px-4 py-3 text-sm font-semibold text-white hover:bg-[#c4b5fd] focus:outline-none focus:ring-2 focus:ring-[#a78bfa] focus:ring-offset-2 focus:ring-offset-[#0e0c16] transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
          >
            Reset password
          </button>
        </form>

        <!-- Back to login -->
        <p class="mt-6 text-center text-sm text-[#4a4560]">
          Remember your password?
          <a href="/auth/login" class="text-[#a78bfa] hover:text-[#c4b5fd] transition-colors font-medium">
            Sign in
          </a>
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const form = document.getElementById('reset-form') as HTMLFormElement;
  const errorEl = document.getElementById('auth-error')!;
  const successEl = document.getElementById('success-message')!;
  const invalidEl = document.getElementById('invalid-link')!;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const passwordInput = document.getElementById('password') as HTMLInputElement;
  const confirmInput = document.getElementById('confirmPassword') as HTMLInputElement;
  const matchMsg = document.getElementById('password-match')!;
  const strengthMsg = document.getElementById('password-strength')!;
  const toggleBtn = document.getElementById('toggle-password')!;

  // Extract tokens from URL hash fragment
  // Supabase redirects with #access_token=...&refresh_token=...&type=recovery
  let accessToken = '';
  let refreshToken = '';

  function parseHashParams() {
    const hash = window.location.hash.substring(1); // remove #
    const params = new URLSearchParams(hash);
    accessToken = params.get('access_token') ?? '';
    refreshToken = params.get('refresh_token') ?? '';
  }

  parseHashParams();

  // If no tokens, show invalid link message and hide form
  if (!accessToken || !refreshToken) {
    form.classList.add('hidden');
    invalidEl.classList.remove('hidden');
    // Also hide the "back to login" link since the invalid-link section has its own CTA
    const backLink = form.parentElement?.querySelector('p.mt-6');
    if (backLink) (backLink as HTMLElement).classList.add('hidden');
  }

  // Toggle password visibility
  toggleBtn.addEventListener('click', () => {
    const isPassword = passwordInput.type === 'password';
    passwordInput.type = isPassword ? 'text' : 'password';
    confirmInput.type = isPassword ? 'text' : 'password';
  });

  // Password strength indicator (same as register.astro)
  passwordInput.addEventListener('input', () => {
    const val = passwordInput.value;
    if (!val) { strengthMsg.textContent = ''; return; }
    let score = 0;
    if (val.length >= 8) score++;
    if (val.length >= 12) score++;
    if (/[A-Z]/.test(val) && /[a-z]/.test(val)) score++;
    if (/\d/.test(val)) score++;
    if (/[^A-Za-z0-9]/.test(val)) score++;

    const labels = ['Very weak', 'Weak', 'Fair', 'Good', 'Strong'];
    const colors = ['text-red-400', 'text-orange-400', 'text-yellow-400', 'text-[#a78bfa]', 'text-[#c4b5fd]'];
    const idx = Math.min(score, labels.length) - 1;
    if (idx < 0) { strengthMsg.textContent = ''; return; }
    strengthMsg.textContent = labels[idx];
    strengthMsg.className = `mt-1.5 text-xs ${colors[idx]}`;
  });

  // Password match check
  confirmInput.addEventListener('input', () => {
    if (confirmInput.value && confirmInput.value !== passwordInput.value) {
      matchMsg.classList.remove('hidden');
    } else {
      matchMsg.classList.add('hidden');
    }
  });

  // Form submission
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorEl.classList.add('hidden');

    const password = passwordInput.value;
    const confirmPassword = confirmInput.value;

    // Client-side validation
    if (password !== confirmPassword) {
      errorEl.textContent = 'Passwords do not match.';
      errorEl.classList.remove('hidden');
      return;
    }

    if (password.length < 8) {
      errorEl.textContent = 'Password must be at least 8 characters.';
      errorEl.classList.remove('hidden');
      return;
    }

    submitBtn.disabled = true;
    submitBtn.textContent = 'Resetting password...';

    try {
      const res = await fetch('/api/auth/reset-password', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          access_token: accessToken,
          refresh_token: refreshToken,
          password,
        }),
      });

      const data = await res.json();

      if (!res.ok || data.error) {
        errorEl.textContent = data.error ?? 'Password reset failed. Please try again.';
        errorEl.classList.remove('hidden');
        submitBtn.disabled = false;
        submitBtn.textContent = 'Reset password';
        return;
      }

      // Show success, hide form
      form.classList.add('hidden');
      successEl.classList.remove('hidden');

      // Redirect after a short delay
      setTimeout(() => {
        window.location.href = '/';
      }, 2000);
    } catch {
      errorEl.textContent = 'Network error. Please try again.';
      errorEl.classList.remove('hidden');
      submitBtn.disabled = false;
      submitBtn.textContent = 'Reset password';
    }
  });
</script>
