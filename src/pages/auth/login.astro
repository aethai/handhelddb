---
import BaseLayout from '@layouts/BaseLayout.astro';
import { getUser } from '@lib/auth/supabase';

// Redirect if already logged in
const user = await getUser(Astro.cookies);
if (user) {
  return Astro.redirect('/');
}

const siteUrl = import.meta.env.PUBLIC_SITE_URL ?? 'https://handheldgamedb.com';
const redirectTo = Astro.url.searchParams.get('redirect') ?? '/';
---

<BaseLayout title="Sign In" noindex>
  <section class="flex min-h-[60vh] items-center justify-center px-4 py-16">
    <div class="w-full max-w-md">
      <div class="rounded-2xl border border-gray-800 bg-gray-900/50 p-8">
        <!-- Header -->
        <div class="text-center mb-8">
          <div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-2xl bg-emerald-500/10 border border-emerald-500/20">
            <svg class="h-7 w-7 text-emerald-400" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z" />
            </svg>
          </div>
          <h1 class="text-2xl font-bold text-white">Sign in to GameDB</h1>
          <p class="mt-2 text-sm text-gray-400">
            Submit performance reports, earn points, and help the community.
          </p>
        </div>

        <!-- OAuth Buttons -->
        <div class="space-y-3">
          <a
            href={`/auth/callback/google?redirect=${encodeURIComponent(redirectTo)}`}
            class="flex w-full items-center justify-center gap-3 rounded-xl border border-gray-700 bg-gray-800/50 px-4 py-3 text-sm font-medium text-white hover:border-gray-600 hover:bg-gray-800 transition-colors"
          >
            <svg class="h-5 w-5" viewBox="0 0 24 24">
              <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1Z"/>
              <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23Z"/>
              <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18A10.96 10.96 0 0 0 1 12c0 1.77.42 3.45 1.18 4.93l2.85-2.22.81-.62Z"/>
              <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53Z"/>
            </svg>
            Continue with Google
          </a>

          <!-- Steam login placeholder (can be enabled later) -->
          <button
            disabled
            class="flex w-full items-center justify-center gap-3 rounded-xl border border-gray-700/50 bg-gray-800/30 px-4 py-3 text-sm font-medium text-gray-500 cursor-not-allowed"
          >
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor">
              <path d="M11.979 0C5.678 0 .511 4.86.022 10.96l6.432 2.658a3.387 3.387 0 0 1 1.912-.588c.063 0 .125.002.188.006l2.861-4.142V8.83a4.528 4.528 0 0 1 4.524-4.524 4.528 4.528 0 0 1 4.524 4.524 4.528 4.528 0 0 1-4.524 4.524h-.105l-4.076 2.911c0 .052.004.105.004.159 0 1.875-1.515 3.396-3.39 3.396a3.406 3.406 0 0 1-3.363-2.924L.533 14.294A11.979 11.979 0 0 0 11.979 24c6.627 0 12-5.373 12-12S18.606 0 11.979 0Z"/>
            </svg>
            Steam Login (Coming Soon)
          </button>
        </div>

        <!-- Info -->
        <div class="mt-6 rounded-xl border border-gray-800 bg-gray-950/50 p-4">
          <p class="text-xs text-gray-500 leading-relaxed">
            By signing in, you agree to our
            <a href="/terms" class="text-emerald-400 hover:text-emerald-300">Terms of Service</a> and
            <a href="/privacy" class="text-emerald-400 hover:text-emerald-300">Privacy Policy</a>.
            We only use your account to identify you and never share your data.
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
