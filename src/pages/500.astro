---
import BaseLayout from '@layouts/BaseLayout.astro';

export const prerender = true;
---

<BaseLayout title="500 — Something Went Wrong" noindex={true}>
  <section class="flex flex-1 items-center justify-center py-20 sm:py-32">
    <div class="mx-auto max-w-lg px-6 text-center">
      <p class="font-mono text-[8rem] sm:text-[10rem] font-bold leading-none tracking-tighter text-[#D4FF00] select-none">
        500
      </p>
      <h1 class="mt-2 text-xl font-bold text-[var(--color-text)] uppercase font-[var(--font-heading)]">
        Something went wrong
      </h1>
      <p class="mt-4 text-sm text-[var(--color-text-3)] leading-relaxed">
        Our server hit an error. Please try again in a moment.
      </p>
      <div class="mt-8 flex items-center justify-center gap-3">
        <a href="/" class="btn-primary px-6 py-3 text-xs">GO HOME</a>
        <button onclick="window.location.reload()" class="btn-ghost px-6 py-3 text-xs cursor-pointer">TRY AGAIN</button>
      </div>
      <p class="mt-8 text-xs text-[var(--color-text-dim)] font-mono">
        If this keeps happening, please report it on
        <a href="https://github.com" class="text-[var(--color-text-3)] hover:text-[#D4FF00] transition-colors">GitHub</a>.
      </p>
    </div>
  </section>
</BaseLayout>
