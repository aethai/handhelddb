---
import BaseLayout from '@layouts/BaseLayout.astro';
import ReportForm from '@components/react/ReportForm';
import { supabaseAdmin } from '@lib/db/client';

// Fetch devices for the form
const { data: devicesData } = await supabaseAdmin
  .from('devices')
  .select('id, name, slug, manufacturer')
  .eq('is_active', true)
  .order('name');

const devices = devicesData ?? [];
const isLoggedIn = !!Astro.locals.user;

// Pre-fill from query params (when coming from a game page)
const gameId = Astro.url.searchParams.get('game') ?? undefined;
const gameName = Astro.url.searchParams.get('gameName') ?? undefined;
const deviceId = Astro.url.searchParams.get('device') ?? undefined;
---

<BaseLayout title="Submit Performance Report" noindex={true}>
  <div class="section-spotlight">
  <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl font-heading font-bold text-white">Submit Performance Report</h1>
    <p class="mt-2 text-gray-400">
      Share your game performance data to help the community find optimal settings.
    </p>

    <div class="mt-8 rounded-xl border border-gray-800 bg-gray-900 p-6">
      <ReportForm
        client:load
        devices={devices}
        isLoggedIn={isLoggedIn}
        preselectedGameId={gameId}
        preselectedGameName={gameName}
        preselectedDeviceId={deviceId}
      />
    </div>
  </div>
  </div>
</BaseLayout>
