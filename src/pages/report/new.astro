---
import BaseLayout from '@layouts/BaseLayout.astro';
---

<BaseLayout title="Submit Performance Report" noindex={true}>
  <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl font-bold text-white">Submit Performance Report</h1>
    <p class="mt-2 text-gray-400">
      Share your game performance data to help the community find optimal settings.
    </p>

    <!-- React ReportForm island will be mounted here -->
    <div class="mt-8 rounded-xl border border-gray-800 bg-gray-900 p-6">
      <div id="report-form-root" class="text-center py-12 text-gray-600">
        <p>Report form loading...</p>
        <p class="mt-2 text-sm">Sign in to submit a performance report.</p>
      </div>
    </div>
  </div>
</BaseLayout>
