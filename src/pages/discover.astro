---
import BaseLayout from '@layouts/BaseLayout.astro';
import GameCard from '@components/astro/GameCard.astro';
import GameCardFeatured from '@components/astro/GameCardFeatured.astro';
import SectionHeader from '@components/astro/SectionHeader.astro';
import { supabaseAdmin } from '@lib/db/client';
import { getCached, setCache } from '@lib/cache';

// ─── Types ───
type GameRow = { slug: string; name: string; header_image: string | null; genres: string[] | null; deck_compatibility: string | null; metacritic_score: number | null };
type MappedGame = { slug: string; name: string; headerImage: string | null; genres: string[]; deckCompatibility: string | null };
type CurationItem = { title: string; subtitle: string; emoji: string; games: MappedGame[] };
type DiscoverCache = {
  curations: CurationItem[];
  topGenres: [string, number][];
  devices: Array<{ slug: string; name: string; manufacturer: string; id: string }>;
  deviceReportMap: Record<string, number>;
  topRatedAll: MappedGame[];
  recentlyAdded: MappedGame[];
};

const cacheKey = 'discover:curated';
let cached = getCached<DiscoverCache>(cacheKey);

if (!cached) {
  const mapGame = (g: GameRow): MappedGame => ({
    slug: g.slug,
    name: g.name,
    headerImage: g.header_image,
    genres: (g.genres as string[]) ?? [],
    deckCompatibility: g.deck_compatibility,
  });

  // ─── Fetch all 6 curated queries + genre counts + devices in parallel ───
  const [
    topRatedRes,
    deckVerifiedRes,
    freeGamesRes,
    rpgGamesRes,
    actionGamesRes,
    indieGamesRes,
    allGamesGenresRes,
    devicesRes,
    reportCountsRes,
    recentlyAddedRes,
  ] = await Promise.all([
    supabaseAdmin.from('games').select('slug, name, header_image, genres, deck_compatibility, metacritic_score').not('metacritic_score', 'is', null).order('metacritic_score', { ascending: false }).limit(8),
    supabaseAdmin.from('games').select('slug, name, header_image, genres, deck_compatibility, metacritic_score').eq('deck_compatibility', 'verified').order('metacritic_score', { ascending: false }).limit(4),
    supabaseAdmin.from('games').select('slug, name, header_image, genres, deck_compatibility, metacritic_score').eq('is_free_to_play', true).order('metacritic_score', { ascending: false }).limit(4),
    supabaseAdmin.from('games').select('slug, name, header_image, genres, deck_compatibility, metacritic_score').contains('genres', ['RPG']).order('metacritic_score', { ascending: false }).limit(4),
    supabaseAdmin.from('games').select('slug, name, header_image, genres, deck_compatibility, metacritic_score').contains('genres', ['Action']).order('metacritic_score', { ascending: false }).limit(4),
    supabaseAdmin.from('games').select('slug, name, header_image, genres, deck_compatibility, metacritic_score').contains('genres', ['Indie']).not('metacritic_score', 'is', null).order('metacritic_score', { ascending: false }).limit(4),
    supabaseAdmin.from('games').select('genres').not('genres', 'is', null).limit(2000),
    supabaseAdmin.from('devices').select('slug, name, manufacturer, id').eq('is_active', true).order('name').limit(6),
    supabaseAdmin.from('performance_reports').select('device_id').limit(2000),
    supabaseAdmin.from('games').select('slug, name, header_image, genres, deck_compatibility, metacritic_score').order('created_at', { ascending: false }).limit(4),
  ]);

  const topRated = topRatedRes.data;
  const deckVerified = deckVerifiedRes.data;
  const freeGames = freeGamesRes.data;
  const rpgGames = rpgGamesRes.data;
  const actionGames = actionGamesRes.data;
  const indieGames = indieGamesRes.data;

  // Genre counts
  const genreCountMap = new Map<string, number>();
  (allGamesGenresRes.data ?? []).forEach(g => {
    ((g.genres as string[]) ?? []).forEach(genre => {
      genreCountMap.set(genre, (genreCountMap.get(genre) ?? 0) + 1);
    });
  });
  const topGenres: [string, number][] = [...genreCountMap.entries()]
    .sort((a, b) => b[1] - a[1])
    .slice(0, 12);

  // Report counts per device
  const deviceReportMapLocal: Record<string, number> = {};
  (reportCountsRes.data ?? []).forEach(r => {
    deviceReportMapLocal[r.device_id] = (deviceReportMapLocal[r.device_id] ?? 0) + 1;
  });

  const curations: CurationItem[] = [
    {
      title: 'Highest Rated',
      subtitle: 'Top metacritic scores in our database',
      emoji: '\u{1F3C6}',
      games: (topRated ?? []).slice(0, 4).map(mapGame),
    },
    ...(deckVerified && deckVerified.length > 0 ? [{
      title: 'Steam Deck Verified',
      subtitle: 'Officially verified for Steam Deck',
      emoji: '\u2705',
      games: deckVerified.map(mapGame),
    }] : []),
    ...(freeGames && freeGames.length > 0 ? [{
      title: 'Free to Play',
      subtitle: 'Great handheld games that cost nothing',
      emoji: '\u{1F3AE}',
      games: freeGames.map(mapGame),
    }] : []),
    ...(rpgGames && rpgGames.length > 0 ? [{
      title: 'Best RPGs',
      subtitle: 'Role-playing adventures for handheld gaming',
      emoji: '\u2694\uFE0F',
      games: rpgGames.map(mapGame),
    }] : []),
    ...(actionGames && actionGames.length > 0 ? [{
      title: 'Top Action Games',
      subtitle: 'Fast-paced games that shine on handhelds',
      emoji: '\u{1F4A5}',
      games: actionGames.map(mapGame),
    }] : []),
    ...(indieGames && indieGames.length > 0 ? [{
      title: 'Indie Gems',
      subtitle: 'Hidden indie favorites with great handheld performance',
      emoji: '\u{1F48E}',
      games: indieGames.map(mapGame),
    }] : []),
  ].filter(c => c.games.length > 0);

  cached = {
    curations,
    topGenres,
    devices: (devicesRes.data ?? []) as Array<{ slug: string; name: string; manufacturer: string; id: string }>,
    deviceReportMap: deviceReportMapLocal,
    topRatedAll: (topRated ?? []).map(mapGame),
    recentlyAdded: (recentlyAddedRes.data ?? []).map(mapGame),
  };
  setCache(cacheKey, cached, 600); // 10 minutes
}

const { curations, topGenres, devices, deviceReportMap, topRatedAll, recentlyAdded } = cached;

// Genre color mapping (static, no need to cache)
const genreColors: Record<string, string> = {
  'Action': 'border-red-500/30 text-red-400 hover:bg-red-500/10',
  'RPG': 'border-purple-500/30 text-purple-400 hover:bg-purple-500/10',
  'Indie': 'border-[#a78bfa]/30 text-[#a78bfa] hover:bg-[#a78bfa]/10',
  'Adventure': 'border-[#a78bfa]/30 text-[#a78bfa] hover:bg-[#a78bfa]/10',
  'Strategy': 'border-blue-500/30 text-blue-400 hover:bg-blue-500/10',
  'Simulation': 'border-green-500/30 text-green-400 hover:bg-green-500/10',
  'Casual': 'border-yellow-500/30 text-yellow-400 hover:bg-yellow-500/10',
  'Puzzle': 'border-pink-500/30 text-pink-400 hover:bg-pink-500/10',
  'Shooter': 'border-orange-500/30 text-orange-400 hover:bg-orange-500/10',
  'Platformer': 'border-teal-500/30 text-teal-400 hover:bg-teal-500/10',
  'Horror': 'border-[#4a4560]/30 text-[#9890a8] hover:bg-[#4a4560]/10',
  'Racing': 'border-amber-500/30 text-amber-400 hover:bg-amber-500/10',
};
const defaultColor = 'border-[#4a4560]/30 text-[#9890a8] hover:bg-[#4a4560]/10';

// Deck badge helper for compact list
const deckBadgeMap: Record<string, { label: string; class: string }> = {
  verified: { label: 'Verified', class: 'text-green-400' },
  playable: { label: 'Playable', class: 'text-yellow-400' },
  unsupported: { label: 'Unsupported', class: 'text-red-400' },
};
---

<BaseLayout title="What Should I Play?" description="Discover the best handheld games. Curated lists for Steam Deck, ROG Ally, and Legion Go — browse by genre, rating, and device compatibility.">
  <div style="max-width:1080px;margin:0 auto;padding:40px 24px;">

    <!-- Page Heading -->
    <div style="margin-bottom:40px;">
      <h1 style="font-family:var(--font-display);font-size:clamp(28px,5vw,40px);font-weight:900;color:#eae6f4;letter-spacing:-0.03em;">What Should I Play?</h1>
      <p style="margin-top:8px;font-size:15px;color:#6d6882;max-width:480px;">Discover games perfect for handheld gaming — curated by the community, tested on real devices.</p>
    </div>

    <!-- ═══════════════════════════════════════════ -->
    <!-- GENRE TAGS — Horizontal scroll strip       -->
    <!-- ═══════════════════════════════════════════ -->
    {topGenres.length > 0 && (
      <div style="margin-bottom:40px;">
        <div style="font-family:var(--font-mono);font-size:10px;font-weight:600;color:#4a4560;letter-spacing:0.08em;text-transform:uppercase;margin-bottom:12px;">Browse by Genre</div>
        <div class="scroll-strip" style="display:flex;gap:8px;padding-bottom:4px;">
          {topGenres.map(([genre, count]) => (
            <a
              href={`/games?genre=${encodeURIComponent(genre)}`}
              style="flex-shrink:0;border-radius:100px;border:1px solid rgba(255,255,255,0.06);padding:7px 16px;font-size:13px;font-weight:500;color:#6d6882;text-decoration:none;transition:all 0.15s;white-space:nowrap;"
              class="hdb-genre-pill"
            >
              {genre}
              <span style="margin-left:6px;font-size:11px;opacity:0.5;">{count}</span>
            </a>
          ))}
        </div>
      </div>
    )}

    <!-- ═══════════════════════════════════════════ -->
    <!-- CURATED LISTS — Alternating layouts        -->
    <!-- ═══════════════════════════════════════════ -->
    <div style="display:flex;flex-direction:column;gap:48px;">
      {curations.map((list, idx) => (
        <section>
          <SectionHeader
            title={list.title}
            subtitle={list.subtitle}
            href="/games"
            editorial={list.emoji}
          />

          {/* ─── Layout 0: BENTO GRID (Highest Rated) ─── */}
          {idx === 0 && (
            <div class="grid grid-cols-2 lg:grid-cols-4 grid-rows-2 gap-3">
              {list.games[0] && (
                <div class="col-span-2 row-span-2">
                  <GameCardFeatured
                    slug={list.games[0].slug}
                    name={list.games[0].name}
                    headerImage={list.games[0].headerImage}
                    genres={list.games[0].genres}
                    deckCompatibility={list.games[0].deckCompatibility}
                  />
                </div>
              )}
              {list.games.slice(1).map((game) => (
                <GameCard {...game} />
              ))}
            </div>
          )}

          {/* ─── Layout 1: HORIZONTAL SCROLL (Deck Verified) ─── */}
          {idx === 1 && (
            <div class="flex gap-4 scroll-strip snap-x snap-mandatory pb-4">
              {list.games.map((game) => (
                <div class="flex-shrink-0 w-64 snap-center">
                  <GameCard {...game} />
                </div>
              ))}
            </div>
          )}

          {/* ─── Layout 2: COMPACT LIST (Free to Play) ─── */}
          {idx === 2 && (
            <div style="border-radius:14px;overflow:hidden;border:1px solid rgba(255,255,255,0.06);background:#0e0c16;">
              {list.games.map((game) => {
                const badge = deckBadgeMap[game.deckCompatibility ?? ''];
                return (
                  <a
                    href={`/games/${game.slug}`}
                    style="display:flex;align-items:center;justify-content:space-between;padding:14px 18px;border-bottom:1px solid rgba(255,255,255,0.04);text-decoration:none;transition:background 0.12s;"
                    class="hdb-list-row group"
                  >
                    <div style="display:flex;align-items:center;gap:10px;min-width:0;">
                      <span style="font-family:var(--font-display);font-size:14px;font-weight:600;color:#eae6f4;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;transition:color 0.15s;" class="group-hover:!text-[#a78bfa]">
                        {game.name}
                      </span>
                      {game.genres.length > 0 && (
                        <span style="font-size:11px;color:#4a4560;flex-shrink:0;" class="hidden sm:inline">{game.genres[0]}</span>
                      )}
                    </div>
                    <div style="display:flex;align-items:center;gap:10px;flex-shrink:0;">
                      {badge && (
                        <span class={`text-xs font-medium ${badge.class}`}>{badge.label}</span>
                      )}
                      <svg style="width:14px;height:14px;color:#2a2838;transition:color 0.15s;" class="group-hover:!text-[#6d6882]" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
                      </svg>
                    </div>
                  </a>
                );
              })}
            </div>
          )}

          {/* ─── Layout 3+: STANDARD GRID with first item bento-wide ─── */}
          {idx >= 3 && (
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
              {list.games.map((game, gameIdx) => (
                <div class={gameIdx === 0 ? 'sm:col-span-2' : ''}>
                  {gameIdx === 0 ? (
                    <GameCardFeatured
                      slug={game.slug}
                      name={game.name}
                      headerImage={game.headerImage}
                      genres={game.genres}
                      deckCompatibility={game.deckCompatibility}
                    />
                  ) : (
                    <GameCard {...game} />
                  )}
                </div>
              ))}
            </div>
          )}
        </section>
      ))}
    </div>

    <!-- ═══════════════════════════════════════════ -->
    <!-- DEVICE FILTERS — Prominent cards           -->
    <!-- ═══════════════════════════════════════════ -->
    {devices && devices.length > 0 && (
      <div style="margin-top:56px;">
        <SectionHeader
          title="Find Games for Your Device"
          subtitle="Browse performance reports by handheld"
        />
        <div class="stagger" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:12px;">
          {devices.map((device) => (
            <a
              href={`/devices/${device.slug}`}
              style="display:block;border-radius:14px;border:1px solid rgba(255,255,255,0.06);background:#0e0c16;padding:24px 16px;text-align:center;text-decoration:none;transition:all 0.2s;"
              class="hdb-device-discover group"
            >
              <div style="margin:0 auto 10px;width:44px;height:44px;border-radius:12px;background:#12101a;display:flex;align-items:center;justify-content:center;transition:background 0.15s;" class="group-hover:!bg-[#1a1828]">
                <svg style="width:22px;height:22px;color:#6d6882;" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 1.5H8.25A2.25 2.25 0 006 3.75v16.5a2.25 2.25 0 002.25 2.25h7.5A2.25 2.25 0 0018 20.25V3.75a2.25 2.25 0 00-2.25-2.25H13.5m-3 0V3h3V1.5m-3 0h3m-3 18.75h3" />
                </svg>
              </div>
              <div style="font-size:11px;color:#a78bfa;font-weight:600;letter-spacing:0.02em;">{device.manufacturer}</div>
              <div style="font-family:var(--font-display);font-size:16px;font-weight:700;color:#eae6f4;margin-top:2px;transition:color 0.15s;" class="group-hover:!text-[#a78bfa]">
                {device.name}
              </div>
              <div style="margin-top:8px;font-family:var(--font-mono);font-size:12px;color:#4a4560;">
                {deviceReportMap[device.id] ?? 0} reports
              </div>
            </a>
          ))}
        </div>
      </div>
    )}

    <!-- ═══════════════════════════════════════════ -->
    <!-- RECENTLY ADDED — Horizontal scroll strip   -->
    <!-- ═══════════════════════════════════════════ -->
    {recentlyAdded.length > 0 && (
      <div style="margin-top:56px;">
        <SectionHeader
          title="Recently Added"
          subtitle="Latest games added to the database"
          href="/games"
        />
        <div class="scroll-strip" style="display:flex;gap:12px;padding-bottom:8px;">
          {recentlyAdded.map((g) => (
            <div style="flex-shrink:0;width:240px;">
              <GameCard {...g} />
            </div>
          ))}
        </div>
      </div>
    )}
  </div>

<style>
  .hdb-genre-pill:hover {
    background: rgba(255,255,255,0.04);
    border-color: rgba(167,139,250,0.2);
    color: #a78bfa;
  }
  .hdb-list-row:hover {
    background: rgba(255,255,255,0.02);
  }
  .hdb-device-discover:hover {
    border-color: rgba(167,139,250,0.15);
    box-shadow: 0 4px 20px rgba(0,0,0,0.2), 0 0 16px rgba(167,139,250,0.04);
    transform: translateY(-2px);
  }
</style>
</BaseLayout>
