---
import BaseLayout from '@layouts/BaseLayout.astro';
import GameCard from '@components/astro/GameCard.astro';
import { supabaseAdmin } from '@lib/db/client';

// ─── Fetch real data from Supabase ───

// 1. Top-rated games (by metacritic_score)
const { data: topRated } = await supabaseAdmin
  .from('games')
  .select('slug, name, header_image, genres, deck_compatibility, metacritic_score')
  .not('metacritic_score', 'is', null)
  .order('metacritic_score', { ascending: false })
  .limit(8);

// 2. Steam Deck Verified games
const { data: deckVerified } = await supabaseAdmin
  .from('games')
  .select('slug, name, header_image, genres, deck_compatibility, metacritic_score')
  .eq('deck_compatibility', 'verified')
  .order('metacritic_score', { ascending: false })
  .limit(4);

// 3. Free to Play games
const { data: freeGames } = await supabaseAdmin
  .from('games')
  .select('slug, name, header_image, genres, deck_compatibility, metacritic_score')
  .eq('is_free_to_play', true)
  .order('metacritic_score', { ascending: false })
  .limit(4);

// 4. RPG games
const { data: rpgGames } = await supabaseAdmin
  .from('games')
  .select('slug, name, header_image, genres, deck_compatibility, metacritic_score')
  .contains('genres', ['RPG'])
  .order('metacritic_score', { ascending: false })
  .limit(4);

// 5. Action games
const { data: actionGames } = await supabaseAdmin
  .from('games')
  .select('slug, name, header_image, genres, deck_compatibility, metacritic_score')
  .contains('genres', ['Action'])
  .order('metacritic_score', { ascending: false })
  .limit(4);

// 6. Indie gems (Indie genre, good metacritic)
const { data: indieGames } = await supabaseAdmin
  .from('games')
  .select('slug, name, header_image, genres, deck_compatibility, metacritic_score')
  .contains('genres', ['Indie'])
  .not('metacritic_score', 'is', null)
  .order('metacritic_score', { ascending: false })
  .limit(4);

// Genre counts
const { data: allGamesGenres } = await supabaseAdmin
  .from('games')
  .select('genres');
const genreCountMap = new Map<string, number>();
(allGamesGenres ?? []).forEach(g => {
  ((g.genres as string[]) ?? []).forEach(genre => {
    genreCountMap.set(genre, (genreCountMap.get(genre) ?? 0) + 1);
  });
});

// Sort genres by count descending, take top 12
const topGenres = [...genreCountMap.entries()]
  .sort((a, b) => b[1] - a[1])
  .slice(0, 12);

// Genre color mapping
const genreColors: Record<string, string> = {
  'Action': 'border-red-500/30 text-red-400 hover:bg-red-500/10',
  'RPG': 'border-purple-500/30 text-purple-400 hover:bg-purple-500/10',
  'Indie': 'border-emerald-500/30 text-emerald-400 hover:bg-emerald-500/10',
  'Adventure': 'border-cyan-500/30 text-cyan-400 hover:bg-cyan-500/10',
  'Strategy': 'border-blue-500/30 text-blue-400 hover:bg-blue-500/10',
  'Simulation': 'border-green-500/30 text-green-400 hover:bg-green-500/10',
  'Casual': 'border-yellow-500/30 text-yellow-400 hover:bg-yellow-500/10',
  'Puzzle': 'border-pink-500/30 text-pink-400 hover:bg-pink-500/10',
  'Shooter': 'border-orange-500/30 text-orange-400 hover:bg-orange-500/10',
  'Platformer': 'border-teal-500/30 text-teal-400 hover:bg-teal-500/10',
  'Horror': 'border-gray-500/30 text-gray-400 hover:bg-gray-500/10',
  'Racing': 'border-amber-500/30 text-amber-400 hover:bg-amber-500/10',
};
const defaultColor = 'border-gray-500/30 text-gray-400 hover:bg-gray-500/10';

// Devices for quick filters
const { data: devices } = await supabaseAdmin
  .from('devices')
  .select('slug, name, manufacturer, id')
  .order('name')
  .limit(6);

// Report counts per device
const { data: reportCounts } = await supabaseAdmin
  .from('performance_reports')
  .select('device_id');
const deviceReportMap = new Map<string, number>();
(reportCounts ?? []).forEach(r => {
  deviceReportMap.set(r.device_id, (deviceReportMap.get(r.device_id) ?? 0) + 1);
});

// Build curated lists from real data
type GameRow = { slug: string; name: string; header_image: string | null; genres: string[] | null; deck_compatibility: string | null; metacritic_score: number | null };
const mapGame = (g: GameRow) => ({
  slug: g.slug,
  name: g.name,
  headerImage: g.header_image,
  genres: (g.genres as string[]) ?? [],
  deckCompatibility: g.deck_compatibility,
});

const curations = [
  {
    title: 'Highest Rated',
    subtitle: 'Top metacritic scores in our database',
    emoji: '🏆',
    games: (topRated ?? []).slice(0, 4).map(mapGame),
  },
  ...(deckVerified && deckVerified.length > 0 ? [{
    title: 'Steam Deck Verified',
    subtitle: 'Officially verified for Steam Deck',
    emoji: '✅',
    games: deckVerified.map(mapGame),
  }] : []),
  ...(freeGames && freeGames.length > 0 ? [{
    title: 'Free to Play',
    subtitle: 'Great handheld games that cost nothing',
    emoji: '🎮',
    games: freeGames.map(mapGame),
  }] : []),
  ...(rpgGames && rpgGames.length > 0 ? [{
    title: 'Best RPGs',
    subtitle: 'Role-playing adventures for handheld gaming',
    emoji: '⚔️',
    games: rpgGames.map(mapGame),
  }] : []),
  ...(actionGames && actionGames.length > 0 ? [{
    title: 'Top Action Games',
    subtitle: 'Fast-paced games that shine on handhelds',
    emoji: '💥',
    games: actionGames.map(mapGame),
  }] : []),
  ...(indieGames && indieGames.length > 0 ? [{
    title: 'Indie Gems',
    subtitle: 'Hidden indie favorites with great handheld performance',
    emoji: '💎',
    games: indieGames.map(mapGame),
  }] : []),
].filter(c => c.games.length > 0);
---

<BaseLayout title="What Should I Play?" description="Discover the best handheld games. Curated lists for Steam Deck, ROG Ally, and Legion Go — browse by genre, rating, and device compatibility.">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8">
    <div class="mb-10">
      <h1 class="text-3xl font-bold text-white">What Should I Play?</h1>
      <p class="mt-2 text-gray-400">Discover games perfect for handheld gaming</p>
    </div>

    <!-- Genre Tags Cloud -->
    {topGenres.length > 0 && (
      <div class="mb-10">
        <h2 class="text-sm font-semibold text-gray-400 uppercase tracking-wider mb-4">Browse by Genre</h2>
        <div class="flex flex-wrap gap-2">
          {topGenres.map(([genre, count]) => (
            <a
              href={`/games?genre=${encodeURIComponent(genre)}`}
              class={`rounded-full border px-4 py-2 text-sm font-medium transition-colors ${genreColors[genre] ?? defaultColor}`}
            >
              {genre}
              <span class="ml-1.5 text-xs opacity-60">{count}</span>
            </a>
          ))}
        </div>
      </div>
    )}

    <!-- Curated Lists -->
    <div class="space-y-12">
      {curations.map((list) => (
        <section>
          <div class="flex items-end justify-between mb-5">
            <div>
              <h2 class="text-xl font-bold text-white">
                <span class="mr-2">{list.emoji}</span>{list.title}
              </h2>
              <p class="mt-0.5 text-sm text-gray-500">{list.subtitle}</p>
            </div>
            <a href="/games" class="text-sm text-emerald-400 hover:text-emerald-300 transition-colors">
              View all &rarr;
            </a>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
            {list.games.map((game) => (
              <GameCard {...game} />
            ))}
          </div>
        </section>
      ))}
    </div>

    <!-- Quick Device Filters -->
    {devices && devices.length > 0 && (
      <div class="mt-16 mb-8">
        <h2 class="text-xl font-bold text-white mb-6 text-center">Find games for your device</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
          {devices.map((device) => (
            <a
              href={`/devices/${device.slug}`}
              class="group rounded-xl border border-gray-800 bg-gray-900 p-6 text-center hover:border-emerald-500/30 transition-colors"
            >
              <p class="text-xs text-gray-500 uppercase">{device.manufacturer}</p>
              <p class="text-lg font-bold text-white group-hover:text-emerald-400 transition-colors">
                {device.name}
              </p>
              <p class="mt-2 text-sm text-gray-400">
                {deviceReportMap.get(device.id) ?? 0} reports
              </p>
            </a>
          ))}
        </div>
      </div>
    )}

    <!-- Recently Added -->
    {(topRated ?? []).length > 4 && (
      <div class="mt-16">
        <div class="flex items-end justify-between mb-5">
          <div>
            <h2 class="text-xl font-bold text-white">
              <span class="mr-2">🆕</span>Recently Added
            </h2>
            <p class="mt-0.5 text-sm text-gray-500">Latest games added to the database</p>
          </div>
          <a href="/games" class="text-sm text-emerald-400 hover:text-emerald-300 transition-colors">
            View all &rarr;
          </a>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          {(topRated ?? []).slice(4, 8).map((g) => (
            <GameCard {...mapGame(g)} />
          ))}
        </div>
      </div>
    )}
  </div>
</BaseLayout>
