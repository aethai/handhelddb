---
import BaseLayout from '@layouts/BaseLayout.astro';
import GameCard from '@components/astro/GameCard.astro';
import { supabaseAdmin } from '@lib/db/client';
import { getCached, setCache } from '@lib/cache';

// ─── Types ───
type GameRow = { slug: string; name: string; header_image: string | null; genres: string[] | null; deck_compatibility: string | null; metacritic_score: number | null };
type MappedGame = { slug: string; name: string; headerImage: string | null; genres: string[]; deckCompatibility: string | null };
type CurationItem = { title: string; subtitle: string; emoji: string; games: MappedGame[] };
type DiscoverCache = {
  curations: CurationItem[];
  topGenres: [string, number][];
  devices: Array<{ slug: string; name: string; manufacturer: string; id: string }>;
  deviceReportMap: Record<string, number>;
  topRatedAll: MappedGame[];
};

const cacheKey = 'discover:curated';
let cached = getCached<DiscoverCache>(cacheKey);

if (!cached) {
  const mapGame = (g: GameRow): MappedGame => ({
    slug: g.slug,
    name: g.name,
    headerImage: g.header_image,
    genres: (g.genres as string[]) ?? [],
    deckCompatibility: g.deck_compatibility,
  });

  // ─── Fetch all 6 curated queries + genre counts + devices in parallel ───
  const [
    topRatedRes,
    deckVerifiedRes,
    freeGamesRes,
    rpgGamesRes,
    actionGamesRes,
    indieGamesRes,
    allGamesGenresRes,
    devicesRes,
    reportCountsRes,
  ] = await Promise.all([
    supabaseAdmin.from('games').select('slug, name, header_image, genres, deck_compatibility, metacritic_score').not('metacritic_score', 'is', null).order('metacritic_score', { ascending: false }).limit(8),
    supabaseAdmin.from('games').select('slug, name, header_image, genres, deck_compatibility, metacritic_score').eq('deck_compatibility', 'verified').order('metacritic_score', { ascending: false }).limit(4),
    supabaseAdmin.from('games').select('slug, name, header_image, genres, deck_compatibility, metacritic_score').eq('is_free_to_play', true).order('metacritic_score', { ascending: false }).limit(4),
    supabaseAdmin.from('games').select('slug, name, header_image, genres, deck_compatibility, metacritic_score').contains('genres', ['RPG']).order('metacritic_score', { ascending: false }).limit(4),
    supabaseAdmin.from('games').select('slug, name, header_image, genres, deck_compatibility, metacritic_score').contains('genres', ['Action']).order('metacritic_score', { ascending: false }).limit(4),
    supabaseAdmin.from('games').select('slug, name, header_image, genres, deck_compatibility, metacritic_score').contains('genres', ['Indie']).not('metacritic_score', 'is', null).order('metacritic_score', { ascending: false }).limit(4),
    supabaseAdmin.from('games').select('genres'),
    supabaseAdmin.from('devices').select('slug, name, manufacturer, id').order('name').limit(6),
    supabaseAdmin.from('performance_reports').select('device_id'),
  ]);

  const topRated = topRatedRes.data;
  const deckVerified = deckVerifiedRes.data;
  const freeGames = freeGamesRes.data;
  const rpgGames = rpgGamesRes.data;
  const actionGames = actionGamesRes.data;
  const indieGames = indieGamesRes.data;

  // Genre counts
  const genreCountMap = new Map<string, number>();
  (allGamesGenresRes.data ?? []).forEach(g => {
    ((g.genres as string[]) ?? []).forEach(genre => {
      genreCountMap.set(genre, (genreCountMap.get(genre) ?? 0) + 1);
    });
  });
  const topGenres: [string, number][] = [...genreCountMap.entries()]
    .sort((a, b) => b[1] - a[1])
    .slice(0, 12);

  // Report counts per device
  const deviceReportMapLocal: Record<string, number> = {};
  (reportCountsRes.data ?? []).forEach(r => {
    deviceReportMapLocal[r.device_id] = (deviceReportMapLocal[r.device_id] ?? 0) + 1;
  });

  const curations: CurationItem[] = [
    {
      title: 'Highest Rated',
      subtitle: 'Top metacritic scores in our database',
      emoji: '\u{1F3C6}',
      games: (topRated ?? []).slice(0, 4).map(mapGame),
    },
    ...(deckVerified && deckVerified.length > 0 ? [{
      title: 'Steam Deck Verified',
      subtitle: 'Officially verified for Steam Deck',
      emoji: '\u2705',
      games: deckVerified.map(mapGame),
    }] : []),
    ...(freeGames && freeGames.length > 0 ? [{
      title: 'Free to Play',
      subtitle: 'Great handheld games that cost nothing',
      emoji: '\u{1F3AE}',
      games: freeGames.map(mapGame),
    }] : []),
    ...(rpgGames && rpgGames.length > 0 ? [{
      title: 'Best RPGs',
      subtitle: 'Role-playing adventures for handheld gaming',
      emoji: '\u2694\uFE0F',
      games: rpgGames.map(mapGame),
    }] : []),
    ...(actionGames && actionGames.length > 0 ? [{
      title: 'Top Action Games',
      subtitle: 'Fast-paced games that shine on handhelds',
      emoji: '\u{1F4A5}',
      games: actionGames.map(mapGame),
    }] : []),
    ...(indieGames && indieGames.length > 0 ? [{
      title: 'Indie Gems',
      subtitle: 'Hidden indie favorites with great handheld performance',
      emoji: '\u{1F48E}',
      games: indieGames.map(mapGame),
    }] : []),
  ].filter(c => c.games.length > 0);

  cached = {
    curations,
    topGenres,
    devices: (devicesRes.data ?? []) as Array<{ slug: string; name: string; manufacturer: string; id: string }>,
    deviceReportMap: deviceReportMapLocal,
    topRatedAll: (topRated ?? []).map(mapGame),
  };
  setCache(cacheKey, cached, 600); // 10 minutes
}

const { curations, topGenres, devices, deviceReportMap, topRatedAll } = cached;

// Genre color mapping (static, no need to cache)
const genreColors: Record<string, string> = {
  'Action': 'border-red-500/30 text-red-400 hover:bg-red-500/10',
  'RPG': 'border-purple-500/30 text-purple-400 hover:bg-purple-500/10',
  'Indie': 'border-cyan-500/30 text-cyan-400 hover:bg-cyan-500/10',
  'Adventure': 'border-cyan-500/30 text-cyan-400 hover:bg-cyan-500/10',
  'Strategy': 'border-blue-500/30 text-blue-400 hover:bg-blue-500/10',
  'Simulation': 'border-green-500/30 text-green-400 hover:bg-green-500/10',
  'Casual': 'border-yellow-500/30 text-yellow-400 hover:bg-yellow-500/10',
  'Puzzle': 'border-pink-500/30 text-pink-400 hover:bg-pink-500/10',
  'Shooter': 'border-orange-500/30 text-orange-400 hover:bg-orange-500/10',
  'Platformer': 'border-teal-500/30 text-teal-400 hover:bg-teal-500/10',
  'Horror': 'border-gray-500/30 text-gray-400 hover:bg-gray-500/10',
  'Racing': 'border-amber-500/30 text-amber-400 hover:bg-amber-500/10',
};
const defaultColor = 'border-gray-500/30 text-gray-400 hover:bg-gray-500/10';
---

<BaseLayout title="What Should I Play?" description="Discover the best handheld games. Curated lists for Steam Deck, ROG Ally, and Legion Go — browse by genre, rating, and device compatibility.">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8">
    <div class="mb-10">
      <h1 class="text-3xl font-bold text-white font-heading">What Should I Play?</h1>
      <p class="mt-2 text-gray-400">Discover games perfect for handheld gaming</p>
    </div>

    <!-- Genre Tags Cloud -->
    {topGenres.length > 0 && (
      <div class="mb-10">
        <h2 class="text-sm font-semibold text-gray-400 uppercase tracking-wider mb-4 font-heading">Browse by Genre</h2>
        <div class="flex flex-wrap gap-2">
          {topGenres.map(([genre, count]) => (
            <a
              href={`/games?genre=${encodeURIComponent(genre)}`}
              class={`rounded-full border px-4 py-2 text-sm font-medium transition-colors ${genreColors[genre] ?? defaultColor}`}
            >
              {genre}
              <span class="ml-1.5 text-xs opacity-60">{count}</span>
            </a>
          ))}
        </div>
      </div>
    )}

    <!-- Curated Lists -->
    <div class="space-y-12">
      {curations.map((list) => (
        <section>
          <div class="flex items-end justify-between mb-5">
            <div>
              <h2 class="text-xl font-bold text-white">
                <span class="mr-2">{list.emoji}</span>{list.title}
              </h2>
              <p class="mt-0.5 text-sm text-gray-500">{list.subtitle}</p>
            </div>
            <a href="/games" class="text-sm text-cyan-400 hover:text-cyan-300 transition-colors">
              View all &rarr;
            </a>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
            {list.games.map((game) => (
              <GameCard {...game} />
            ))}
          </div>
        </section>
      ))}
    </div>

    <!-- Quick Device Filters -->
    {devices && devices.length > 0 && (
      <div class="mt-16 mb-8">
        <h2 class="text-xl font-bold text-white mb-6 text-center font-heading">Find games for your device</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
          {devices.map((device) => (
            <a
              href={`/devices/${device.slug}`}
              class="group rounded-xl border border-[#151c2b] bg-[#0f1520] p-6 text-center hover:border-cyan-500/30 transition-colors"
            >
              <p class="text-xs text-gray-500 uppercase">{device.manufacturer}</p>
              <p class="text-lg font-bold text-white group-hover:text-cyan-400 transition-colors">
                {device.name}
              </p>
              <p class="mt-2 text-sm text-gray-400">
                {deviceReportMap[device.id] ?? 0} reports
              </p>
            </a>
          ))}
        </div>
      </div>
    )}

    <!-- Recently Added -->
    {topRatedAll.length > 4 && (
      <div class="mt-16">
        <div class="flex items-end justify-between mb-5">
          <div>
            <h2 class="text-xl font-bold text-white">
              <span class="mr-2">🆕</span>Recently Added
            </h2>
            <p class="mt-0.5 text-sm text-gray-500">Latest games added to the database</p>
          </div>
          <a href="/games" class="text-sm text-cyan-400 hover:text-cyan-300 transition-colors">
            View all &rarr;
          </a>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          {topRatedAll.slice(4, 8).map((g) => (
            <GameCard {...g} />
          ))}
        </div>
      </div>
    )}
  </div>
</BaseLayout>
