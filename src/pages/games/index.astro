---
import BaseLayout from '@layouts/BaseLayout.astro';
import GamesBrowser from '@components/react/GamesBrowser';
import { supabaseAdmin } from '@lib/db/client';
import { getCached, setCache } from '@lib/cache';

const cacheKey = 'games:list:initial';

type CachedGamesData = {
  initialGames: Array<{
    id: string;
    slug: string;
    name: string;
    header_image: string | null;
    genres: string[];
    deck_compatibility: string | null;
    metacritic_score: number | null;
    is_free_to_play: boolean | null;
  }>;
  allGenres: string[];
  count: number;
};

let cached = getCached<CachedGamesData>(cacheKey);

if (!cached) {
  // Fetch initial games: prioritize popular titles with data for SEO first-paint
  const { count } = await supabaseAdmin
    .from('games')
    .select('id', { count: 'exact', head: true });

  const { data: games } = await supabaseAdmin
    .from('games')
    .select('id, slug, name, header_image, genres, deck_compatibility, metacritic_score, is_free_to_play')
    .not('metacritic_score', 'is', null)
    .not('header_image', 'is', null)
    .order('metacritic_score', { ascending: false })
    .limit(60);

  // Extract unique genres for filter pills from initial games + sample
  const genreSet = new Set<string>();
  (games ?? []).forEach(g => {
    ((g.genres as string[]) ?? []).forEach(genre => genreSet.add(genre));
  });
  // Sample more games for broader genre coverage
  const { data: extraGenres } = await supabaseAdmin
    .from('games')
    .select('genres')
    .not('genres', 'is', null)
    .limit(500);
  (extraGenres ?? []).forEach(g => {
    ((g.genres as string[]) ?? []).forEach(genre => genreSet.add(genre));
  });

  cached = {
    initialGames: (games ?? []).map(g => ({
      id: g.id,
      slug: g.slug,
      name: g.name,
      header_image: g.header_image,
      genres: (g.genres as string[]) ?? [],
      deck_compatibility: g.deck_compatibility,
      metacritic_score: g.metacritic_score,
      is_free_to_play: g.is_free_to_play,
    })),
    allGenres: [...genreSet].sort(),
    count: count ?? 0,
  };
  setCache(cacheKey, cached, 300); // 5 minutes
}

const { initialGames, allGenres, count } = cached;
---

<BaseLayout title="Games" description="Browse all games with handheld performance data. Find optimal settings for Steam Deck, ROG Ally, and Legion Go.">
  <div style="max-width:1080px;margin:0 auto;padding:32px 24px;">
    <div style="margin-bottom:20px;">
      <h1 style="font-family:var(--font-heading);font-size:clamp(28px,5vw,40px);font-weight:900;color:var(--color-text);letter-spacing:-0.03em;">Games</h1>
      <p style="margin-top:6px;font-size:14px;color:var(--color-text-3);">{count.toLocaleString()} games with handheld performance data</p>
    </div>

    <GamesBrowser
      client:load
      initialGames={initialGames}
      totalGames={count}
      allGenres={allGenres}
    />
  </div>
</BaseLayout>
