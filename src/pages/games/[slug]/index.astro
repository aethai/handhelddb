---
import BaseLayout from '@layouts/BaseLayout.astro';
import GameJsonLd from '@components/astro/GameJsonLd.astro';
import BreadcrumbJsonLd from '@components/astro/BreadcrumbJsonLd.astro';
import CommentSection from '@components/react/CommentSection';
import GameDetailPanel from '@components/react/GameDetailPanel';
import FollowButton from '@components/react/FollowButton';
import { supabaseAdmin } from '@lib/db/client';

const { slug } = Astro.params;
const currentUser = Astro.locals.user;

// ── Fetch game (must happen first — we need game.id) ──
const { data: game, error } = await supabaseAdmin
  .from('games')
  .select('id, name, slug, header_image, capsule_image, genres, developers, publishers, tags, short_description, description, release_date, price_usd, is_free_to_play, metacritic_score, steam_review_score, deck_compatibility, steam_appid, protondb_tier, hltb_main_hours, performance_tier')
  .eq('slug', slug)
  .single();

if (error || !game) {
  return Astro.redirect('/games');
}

// ── Parallel batch 1: devices, consensus, follow state, follower count ──
const [
  { data: devicesData },
  { data: consensusData },
  { data: followData },
  followerCountResult,
] = await Promise.all([
  supabaseAdmin
    .from('devices')
    .select('id, slug, name, manufacturer, chip, screen_resolution, battery_wh, tdp_min, tdp_max, image')
    .eq('is_active', true)
    .order('name')
    .limit(15),
  supabaseAdmin
    .from('consensus_ratings')
    .select('*')
    .eq('game_id', game.id),
  currentUser
    ? supabaseAdmin
        .from('game_follows')
        .select('id')
        .eq('game_id', game.id)
        .eq('user_id', currentUser.id)
        .maybeSingle()
    : Promise.resolve({ data: null }),
  supabaseAdmin
    .from('game_follows')
    .select('id', { count: 'exact', head: true })
    .eq('game_id', game.id),
]);
const followerCount = followerCountResult.count ?? 0;

// ── Build consensus lookup by device_id ──
const consensusById: Record<string, any> = {};
if (consensusData) {
  for (const c of consensusData) {
    consensusById[c.device_id] = c;
  }
}

// ── Determine default device ──
const deckDevice = devicesData?.find(d => d.slug === 'steam-deck-oled') ?? devicesData?.find(d => d.slug === 'steam-deck');
const deviceWithMostReports = devicesData
  ?.filter(d => consensusById[d.id]?.report_count > 0)
  ?.sort((a, b) => (consensusById[b.id]?.report_count ?? 0) - (consensusById[a.id]?.report_count ?? 0))[0];
const defaultDevice = (deckDevice && consensusById[deckDevice.id]) ? deckDevice : deviceWithMostReports ?? devicesData?.[0];

// ── Parallel batch 2: reports + similar games (need defaultDevice) ──
const gameGenres = (game.genres as string[]) ?? [];

const [reportsResult, similarRawResult] = await Promise.all([
  defaultDevice
    ? supabaseAdmin
        .from('performance_reports')
        .select('id, fps_avg, fps_low, preset, resolution, fsr_enabled, fsr_mode, tdp_limit_watts, battery_life_hours, overall_rating, notes, upvotes, downvotes, created_at, user:users(display_name, avatar_url, username)')
        .eq('game_id', game.id)
        .eq('device_id', defaultDevice.id)
        .eq('moderation_status', 'approved')
        .order('created_at', { ascending: false })
        .limit(10)
    : Promise.resolve({ data: [] }),
  gameGenres.length > 0
    ? supabaseAdmin
        .from('games')
        .select('id, name, slug, header_image')
        .neq('id', game.id)
        .contains('genres', [gameGenres[0]])
        .limit(20)
    : Promise.resolve({ data: [] }),
]);

const initialReports = reportsResult.data ?? [];

// ── Parallel batch 3: user votes + similar games consensus ──
const rawSimilar = similarRawResult.data ?? [];

const [userVotesResult, simConsResult] = await Promise.all([
  currentUser && initialReports.length > 0
    ? supabaseAdmin
        .from('report_votes')
        .select('report_id, is_upvote')
        .eq('user_id', currentUser.id)
        .in('report_id', initialReports.map((r: any) => r.id))
    : Promise.resolve({ data: [] }),
  rawSimilar.length > 0 && defaultDevice
    ? supabaseAdmin
        .from('consensus_ratings')
        .select('game_id, fps_avg')
        .in('game_id', rawSimilar.map(g => g.id))
        .eq('device_id', defaultDevice.id)
    : Promise.resolve({ data: [] }),
]);

// ── Build user votes map ──
let userVotesMap: Record<string, boolean> = {};
for (const v of userVotesResult.data ?? []) {
  userVotesMap[v.report_id] = v.is_upvote;
}

// ── Build similar games list ──
let similarGames: { name: string; slug: string; header_image: string | null; fps: number }[] = [];
if (rawSimilar.length > 0 && simConsResult.data?.length) {
  const consMap = new Map(simConsResult.data.map(c => [c.game_id, c.fps_avg]));
  similarGames = rawSimilar
    .filter(g => consMap.has(g.id) && consMap.get(g.id)! > 0)
    .slice(0, 4)
    .map(g => ({
      name: g.name,
      slug: g.slug,
      header_image: g.header_image,
      fps: Math.round(consMap.get(g.id)!),
    }));
}

// ── Derived data ──
const genres = (game.genres as string[]) ?? [];
const developers = (game.developers as string[]) ?? [];
const tags = (game.tags as string[]) ?? [];
const cleanDescription = game.short_description || (game.description?.replace(/<[^>]*>/g, '').slice(0, 500) ?? '');
const releaseYear = game.release_date ? new Date(game.release_date).getFullYear() : null;
const rawPrice = game.price_usd != null ? (game.price_usd > 200 ? game.price_usd / 100 : game.price_usd) : null;
const priceDisplay = rawPrice != null ? (game.is_free_to_play ? 'Free' : `$${rawPrice.toFixed(2)}`) : null;

const fpsColor = (f: number) => f >= 55 ? 'gd-fps-green' : f >= 40 ? 'gd-fps-yellow' : f >= 30 ? 'gd-fps-orange' : 'gd-fps-red';

// ── Short names for device tabs ──
function shortName(name: string): string {
  if (name.includes('Steam Deck OLED')) return 'DECK OLED';
  if (name.includes('Steam Deck')) return 'DECK';
  if (name.includes('ROG Ally X')) return 'ALLY X';
  if (name.includes('ROG Ally')) return 'ALLY';
  if (name.includes('Legion Go')) return 'LEGION';
  if (name.includes('GPD Win')) return 'GPD';
  if (name.includes('MSI Claw')) return 'CLAW';
  if (name.includes('AYANEO')) return 'AYANEO';
  const words = name.split(/[\s-]+/);
  return words.length > 1 ? words.slice(0, 2).join(' ').toUpperCase().slice(0, 10) : name.toUpperCase().slice(0, 8);
}

// ── Serialize data for React island ──
const panelData = {
  gameId: game.id,
  gameName: game.name,
  gameSlug: game.slug,
  devices: (devicesData ?? []).map(d => ({
    id: d.id, slug: d.slug, name: d.name, shortName: shortName(d.name),
    manufacturer: d.manufacturer, chip: d.chip,
    screen_resolution: d.screen_resolution, battery_wh: d.battery_wh,
    tdp_min: d.tdp_min, tdp_max: d.tdp_max, image: d.image,
  })),
  consensus: consensusById,
  defaultDeviceId: defaultDevice?.id ?? '',
  initialReports,
  gameInfo: {
    name: game.name, headerImage: game.header_image,
    metacriticScore: game.metacritic_score, steamReviewScore: game.steam_review_score,
    deckCompatibility: game.deck_compatibility, priceDisplay,
    subtitle: `${developers[0] ?? ''}${genres[0] ? ` · ${genres[0]}` : ''}${releaseYear ? ` · ${releaseYear}` : ''}`,
    description: cleanDescription, tags: tags.slice(0, 6), steamAppid: game.steam_appid,
  },
  isLoggedIn: !!currentUser,
  userVotes: userVotesMap,
};
---

<BaseLayout
  title={`${game.name} — Handheld Performance`}
  description={`Best settings for ${game.name} on Steam Deck, ROG Ally, Legion Go. FPS benchmarks, TDP profiles, and battery life.`}
  ogImage={`${import.meta.env.PUBLIC_SITE_URL ?? ''}/api/og/${slug}`}
>
  <GameJsonLd game={game} />
  <BreadcrumbJsonLd items={[
    { name: 'Home', url: `${import.meta.env.PUBLIC_SITE_URL ?? ''}/` },
    { name: 'Games', url: `${import.meta.env.PUBLIC_SITE_URL ?? ''}/games` },
    { name: game.name, url: `${import.meta.env.PUBLIC_SITE_URL ?? ''}/games/${game.slug}` },
  ]} />

  <!-- Embedded JSON data for React island -->
  <script type="application/json" id="game-page-data" set:html={JSON.stringify(panelData)} />

<div class="gd-page">

  <!-- Breadcrumbs -->
  <nav aria-label="Breadcrumb" class="gd-breadcrumb-wrap">
    <ol class="hdb-breadcrumb">
      <li><a href="/">Home</a></li>
      <li class="hdb-breadcrumb-sep" aria-hidden="true">›</li>
      <li><a href="/games">Games</a></li>
      <li class="hdb-breadcrumb-sep" aria-hidden="true">›</li>
      <li class="hdb-breadcrumb-current" aria-current="page">{game.name}</li>
    </ol>
  </nav>

  <!-- React island (hero + all interactive content) -->
  <GameDetailPanel client:load dataId="game-page-data" initialData={panelData} />

  <!-- Static bottom sections -->
  <div class="gd-bottom">

    <!-- CTA -->
    <section class="gd-cta-section">
      <div class="gd-cta">
        <div class="gd-cta-text">
          <h2 class="gd-cta-title">Played {game.name} on a handheld?</h2>
          <p class="gd-cta-sub">Share your FPS and settings. Takes about 5 minutes.</p>
        </div>
        <div class="gd-cta-actions">
          <FollowButton client:load gameId={game.id} initialFollowing={!!followData} followerCount={followerCount ?? 0} />
          <a href="/report/new" class="gd-btn-primary">SUBMIT REPORT</a>
        </div>
      </div>
    </section>

    <!-- Similar Games -->
    {similarGames.length >= 2 && (
      <section class="gd-similar-section">
        <h2 class="gd-section-title-static">Similar Games</h2>
        <div class="gd-similar-grid stagger">
          {similarGames.map(sg => (
            <a href={`/games/${sg.slug}`} class="gd-similar-card">
              {sg.header_image && (
                <div class="gd-similar-img">
                  <img src={sg.header_image} alt="" loading="lazy" />
                </div>
              )}
              <div class="gd-similar-body">
                <span class={`gd-similar-fps ${fpsColor(sg.fps)}`}>{sg.fps}<span class="gd-similar-fps-unit">fps</span></span>
                <span class="gd-similar-name">{sg.name}</span>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- Discussion -->
    <section class="gd-discussion-section">
      <h2 class="gd-section-title-static">Discussion</h2>
      <CommentSection
        client:visible
        gameId={game.id}
        currentUserId={currentUser?.id ?? null}
      />
    </section>
  </div>

</div>

</BaseLayout>

<style>
  /* ═══ PAGE ═══ */
  .gd-page {
    background: var(--color-base);
    min-height: 100vh;
  }
  .gd-breadcrumb-wrap {
    max-width: 1080px;
    margin: 0 auto;
    padding: 12px 24px 0;
  }
  .gd-bottom {
    max-width: 1080px;
    margin: 0 auto;
    padding: 0 24px;
  }

  /* ═══ FPS COLOR CLASSES ═══ */
  :global(.gd-fps-green) { color: var(--color-fps-green); }
  :global(.gd-fps-yellow) { color: var(--color-fps-yellow); }
  :global(.gd-fps-orange) { color: var(--color-fps-orange); }
  :global(.gd-fps-red) { color: var(--color-fps-red); }

  /* ═══ BADGES ═══ */
  :global(.gd-badge) {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 600;
    padding: 4px 10px;
    border-radius: 4px;
    letter-spacing: 0.03em;
    border: 1px solid var(--color-border);
    color: var(--color-text-3);
    background: var(--color-elevated);
  }
  :global(.gd-badge-green) { color: var(--color-fps-green); border-color: rgba(34,197,94,0.2); background: rgba(34,197,94,0.08); }
  :global(.gd-badge-yellow) { color: var(--color-fps-yellow); border-color: rgba(234,179,8,0.2); background: rgba(234,179,8,0.08); }
  :global(.gd-badge-red) { color: var(--color-fps-red); border-color: rgba(239,68,68,0.2); background: rgba(239,68,68,0.08); }
  :global(.gd-badge-dim) { color: var(--color-text-3); }

  /* ═══ HERO ═══ */
  :global(.gd-hero) {
    position: relative;
    min-height: 280px;
    overflow: hidden;
    display: flex;
    align-items: flex-end;
  }
  :global(.gd-hero-bg) {
    position: absolute;
    inset: 0;
  }
  :global(.gd-hero-bg img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.4;
  }
  :global(.gd-hero-bg::after) {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, var(--color-base) 0%, var(--color-base) 5%, transparent 60%),
                linear-gradient(to right, var(--color-base) 0%, transparent 50%);
  }
  :global(.gd-hero-inner) {
    position: relative;
    z-index: 1;
    max-width: 1080px;
    margin: 0 auto;
    width: 100%;
    padding: 80px 24px 32px;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 32px;
  }
  :global(.gd-hero-info) {
    flex: 1;
    min-width: 0;
  }
  :global(.gd-badges) {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
    margin-bottom: 12px;
  }
  :global(.gd-title) {
    font-family: var(--font-heading);
    font-size: clamp(28px, 5vw, 48px);
    font-weight: 800;
    color: var(--color-text);
    letter-spacing: -0.03em;
    line-height: 0.95;
    margin-bottom: 8px;
  }
  :global(.gd-subtitle) {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-text-3);
    letter-spacing: 0.02em;
  }

  /* Hero perf block */
  :global(.gd-hero-perf) {
    text-align: right;
    flex-shrink: 0;
  }
  :global(.gd-fps-big) {
    font-family: var(--font-mono);
    font-size: clamp(48px, 8vw, 80px);
    font-weight: 800;
    line-height: 0.85;
    letter-spacing: -0.04em;
    transition: color 0.3s;
  }
  :global(.gd-fps-unit) {
    font-size: 0.2em;
    font-weight: 500;
    opacity: 0.5;
    letter-spacing: 0.1em;
    margin-left: 4px;
    vertical-align: super;
  }
  :global(.gd-verdict) {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.12em;
    margin-top: 8px;
    transition: color 0.3s;
  }
  :global(.gd-perf-stats) {
    display: flex;
    gap: 20px;
    margin-top: 16px;
    justify-content: flex-end;
  }
  :global(.gd-perf-stat) {
    text-align: center;
  }
  :global(.gd-perf-stat-val) {
    display: block;
    font-family: var(--font-mono);
    font-size: 14px;
    font-weight: 700;
    color: var(--color-text);
  }
  :global(.gd-perf-stat-lbl) {
    display: block;
    font-family: var(--font-mono);
    font-size: 8px;
    color: var(--color-text-dim);
    letter-spacing: 0.1em;
    margin-top: 2px;
  }

  /* ═══ DEVICE TAB BAR ═══ */
  :global(.gd-device-bar) {
    border-bottom: 1px solid var(--color-border);
    background: var(--color-raised);
    position: sticky;
    top: 0;
    z-index: 20;
  }
  :global(.gd-device-bar-inner) {
    max-width: 1080px;
    margin: 0 auto;
    padding: 0 24px;
    display: flex;
    gap: 0;
    overflow-x: auto;
    scrollbar-width: none;
  }
  :global(.gd-device-bar-inner::-webkit-scrollbar) { display: none; }
  :global(.gd-device-tab) {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--color-text-dim);
    background: none;
    border: none;
    border-bottom: 2px solid transparent;
    padding: 12px 16px;
    cursor: pointer;
    white-space: nowrap;
    transition: color 0.15s, border-color 0.15s;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  :global(.gd-device-tab:hover) {
    color: var(--color-text-2);
  }
  :global(.gd-device-tab-active) {
    color: var(--color-text);
    border-bottom-color: var(--color-accent);
    font-weight: 700;
  }
  :global(.gd-device-tab-fps) {
    font-size: 10px;
    font-weight: 700;
    opacity: 0.7;
  }
  :global(.gd-device-tab-active .gd-device-tab-fps) {
    opacity: 1;
  }

  /* ═══ CONTENT ═══ */
  :global(.gd-content) {
    max-width: 1080px;
    margin: 0 auto;
    padding: 0 24px;
  }
  :global(.gd-section) {
    margin: 32px 0;
    padding-bottom: 32px;
    border-bottom: 1px solid var(--color-border-subtle);
  }
  :global(.gd-section:last-child) {
    border-bottom: none;
  }
  :global(.gd-section-head) {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 16px;
    flex-wrap: wrap;
    gap: 10px;
  }
  :global(.gd-section-title) {
    font-family: var(--font-heading);
    font-size: 18px;
    font-weight: 700;
    color: var(--color-text);
    letter-spacing: -0.02em;
  }
  :global(.gd-section-sub) {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    color: var(--color-text-dim);
    margin-left: 8px;
  }
  .gd-section-title-static {
    font-family: var(--font-heading);
    font-size: 18px;
    font-weight: 700;
    color: var(--color-text);
    letter-spacing: -0.02em;
    margin-bottom: 14px;
  }

  /* About */
  :global(.gd-about) {
    margin-top: 24px;
  }
  :global(.gd-description) {
    font-size: 13px;
    color: var(--color-text-2);
    line-height: 1.6;
    max-width: 600px;
    margin-bottom: 12px;
  }
  :global(.gd-tags) {
    display: flex;
    gap: 5px;
    flex-wrap: wrap;
    margin-bottom: 16px;
  }
  :global(.gd-tag) {
    font-family: var(--font-mono);
    font-size: 9px;
    color: var(--color-text-dim);
    background: var(--color-elevated);
    border: 1px solid var(--color-border-subtle);
    padding: 3px 10px;
    border-radius: 4px;
  }
  :global(.gd-actions) {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  :global(.gd-btn-primary) {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--color-accent-on);
    background: var(--color-accent);
    padding: 10px 24px;
    border: none;
    border-radius: 6px;
    text-decoration: none;
    transition: opacity 0.2s;
    cursor: pointer;
  }
  :global(.gd-btn-primary:hover) { opacity: 0.85; }
  :global(.gd-btn-ghost) {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    color: var(--color-text-3);
    padding: 10px 18px;
    border-radius: 6px;
    border: 1px solid var(--color-border);
    background: transparent;
    text-decoration: none;
    transition: border-color 0.15s, color 0.15s;
    cursor: pointer;
  }
  :global(.gd-btn-ghost:hover) {
    border-color: var(--color-border-strong);
    color: var(--color-text-2);
  }

  /* ═══ SETTINGS GRID ═══ */
  :global(.gd-settings-grid) {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 1px;
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid var(--color-border);
  }
  :global(.gd-setting-cell) {
    padding: 16px 12px;
    background: var(--color-raised);
    text-align: center;
  }
  :global(.gd-setting-cell:nth-child(even)) {
    background: var(--color-elevated);
  }
  :global(.gd-setting-val) {
    font-family: var(--font-mono);
    font-size: 14px;
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: 4px;
  }
  :global(.gd-setting-lbl) {
    font-family: var(--font-mono);
    font-size: 8px;
    color: var(--color-text-dim);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  /* ═══ TDP PROFILES ═══ */
  :global(.gd-profiles) {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid var(--color-border);
  }
  :global(.gd-profile) {
    padding: 20px 16px;
    background: var(--color-raised);
    text-align: center;
    position: relative;
  }
  :global(.gd-profile-bal) {
    background: var(--color-elevated);
  }
  :global(.gd-profile-bal::before) {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--color-accent), transparent);
  }
  :global(.gd-profile-label) {
    font-family: var(--font-mono);
    font-size: 9px;
    font-weight: 600;
    color: var(--color-text-dim);
    letter-spacing: 0.12em;
    margin-bottom: 10px;
  }
  :global(.gd-profile-bal .gd-profile-label) {
    color: var(--color-accent);
  }
  :global(.gd-profile-fps) {
    font-family: var(--font-mono);
    font-size: clamp(28px, 5vw, 40px);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 0.9;
  }
  :global(.gd-profile-meta) {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--color-text-3);
    margin-top: 8px;
  }

  /* ═══ ALL DEVICES ═══ */
  :global(.gd-devices-list) {
    display: flex;
    flex-direction: column;
    gap: 2px;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    overflow: hidden;
  }
