---
import BaseLayout from '@layouts/BaseLayout.astro';
import PerformanceBadge from '@components/astro/PerformanceBadge.astro';
import { supabaseAdmin } from '@lib/db/client';

const { slug } = Astro.params;

// Fetch game from Supabase
const { data: game, error } = await supabaseAdmin
  .from('games')
  .select('*')
  .eq('slug', slug)
  .single();

if (error || !game) {
  return Astro.redirect('/games');
}

// Fetch all devices for sidebar "Quick Verdict" (placeholder until we have reports)
const { data: devicesData } = await supabaseAdmin
  .from('devices')
  .select('slug, name')
  .eq('is_active', true)
  .order('name')
  .limit(6);

const deckStatusColors: Record<string, { label: string; class: string }> = {
  verified: { label: 'Verified', class: 'bg-green-500/20 text-green-400 border-green-500/30' },
  playable: { label: 'Playable', class: 'bg-yellow-500/20 text-yellow-400 border-yellow-500/30' },
  unsupported: { label: 'Unsupported', class: 'bg-red-500/20 text-red-400 border-red-500/30' },
  unknown: { label: 'Unknown', class: 'bg-gray-500/20 text-gray-400 border-gray-500/30' },
};

const protonColors: Record<string, { label: string; class: string }> = {
  platinum: { label: 'Platinum', class: 'bg-blue-500/20 text-blue-300' },
  gold: { label: 'Gold', class: 'bg-yellow-500/20 text-yellow-400' },
  silver: { label: 'Silver', class: 'bg-gray-400/20 text-gray-300' },
  bronze: { label: 'Bronze', class: 'bg-orange-500/20 text-orange-400' },
  borked: { label: 'Borked', class: 'bg-red-500/20 text-red-400' },
  pending: { label: 'Pending', class: 'bg-gray-500/20 text-gray-400' },
};

const genres = (game.genres as string[]) ?? [];
const developers = (game.developers as string[]) ?? [];
const publishers = (game.publishers as string[]) ?? [];
const screenshots = (game.screenshots as string[]) ?? [];
const tags = (game.tags as string[]) ?? [];

const deckInfo = deckStatusColors[game.deck_compatibility ?? 'unknown'] ?? deckStatusColors.unknown;
const protonInfo = protonColors[game.protondb_tier ?? 'pending'] ?? protonColors.pending;

const releaseDate = game.release_date ? new Date(game.release_date).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) : null;

// Strip HTML from description
const cleanDescription = game.short_description || (game.description?.replace(/<[^>]*>/g, '').slice(0, 500) ?? '');
---

<BaseLayout
  title={`${game.name} — Handheld Performance`}
  description={`Best settings for ${game.name} on Steam Deck, ROG Ally, Legion Go. FPS benchmarks, TDP profiles, and battery life.`}
  ogImage={game.header_image}
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8">
    <!-- Breadcrumb -->
    <nav class="mb-4 text-sm text-gray-500">
      <a href="/" class="hover:text-white transition-colors">Home</a>
      <span class="mx-2">/</span>
      <a href="/games" class="hover:text-white transition-colors">Games</a>
      <span class="mx-2">/</span>
      <span class="text-gray-300">{game.name}</span>
    </nav>

    <div class="flex flex-col lg:flex-row gap-8">
      <!-- MAIN CONTENT -->
      <div class="flex-1 min-w-0">
        <!-- Game Header Card -->
        <div class="rounded-xl border border-gray-800 bg-gray-900 overflow-hidden">
          {game.header_image ? (
            <div class="w-full aspect-[460/215] overflow-hidden relative">
              <img src={game.header_image} alt={game.name} class="w-full h-full object-cover" />
              <div class="absolute top-4 left-4 flex gap-2">
                <span class={`rounded-lg border px-2 py-1 text-xs font-medium ${deckInfo.class}`}>Deck {deckInfo.label}</span>
                {game.protondb_tier && game.protondb_tier !== 'pending' && (
                  <span class={`rounded-lg px-2 py-1 text-xs font-medium ${protonInfo.class}`}>ProtonDB {protonInfo.label}</span>
                )}
              </div>
            </div>
          ) : (
            <div class="w-full aspect-[21/7] bg-gradient-to-br from-gray-800 via-gray-850 to-gray-900 flex items-center justify-center relative">
              <span class="text-5xl font-bold text-gray-700/50">{game.name}</span>
              <div class="absolute top-4 left-4 flex gap-2">
                <span class={`rounded-lg border px-2 py-1 text-xs font-medium ${deckInfo.class}`}>Deck {deckInfo.label}</span>
              </div>
            </div>
          )}

          <div class="p-6">
            <div class="flex items-start justify-between gap-4">
              <div>
                <h1 class="text-3xl font-bold text-white">{game.name}</h1>
                <div class="mt-2 flex items-center gap-3 text-sm text-gray-400 flex-wrap">
                  {developers[0] && <span>{developers[0]}</span>}
                  {genres.length > 0 && (
                    <>
                      <span class="text-gray-700">|</span>
                      {genres.map(genre => (
                        <span class="rounded-full bg-gray-800 px-2.5 py-0.5 text-xs text-gray-300">{genre}</span>
                      ))}
                    </>
                  )}
                </div>
              </div>
              <div class="flex gap-2 flex-shrink-0">
                <a
                  href="/report/new"
                  class="inline-flex items-center gap-1.5 rounded-lg bg-emerald-600 px-3 py-1.5 text-sm font-medium text-white hover:bg-emerald-500 transition-colors"
                >
                  <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" /></svg>
                  Report
                </a>
              </div>
            </div>
            {cleanDescription && (
              <p class="mt-4 text-gray-400 leading-relaxed">{cleanDescription}</p>
            )}
          </div>
        </div>

        <!-- PERFORMANCE BY DEVICE -->
        <div class="mt-6 space-y-4">
          <div class="flex items-center justify-between">
            <h2 class="text-xl font-bold text-white">Performance by Device</h2>
          </div>

          <div class="rounded-xl border border-gray-800 bg-gray-900 p-8 text-center">
            <div class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-2xl bg-gray-800">
              <svg class="h-8 w-8 text-gray-600" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3v11.25A2.25 2.25 0 006 16.5h2.25M3.75 3h-1.5m1.5 0h16.5m0 0h1.5m-1.5 0v11.25A2.25 2.25 0 0118 16.5h-2.25m-7.5 0h7.5m-7.5 0l-1 3m8.5-3l1 3m0 0l.5 1.5m-.5-1.5h-9.5m0 0l-.5 1.5" />
              </svg>
            </div>
            <h3 class="text-lg font-semibold text-white">No performance data yet</h3>
            <p class="mt-2 text-sm text-gray-400">Be the first to report how {game.name} runs on your handheld!</p>
            <a
              href="/report/new"
              class="mt-4 inline-flex items-center gap-2 rounded-lg bg-emerald-600 px-4 py-2 text-sm font-medium text-white hover:bg-emerald-500 transition-colors"
            >
              <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" /></svg>
              Submit First Report
            </a>
          </div>
        </div>

        <!-- SCREENSHOTS -->
        {screenshots.length > 0 && (
          <div class="mt-8">
            <h2 class="text-xl font-bold text-white mb-4">Screenshots</h2>
            <div class="grid grid-cols-2 lg:grid-cols-3 gap-3">
              {screenshots.slice(0, 6).map((url) => (
                <div class="aspect-video rounded-lg overflow-hidden bg-gray-800">
                  <img src={url} alt={`${game.name} screenshot`} class="w-full h-full object-cover" loading="lazy" />
                </div>
              ))}
            </div>
          </div>
        )}
      </div>

      <!-- SIDEBAR -->
      <aside class="w-full lg:w-80 flex-shrink-0 space-y-4">
        <!-- Game Info -->
        <div class="rounded-xl border border-gray-800 bg-gray-900 p-5">
          <h3 class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-3">Game Info</h3>
          <dl class="space-y-2.5 text-sm">
            {developers[0] && (
              <div class="flex justify-between"><dt class="text-gray-500">Developer</dt><dd class="text-gray-300">{developers[0]}</dd></div>
            )}
            {publishers[0] && (
              <div class="flex justify-between"><dt class="text-gray-500">Publisher</dt><dd class="text-gray-300">{publishers[0]}</dd></div>
            )}
            {releaseDate && (
              <div class="flex justify-between"><dt class="text-gray-500">Released</dt><dd class="text-gray-300">{releaseDate}</dd></div>
            )}
            {game.price_usd != null && (
              <div class="flex justify-between"><dt class="text-gray-500">Price</dt><dd class="text-gray-300">{game.is_free_to_play ? 'Free to Play' : `$${game.price_usd.toFixed(2)}`}</dd></div>
            )}
            {genres.length > 0 && (
              <div class="flex justify-between"><dt class="text-gray-500">Genres</dt><dd class="text-gray-300 text-right">{genres.join(', ')}</dd></div>
            )}
          </dl>
        </div>

        <!-- Scores -->
        {(game.metacritic_score || game.steam_review_score) && (
          <div class="rounded-xl border border-gray-800 bg-gray-900 p-5">
            <h3 class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-3">Scores</h3>
            <div class="grid grid-cols-2 gap-3">
              {game.metacritic_score && (
                <div class="rounded-lg bg-gray-800 p-3 text-center">
                  <p class={`text-xl font-bold ${game.metacritic_score >= 75 ? 'text-green-400' : game.metacritic_score >= 50 ? 'text-yellow-400' : 'text-red-400'}`}>{game.metacritic_score}</p>
                  <p class="text-xs text-gray-500 mt-0.5">Metacritic</p>
                </div>
              )}
              {game.steam_review_score && (
                <div class="rounded-lg bg-gray-800 p-3 text-center">
                  <p class="text-xl font-bold text-blue-400">{game.steam_review_score}%</p>
                  <p class="text-xs text-gray-500 mt-0.5">Steam</p>
                </div>
              )}
            </div>
          </div>
        )}

        <!-- Compatibility -->
        <div class="rounded-xl border border-gray-800 bg-gray-900 p-5">
          <h3 class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-3">Compatibility</h3>
          <dl class="space-y-2.5 text-sm">
            <div class="flex justify-between items-center">
              <dt class="text-gray-500">Deck Status</dt>
              <dd class={`rounded-md px-2 py-0.5 text-xs font-medium ${deckInfo.class}`}>{deckInfo.label}</dd>
            </div>
            {game.protondb_tier && game.protondb_tier !== 'pending' && (
              <div class="flex justify-between items-center">
                <dt class="text-gray-500">ProtonDB</dt>
                <dd class={`rounded-md px-2 py-0.5 text-xs font-medium ${protonInfo.class}`}>{protonInfo.label}</dd>
              </div>
            )}
            {game.anticheat_engine && (
              <div class="flex justify-between items-center">
                <dt class="text-gray-500">Anti-Cheat</dt>
                <dd class="text-gray-300 text-xs">{game.anticheat_engine}</dd>
              </div>
            )}
          </dl>
        </div>

        <!-- HLTB -->
        {(game.hltb_main_hours || game.hltb_extra_hours || game.hltb_completionist_hours) && (
          <div class="rounded-xl border border-gray-800 bg-gray-900 p-5">
            <h3 class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-3">Time to Beat</h3>
            <div class="space-y-2">
              {game.hltb_main_hours && (
                <>
                  <div class="flex justify-between items-center"><span class="text-sm text-gray-500">Main Story</span><span class="text-sm font-medium text-gray-300">{game.hltb_main_hours}h</span></div>
                  <div class="h-1.5 rounded-full bg-gray-800 overflow-hidden">
                    <div class="h-full rounded-full bg-emerald-500/60" style={`width: ${Math.min((game.hltb_main_hours / (game.hltb_completionist_hours || game.hltb_main_hours)) * 100, 100)}%`}></div>
                  </div>
                </>
              )}
              {game.hltb_extra_hours && (
                <>
                  <div class="flex justify-between items-center mt-2"><span class="text-sm text-gray-500">Main + Extra</span><span class="text-sm font-medium text-gray-300">{game.hltb_extra_hours}h</span></div>
                  <div class="h-1.5 rounded-full bg-gray-800 overflow-hidden">
                    <div class="h-full rounded-full bg-emerald-500/60" style={`width: ${Math.min((game.hltb_extra_hours / (game.hltb_completionist_hours || game.hltb_extra_hours)) * 100, 100)}%`}></div>
                  </div>
                </>
              )}
              {game.hltb_completionist_hours && (
                <>
                  <div class="flex justify-between items-center mt-2"><span class="text-sm text-gray-500">Completionist</span><span class="text-sm font-medium text-gray-300">{game.hltb_completionist_hours}h</span></div>
                  <div class="h-1.5 rounded-full bg-gray-800 overflow-hidden"><div class="h-full rounded-full bg-emerald-500/60" style="width: 100%"></div></div>
                </>
              )}
            </div>
          </div>
        )}

        <!-- Tested on Devices -->
        {(devicesData && devicesData.length > 0) && (
          <div class="rounded-xl border border-gray-800 bg-gray-900 p-5">
            <h3 class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-3">Test on Your Device</h3>
            <div class="space-y-2">
              {devicesData.map(d => (
                <a href={`/games/${slug}/${d.slug}`} class="flex items-center justify-between rounded-lg bg-gray-800 px-3 py-2 text-sm text-gray-300 hover:bg-gray-700 hover:text-white transition-colors">
                  <span>{d.name}</span>
                  <span class="text-xs text-gray-500">0 reports</span>
                </a>
              ))}
            </div>
          </div>
        )}

        <!-- Steam Link -->
        {game.steam_appid && (
          <a
            href={`https://store.steampowered.com/app/${game.steam_appid}`}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center justify-center gap-2 rounded-xl border border-gray-700 bg-gray-900 p-4 text-sm font-medium text-gray-300 hover:border-gray-500 hover:text-white transition-colors"
          >
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 15h-2v-2h2v2zm0-4h-2V7h2v6z" /></svg>
            View on Steam
          </a>
        )}
      </aside>
    </div>
  </div>
</BaseLayout>
