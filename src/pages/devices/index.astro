---
import BaseLayout from '@layouts/BaseLayout.astro';
import DeviceCard from '@components/astro/DeviceCard.astro';
import { supabaseAdmin } from '@lib/db/client';
import { getCached, setCache } from '@lib/cache';

type DeviceItem = {
  slug: string;
  name: string;
  manufacturer: string;
  screenSize: number | null;
  batteryWh: number | null;
  chip: string | null;
  image: string | null;
  msrpUsd: number | null;
};

const cacheKey = 'devices:list';
let devices = getCached<DeviceItem[]>(cacheKey);

if (!devices) {
  const { data: devicesData } = await supabaseAdmin
    .from('devices')
    .select('*')
    .eq('is_active', true)
    .order('manufacturer')
    .order('name');

  devices = (devicesData ?? []).map(d => ({
    slug: d.slug,
    name: d.name,
    manufacturer: d.manufacturer,
    screenSize: d.screen_size,
    batteryWh: d.battery_wh,
    chip: d.chip,
    image: d.image,
    msrpUsd: d.msrp_usd,
  }));
  setCache(cacheKey, devices, 600); // 10 minutes
}

// Featured devices: try Steam Deck + ROG Ally X, fallback to first 2
const featuredSlugs = ['steam-deck-oled', 'rog-ally-x'];
let featuredDevices = devices.filter(d => featuredSlugs.includes(d.slug));
if (featuredDevices.length < 2) {
  featuredDevices = devices.slice(0, Math.min(2, devices.length));
}

// Group remaining devices by manufacturer
const devicesByManufacturer = new Map<string, DeviceItem[]>();
for (const device of devices) {
  const group = devicesByManufacturer.get(device.manufacturer) ?? [];
  group.push(device);
  devicesByManufacturer.set(device.manufacturer, group);
}

// Sort manufacturers alphabetically
const sortedManufacturers = [...devicesByManufacturer.keys()].sort();
---

<BaseLayout title="Devices" description="Compare handheld gaming devices. Steam Deck, ROG Ally, ROG Ally X, Legion Go specs, performance, and game compatibility.">
  <div style="max-width:1080px;margin:0 auto;padding:40px 24px;">

    <!-- Page Heading -->
    <div style="margin-bottom:32px;">
      <h1 style="font-family:var(--font-display);font-size:clamp(28px,5vw,40px);font-weight:900;color:#eae6f4;letter-spacing:-0.03em;">Devices</h1>
      <p style="margin-top:8px;font-size:15px;color:#6d6882;">{devices.length} handheld gaming devices tracked</p>
    </div>

    <!-- Featured Devices -->
    {featuredDevices.length > 0 && (
      <section style="margin-bottom:48px;">
        <div style="display:flex;align-items:center;gap:12px;margin-bottom:16px;">
          <span style="font-family:var(--font-mono);font-size:10px;font-weight:600;color:#a78bfa;letter-spacing:0.08em;text-transform:uppercase;">Featured</span>
          <div class="metallic-line" style="flex:1;"></div>
        </div>

        <div class="stagger" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:16px;">
          {featuredDevices.map((device) => (
            <a href={`/devices/${device.slug}`} class="hdb-featured-device group" style="display:block;border-radius:16px;border:1px solid rgba(255,255,255,0.06);background:#0e0c16;overflow:hidden;text-decoration:none;transition:all 0.2s;">
              <div style="height:160px;background:linear-gradient(135deg,#12101a,#0e0c16);display:flex;align-items:center;justify-content:center;padding:20px;">
                {device.image ? (
                  <img src={device.image} alt={device.name} style="height:100%;width:100%;object-fit:contain;" loading="eager" />
                ) : (
                  <svg style="width:64px;height:64px;color:#2a2838;" viewBox="0 0 32 32" fill="none">
                    <rect x="4" y="8" width="24" height="16" rx="4" stroke="currentColor" stroke-width="1.5" />
                    <circle cx="11" cy="16" r="2" fill="currentColor" />
                    <circle cx="21" cy="14" r="1.5" fill="currentColor" />
                    <circle cx="23" cy="16" r="1.5" fill="currentColor" />
                    <circle cx="21" cy="18" r="1.5" fill="currentColor" />
                    <circle cx="19" cy="16" r="1.5" fill="currentColor" />
                  </svg>
                )}
              </div>

              <div style="padding:20px;">
                <div style="font-size:11px;font-weight:600;color:#a78bfa;letter-spacing:0.02em;margin-bottom:4px;">{device.manufacturer}</div>
                <h2 style="font-family:var(--font-display);font-size:22px;font-weight:800;color:#eae6f4;transition:color 0.15s;" class="group-hover:!text-[#a78bfa]">
                  {device.name}
                </h2>

                <div style="margin-top:12px;display:flex;flex-wrap:wrap;gap:6px;">
                  {device.chip && (
                    <span style="display:inline-flex;align-items:center;gap:6px;border-radius:8px;background:#12101a;border:1px solid rgba(255,255,255,0.06);padding:5px 10px;font-size:12px;color:#9890a8;">
                      {device.chip}
                    </span>
                  )}
                  {device.batteryWh && (
                    <span style="display:inline-flex;align-items:center;gap:6px;border-radius:8px;background:#12101a;border:1px solid rgba(255,255,255,0.06);padding:5px 10px;font-size:12px;color:#9890a8;">
                      {device.batteryWh} Wh
                    </span>
                  )}
                  {device.screenSize && (
                    <span style="display:inline-flex;align-items:center;gap:6px;border-radius:8px;background:#12101a;border:1px solid rgba(255,255,255,0.06);padding:5px 10px;font-size:12px;color:#9890a8;">
                      {device.screenSize}"
                    </span>
                  )}
                </div>

                <div style="margin-top:14px;display:flex;align-items:center;justify-content:space-between;">
                  <div>
                    {device.msrpUsd && (
                      <span style="font-family:var(--font-mono);font-size:18px;font-weight:800;color:#eae6f4;">${device.msrpUsd}</span>
                    )}
                  </div>
                  <div style="display:flex;align-items:center;gap:12px;">
                    <span style="font-size:13px;color:#a78bfa;font-weight:600;transition:color 0.15s;">View details &rarr;</span>
                  </div>
                </div>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- All Devices Grouped by Manufacturer -->
    {sortedManufacturers.map((manufacturer) => {
      const manufacturerDevices = devicesByManufacturer.get(manufacturer)!;
      return (
        <section style="margin-bottom:40px;">
          <div style="display:flex;align-items:center;gap:12px;margin-bottom:14px;">
            <div class="metallic-line" style="flex:1;"></div>
            <span style="font-family:var(--font-mono);font-size:10px;font-weight:600;color:#a78bfa;letter-spacing:0.08em;text-transform:uppercase;white-space:nowrap;">{manufacturer}</span>
            <div class="metallic-line" style="flex:1;"></div>
          </div>

          <div class="stagger" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:10px;">
            {manufacturerDevices.map((device) => (
              <DeviceCard {...device} />
            ))}
          </div>
        </section>
      );
    })}
  </div>

<style>
  .hdb-featured-device:hover {
    border-color: rgba(167,139,250,0.15);
    box-shadow: 0 4px 24px rgba(0,0,0,0.3), 0 0 20px rgba(167,139,250,0.06);
    transform: translateY(-2px);
  }
</style>
</BaseLayout>
