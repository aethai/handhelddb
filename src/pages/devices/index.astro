---
import BaseLayout from '@layouts/BaseLayout.astro';
import DeviceCard from '@components/astro/DeviceCard.astro';
import { supabaseAdmin } from '@lib/db/client';
import { getCached, setCache } from '@lib/cache';

type DeviceItem = {
  slug: string;
  name: string;
  manufacturer: string;
  screenSize: number | null;
  batteryWh: number | null;
  chip: string | null;
  image: string | null;
  msrpUsd: number | null;
};

const cacheKey = 'devices:list';
let devices = getCached<DeviceItem[]>(cacheKey);

if (!devices) {
  const { data: devicesData } = await supabaseAdmin
    .from('devices')
    .select('*')
    .order('manufacturer')
    .order('name');

  devices = (devicesData ?? []).map(d => ({
    slug: d.slug,
    name: d.name,
    manufacturer: d.manufacturer,
    screenSize: d.screen_size,
    batteryWh: d.battery_wh,
    chip: d.chip,
    image: d.image,
    msrpUsd: d.msrp_usd,
  }));
  setCache(cacheKey, devices, 600); // 10 minutes
}
---

<BaseLayout title="Devices" description="Compare handheld gaming devices. Steam Deck OLED, ROG Ally X, Legion Go specs, performance, and game compatibility.">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8">
    <div class="mb-8">
      <h1 class="text-3xl font-bold text-white font-heading">Devices</h1>
      <div class="mt-2 h-0.5 w-24 bg-gradient-to-r from-[#D4A574] to-[#DAA520]"></div>
      <p class="mt-2 text-gray-400">{devices.length} supported handheld gaming devices</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      {devices.map((device) => (
        <DeviceCard {...device} />
      ))}
    </div>

    <!-- Comparison CTA -->
    <div class="mt-8 rounded-xl border border-[#292524] bg-[#1C1917] p-6 text-center">
      <h2 class="text-lg font-semibold text-white">Can't decide?</h2>
      <p class="mt-1 text-sm text-gray-400">Compare devices side-by-side to see which one is right for you.</p>
      <a
        href="/compare/steam-deck-oled/rog-ally-x"
        class="mt-4 inline-flex items-center gap-2 rounded-lg bg-[#C9956B] px-4 py-2 text-sm font-medium text-white hover:bg-[#D4A574] transition-colors"
      >
        Compare Devices
      </a>
    </div>
  </div>
</BaseLayout>
