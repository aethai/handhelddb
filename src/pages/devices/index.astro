---
import BaseLayout from '@layouts/BaseLayout.astro';
import DeviceCard from '@components/astro/DeviceCard.astro';

// TODO: Fetch from DB
const devices = [
  {
    slug: 'steam-deck-oled',
    name: 'Steam Deck OLED',
    manufacturer: 'Valve',
    screenSize: 7.4,
    batteryWh: 50,
    chip: 'AMD Van Gogh',
    msrpUsd: 549,
  },
  {
    slug: 'rog-ally-x',
    name: 'ASUS ROG Ally X',
    manufacturer: 'ASUS',
    screenSize: 7.0,
    batteryWh: 80,
    chip: 'Ryzen Z1 Extreme',
    msrpUsd: 799,
  },
  {
    slug: 'legion-go',
    name: 'Lenovo Legion Go',
    manufacturer: 'Lenovo',
    screenSize: 8.8,
    batteryWh: 49.2,
    chip: 'Ryzen Z1 Extreme',
    msrpUsd: 699,
  },
];
---

<BaseLayout title="Devices" description="Compare handheld gaming devices. Steam Deck OLED, ROG Ally X, Legion Go specs, performance, and game compatibility.">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8">
    <div class="mb-8">
      <h1 class="text-3xl font-bold text-white">Devices</h1>
      <p class="mt-1 text-gray-400">Supported handheld gaming devices</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      {devices.map((device) => (
        <DeviceCard {...device} />
      ))}
    </div>

    <!-- Comparison CTA -->
    <div class="mt-8 rounded-xl border border-gray-800 bg-gray-900 p-6 text-center">
      <h2 class="text-lg font-semibold text-white">Can't decide?</h2>
      <p class="mt-1 text-sm text-gray-400">Compare devices side-by-side to see which one is right for you.</p>
      <a
        href="/compare/steam-deck-oled/rog-ally-x"
        class="mt-4 inline-flex items-center gap-2 rounded-lg bg-emerald-600 px-4 py-2 text-sm font-medium text-white hover:bg-emerald-500 transition-colors"
      >
        Compare Devices
      </a>
    </div>
  </div>
</BaseLayout>
