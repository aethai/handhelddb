---
import BaseLayout from '@layouts/BaseLayout.astro';
import { supabaseAdmin } from '@lib/db/client';

const { slug } = Astro.params;

// Fetch device
const { data: device, error } = await supabaseAdmin
  .from('devices')
  .select('*')
  .eq('slug', slug)
  .single();

if (error || !device) {
  return Astro.redirect('/devices');
}

// Fetch other devices for comparison links
const { data: otherDevices } = await supabaseAdmin
  .from('devices')
  .select('slug, name')
  .neq('slug', slug)
  .eq('is_active', true)
  .order('name')
  .limit(5);
---

<BaseLayout
  title={`${device.name} — Game Performance Database`}
  description={`${device.name} game compatibility and performance data. Specs, FPS benchmarks, optimal settings, battery life.`}
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8">
    <!-- Breadcrumb -->
    <nav class="mb-4 text-sm text-gray-500">
      <a href="/" class="hover:text-white transition-colors">Home</a>
      <span class="mx-2">/</span>
      <a href="/devices" class="hover:text-white transition-colors">Devices</a>
      <span class="mx-2">/</span>
      <span class="text-gray-300">{device.name}</span>
    </nav>

    <!-- Device Header -->
    <div class="rounded-xl border border-gray-800 bg-gray-900 p-6 sm:p-8">
      <div class="flex flex-col md:flex-row gap-6">
        <!-- Device image placeholder -->
        <div class="w-full md:w-56 h-56 rounded-xl bg-gradient-to-br from-gray-800 to-gray-900 flex items-center justify-center border border-gray-800">
          {device.image ? (
            <img src={device.image} alt={device.name} class="h-full w-full object-contain rounded-xl" />
          ) : (
            <svg class="h-20 w-20 text-gray-700" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
              <rect x="4" y="8" width="24" height="16" rx="4" stroke="currentColor" stroke-width="1.5" />
              <circle cx="11" cy="16" r="2" fill="currentColor" />
              <circle cx="21" cy="14" r="1.5" fill="currentColor" />
              <circle cx="23" cy="16" r="1.5" fill="currentColor" />
              <circle cx="21" cy="18" r="1.5" fill="currentColor" />
              <circle cx="19" cy="16" r="1.5" fill="currentColor" />
            </svg>
          )}
        </div>

        <div class="flex-1">
          <p class="text-xs text-emerald-400 uppercase tracking-wider font-semibold">{device.manufacturer}</p>
          <h1 class="text-3xl font-bold text-white mt-1">{device.name}</h1>

          <!-- Quick specs pills -->
          <div class="mt-4 flex flex-wrap gap-2">
            {device.chip && <span class="rounded-lg bg-gray-800 border border-gray-700 px-3 py-1.5 text-xs text-gray-300">{device.chip}</span>}
            {device.ram_gb && <span class="rounded-lg bg-gray-800 border border-gray-700 px-3 py-1.5 text-xs text-gray-300">{device.ram_gb}GB RAM</span>}
            {device.screen_size && device.screen_type && <span class="rounded-lg bg-gray-800 border border-gray-700 px-3 py-1.5 text-xs text-gray-300">{device.screen_size}" {device.screen_type}</span>}
            {device.battery_wh && <span class="rounded-lg bg-gray-800 border border-gray-700 px-3 py-1.5 text-xs text-gray-300">{device.battery_wh} Wh</span>}
            {(device.tdp_min != null && device.tdp_max != null) && <span class="rounded-lg bg-gray-800 border border-gray-700 px-3 py-1.5 text-xs text-gray-300">{device.tdp_min}-{device.tdp_max}W TDP</span>}
            {device.weight_grams && <span class="rounded-lg bg-gray-800 border border-gray-700 px-3 py-1.5 text-xs text-gray-300">{device.weight_grams}g</span>}
            {device.chipset_generation && <span class="rounded-lg bg-emerald-500/10 border border-emerald-500/20 px-3 py-1.5 text-xs text-emerald-400">{device.chipset_generation}</span>}
          </div>

          <!-- No reports yet message -->
          <div class="mt-6 rounded-lg bg-gray-800/50 border border-gray-700 p-4">
            <p class="text-sm text-gray-400">No performance reports yet. Be the first to test games on the {device.name}!</p>
            <a href="/report/new" class="mt-2 inline-flex items-center gap-1.5 rounded-lg bg-emerald-600 px-3 py-1.5 text-sm font-medium text-white hover:bg-emerald-500 transition-colors">
              <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" /></svg>
              Submit First Report
            </a>
          </div>
        </div>
      </div>
    </div>

    <div class="mt-6 grid grid-cols-1 lg:grid-cols-3 gap-6">
      <!-- MAIN (2/3) -->
      <div class="lg:col-span-2">
        <div class="rounded-xl border border-gray-800 bg-gray-900 p-8 text-center">
          <div class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-2xl bg-gray-800">
            <svg class="h-8 w-8 text-gray-600" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3v11.25A2.25 2.25 0 006 16.5h2.25M3.75 3h-1.5m1.5 0h16.5m0 0h1.5m-1.5 0v11.25A2.25 2.25 0 0118 16.5h-2.25m-7.5 0h7.5m-7.5 0l-1 3m8.5-3l1 3m0 0l.5 1.5m-.5-1.5h-9.5m0 0l-.5 1.5" />
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-white">Game performance data coming soon</h3>
          <p class="mt-2 text-sm text-gray-400 max-w-md mx-auto">
            Once users start submitting performance reports, you'll see FPS benchmarks, optimal settings, and battery life data for games tested on the {device.name}.
          </p>
        </div>
      </div>

      <!-- SIDEBAR (1/3) -->
      <div class="space-y-4">
        <!-- Full Specs -->
        <div class="rounded-xl border border-gray-800 bg-gray-900 p-5">
          <h3 class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-3">Full Specifications</h3>
          <dl class="space-y-2.5 text-sm">
            {device.chip && <div class="flex justify-between"><dt class="text-gray-500">Chip</dt><dd class="text-gray-300 text-right max-w-[60%]">{device.chip}</dd></div>}
            {device.gpu && <div class="flex justify-between"><dt class="text-gray-500">GPU</dt><dd class="text-gray-300 text-right max-w-[60%]">{device.gpu}</dd></div>}
            {device.ram_gb && <div class="flex justify-between"><dt class="text-gray-500">RAM</dt><dd class="text-gray-300">{device.ram_gb} GB</dd></div>}
            {device.storage_gb && <div class="flex justify-between"><dt class="text-gray-500">Storage</dt><dd class="text-gray-300">{device.storage_gb} GB</dd></div>}
            {device.screen_size && <div class="flex justify-between"><dt class="text-gray-500">Screen</dt><dd class="text-gray-300">{device.screen_size}" {device.screen_type ?? ''}</dd></div>}
            {device.screen_resolution && <div class="flex justify-between"><dt class="text-gray-500">Resolution</dt><dd class="text-gray-300">{device.screen_resolution}</dd></div>}
            {device.battery_wh && <div class="flex justify-between"><dt class="text-gray-500">Battery</dt><dd class="text-gray-300">{device.battery_wh} Wh</dd></div>}
            {(device.tdp_min != null && device.tdp_max != null) && <div class="flex justify-between"><dt class="text-gray-500">TDP Range</dt><dd class="text-gray-300">{device.tdp_min}-{device.tdp_max}W</dd></div>}
            {device.tdp_default && <div class="flex justify-between"><dt class="text-gray-500">Default TDP</dt><dd class="text-gray-300">{device.tdp_default}W</dd></div>}
            {device.weight_grams && <div class="flex justify-between"><dt class="text-gray-500">Weight</dt><dd class="text-gray-300">{device.weight_grams}g</dd></div>}
            {device.default_os && <div class="flex justify-between"><dt class="text-gray-500">OS</dt><dd class="text-gray-300">{device.default_os}</dd></div>}
            {device.msrp_usd && <div class="flex justify-between"><dt class="text-gray-500">Price</dt><dd class="text-gray-300 font-medium">${device.msrp_usd}</dd></div>}
          </dl>
        </div>

        <!-- Compare CTA -->
        {otherDevices && otherDevices.length > 0 && (
          <div class="rounded-xl border border-gray-800 bg-gray-900 p-5">
            <h3 class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-3">Compare</h3>
            <div class="flex flex-col gap-2">
              {otherDevices.map(d => (
                <a
                  href={`/compare/${slug}/${d.slug}`}
                  class="rounded-lg border border-gray-700 px-3 py-2 text-sm text-gray-300 hover:border-emerald-500 hover:text-white transition-colors text-center"
                >
                  vs {d.name}
                </a>
              ))}
            </div>
          </div>
        )}
      </div>
    </div>
  </div>
</BaseLayout>
