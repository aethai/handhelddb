---
import BaseLayout from '@layouts/BaseLayout.astro';

const { slug } = Astro.params;
const deviceName = slug?.split('-').map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(' ') ?? 'Device';
---

<BaseLayout
  title={`${deviceName} — Game Performance Database`}
  description={`${deviceName} game compatibility and performance data. See FPS benchmarks, optimal settings, and battery life for hundreds of games.`}
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8">
    <!-- Device Header -->
    <div class="rounded-xl border border-gray-800 bg-gray-900 p-6">
      <div class="flex flex-col md:flex-row gap-6">
        <div class="w-full md:w-48 h-48 rounded-lg bg-gray-800 flex items-center justify-center">
          <svg class="h-16 w-16 text-gray-600" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
            <rect x="5" y="3" width="14" height="18" rx="3" />
          </svg>
        </div>
        <div class="flex-1">
          <h1 class="text-3xl font-bold text-white">{deviceName}</h1>
          <p class="mt-4 text-gray-400">Device details will be loaded from the database.</p>

          <!-- Stats placeholders -->
          <div class="mt-6 grid grid-cols-2 sm:grid-cols-4 gap-4">
            <div class="rounded-lg bg-gray-800 p-3 text-center">
              <p class="text-2xl font-bold text-white">—</p>
              <p class="text-xs text-gray-500">Games Tested</p>
            </div>
            <div class="rounded-lg bg-gray-800 p-3 text-center">
              <p class="text-2xl font-bold text-green-400">—</p>
              <p class="text-xs text-gray-500">60fps Games</p>
            </div>
            <div class="rounded-lg bg-gray-800 p-3 text-center">
              <p class="text-2xl font-bold text-yellow-400">—</p>
              <p class="text-xs text-gray-500">40fps Games</p>
            </div>
            <div class="rounded-lg bg-gray-800 p-3 text-center">
              <p class="text-2xl font-bold text-emerald-400">—</p>
              <p class="text-xs text-gray-500">Avg Battery</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Tested Games -->
    <div class="mt-6 rounded-xl border border-gray-800 bg-gray-900 p-6">
      <h2 class="text-xl font-bold text-white mb-4">Tested Games</h2>
      <div class="text-center py-8 text-gray-600">
        <p>Connect database to see tested games for this device.</p>
      </div>
    </div>
  </div>
</BaseLayout>
