---
import BaseLayout from '@layouts/BaseLayout.astro';
import PerformanceHeatmap from '@components/react/PerformanceHeatmap';
import { supabaseAdmin } from '@lib/db/client';

const { slug } = Astro.params;

// Fetch device
const { data: device, error } = await supabaseAdmin
  .from('devices')
  .select('*')
  .eq('slug', slug)
  .eq('is_active', true)
  .single();

if (error || !device) {
  return Astro.redirect('/devices');
}

// Fetch other devices for comparison links
const { data: otherDevices } = await supabaseAdmin
  .from('devices')
  .select('slug, name')
  .neq('slug', slug)
  .eq('is_active', true)
  .order('name')
  .limit(5);

// Fetch performance reports for this device (for heatmap)
const { data: deviceReportsRaw } = await supabaseAdmin
  .from('performance_reports')
  .select('fps_avg, overall_rating, preset, game_id, games(name, slug)')
  .eq('device_id', device.id)
  .eq('is_flagged', false)
  .limit(2000);

// Group reports by game, calculate averages
const gameGroups = new Map<string, {
  gameName: string;
  gameSlug: string;
  fpsValues: number[];
  ratings: string[];
  presets: string[];
}>();

for (const report of deviceReportsRaw ?? []) {
  const game = (report as any).games;
  if (!game?.slug || !report.fps_avg) continue;

  const existing = gameGroups.get(game.slug);
  if (existing) {
    existing.fpsValues.push(report.fps_avg);
    if (report.overall_rating) existing.ratings.push(report.overall_rating);
    if (report.preset) existing.presets.push(report.preset);
  } else {
    gameGroups.set(game.slug, {
      gameName: game.name,
      gameSlug: game.slug,
      fpsValues: [report.fps_avg],
      ratings: report.overall_rating ? [report.overall_rating] : [],
      presets: report.preset ? [report.preset] : [],
    });
  }
}

// Build heatmap data
const heatmapData = [...gameGroups.values()].map((g) => {
  const fpsAvg = g.fpsValues.reduce((a, b) => a + b, 0) / g.fpsValues.length;
  // Most common rating
  const ratingCounts = new Map<string, number>();
  for (const r of g.ratings) {
    ratingCounts.set(r, (ratingCounts.get(r) ?? 0) + 1);
  }
  let topRating = 'fair';
  let topRatingCount = 0;
  for (const [rating, count] of ratingCounts) {
    if (count > topRatingCount) {
      topRating = rating;
      topRatingCount = count;
    }
  }
  // Most common preset
  const presetCounts = new Map<string, number>();
  for (const p of g.presets) {
    presetCounts.set(p, (presetCounts.get(p) ?? 0) + 1);
  }
  let topPreset = 'medium';
  let topPresetCount = 0;
  for (const [preset, count] of presetCounts) {
    if (count > topPresetCount) {
      topPreset = preset;
      topPresetCount = count;
    }
  }
  return {
    gameName: g.gameName,
    gameSlug: g.gameSlug,
    fpsAvg: Math.round(fpsAvg * 10) / 10,
    rating: topRating,
    preset: topPreset,
    reportCount: g.fpsValues.length,
  };
});

// Build specs array for the bento grid
type SpecItem = { label: string; value: string };
const specs: SpecItem[] = [];
if (device.chip) specs.push({ label: 'Chip', value: device.chip });
if (device.gpu) specs.push({ label: 'GPU', value: device.gpu });
if (device.ram_gb) specs.push({ label: 'RAM', value: `${device.ram_gb} GB` });
if (device.storage_gb) specs.push({ label: 'Storage', value: `${device.storage_gb} GB` });
if (device.screen_size) specs.push({ label: 'Screen', value: `${device.screen_size}" ${device.screen_type ?? ''}`.trim() });
if (device.screen_resolution) specs.push({ label: 'Resolution', value: device.screen_resolution });
if (device.battery_wh) specs.push({ label: 'Battery', value: `${device.battery_wh} Wh` });
if (device.tdp_min != null && device.tdp_max != null) specs.push({ label: 'TDP Range', value: `${device.tdp_min}-${device.tdp_max}W` });
if (device.tdp_default) specs.push({ label: 'Default TDP', value: `${device.tdp_default}W` });
if (device.weight_grams) specs.push({ label: 'Weight', value: `${device.weight_grams}g` });
if (device.default_os) specs.push({ label: 'OS', value: device.default_os });
if (device.msrp_usd) specs.push({ label: 'MSRP', value: `$${device.msrp_usd}` });
if (device.chipset_generation) specs.push({ label: 'Generation', value: device.chipset_generation });
---

<BaseLayout
  title={`${device.name} — Game Performance Database`}
  description={`${device.name} game compatibility and performance data. Specs, FPS benchmarks, optimal settings, battery life.`}
>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Product",
    "name": device.name,
    "brand": { "@type": "Brand", "name": device.manufacturer },
    ...(device.image ? { "image": device.image } : {}),
    "description": `${device.name} handheld gaming device by ${device.manufacturer}. ${device.chip ? `Powered by ${device.chip}.` : ''} ${device.screen_size ? `${device.screen_size}" display.` : ''} ${device.battery_wh ? `${device.battery_wh}Wh battery.` : ''}`.trim(),
    ...(device.msrp_usd ? { "offers": { "@type": "Offer", "priceCurrency": "USD", "price": device.msrp_usd } } : {}),
    "additionalProperty": specs.map(s => ({ "@type": "PropertyValue", "name": s.label, "value": s.value })),
  })} />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://handhelddb.com/" },
      { "@type": "ListItem", "position": 2, "name": "Devices", "item": "https://handhelddb.com/devices" },
      { "@type": "ListItem", "position": 3, "name": device.name, "item": `https://handhelddb.com/devices/${device.slug}` },
    ],
  })} />
  <div style="max-width:1080px;margin:0 auto;padding:24px 24px 40px;">

    <!-- Breadcrumb -->
    <nav aria-label="Breadcrumb" style="margin-bottom:16px;">
      <ol class="hdb-breadcrumb">
        <li><a href="/">Home</a></li>
        <li class="hdb-breadcrumb-sep" aria-hidden="true">›</li>
        <li><a href="/devices">Devices</a></li>
        <li class="hdb-breadcrumb-sep" aria-hidden="true">›</li>
        <li class="hdb-breadcrumb-current" aria-current="page">{device.name}</li>
      </ol>
    </nav>

    <!-- Full-width Device Hero -->
    <section style="border-radius:16px;border:1px solid rgba(255,255,255,0.06);background:var(--color-raised);padding:24px;margin-bottom:28px;" class="sm:!p-10">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-center">

        <!-- Left: Device Image -->
        <div class="flex items-center justify-center h-64 md:h-80 bg-gradient-to-br from-[var(--color-elevated)]/50 to-transparent rounded-lg p-8">
          {device.image ? (
            <img
              src={device.image}
              alt={device.name}
              class="h-full w-full object-contain drop-shadow-2xl"
              loading="eager"
            />
          ) : (
            <svg class="h-32 w-32 text-[var(--color-text-dim)]" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
              <rect x="4" y="8" width="24" height="16" rx="4" stroke="currentColor" stroke-width="1.5" />
              <circle cx="11" cy="16" r="2" fill="currentColor" />
              <circle cx="21" cy="14" r="1.5" fill="currentColor" />
              <circle cx="23" cy="16" r="1.5" fill="currentColor" />
              <circle cx="21" cy="18" r="1.5" fill="currentColor" />
              <circle cx="19" cy="16" r="1.5" fill="currentColor" />
            </svg>
          )}
        </div>

        <!-- Right: Name + Bento Spec Grid -->
        <div>
          <p class="editorial-label mb-2">{device.manufacturer}</p>
          <h1 class="text-4xl sm:text-5xl font-bold text-white leading-tight">{device.name}</h1>

          {device.chipset_generation && (
            <span class="mt-3 inline-block rounded-full bg-[#D4FF00]/10 border border-[#D4FF00]/20 px-3 py-1 text-xs text-[#D4FF00] font-medium">
              {device.chipset_generation}
            </span>
          )}

          {device.msrp_usd && (
            <p class="mt-4 text-3xl font-mono font-bold text-white">${device.msrp_usd}</p>
          )}

          <!-- Bento Spec Grid -->
          <div class="mt-6 grid grid-cols-3 gap-2">
            {specs.slice(0, 9).map((spec) => (
              <div class="rounded-lg bg-[var(--color-elevated)] p-3 text-center">
                <p class="text-lg font-bold font-mono text-white truncate" title={spec.value}>{spec.value}</p>
                <p class="text-xs text-[var(--color-text-dim)] mt-0.5">{spec.label}</p>
              </div>
            ))}
          </div>

          <!-- Overflow specs (if more than 9) -->
          {specs.length > 9 && (
            <div class="mt-2 grid grid-cols-3 gap-2">
              {specs.slice(9).map((spec) => (
                <div class="rounded-lg bg-[var(--color-elevated)] p-3 text-center">
                  <p class="text-lg font-bold font-mono text-white truncate" title={spec.value}>{spec.value}</p>
                  <p class="text-xs text-[var(--color-text-dim)] mt-0.5">{spec.label}</p>
                </div>
              ))}
            </div>
          )}
        </div>
      </div>
    </section>

    <!-- Compare Links -->
    {otherDevices && otherDevices.length > 0 && (
      <section class="mb-8">
        <div class="flex items-center gap-4 mb-4">
          <span class="editorial-label">Compare</span>
          <div class="flex-1 metallic-line"></div>
        </div>
        <div class="flex flex-wrap gap-2">
          {otherDevices.map(d => (
            <a
              href={`/compare/${slug}/${d.slug}`}
              class="rounded-full border border-[#D4FF00]/30 text-[#D4FF00] px-4 py-2 text-sm hover:bg-[#D4FF00]/10 hover:border-[#D4FF00]/50 transition-all"
            >
              vs {d.name}
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- Performance Heatmap (Primary Content) -->
    {heatmapData.length > 0 ? (
      <section class="mb-8">
        <div class="flex items-center gap-4 mb-4">
          <span class="editorial-label">Performance</span>
          <div class="flex-1 metallic-line"></div>
        </div>
        <div class="rounded-lg border border-white/6 bg-[var(--color-raised)] p-6 sm:p-8">
          <PerformanceHeatmap
            client:visible
            data={heatmapData}
            deviceName={device.name}
            deviceSlug={device.slug}
          />
        </div>
      </section>
    ) : (
      <section class="mb-8">
        <div class="flex items-center gap-4 mb-4">
          <span class="editorial-label">Performance</span>
          <div class="flex-1 metallic-line"></div>
        </div>
        <div class="section-atmospheric rounded-lg border border-white/6 p-10 sm:p-14 text-center">
          <div class="mx-auto mb-6 flex h-20 w-20 items-center justify-center rounded-lg bg-[var(--color-elevated)] border border-white/9">
            <svg class="h-10 w-10 text-[#D4FF00]/40" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3v11.25A2.25 2.25 0 006 16.5h2.25M3.75 3h-1.5m1.5 0h16.5m0 0h1.5m-1.5 0v11.25A2.25 2.25 0 0118 16.5h-2.25m-7.5 0h7.5m-7.5 0l-1 3m8.5-3l1 3m0 0l.5 1.5m-.5-1.5h-9.5m0 0l-.5 1.5" />
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-white mb-2">No performance data yet</h3>
          <p class="text-[var(--color-text-2)] max-w-lg mx-auto mb-6">
            Be the first to submit a performance report for the {device.name}. Your benchmarks help the entire community find optimal settings.
          </p>
          <a
            href="/report/new"
            class="inline-flex items-center gap-2 rounded-lg bg-[#D4FF00] px-6 py-3 text-sm font-semibold text-[#0a0a0a] hover:bg-[#e8ff4d] transition-colors"
          >
            <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" /></svg>
            Submit First Report
          </a>
        </div>
      </section>
    )}

  </div>
</BaseLayout>
