---
import BaseLayout from '@layouts/BaseLayout.astro';
import AdminNav from '@components/astro/AdminNav.astro';
import { requireAdmin } from './_admin-guard';
import { supabaseAdmin } from '@lib/db/client';

const redirect = await requireAdmin(Astro);
if (redirect) return redirect;

// ─── Pagination ───
const PER_PAGE = 25;
const page = Math.max(1, parseInt(Astro.url.searchParams.get('page') ?? '1', 10) || 1);
const offset = (page - 1) * PER_PAGE;

// ─── Search filter ───
const search = Astro.url.searchParams.get('q')?.trim() ?? '';

// ─── Fetch users ───
let query = supabaseAdmin
  .from('users')
  .select('id, display_name, email, avatar_url, points, level, is_admin, is_banned, is_verified_tester, created_at', { count: 'exact' })
  .order('created_at', { ascending: false })
  .range(offset, offset + PER_PAGE - 1);

if (search) {
  query = query.or(`display_name.ilike.%${search}%,email.ilike.%${search}%`);
}

const { data: users, count: totalCount } = await query;
const total = totalCount ?? 0;
const totalPages = Math.ceil(total / PER_PAGE);

function formatDate(dateStr: string): string {
  return new Date(dateStr).toLocaleDateString('en-US', {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
  });
}

function levelLabel(level: string | null): string {
  if (!level) return 'New';
  return level.replace(/_/g, ' ').replace(/\b\w/g, c => c.toUpperCase());
}

// Build pagination numbers in frontmatter to avoid template parser issues
function buildPageNumbers(currentPage: number, total: number): number[] {
  if (total <= 7) return Array.from({ length: total }, (_, i) => i + 1);
  const pages: number[] = [];
  const count = Math.min(total, 7);
  for (let i = 0; i < count; i++) {
    if (currentPage <= 4) {
      pages.push(i + 1);
    } else if (currentPage >= total - 3) {
      pages.push(total - 6 + i);
    } else {
      pages.push(currentPage - 3 + i);
    }
  }
  return pages;
}

const pageNumbers = buildPageNumbers(page, totalPages);
---

<BaseLayout title="Users Management" noindex>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8">
    <div class="mb-8">
      <h1 class="text-2xl font-bold text-white">Users Management</h1>
      <p class="mt-1 text-sm text-[#8a8a94]">{total.toLocaleString()} total users</p>
    </div>

    <div class="flex flex-col lg:flex-row gap-8">
      <AdminNav />

      <div class="flex-1 min-w-0">
        <!-- Search -->
        <form method="get" class="mb-6">
          <div class="flex gap-3">
            <input
              type="text"
              name="q"
              value={search}
              placeholder="Search by name or email..."
              class="flex-1 rounded-lg border border-[#25252e] bg-[#0f0f12] px-4 py-2 text-sm text-white placeholder-[#55555e] focus:border-[#7c6cf0] focus:ring-1 focus:ring-[#7c6cf0] focus:outline-none"
            />
            <button
              type="submit"
              class="rounded-lg bg-[#7c6cf0] px-4 py-2 text-sm font-medium text-white hover:bg-[#6d5cff] transition-colors"
            >
              Search
            </button>
          </div>
        </form>

        <!-- Users Table -->
        <div class="rounded-xl border border-[#1a1a22] bg-[#0f0f12] overflow-hidden">
          <div class="overflow-x-auto">
            <table class="w-full text-sm">
              <thead>
                <tr class="border-b border-[#1a1a22] bg-[#0f0f12]/50">
                  <th class="px-4 py-3 text-left text-xs font-medium text-[#55555e]">User</th>
                  <th class="px-4 py-3 text-left text-xs font-medium text-[#55555e]">Email</th>
                  <th class="px-4 py-3 text-left text-xs font-medium text-[#55555e]">Points</th>
                  <th class="px-4 py-3 text-left text-xs font-medium text-[#55555e]">Level</th>
                  <th class="px-4 py-3 text-left text-xs font-medium text-[#55555e]">Status</th>
                  <th class="px-4 py-3 text-left text-xs font-medium text-[#55555e]">Joined</th>
                  <th class="px-4 py-3 text-right text-xs font-medium text-[#55555e]">Actions</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-[#1a1a22]">
                {(!users || users.length === 0) ? (
                  <tr>
                    <td colspan="7" class="px-4 py-8 text-center text-[#55555e]">No users found.</td>
                  </tr>
                ) : (
                  users.map(user => (
                    <tr class="hover:bg-[#1a1a22]/50 transition-colors" data-user-id={user.id}>
                      <td class="px-4 py-3">
                        <div class="flex items-center gap-3">
                          {user.avatar_url ? (
                            <img src={user.avatar_url} alt="" class="h-8 w-8 rounded-full" />
                          ) : (
                            <div class="h-8 w-8 rounded-full bg-[#25252e] flex items-center justify-center text-xs font-bold text-[#8a8a94]">
                              {(user.display_name ?? '?').charAt(0).toUpperCase()}
                            </div>
                          )}
                          <span class="font-medium text-white">{user.display_name ?? 'No name'}</span>
                        </div>
                      </td>
                      <td class="px-4 py-3 text-[#8a8a94]">{user.email ?? '-'}</td>
                      <td class="px-4 py-3 text-[#8a8a94]">{user.points ?? 0}</td>
                      <td class="px-4 py-3">
                        <span class="inline-flex rounded-md px-2 py-0.5 text-xs font-medium bg-[#25252e]/50 text-[#8a8a94]">
                          {levelLabel(user.level)}
                        </span>
                      </td>
                      <td class="px-4 py-3">
                        <div class="flex flex-wrap gap-1">
                          {user.is_admin && (
                            <span class="inline-flex rounded-md px-2 py-0.5 text-xs font-medium bg-[#7c6cf0]/20 text-[#7c6cf0]">Admin</span>
                          )}
                          {user.is_banned && (
                            <span class="inline-flex rounded-md px-2 py-0.5 text-xs font-medium bg-red-500/20 text-red-400">Banned</span>
                          )}
                          {user.is_verified_tester && (
                            <span class="inline-flex rounded-md px-2 py-0.5 text-xs font-medium bg-blue-500/20 text-blue-400">Verified</span>
                          )}
                          {!user.is_admin && !user.is_banned && !user.is_verified_tester && (
                            <span class="text-xs text-[#35353e]">Normal</span>
                          )}
                        </div>
                      </td>
                      <td class="px-4 py-3 text-[#55555e] whitespace-nowrap">{formatDate(user.created_at)}</td>
                      <td class="px-4 py-3 text-right">
                        <div class="flex items-center justify-end gap-2">
                          <button
                            class="admin-user-action rounded-md px-2 py-1 text-xs font-medium transition-colors border"
                            data-user-id={user.id}
                            data-action={user.is_banned ? 'unban' : 'ban'}
                            class:list={[
                              user.is_banned
                                ? 'border-green-700 text-green-400 hover:bg-green-900/30'
                                : 'border-red-700 text-red-400 hover:bg-red-900/30',
                            ]}
                          >
                            {user.is_banned ? 'Unban' : 'Ban'}
                          </button>
                          <button
                            class="admin-user-action rounded-md px-2 py-1 text-xs font-medium transition-colors border"
                            data-user-id={user.id}
                            data-action={user.is_admin ? 'remove-admin' : 'make-admin'}
                            class:list={[
                              user.is_admin
                                ? 'border-amber-700 text-amber-400 hover:bg-amber-900/30'
                                : 'border-[#7c6cf0] text-[#7c6cf0] hover:bg-[#7c6cf0]/10',
                            ]}
                          >
                            {user.is_admin ? 'Remove Admin' : 'Make Admin'}
                          </button>
                        </div>
                      </td>
                    </tr>
                  ))
                )}
              </tbody>
            </table>
          </div>
        </div>

        <!-- Pagination -->
        {totalPages > 1 && (
          <div class="mt-6 flex items-center justify-between">
            <p class="text-sm text-[#55555e]">
              Showing {offset + 1}–{Math.min(offset + PER_PAGE, total)} of {total}
            </p>
            <div class="flex gap-2">
              {page > 1 && (
                <a
                  href={`/admin/users?page=${page - 1}${search ? `&q=${encodeURIComponent(search)}` : ''}`}
                  class="rounded-lg border border-[#25252e] px-3 py-1.5 text-sm text-[#8a8a94] hover:bg-[#1a1a22] transition-colors"
                >
                  Previous
                </a>
              )}
              {pageNumbers.map(pageNum => (
                <a
                  href={`/admin/users?page=${pageNum}${search ? `&q=${encodeURIComponent(search)}` : ''}`}
                  class:list={[
                    'rounded-lg px-3 py-1.5 text-sm font-medium transition-colors',
                    pageNum === page
                      ? 'bg-[#7c6cf0] text-white'
                      : 'border border-[#25252e] text-[#8a8a94] hover:bg-[#1a1a22] hover:text-white',
                  ]}
                >
                  {pageNum}
                </a>
              ))}
              {page < totalPages && (
                <a
                  href={`/admin/users?page=${page + 1}${search ? `&q=${encodeURIComponent(search)}` : ''}`}
                  class="rounded-lg border border-[#25252e] px-3 py-1.5 text-sm text-[#8a8a94] hover:bg-[#1a1a22] transition-colors"
                >
                  Next
                </a>
              )}
            </div>
          </div>
        )}
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  function initUserActions() {
    document.querySelectorAll('.admin-user-action').forEach(btn => {
      btn.addEventListener('click', async (e) => {
        const target = e.currentTarget as HTMLButtonElement;
        const userId = target.dataset.userId;
        const action = target.dataset.action;

        if (!userId || !action) return;

        const confirmed = confirm(`Are you sure you want to ${action.replace('-', ' ')} this user?`);
        if (!confirmed) return;

        const updates: Record<string, boolean> = {};
        if (action === 'ban') updates.is_banned = true;
        if (action === 'unban') updates.is_banned = false;
        if (action === 'make-admin') updates.is_admin = true;
        if (action === 'remove-admin') updates.is_admin = false;

        try {
          const res = await fetch('/api/admin/users', {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ userId, ...updates }),
          });

          if (!res.ok) {
            const data = await res.json();
            alert(data.error ?? 'Failed to update user');
            return;
          }

          // Reload to reflect changes
          window.location.reload();
        } catch (err) {
          alert('Network error. Please try again.');
        }
      });
    });
  }

  initUserActions();
  document.addEventListener('astro:after-swap', initUserActions);
</script>
