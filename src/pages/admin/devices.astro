---
import BaseLayout from '@layouts/BaseLayout.astro';
import AdminNav from '@components/astro/AdminNav.astro';
import { requireAdmin } from './_admin-guard';
import { supabaseAdmin } from '@lib/db/client';

const redirect = await requireAdmin(Astro);
if (redirect) return redirect;

// ─── Fetch all devices ───
const { data: devices } = await supabaseAdmin
  .from('devices')
  .select('*')
  .order('name');

function formatDate(dateStr: string | null): string {
  if (!dateStr) return '-';
  return new Date(dateStr).toLocaleDateString('en-US', {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
  });
}
---

<BaseLayout title="Devices Management" noindex>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8">
    <div class="mb-8">
      <h1 class="text-2xl font-bold text-white">Devices Management</h1>
      <p class="mt-1 text-sm text-[#8a8a94]">{devices?.length ?? 0} devices registered</p>
    </div>

    <div class="flex flex-col lg:flex-row gap-8">
      <AdminNav />

      <div class="flex-1 min-w-0">
        <!-- Add Device Form -->
        <div class="rounded-xl border border-[#1a1a22] bg-[#0f0f12] p-5 mb-8">
          <h2 class="text-sm font-semibold text-white mb-4">Add New Device</h2>
          <form id="add-device-form" class="space-y-4">
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
              <div>
                <label for="dev-name" class="block text-xs font-medium text-[#8a8a94] mb-1">Name *</label>
                <input type="text" id="dev-name" required class="w-full rounded-lg border border-[#25252e] bg-[#1a1a22] px-3 py-2 text-sm text-white placeholder-[#55555e] focus:border-[#7c6cf0] focus:ring-1 focus:ring-[#7c6cf0] focus:outline-none" placeholder="Steam Deck" />
              </div>
              <div>
                <label for="dev-slug" class="block text-xs font-medium text-[#8a8a94] mb-1">Slug</label>
                <input type="text" id="dev-slug" class="w-full rounded-lg border border-[#25252e] bg-[#1a1a22] px-3 py-2 text-sm text-white placeholder-[#55555e] focus:border-[#7c6cf0] focus:ring-1 focus:ring-[#7c6cf0] focus:outline-none" placeholder="steam-deck-oled" />
              </div>
              <div>
                <label for="dev-manufacturer" class="block text-xs font-medium text-[#8a8a94] mb-1">Manufacturer *</label>
                <input type="text" id="dev-manufacturer" required class="w-full rounded-lg border border-[#25252e] bg-[#1a1a22] px-3 py-2 text-sm text-white placeholder-[#55555e] focus:border-[#7c6cf0] focus:ring-1 focus:ring-[#7c6cf0] focus:outline-none" placeholder="Valve" />
              </div>
              <div>
                <label for="dev-chip" class="block text-xs font-medium text-[#8a8a94] mb-1">Chip</label>
                <input type="text" id="dev-chip" class="w-full rounded-lg border border-[#25252e] bg-[#1a1a22] px-3 py-2 text-sm text-white placeholder-[#55555e] focus:border-[#7c6cf0] focus:ring-1 focus:ring-[#7c6cf0] focus:outline-none" placeholder="AMD Custom APU" />
              </div>
              <div>
                <label for="dev-gpu" class="block text-xs font-medium text-[#8a8a94] mb-1">GPU</label>
                <input type="text" id="dev-gpu" class="w-full rounded-lg border border-[#25252e] bg-[#1a1a22] px-3 py-2 text-sm text-white placeholder-[#55555e] focus:border-[#7c6cf0] focus:ring-1 focus:ring-[#7c6cf0] focus:outline-none" placeholder="RDNA 2" />
              </div>
              <div>
                <label for="dev-ram" class="block text-xs font-medium text-[#8a8a94] mb-1">RAM (GB)</label>
                <input type="number" id="dev-ram" class="w-full rounded-lg border border-[#25252e] bg-[#1a1a22] px-3 py-2 text-sm text-white placeholder-[#55555e] focus:border-[#7c6cf0] focus:ring-1 focus:ring-[#7c6cf0] focus:outline-none" placeholder="16" />
              </div>
              <div>
                <label for="dev-screen-res" class="block text-xs font-medium text-[#8a8a94] mb-1">Screen Resolution</label>
                <input type="text" id="dev-screen-res" class="w-full rounded-lg border border-[#25252e] bg-[#1a1a22] px-3 py-2 text-sm text-white placeholder-[#55555e] focus:border-[#7c6cf0] focus:ring-1 focus:ring-[#7c6cf0] focus:outline-none" placeholder="1280x800" />
              </div>
              <div>
                <label for="dev-screen-size" class="block text-xs font-medium text-[#8a8a94] mb-1">Screen Size (inches)</label>
                <input type="number" step="0.1" id="dev-screen-size" class="w-full rounded-lg border border-[#25252e] bg-[#1a1a22] px-3 py-2 text-sm text-white placeholder-[#55555e] focus:border-[#7c6cf0] focus:ring-1 focus:ring-[#7c6cf0] focus:outline-none" placeholder="7.4" />
              </div>
              <div>
                <label for="dev-battery" class="block text-xs font-medium text-[#8a8a94] mb-1">Battery (Wh)</label>
                <input type="number" step="0.1" id="dev-battery" class="w-full rounded-lg border border-[#25252e] bg-[#1a1a22] px-3 py-2 text-sm text-white placeholder-[#55555e] focus:border-[#7c6cf0] focus:ring-1 focus:ring-[#7c6cf0] focus:outline-none" placeholder="50" />
              </div>
              <div>
                <label for="dev-tdp-min" class="block text-xs font-medium text-[#8a8a94] mb-1">TDP Min (W)</label>
                <input type="number" step="0.1" id="dev-tdp-min" class="w-full rounded-lg border border-[#25252e] bg-[#1a1a22] px-3 py-2 text-sm text-white placeholder-[#55555e] focus:border-[#7c6cf0] focus:ring-1 focus:ring-[#7c6cf0] focus:outline-none" placeholder="3" />
              </div>
              <div>
                <label for="dev-tdp-max" class="block text-xs font-medium text-[#8a8a94] mb-1">TDP Max (W)</label>
                <input type="number" step="0.1" id="dev-tdp-max" class="w-full rounded-lg border border-[#25252e] bg-[#1a1a22] px-3 py-2 text-sm text-white placeholder-[#55555e] focus:border-[#7c6cf0] focus:ring-1 focus:ring-[#7c6cf0] focus:outline-none" placeholder="15" />
              </div>
              <div>
                <label for="dev-msrp" class="block text-xs font-medium text-[#8a8a94] mb-1">MSRP (USD)</label>
                <input type="number" step="0.01" id="dev-msrp" class="w-full rounded-lg border border-[#25252e] bg-[#1a1a22] px-3 py-2 text-sm text-white placeholder-[#55555e] focus:border-[#7c6cf0] focus:ring-1 focus:ring-[#7c6cf0] focus:outline-none" placeholder="549" />
              </div>
              <div>
                <label for="dev-os" class="block text-xs font-medium text-[#8a8a94] mb-1">Default OS</label>
                <input type="text" id="dev-os" class="w-full rounded-lg border border-[#25252e] bg-[#1a1a22] px-3 py-2 text-sm text-white placeholder-[#55555e] focus:border-[#7c6cf0] focus:ring-1 focus:ring-[#7c6cf0] focus:outline-none" placeholder="SteamOS 3.x" />
              </div>
              <div>
                <label for="dev-image" class="block text-xs font-medium text-[#8a8a94] mb-1">Image URL</label>
                <input type="url" id="dev-image" class="w-full rounded-lg border border-[#25252e] bg-[#1a1a22] px-3 py-2 text-sm text-white placeholder-[#55555e] focus:border-[#7c6cf0] focus:ring-1 focus:ring-[#7c6cf0] focus:outline-none" placeholder="https://..." />
              </div>
              <div>
                <label for="dev-weight" class="block text-xs font-medium text-[#8a8a94] mb-1">Weight (grams)</label>
                <input type="number" id="dev-weight" class="w-full rounded-lg border border-[#25252e] bg-[#1a1a22] px-3 py-2 text-sm text-white placeholder-[#55555e] focus:border-[#7c6cf0] focus:ring-1 focus:ring-[#7c6cf0] focus:outline-none" placeholder="640" />
              </div>
            </div>
            <div class="flex items-center gap-3 pt-2">
              <button type="submit" class="rounded-lg bg-[#7c6cf0] px-4 py-2 text-sm font-medium text-white hover:bg-[#6d5cff] transition-colors">
                Add Device
              </button>
              <div id="device-status" class="text-sm text-[#55555e] hidden"></div>
            </div>
          </form>
        </div>

        <!-- Devices Table -->
        <div class="rounded-xl border border-[#1a1a22] bg-[#0f0f12] overflow-hidden">
          <div class="overflow-x-auto">
            <table class="w-full text-sm">
              <thead>
                <tr class="border-b border-[#1a1a22] bg-[#0f0f12]/50">
                  <th class="px-4 py-3 text-left text-xs font-medium text-[#55555e]">Device</th>
                  <th class="px-4 py-3 text-left text-xs font-medium text-[#55555e]">Manufacturer</th>
                  <th class="px-4 py-3 text-left text-xs font-medium text-[#55555e]">Chip</th>
                  <th class="px-4 py-3 text-left text-xs font-medium text-[#55555e]">Screen</th>
                  <th class="px-4 py-3 text-left text-xs font-medium text-[#55555e]">MSRP</th>
                  <th class="px-4 py-3 text-left text-xs font-medium text-[#55555e]">Status</th>
                  <th class="px-4 py-3 text-right text-xs font-medium text-[#55555e]">Actions</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-[#1a1a22]">
                {(!devices || devices.length === 0) ? (
                  <tr>
                    <td colspan="7" class="px-4 py-8 text-center text-[#55555e]">No devices found.</td>
                  </tr>
                ) : (
                  devices.map(device => (
                    <tr class="hover:bg-[#1a1a22]/50 transition-colors" data-device-id={device.id}>
                      <td class="px-4 py-3">
                        <div class="flex items-center gap-3">
                          {device.image ? (
                            <img src={device.image} alt="" class="h-8 w-12 rounded object-cover" />
                          ) : (
                            <div class="h-8 w-12 rounded bg-[#25252e] flex items-center justify-center text-xs text-[#55555e]">N/A</div>
                          )}
                          <div>
                            <p class="font-medium text-white">{device.name}</p>
                            <p class="text-xs text-[#55555e]">{device.slug}</p>
                          </div>
                        </div>
                      </td>
                      <td class="px-4 py-3 text-[#8a8a94]">{device.manufacturer}</td>
                      <td class="px-4 py-3 text-[#8a8a94]">{device.chip ?? '-'}</td>
                      <td class="px-4 py-3 text-[#8a8a94] whitespace-nowrap">
                        {device.screen_resolution ?? '-'} {device.screen_size ? `(${device.screen_size}")` : ''}
                      </td>
                      <td class="px-4 py-3 text-[#8a8a94]">
                        {device.msrp_usd ? `$${device.msrp_usd}` : '-'}
                      </td>
                      <td class="px-4 py-3">
                        {device.is_active ? (
                          <span class="inline-flex rounded-md px-2 py-0.5 text-xs font-medium bg-[#7c6cf0]/20 text-[#7c6cf0]">Active</span>
                        ) : (
                          <span class="inline-flex rounded-md px-2 py-0.5 text-xs font-medium bg-[#55555e]/20 text-[#8a8a94]">Inactive</span>
                        )}
                        {device.discontinued && (
                          <span class="ml-1 inline-flex rounded-md px-2 py-0.5 text-xs font-medium bg-red-500/20 text-red-400">Discontinued</span>
                        )}
                      </td>
                      <td class="px-4 py-3 text-right">
                        <div class="flex items-center justify-end gap-2">
                          <button
                            class="admin-device-toggle rounded-md px-2 py-1 text-xs font-medium transition-colors border"
                            data-device-id={device.id}
                            data-active={device.is_active ? 'true' : 'false'}
                            class:list={[
                              device.is_active
                                ? 'border-amber-700 text-amber-400 hover:bg-amber-900/30'
                                : 'border-[#7c6cf0] text-[#7c6cf0] hover:bg-[#7c6cf0]/10',
                            ]}
                          >
                            {device.is_active ? 'Deactivate' : 'Activate'}
                          </button>
                        </div>
                      </td>
                    </tr>
                  ))
                )}
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  function initDeviceManagement() {
    const form = document.getElementById('add-device-form') as HTMLFormElement;
    const statusDiv = document.getElementById('device-status') as HTMLDivElement;
    const nameInput = document.getElementById('dev-name') as HTMLInputElement;
    const slugInput = document.getElementById('dev-slug') as HTMLInputElement;

    // Auto-generate slug
    nameInput?.addEventListener('input', () => {
      if (!slugInput.dataset.manual) {
        slugInput.value = nameInput.value
          .toLowerCase()
          .replace(/[^a-z0-9\s-]/g, '')
          .replace(/\s+/g, '-')
          .replace(/-+/g, '-')
          .replace(/^-|-$/g, '');
      }
    });

    slugInput?.addEventListener('input', () => {
      slugInput.dataset.manual = 'true';
    });

    // Add device form submission
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();

      const getVal = (id: string) => (document.getElementById(id) as HTMLInputElement)?.value?.trim() ?? '';
      const getNum = (id: string) => {
        const v = getVal(id);
        return v ? parseFloat(v) : null;
      };
      const getInt = (id: string) => {
        const v = getVal(id);
        return v ? parseInt(v, 10) : null;
      };

      const name = getVal('dev-name');
      const manufacturer = getVal('dev-manufacturer');
      if (!name || !manufacturer) {
        alert('Name and manufacturer are required.');
        return;
      }

      const payload: Record<string, unknown> = {
        name,
        slug: getVal('dev-slug') || name.toLowerCase().replace(/[^a-z0-9\s-]/g, '').replace(/\s+/g, '-'),
        manufacturer,
        chip: getVal('dev-chip') || null,
        gpu: getVal('dev-gpu') || null,
        ram_gb: getInt('dev-ram'),
        screen_resolution: getVal('dev-screen-res') || null,
        screen_size: getNum('dev-screen-size'),
        battery_wh: getNum('dev-battery'),
        tdp_min: getNum('dev-tdp-min'),
        tdp_max: getNum('dev-tdp-max'),
        msrp_usd: getNum('dev-msrp'),
        default_os: getVal('dev-os') || null,
        image: getVal('dev-image') || null,
        weight_grams: getInt('dev-weight'),
      };

      statusDiv.textContent = 'Saving...';
      statusDiv.classList.remove('hidden', 'text-red-400', 'text-[#7c6cf0]');

      try {
        const res = await fetch('/api/admin/devices', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });

        const data = await res.json();
        if (!res.ok) {
          statusDiv.textContent = data.error ?? 'Failed to add device';
          statusDiv.classList.add('text-red-400');
          return;
        }

        statusDiv.textContent = 'Device added!';
        statusDiv.classList.add('text-[#7c6cf0]');
        setTimeout(() => window.location.reload(), 1000);
      } catch {
        statusDiv.textContent = 'Network error';
        statusDiv.classList.add('text-red-400');
      }
    });

    // Toggle active/inactive
    document.querySelectorAll('.admin-device-toggle').forEach(btn => {
      btn.addEventListener('click', async (e) => {
        const target = e.currentTarget as HTMLButtonElement;
        const deviceId = target.dataset.deviceId;
        const isActive = target.dataset.active === 'true';

        if (!deviceId) return;

        const action = isActive ? 'deactivate' : 'activate';
        const confirmed = confirm(`Are you sure you want to ${action} this device?`);
        if (!confirmed) return;

        try {
          if (isActive) {
            // Deactivate via DELETE
            const res = await fetch('/api/admin/devices', {
              method: 'DELETE',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ deviceId }),
            });
            if (!res.ok) {
              const data = await res.json();
              alert(data.error ?? 'Failed');
              return;
            }
          } else {
            // Activate via PATCH
            const res = await fetch('/api/admin/devices', {
              method: 'PATCH',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ deviceId, is_active: true }),
            });
            if (!res.ok) {
              const data = await res.json();
              alert(data.error ?? 'Failed');
              return;
            }
          }

          window.location.reload();
        } catch {
          alert('Network error');
        }
      });
    });
  }

  initDeviceManagement();
  document.addEventListener('astro:after-swap', initDeviceManagement);
</script>
