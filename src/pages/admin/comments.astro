---
import BaseLayout from '@layouts/BaseLayout.astro';
import AdminNav from '@components/astro/AdminNav.astro';
import { requireAdmin } from './_admin-guard';
import { supabaseAdmin } from '@lib/db/client';

const redirect = await requireAdmin(Astro);
if (redirect) return redirect;

// ─── Pagination ───
const PER_PAGE = 25;
const page = Math.max(1, parseInt(Astro.url.searchParams.get('page') ?? '1', 10) || 1);
const offset = (page - 1) * PER_PAGE;

// ─── Filter ───
const filter = Astro.url.searchParams.get('filter') ?? ''; // 'flagged', 'deleted', ''

// ─── Fetch comments ───
let query = supabaseAdmin
  .from('comments')
  .select('id, game_id, user_id, body, body_html, upvotes, downvotes, is_flagged, is_deleted, created_at', { count: 'exact' })
  .order('created_at', { ascending: false })
  .range(offset, offset + PER_PAGE - 1);

if (filter === 'flagged') {
  query = query.eq('is_flagged', true);
} else if (filter === 'deleted') {
  query = query.eq('is_deleted', true);
}

const { data: comments, count: totalCount } = await query;
const total = totalCount ?? 0;
const totalPages = Math.ceil(total / PER_PAGE);

// Look up user names and game names
let enrichedComments: Array<{
  id: string;
  body: string;
  authorName: string;
  gameName: string;
  gameSlug: string;
  upvotes: number;
  downvotes: number;
  isFlagged: boolean;
  isDeleted: boolean;
  createdAt: string;
}> = [];

if (comments && comments.length > 0) {
  const userIds = [...new Set(comments.map(c => c.user_id))];
  const gameIds = [...new Set(comments.map(c => c.game_id))];

  const [{ data: users }, { data: games }] = await Promise.all([
    supabaseAdmin.from('users').select('id, display_name, email').in('id', userIds),
    supabaseAdmin.from('games').select('id, name, slug').in('id', gameIds),
  ]);

  const userMap = new Map((users ?? []).map(u => [u.id, u.display_name ?? u.email ?? 'Unknown']));
  const gameMap = new Map((games ?? []).map(g => [g.id, { name: g.name, slug: g.slug }]));

  enrichedComments = comments.map(c => ({
    id: c.id,
    body: c.body,
    authorName: userMap.get(c.user_id) ?? 'Unknown',
    gameName: gameMap.get(c.game_id)?.name ?? 'Unknown',
    gameSlug: gameMap.get(c.game_id)?.slug ?? '',
    upvotes: c.upvotes ?? 0,
    downvotes: c.downvotes ?? 0,
    isFlagged: c.is_flagged ?? false,
    isDeleted: c.is_deleted ?? false,
    createdAt: c.created_at,
  }));
}

function formatDate(dateStr: string): string {
  return new Date(dateStr).toLocaleDateString('en-US', {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
    hour: '2-digit',
    minute: '2-digit',
  });
}

function truncate(str: string, maxLen: number): string {
  if (str.length <= maxLen) return str;
  return str.slice(0, maxLen) + '...';
}
---

<BaseLayout title="Comments Moderation" noindex>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8">
    <div class="mb-8">
      <h1 class="text-2xl font-bold text-white">Comments Moderation</h1>
      <p class="mt-1 text-sm text-gray-400">{total} comments total</p>
    </div>

    <div class="flex flex-col lg:flex-row gap-8">
      <AdminNav />

      <div class="flex-1 min-w-0">
        <!-- Filters -->
        <div class="mb-6 flex flex-wrap gap-2">
          <a
            href="/admin/comments"
            class:list={[
              'rounded-lg px-3 py-1.5 text-sm font-medium transition-colors',
              !filter
                ? 'bg-[#D4A574]/20 text-[#D4A574] border border-[#D4A574]/30'
                : 'text-gray-400 hover:text-white border border-gray-700 hover:bg-gray-800',
            ]}
          >
            All
          </a>
          <a
            href="/admin/comments?filter=flagged"
            class:list={[
              'rounded-lg px-3 py-1.5 text-sm font-medium transition-colors',
              filter === 'flagged'
                ? 'bg-amber-600/20 text-amber-400 border border-amber-500/30'
                : 'text-gray-400 hover:text-white border border-gray-700 hover:bg-gray-800',
            ]}
          >
            Flagged
          </a>
          <a
            href="/admin/comments?filter=deleted"
            class:list={[
              'rounded-lg px-3 py-1.5 text-sm font-medium transition-colors',
              filter === 'deleted'
                ? 'bg-red-600/20 text-red-400 border border-red-500/30'
                : 'text-gray-400 hover:text-white border border-gray-700 hover:bg-gray-800',
            ]}
          >
            Deleted
          </a>
        </div>

        <!-- Comments List -->
        <div class="space-y-3">
          {enrichedComments.length === 0 ? (
            <div class="rounded-xl border border-gray-800 bg-gray-900 p-8 text-center text-gray-500">
              No comments found.
            </div>
          ) : (
            enrichedComments.map(comment => (
              <div
                class:list={[
                  'rounded-xl border bg-gray-900 p-4 transition-colors',
                  comment.isFlagged ? 'border-amber-700/50' : comment.isDeleted ? 'border-red-700/50' : 'border-gray-800',
                ]}
                data-comment-id={comment.id}
              >
                <div class="flex items-start gap-4">
                  <div class="flex-1 min-w-0">
                    <div class="flex items-center gap-2 mb-1">
                      <span class="text-sm font-medium text-white">{comment.authorName}</span>
                      <span class="text-xs text-gray-600">on</span>
                      <a href={`/games/${comment.gameSlug}`} class="text-sm text-[#D4A574] hover:text-[#E8C5A0] transition-colors">
                        {comment.gameName}
                      </a>
                      {comment.isFlagged && (
                        <span class="inline-flex rounded-md px-2 py-0.5 text-xs font-medium bg-amber-500/20 text-amber-400">Flagged</span>
                      )}
                      {comment.isDeleted && (
                        <span class="inline-flex rounded-md px-2 py-0.5 text-xs font-medium bg-red-500/20 text-red-400">Deleted</span>
                      )}
                    </div>
                    <p class="text-sm text-gray-300 break-words">{truncate(comment.body, 300)}</p>
                    <div class="mt-2 flex items-center gap-4 text-xs text-gray-500">
                      <span>{formatDate(comment.createdAt)}</span>
                      <span>+{comment.upvotes} / -{comment.downvotes}</span>
                    </div>
                  </div>
                  <div class="shrink-0">
                    {!comment.isDeleted && (
                      <button
                        class="admin-comment-delete rounded-md border border-red-700 px-2.5 py-1 text-xs font-medium text-red-400 hover:bg-red-900/30 transition-colors"
                        data-comment-id={comment.id}
                      >
                        Delete
                      </button>
                    )}
                  </div>
                </div>
              </div>
            ))
          )}
        </div>

        <!-- Pagination -->
        {totalPages > 1 && (
          <div class="mt-6 flex items-center justify-between">
            <p class="text-sm text-gray-500">
              Showing {offset + 1}–{Math.min(offset + PER_PAGE, total)} of {total}
            </p>
            <div class="flex gap-2">
              {page > 1 && (
                <a
                  href={`/admin/comments?page=${page - 1}${filter ? `&filter=${filter}` : ''}`}
                  class="rounded-lg border border-gray-700 px-3 py-1.5 text-sm text-gray-300 hover:bg-gray-800 transition-colors"
                >
                  Previous
                </a>
              )}
              {page < totalPages && (
                <a
                  href={`/admin/comments?page=${page + 1}${filter ? `&filter=${filter}` : ''}`}
                  class="rounded-lg border border-gray-700 px-3 py-1.5 text-sm text-gray-300 hover:bg-gray-800 transition-colors"
                >
                  Next
                </a>
              )}
            </div>
          </div>
        )}
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  function initCommentModeration() {
    document.querySelectorAll('.admin-comment-delete').forEach(btn => {
      btn.addEventListener('click', async (e) => {
        const target = e.currentTarget as HTMLButtonElement;
        const commentId = target.dataset.commentId;
        if (!commentId) return;

        const confirmed = confirm('Are you sure you want to delete this comment? This will soft-delete it.');
        if (!confirmed) return;

        try {
          const res = await fetch('/api/admin/comments', {
            method: 'DELETE',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ commentId }),
          });

          if (!res.ok) {
            const data = await res.json();
            alert(data.error ?? 'Failed to delete comment');
            return;
          }

          // Remove from the DOM or reload
          window.location.reload();
        } catch {
          alert('Network error. Please try again.');
        }
      });
    });
  }

  initCommentModeration();
  document.addEventListener('astro:after-swap', initCommentModeration);
</script>
