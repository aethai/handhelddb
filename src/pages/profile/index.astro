---
import BaseLayout from '@layouts/BaseLayout.astro';
import DevicePicker from '@components/react/DevicePicker';
import SteamImport from '@components/react/SteamImport';
import BadgeGrid from '@components/react/BadgeGrid';
import { supabaseAdmin } from '@lib/db/client';

// ─── Auth guard ───
const user = Astro.locals.user;
if (!user) {
  return Astro.redirect('/auth/login');
}

// ─── Fetch user profile ───
const { data: profile } = await supabaseAdmin
  .from('users')
  .select('id, email, username, display_name, avatar_url, steam_id, google_id, points, level, is_verified_tester, primary_device_id, created_at, notify_on_reply, notify_on_vote')
  .eq('id', user.id)
  .single();

if (!profile) {
  return Astro.redirect('/auth/login');
}

// ─── Fetch user's devices with device details ───
const { data: userDevicesRaw } = await supabaseAdmin
  .from('user_devices')
  .select('device_id, is_primary, devices(id, slug, name, manufacturer, screen_size, battery_wh, chip, image)')
  .eq('user_id', user.id);

const userDevices = (userDevicesRaw ?? []).map((ud: any) => ({
  deviceId: ud.device_id,
  isPrimary: ud.is_primary,
  device: ud.devices,
}));

const userDeviceIds = userDevices.map((ud: any) => ud.deviceId);

// ─── Count reports ───
const { count: reportCount } = await supabaseAdmin
  .from('performance_reports')
  .select('*', { count: 'exact', head: true })
  .eq('user_id', user.id);

// ─── Fetch recent reports with game and device info ───
const { data: recentReportsRaw } = await supabaseAdmin
  .from('performance_reports')
  .select('id, overall_rating, fps_avg, created_at, game_id, device_id, games(slug, name, header_image), devices(name)')
  .eq('user_id', user.id)
  .order('created_at', { ascending: false })
  .limit(10);

const recentReports = (recentReportsRaw ?? []).map((r: any) => ({
  id: r.id,
  overallRating: r.overall_rating,
  fpsAvg: r.fps_avg,
  createdAt: r.created_at,
  gameSlug: r.games?.slug,
  gameName: r.games?.name ?? 'Unknown Game',
  gameImage: r.games?.header_image,
  deviceName: r.devices?.name ?? 'Unknown Device',
}));

// ─── Fetch user's badges ───
const { data: userBadgesRaw } = await supabaseAdmin
  .from('user_badges')
  .select('earned_at, badges(*)')
  .eq('user_id', user.id);

const { data: allBadgesRaw } = await supabaseAdmin
  .from('badges')
  .select('*');

// Build badge list: earned badges with dates, unearned badges without
const earnedMap = new Map(
  (userBadgesRaw ?? []).map((ub: any) => [ub.badges?.id, ub.earned_at])
);

const badgesForGrid = (allBadgesRaw ?? []).map((b: any) => ({
  name: b.name,
  description: b.description,
  icon: b.icon,
  category: b.category,
  earnedAt: earnedMap.get(b.id) ?? null,
}));

// ─── Fetch followed games ───
const { data: followedGamesRaw } = await supabaseAdmin
  .from('game_follows')
  .select('game_id, created_at, games(slug, name, header_image, capsule_image)')
  .eq('user_id', user.id)
  .order('created_at', { ascending: false })
  .limit(12);

const followedGames = (followedGamesRaw ?? []).map((f: any) => ({
  gameId: f.game_id,
  followedAt: f.created_at,
  slug: f.games?.slug,
  name: f.games?.name ?? 'Unknown Game',
  image: f.games?.capsule_image ?? f.games?.header_image,
}));

// ─── Fetch user library (from Steam import) ───
const { data: libraryRaw, count: libraryCount } = await supabaseAdmin
  .from('user_library')
  .select('game_id, playtime_hours, games(slug, name, header_image, capsule_image)', { count: 'exact' })
  .eq('user_id', user.id)
  .order('playtime_hours', { ascending: false })
  .limit(12);

const libraryGames = (libraryRaw ?? []).map((l: any) => ({
  gameId: l.game_id,
  playtime: l.playtime_hours ?? 0,
  slug: l.games?.slug,
  name: l.games?.name ?? 'Unknown Game',
  image: l.games?.capsule_image ?? l.games?.header_image,
}));

// ─── Derived values ───
const displayName = profile.display_name ?? profile.username ?? user.email?.split('@')[0] ?? 'User';
const avatarUrl = profile.avatar_url ?? (user.user_metadata?.avatar_url as string | undefined);
const memberSince = new Date(profile.created_at).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
const levelLabel = profile.level ?? 1;
const points = profile.points ?? 0;
const totalReports = reportCount ?? 0;

const ratingColors: Record<string, string> = {
  excellent: 'bg-[#D4FF00]/20 text-[#D4FF00] border-[#D4FF00]/30',
  good: 'bg-green-500/20 text-green-400 border-green-500/30',
  fair: 'bg-yellow-500/20 text-yellow-400 border-yellow-500/30',
  poor: 'bg-orange-500/20 text-orange-400 border-orange-500/30',
  unplayable: 'bg-red-500/20 text-red-400 border-red-500/30',
};
---

<BaseLayout title="My Setup" noindex={true}>

  <!-- ═══════════════════════════════════════════
       FULL-BLEED PROFILE HERO
       ═══════════════════════════════════════════ -->
  <section class="bg-gradient-to-b from-[var(--color-raised)] to-[var(--color-base)] py-12 border-b border-white/6">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col sm:flex-row items-center sm:items-start gap-6">
        <!-- Avatar -->
        <div class="flex-shrink-0">
          {avatarUrl ? (
            <img
              src={avatarUrl}
              alt={displayName}
              class="h-24 w-24 rounded-lg border-2 border-white/6 object-cover ring-2 ring-[#D4FF00]/20 ring-offset-2 ring-offset-[var(--color-base)]"
            />
          ) : (
            <div class="h-24 w-24 rounded-lg border-2 border-white/6 bg-gradient-to-br from-[#D4FF00] to-[#D4FF00] flex items-center justify-center text-3xl font-bold text-white ring-2 ring-[#D4FF00]/20 ring-offset-2 ring-offset-[var(--color-base)]">
              {displayName.charAt(0).toUpperCase()}
            </div>
          )}
        </div>

        <!-- Identity block -->
        <div class="flex-1 text-center sm:text-left">
          <h1 class="text-3xl font-bold text-white">{displayName}</h1>
          <div class="flex flex-wrap items-center justify-center sm:justify-start gap-2 mt-1.5">
            {profile.username && (
              <span class="text-sm text-[var(--color-text-dim)]">@{profile.username}</span>
            )}
            <span class="inline-flex items-center gap-1 rounded-full bg-[#D4FF00]/15 border border-[#D4FF00]/25 px-2.5 py-0.5 text-xs font-semibold text-[#D4FF00]">
              <svg class="h-3 w-3" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-8.707l-3-3a1 1 0 00-1.414 0l-3 3a1 1 0 001.414 1.414L9 9.414V13a1 1 0 102 0V9.414l1.293 1.293a1 1 0 001.414-1.414z" clip-rule="evenodd" />
              </svg>
              Level {levelLabel}
            </span>
            {profile.is_verified_tester && (
              <span class="inline-flex items-center gap-1 rounded-full bg-blue-500/15 border border-blue-500/25 px-2.5 py-0.5 text-xs font-semibold text-blue-400">
                <svg class="h-3 w-3" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M6.267 3.455a3.066 3.066 0 001.745-.723 3.066 3.066 0 013.976 0 3.066 3.066 0 001.745.723 3.066 3.066 0 012.812 2.812c.051.643.304 1.254.723 1.745a3.066 3.066 0 010 3.976 3.066 3.066 0 00-.723 1.745 3.066 3.066 0 01-2.812 2.812 3.066 3.066 0 00-1.745.723 3.066 3.066 0 01-3.976 0 3.066 3.066 0 00-1.745-.723 3.066 3.066 0 01-2.812-2.812 3.066 3.066 0 00-.723-1.745 3.066 3.066 0 010-3.976 3.066 3.066 0 00.723-1.745 3.066 3.066 0 012.812-2.812zm7.44 5.252a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                </svg>
                Verified Tester
              </span>
            )}
          </div>
          <p class="mt-2 text-sm text-[var(--color-text-dim)]">
            Member since {memberSince}
          </p>

          <!-- Stats row -->
          <div class="mt-6 flex flex-wrap justify-center sm:justify-start gap-8">
            <div class="text-center sm:text-left">
              <p class="text-2xl font-bold text-white font-mono tracking-tight">{totalReports}</p>
              <p class="text-xs text-[var(--color-text-dim)] mt-0.5">Reports</p>
            </div>
            <div class="text-center sm:text-left">
              <p class="text-2xl font-bold text-white font-mono tracking-tight">{userDevices.length}</p>
              <p class="text-xs text-[var(--color-text-dim)] mt-0.5">Devices</p>
            </div>
            <div class="text-center sm:text-left">
              <p class="text-2xl font-bold text-white font-mono tracking-tight">{points}</p>
              <p class="text-xs text-[var(--color-text-dim)] mt-0.5">Points</p>
            </div>
            <div class="text-center sm:text-left">
              <p class="text-2xl font-bold text-white font-mono tracking-tight">{followedGames.length}</p>
              <p class="text-xs text-[var(--color-text-dim)] mt-0.5">Following</p>
            </div>
          </div>
        </div>

        <!-- Edit profile button -->
        <div class="flex-shrink-0">
          <button
            id="edit-profile-btn"
            class="inline-flex items-center gap-2 rounded-lg border border-white/10 bg-[var(--color-raised)] px-4 py-2.5 text-sm font-medium text-[var(--color-text-2)] hover:border-[#D4FF00]/40 hover:text-white transition-all"
          >
            <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125" />
            </svg>
            Edit Profile
          </button>
        </div>
      </div>

      <!-- Edit profile form (slides open below hero) -->
      <div id="edit-profile-form" class="hidden mt-8 pt-8 border-t border-white/6 animate-slideDown">
        <form class="flex flex-col sm:flex-row gap-4 items-end">
          <div class="flex-1">
            <label for="edit-display-name" class="block text-sm font-medium text-[var(--color-text-2)] mb-1.5">Display Name</label>
            <input
              id="edit-display-name"
              type="text"
              value={profile.display_name ?? ''}
              maxlength="50"
              class="w-full rounded-lg border border-white/10 bg-[var(--color-base)] px-3.5 py-2.5 text-sm text-white placeholder-[var(--color-text-dim)] focus:border-[#D4FF00] focus:outline-none focus:ring-1 focus:ring-[#D4FF00] transition-colors"
            />
          </div>
          <div class="flex-1">
            <label for="edit-username" class="block text-sm font-medium text-[var(--color-text-2)] mb-1.5">Username</label>
            <input
              id="edit-username"
              type="text"
              value={profile.username ?? ''}
              maxlength="24"
              pattern="[a-z0-9_]{3,24}"
              placeholder="lowercase, 3-24 chars"
              class="w-full rounded-lg border border-white/10 bg-[var(--color-base)] px-3.5 py-2.5 text-sm text-white placeholder-[var(--color-text-dim)] focus:border-[#D4FF00] focus:outline-none focus:ring-1 focus:ring-[#D4FF00] transition-colors"
            />
          </div>
          <div class="flex gap-2">
            <button
              type="button"
              id="save-profile-btn"
              class="rounded-lg bg-[#D4FF00] px-5 py-2.5 text-sm font-medium text-[#0a0a0a] hover:bg-[#e8ff4d] transition-colors"
            >
              Save
            </button>
            <button
              type="button"
              id="cancel-profile-btn"
              class="rounded-lg border border-white/10 px-4 py-2.5 text-sm font-medium text-[var(--color-text-2)] hover:border-white/15 hover:text-white transition-colors"
            >
              Cancel
            </button>
          </div>
        </form>
        <p id="edit-profile-error" class="hidden mt-3 text-sm text-red-400"></p>
        <p id="edit-profile-success" class="hidden mt-3 text-sm text-[#D4FF00]"></p>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       DASHBOARD BENTO GRID
       ═══════════════════════════════════════════ -->
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-8 sm:py-10">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

      <!-- ─── MY DEVICES (2/3 width) ─── -->
      <section class="lg:col-span-2">
        <div class="flex items-center justify-between mb-4">
          <div>
            <h2 class="text-lg font-bold text-white ">My Devices</h2>
            <p class="mt-0.5 text-xs text-[var(--color-text-dim)]">Handhelds in your collection</p>
          </div>
          <button
            id="toggle-device-picker"
            class="inline-flex items-center gap-1.5 rounded-lg bg-[#D4FF00] px-3 py-1.5 text-sm font-medium text-[#0a0a0a] hover:bg-[#e8ff4d] transition-colors"
          >
            <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
            </svg>
            Add Device
          </button>
        </div>

        {userDevices.length > 0 ? (
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 stagger">
            {userDevices.map((ud: any) => (
              <div class="rounded-lg border border-white/6 bg-[var(--color-raised)] p-4 group relative hover:border-white/10 transition-colors">
                {ud.isPrimary && (
                  <span class="absolute top-3 right-3 inline-flex items-center rounded-full bg-[#D4FF00]/20 px-2 py-0.5 text-[10px] font-semibold text-[#D4FF00] border border-[#D4FF00]/30">
                    Primary
                  </span>
                )}
                <div class="flex items-start gap-3">
                  <div class="flex-shrink-0 w-16 h-16 rounded-lg bg-[var(--color-base)] border border-white/6 flex items-center justify-center overflow-hidden">
                    {ud.device?.image ? (
                      <img src={ud.device.image} alt={ud.device?.name} class="h-full w-full object-cover" loading="lazy" />
                    ) : (
                      <svg class="h-7 w-7 text-[var(--color-text-dim)]" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                        <rect x="5" y="3" width="14" height="18" rx="3" />
                        <line x1="9" y1="18" x2="15" y2="18" />
                      </svg>
                    )}
                  </div>
                  <div class="flex-1 min-w-0">
                    <p class="text-[10px] text-[var(--color-text-dim)] ">{ud.device?.manufacturer}</p>
                    <h3 class="font-semibold text-white text-sm mt-0.5">
                      <a href={`/devices/${ud.device?.slug}`} class="hover:text-[#D4FF00] transition-colors">
                        {ud.device?.name ?? 'Unknown Device'}
                      </a>
                    </h3>
                    <div class="mt-1.5 flex flex-wrap gap-x-3 text-xs text-[var(--color-text-dim)]">
                      {ud.device?.chip && <span>{ud.device.chip}</span>}
                      {ud.device?.screen_size && <span>{ud.device.screen_size}"</span>}
                    </div>
                  </div>
                </div>
                <button
                  data-remove-device={ud.deviceId}
                  class="mt-3 w-full rounded-lg border border-white/6 px-3 py-1.5 text-xs font-medium text-[var(--color-text-dim)] hover:border-red-500/30 hover:bg-red-500/10 hover:text-red-400 transition-colors"
                >
                  Remove
                </button>
              </div>
            ))}
          </div>
        ) : (
          <div class="rounded-lg border border-dashed border-white/10 bg-[var(--color-raised)]/50 p-10 text-center">
            <svg class="mx-auto h-10 w-10 text-[var(--color-text-dim)] mb-3" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
              <rect x="5" y="3" width="14" height="18" rx="3" />
              <line x1="9" y1="18" x2="15" y2="18" />
            </svg>
            <p class="text-[var(--color-text-2)] text-sm">No devices in your setup yet.</p>
            <p class="text-[var(--color-text-dim)] text-xs mt-1">Click "Add Device" above to get started.</p>
          </div>
        )}

        <!-- Device Picker (hidden by default) -->
        <div id="device-picker-container" class="hidden mt-4">
          <div class="rounded-lg border border-white/10 bg-[var(--color-base)] p-6">
            <div class="flex items-center justify-between mb-4">
              <h3 class="text-lg font-semibold text-white">Choose a Device</h3>
              <button id="close-device-picker" class="text-[var(--color-text-2)] hover:text-white transition-colors">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                </svg>
              </button>
            </div>
            <DevicePicker
              client:load
              userDeviceIds={userDeviceIds}
            />
          </div>
        </div>
      </section>

      <!-- ─── BADGES (1/3 width) ─── -->
      <section class="lg:col-span-1">
        <div class="mb-4">
          <h2 class="text-lg font-bold text-white ">Badges</h2>
          <p class="mt-0.5 text-xs text-[var(--color-text-dim)]">Achievements earned through contributions</p>
        </div>
        <div class="rounded-lg border border-white/6 bg-[var(--color-raised)] p-5">
          <BadgeGrid client:visible badges={badgesForGrid} />
        </div>
      </section>

      <!-- ─── MY REPORTS (full width) ─── -->
      <section class="lg:col-span-3">
        <div class="flex items-center justify-between mb-4">
          <div>
            <h2 class="text-lg font-bold text-white ">My Reports</h2>
            <p class="mt-0.5 text-xs text-[var(--color-text-dim)]">Your recent performance submissions</p>
          </div>
          <a
            href="/report/new"
            class="inline-flex items-center gap-1.5 rounded-lg bg-[#D4FF00] px-3 py-1.5 text-sm font-medium text-[#0a0a0a] hover:bg-[#e8ff4d] transition-colors"
          >
            <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
            </svg>
            New Report
          </a>
        </div>

        {recentReports.length > 0 ? (
          <div class="space-y-2 stagger">
            {recentReports.map((report: any) => {
              const ratingClass = ratingColors[report.overallRating] ?? ratingColors.fair;
              const date = new Date(report.createdAt).toLocaleDateString('en-US', {
                month: 'short',
                day: 'numeric',
                year: 'numeric',
              });
              return (
                <a
                  href={report.gameSlug ? `/games/${report.gameSlug}` : '#'}
                  class="flex items-center gap-4 rounded-lg border border-white/6 bg-[var(--color-raised)] p-4 hover:border-white/10 hover:bg-[var(--color-raised)]/80 transition-all group"
                >
                  {/* Game image */}
                  <div class="flex-shrink-0 w-16 h-10 rounded-lg bg-[var(--color-base)] border border-white/6 overflow-hidden">
                    {report.gameImage ? (
                      <img src={report.gameImage} alt="" class="h-full w-full object-cover" loading="lazy" />
                    ) : (
                      <div class="h-full w-full flex items-center justify-center">
                        <svg class="h-5 w-5 text-[var(--color-text-dim)]" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
                          <path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                      </div>
                    )}
                  </div>

                  {/* Report info */}
                  <div class="flex-1 min-w-0">
                    <h4 class="text-sm font-medium text-white group-hover:text-[#D4FF00] transition-colors truncate">
                      {report.gameName}
                    </h4>
                    <p class="text-xs text-[var(--color-text-dim)] mt-0.5">
                      {report.deviceName} &middot; {report.fpsAvg ? `${report.fpsAvg} FPS` : 'No FPS data'}
                    </p>
                  </div>

                  {/* Rating badge */}
                  <span class={`flex-shrink-0 inline-flex items-center rounded-full border px-2.5 py-0.5 text-xs font-medium capitalize ${ratingClass}`}>
                    {report.overallRating}
                  </span>

                  {/* Date */}
                  <span class="flex-shrink-0 text-xs text-[var(--color-text-dim)] hidden sm:block font-mono">
                    {date}
                  </span>

                  {/* Arrow */}
                  <svg class="flex-shrink-0 h-4 w-4 text-[var(--color-text-dim)] group-hover:text-[#D4FF00] transition-colors" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                  </svg>
                </a>
              );
            })}
          </div>
        ) : (
          <div class="rounded-lg border border-dashed border-white/10 bg-[var(--color-raised)]/50 p-10 text-center">
            <svg class="mx-auto h-10 w-10 text-[var(--color-text-dim)] mb-3" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
            <p class="text-[var(--color-text-2)] text-sm">No performance reports yet.</p>
            <p class="text-[var(--color-text-dim)] text-xs mt-1">
              <a href="/report/new" class="text-[#D4FF00] hover:text-[#e8ff4d] transition-colors">Submit your first report</a> to help the community.
            </p>
          </div>
        )}
      </section>

      <!-- ─── FOLLOWED GAMES (2/3 width) ─── -->
      <section class="lg:col-span-2">
        <div class="flex items-center justify-between mb-4">
          <div>
            <h2 class="text-lg font-bold text-white ">Followed Games</h2>
            <p class="mt-0.5 text-xs text-[var(--color-text-dim)]">Games you're tracking for updates</p>
          </div>
          {followedGames.length > 0 && (
            <span class="text-xs text-[var(--color-text-dim)] font-mono">{followedGames.length} games</span>
          )}
        </div>

        {followedGames.length > 0 ? (
          <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 stagger">
            {followedGames.map(game => (
              <a
                href={game.slug ? `/games/${game.slug}` : '#'}
                class="group rounded-lg border border-white/6 bg-[var(--color-raised)] overflow-hidden hover:border-white/10 transition-all"
              >
                <div class="aspect-[460/215] bg-[var(--color-base)] overflow-hidden">
                  {game.image ? (
                    <img src={game.image} alt={game.name} class="h-full w-full object-cover group-hover:scale-105 transition-transform duration-300" loading="lazy" />
                  ) : (
                    <div class="h-full w-full flex items-center justify-center">
                      <svg class="h-8 w-8 text-[var(--color-text-dim)]" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
                        <path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                      </svg>
                    </div>
                  )}
                </div>
                <div class="p-2.5">
                  <p class="text-xs font-medium text-white truncate group-hover:text-[#D4FF00] transition-colors">{game.name}</p>
                </div>
              </a>
            ))}
          </div>
        ) : (
          <div class="rounded-lg border border-dashed border-white/10 bg-[var(--color-raised)]/50 p-10 text-center">
            <svg class="mx-auto h-10 w-10 text-[var(--color-text-dim)] mb-3" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12Z" />
            </svg>
            <p class="text-[var(--color-text-2)] text-sm">No followed games yet.</p>
            <p class="text-[var(--color-text-dim)] text-xs mt-1">
              <a href="/games" class="text-[#D4FF00] hover:text-[#e8ff4d] transition-colors">Browse games</a> and follow the ones you play.
            </p>
          </div>
        )}
      </section>

      <!-- ─── STEAM LIBRARY (1/3 width) ─── -->
      <section class="lg:col-span-1">
        <div class="mb-4">
          <h2 class="text-lg font-bold text-white ">Steam Library</h2>
          <p class="mt-0.5 text-xs text-[var(--color-text-dim)]">Import games from Steam</p>
        </div>
        <div class="rounded-lg border border-white/6 bg-[var(--color-raised)] p-5">
          <SteamImport client:visible currentUserId={profile.id} />
        </div>

        {(libraryCount ?? 0) > 0 && (
          <div class="mt-4 space-y-2">
            {libraryGames.slice(0, 8).map(game => (
              <a
                href={game.slug ? `/games/${game.slug}` : '#'}
                class="flex items-center gap-3 rounded-lg border border-white/6 bg-[var(--color-raised)] p-2.5 hover:border-white/10 transition-all group"
              >
                <div class="flex-shrink-0 w-10 h-10 rounded bg-[var(--color-base)] border border-white/6 overflow-hidden">
                  {game.image ? (
                    <img src={game.image} alt={game.name} class="h-full w-full object-cover" loading="lazy" />
                  ) : (
                    <div class="h-full w-full flex items-center justify-center">
                      <svg class="h-4 w-4 text-[var(--color-text-dim)]" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
                      </svg>
                    </div>
                  )}
                </div>
                <div class="flex-1 min-w-0">
                  <p class="text-xs font-medium text-white truncate group-hover:text-[#D4FF00] transition-colors">{game.name}</p>
                  {game.playtime > 0 && (
                    <p class="text-[10px] text-[var(--color-text-dim)] mt-0.5 font-mono">{game.playtime.toFixed(1)}h</p>
                  )}
                </div>
              </a>
            ))}
            {(libraryCount ?? 0) > 8 && (
              <p class="text-center text-[10px] text-[var(--color-text-dim)] pt-1">
                +{(libraryCount ?? 0) - 8} more games
              </p>
            )}
          </div>
        )}
      </section>

    </div>
  </div>

  <!-- ═══════════════════════════════════════════
       ACCOUNT SETTINGS
       ═══════════════════════════════════════════ -->
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 pb-10">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">

      <!-- Password Change -->
      <section class="rounded-lg border border-white/6 bg-[var(--color-raised)] p-6">
        <h2 class="text-lg font-bold text-white mb-1">Change Password</h2>
        <p class="text-xs text-[var(--color-text-dim)] mb-4">Update your account password</p>

        <div class="space-y-3">
          <div>
            <label for="current-password" class="block text-sm font-medium text-[var(--color-text-2)] mb-1">Current Password</label>
            <input id="current-password" type="password" autocomplete="current-password"
              class="w-full rounded-lg border border-white/10 bg-[var(--color-base)] px-3.5 py-2.5 text-sm text-white placeholder-[var(--color-text-dim)] focus:border-[#D4FF00] focus:outline-none focus:ring-1 focus:ring-[#D4FF00] transition-colors" />
          </div>
          <div>
            <label for="new-password" class="block text-sm font-medium text-[var(--color-text-2)] mb-1">New Password</label>
            <input id="new-password" type="password" autocomplete="new-password" placeholder="Min 8 characters"
              class="w-full rounded-lg border border-white/10 bg-[var(--color-base)] px-3.5 py-2.5 text-sm text-white placeholder-[var(--color-text-dim)] focus:border-[#D4FF00] focus:outline-none focus:ring-1 focus:ring-[#D4FF00] transition-colors" />
          </div>
          <div>
            <label for="confirm-password" class="block text-sm font-medium text-[var(--color-text-2)] mb-1">Confirm Password</label>
            <input id="confirm-password" type="password" autocomplete="new-password"
              class="w-full rounded-lg border border-white/10 bg-[var(--color-base)] px-3.5 py-2.5 text-sm text-white placeholder-[var(--color-text-dim)] focus:border-[#D4FF00] focus:outline-none focus:ring-1 focus:ring-[#D4FF00] transition-colors" />
          </div>
          <p id="password-error" class="hidden text-sm text-red-400"></p>
          <p id="password-success" class="hidden text-sm text-[#D4FF00]"></p>
          <button id="change-password-btn"
            class="rounded-lg bg-[#D4FF00] px-5 py-2.5 text-sm font-medium text-[#0a0a0a] hover:bg-[#e8ff4d] transition-colors disabled:opacity-50 disabled:cursor-not-allowed">
            Update Password
          </button>
        </div>
      </section>

      <!-- Notification Settings -->
      <section class="rounded-lg border border-white/6 bg-[var(--color-raised)] p-6">
        <h2 class="text-lg font-bold text-white mb-1">Notifications</h2>
        <p class="text-xs text-[var(--color-text-dim)] mb-4">Control what notifications you receive</p>

        <div class="space-y-4">
          <label class="flex items-center justify-between cursor-pointer">
            <div>
              <p class="text-sm text-white">Reply notifications</p>
              <p class="text-xs text-[var(--color-text-dim)]">Notify me when someone replies to my comments</p>
            </div>
            <input id="notify-reply" type="checkbox" checked={profile.notify_on_reply !== false}
              class="h-5 w-5 rounded border-white/10 bg-[var(--color-base)] text-[#D4FF00] focus:ring-[#D4FF00] focus:ring-offset-0" />
          </label>

          <label class="flex items-center justify-between cursor-pointer">
            <div>
              <p class="text-sm text-white">Vote notifications</p>
              <p class="text-xs text-[var(--color-text-dim)]">Notify me when someone upvotes my reports or comments</p>
            </div>
            <input id="notify-vote" type="checkbox" checked={profile.notify_on_vote === true}
              class="h-5 w-5 rounded border-white/10 bg-[var(--color-base)] text-[#D4FF00] focus:ring-[#D4FF00] focus:ring-offset-0" />
          </label>
        </div>
        <p id="notif-status" class="hidden mt-3 text-xs text-[#D4FF00]"></p>
      </section>

    </div>
  </div>

  <!-- ═══════════════════════════════════════════
       CLIENT-SIDE SCRIPTS
       ═══════════════════════════════════════════ -->
  <script>
    // --- Edit Profile Toggle ---
    const editBtn = document.getElementById('edit-profile-btn');
    const editForm = document.getElementById('edit-profile-form');
    const cancelBtn = document.getElementById('cancel-profile-btn');
    const saveBtn = document.getElementById('save-profile-btn');
    const errorEl = document.getElementById('edit-profile-error');
    const successEl = document.getElementById('edit-profile-success');

    editBtn?.addEventListener('click', () => {
      editForm?.classList.toggle('hidden');
      if (errorEl) errorEl.classList.add('hidden');
      if (successEl) successEl.classList.add('hidden');
    });

    cancelBtn?.addEventListener('click', () => {
      editForm?.classList.add('hidden');
    });

    saveBtn?.addEventListener('click', async () => {
      const displayName = (document.getElementById('edit-display-name') as HTMLInputElement)?.value.trim();
      const username = (document.getElementById('edit-username') as HTMLInputElement)?.value.trim();

      if (errorEl) errorEl.classList.add('hidden');
      if (successEl) successEl.classList.add('hidden');

      const body: Record<string, string> = {};
      if (displayName) body.displayName = displayName;
      if (username) body.username = username;

      if (Object.keys(body).length === 0) {
        if (errorEl) {
          errorEl.textContent = 'Nothing to update.';
          errorEl.classList.remove('hidden');
        }
        return;
      }

      try {
        const res = await fetch('/api/my-setup', {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(body),
        });
        const data = await res.json();

        if (res.ok) {
          if (successEl) {
            successEl.textContent = 'Profile updated! Reloading...';
            successEl.classList.remove('hidden');
          }
          setTimeout(() => window.location.reload(), 800);
        } else {
          if (errorEl) {
            errorEl.textContent = data.error ?? 'Update failed.';
            errorEl.classList.remove('hidden');
          }
        }
      } catch {
        if (errorEl) {
          errorEl.textContent = 'Network error. Please try again.';
          errorEl.classList.remove('hidden');
        }
      }
    });

    // --- Device Picker Toggle ---
    const togglePickerBtn = document.getElementById('toggle-device-picker');
    const pickerContainer = document.getElementById('device-picker-container');
    const closePickerBtn = document.getElementById('close-device-picker');

    togglePickerBtn?.addEventListener('click', () => {
      pickerContainer?.classList.toggle('hidden');
      if (!pickerContainer?.classList.contains('hidden')) {
        pickerContainer?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    });

    closePickerBtn?.addEventListener('click', () => {
      pickerContainer?.classList.add('hidden');
    });

    // --- Change Password ---
    const changePasswordBtn = document.getElementById('change-password-btn');
    const passwordErrorEl = document.getElementById('password-error');
    const passwordSuccessEl = document.getElementById('password-success');

    changePasswordBtn?.addEventListener('click', async () => {
      const current = (document.getElementById('current-password') as HTMLInputElement)?.value;
      const newPw = (document.getElementById('new-password') as HTMLInputElement)?.value;
      const confirm = (document.getElementById('confirm-password') as HTMLInputElement)?.value;

      if (passwordErrorEl) passwordErrorEl.classList.add('hidden');
      if (passwordSuccessEl) passwordSuccessEl.classList.add('hidden');

      if (!current || !newPw || !confirm) {
        if (passwordErrorEl) {
          passwordErrorEl.textContent = 'All fields are required.';
          passwordErrorEl.classList.remove('hidden');
        }
        return;
      }

      if (newPw !== confirm) {
        if (passwordErrorEl) {
          passwordErrorEl.textContent = 'New passwords do not match.';
          passwordErrorEl.classList.remove('hidden');
        }
        return;
      }

      if (newPw.length < 8) {
        if (passwordErrorEl) {
          passwordErrorEl.textContent = 'Password must be at least 8 characters.';
          passwordErrorEl.classList.remove('hidden');
        }
        return;
      }

      (changePasswordBtn as HTMLButtonElement).disabled = true;
      (changePasswordBtn as HTMLButtonElement).textContent = 'Updating...';

      try {
        const res = await fetch('/api/auth/change-password', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ currentPassword: current, newPassword: newPw }),
        });
        const data = await res.json();

        if (res.ok) {
          if (passwordSuccessEl) {
            passwordSuccessEl.textContent = 'Password updated successfully!';
            passwordSuccessEl.classList.remove('hidden');
          }
          (document.getElementById('current-password') as HTMLInputElement).value = '';
          (document.getElementById('new-password') as HTMLInputElement).value = '';
          (document.getElementById('confirm-password') as HTMLInputElement).value = '';
        } else {
          if (passwordErrorEl) {
            passwordErrorEl.textContent = data.error ?? 'Failed to update password.';
            passwordErrorEl.classList.remove('hidden');
          }
        }
      } catch {
        if (passwordErrorEl) {
          passwordErrorEl.textContent = 'Network error. Please try again.';
          passwordErrorEl.classList.remove('hidden');
        }
      } finally {
        (changePasswordBtn as HTMLButtonElement).disabled = false;
        (changePasswordBtn as HTMLButtonElement).textContent = 'Update Password';
      }
    });

    // --- Notification Preferences ---
    const notifyReplyCheckbox = document.getElementById('notify-reply') as HTMLInputElement;
    const notifyVoteCheckbox = document.getElementById('notify-vote') as HTMLInputElement;
    const notifStatus = document.getElementById('notif-status');

    async function saveNotifPref(field: string, value: boolean) {
      if (notifStatus) {
        notifStatus.textContent = 'Saving...';
        notifStatus.classList.remove('hidden');
      }
      try {
        const body: Record<string, boolean> = {};
        body[field] = value;
        await fetch('/api/my-setup', {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(body),
        });
        if (notifStatus) {
          notifStatus.textContent = 'Saved!';
          setTimeout(() => notifStatus.classList.add('hidden'), 1500);
        }
      } catch {
        if (notifStatus) {
          notifStatus.textContent = 'Failed to save.';
          notifStatus.classList.remove('hidden');
        }
      }
    }

    notifyReplyCheckbox?.addEventListener('change', () => {
      saveNotifPref('notifyOnReply', notifyReplyCheckbox.checked);
    });

    notifyVoteCheckbox?.addEventListener('change', () => {
      saveNotifPref('notifyOnVote', notifyVoteCheckbox.checked);
    });

    // --- Remove device buttons ---
    document.querySelectorAll('[data-remove-device]').forEach(btn => {
      btn.addEventListener('click', async (e) => {
        e.preventDefault();
        const deviceId = (btn as HTMLElement).dataset.removeDevice;
        if (!deviceId) return;

        if (!confirm('Remove this device from your setup?')) return;

        try {
          const res = await fetch(`/api/my-setup?deviceId=${encodeURIComponent(deviceId)}`, {
            method: 'DELETE',
          });
          if (res.ok) {
            window.location.reload();
          } else {
            const data = await res.json();
            alert(data.error ?? 'Failed to remove device.');
          }
        } catch {
          alert('Network error. Please try again.');
        }
      });
    });
  </script>
</BaseLayout>
