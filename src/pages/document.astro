      <!-- ═══ DATABASE SCHEMA ═══ -->
      <section id="database" class="doc-section">
        <span class="doc-label">DATA</span>
        <h1 class="doc-h1">Database Schema</h1>
        <p class="doc-intro">PostgreSQL via Supabase. ORM: Drizzle. 20 tables with foreign keys, unique indexes, and cascade deletes.</p>

        <h2 class="doc-h2">Core Tables</h2>

        <h3 class="doc-h3">games</h3>
